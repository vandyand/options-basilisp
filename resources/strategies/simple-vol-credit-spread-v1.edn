;; Strategy declaration (STRATEGY_PIPELINE §4) — first options strategy:
;; SPY put credit spread entered when the chain-quoted net credit mid of the
;; configured vertical (sell 550 put / buy 545 put, 2026-06-19) is at or
;; above the model threshold, flattened when a later chain snapshot quotes
;; the spread below threshold. Pure data; reviewable without executing code.
;;
;; :strategy/instruments names the UNDERLYING — option-chain snapshots land
;; in :engine/market under the underlying's instrument id, which is also the
;; pipeline trigger scope. The spread's leg strike configuration lives in
;; the feature manifest params (feature/simple-vol/v1 :spread) — single
;; source of truth shared by feature, risk, and execution stages.

{:strategy/id "strategy/simple-vol/credit-spread/v1"
 :strategy/family :strategy-family/simple-vol
 :strategy/name :strategy-name/credit-spread
 :strategy/version 1
 :strategy/mode-policy #{:mode/replay :mode/sim :mode/paper}
 :strategy/schedule {:session :session/us-equities-regular}
 :strategy/warmup {:required-bars 1}
 :strategy/instruments ["equity/NASDAQ/SPY"]
 :strategy/features {:manifest-ref "feature/simple-vol/v1"}
 :strategy/inference {:artifact-ref "model/simple-vol/v1"}
 :strategy/signal {:fn-id :signal/credit-threshold-v1}
 :strategy/risk {:policy-id :risk/defined-risk-spread
                 :params {:max-spreads 1
                          :max-risk "5.00"}}
 :strategy/execution {:policy-id :execution/vertical-credit-spread-v1
                      :params {:quantity "1"}}}
