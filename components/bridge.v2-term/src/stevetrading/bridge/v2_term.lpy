(ns stevetrading.bridge.v2-term
  "Core V2 TERM-family signal bridge (HAWK_TERM_*).

  This bridge adds ONLY the TermSlopeSignal hysteresis machine
  (verified sign convention, hawk_term_main.py):
      z > +enter-sigma             -> :long  (LONG_CALENDAR)
      z < -enter-sigma             -> :short (SHORT_CALENDAR)
      |z| < exit-sigma while held  -> :flat
  and per-wall-minute memoization (prediction_fn does network I/O —
  at most one evaluation per strategy per minute; errors/NaN hold the
  prior kind and degrade health, never throw into the engine).

  Handle shape matches bridge.steve-v2: {:signals-fn (fn [] {bot kind})}
  — the registry's bridge pipeline consumes it unchanged.

  Legacy Data-Preprocessor predictor loading lives in
  stevetrading.bridge.v2-term.legacy. This namespace is intentionally
  injectable so replay/parity tests do not hide legacy imports or network
  hydration behind the core bridge."
  (:import datetime math))

(defn- utc-now []
  (datetime.datetime/now (.-utc datetime/timezone)))

(defn- minute-key [dt]
  (.strftime dt "%Y-%m-%dT%H:%M"))

(defn- finite-z [value]
  (try
    (let [f (python/float value)]
      (when-not (math/isnan f) f))
    (catch python/Exception _
      nil)))

(defn hysteresis-step
  "Pure TermSlopeSignal step: held kind + z -> kind."
  [held z enter-sigma exit-sigma]
  (cond
    (nil? z) held
    (> z enter-sigma) :long
    (< z (- enter-sigma)) :short
    (and (not= :flat held) (< (abs z) exit-sigma)) :flat
    :else held))

(defn make-v2-term-bridge
  "Construct the bridge. config:
    :strategies    {bot {:enter-sigma 2.5 :exit-sigma 0.5}} — bots from
                   the supplied prediction factory
    :prediction-factory REQUIRED Basilisp-owned seam:
                   (fn [bot params] {:pred-fn (fn [instant] z)})
    :now-fn        optional clock for tests/replayable wrappers

  Use stevetrading.bridge.v2-term.legacy/make-legacy-v2-term-bridge when
  loading the legacy Data-Preprocessor predictors for live simulation."
  [{:keys [strategies prediction-factory now-fn]
    :or {strategies {:hawk-term-spy {:enter-sigma 2.5 :exit-sigma 0.5}}
         now-fn utc-now}}]
  (when-not prediction-factory
    (throw (ex-info "make-v2-term-bridge requires :prediction-factory; use stevetrading.bridge.v2-term.legacy/make-legacy-v2-term-bridge for legacy predictors"
                    {:error/reason :missing-prediction-factory})))
  (let [load-bot (fn [bot params]
                   (let [predictor (prediction-factory bot params)
                         pred-fn (:pred-fn predictor)]
                     (when-not pred-fn
                       (throw (ex-info (str "v2 term predictor missing :pred-fn for " bot)
                                       {:error/bot bot})))
                     (assoc predictor
                            :pred-fn pred-fn
                            :enter-sigma (double (:enter-sigma params 2.5))
                            :exit-sigma (double (:exit-sigma params 0.5)))))
        bots (into {} (map (fn [[bot params] ] [bot (load-bot bot params)])
                           strategies))
        state (atom {:kinds (zipmap (keys bots) (repeat :flat))
                     :last-minute nil
                     :last-z {}
                     :last-error nil})]
    {:bots bots
     :state state
     :signals-fn
     (fn []
       (let [now (now-fn)
             minute (minute-key now)
             st @state]
         (if (= minute (:last-minute st))
           (:kinds st)
           (let [results
                 (into {}
                       (map (fn [[bot {:keys [pred-fn enter-sigma exit-sigma]}]]
                              (let [held (get-in st [:kinds bot] :flat)
                                    z (try
                                        (finite-z (pred-fn now))
                                        (catch python/Exception e
                                          (swap! state assoc :last-error
                                                 (str bot ": " e))
                                          nil))]
                                [bot {:kind (hysteresis-step held z
                                                             enter-sigma
                                                             exit-sigma)
                                      :z z}]))
                            bots))
                 kinds (into {} (map (fn [[b r]] [b (:kind r)]) results))]
             (swap! state assoc
                    :kinds kinds
                    :last-minute minute
                    :last-z (into {} (map (fn [[b r]] [b (:z r)]) results)))
             kinds))))}))
