(def required-market-evidence-option-surface-prefixes #{"SPX" "SPXW" "VIX" "VIXW"})
(def required-capture-v2-object-sidecars #{"bar_buffers_json"
                                           "option_chain_json"
                                           "option_surfaces_json"
