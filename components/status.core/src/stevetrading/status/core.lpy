  [{:name "CHESTNUT" :strategy-id "strategy/steve-v2/chestnut/v1" :account-id "account/alpaca/chestnut-paper" :group "alpaca-paper" :stale-minutes 15}
   {:name "LYNX" :strategy-id "strategy/steve-v2/lynx/v1" :account-id "account/alpaca/lynx-paper" :group "alpaca-paper" :stale-minutes 15}
   {:name "MOOSE" :strategy-id "strategy/steve-v2/moose/v1" :account-id "account/alpaca/moose-paper" :group "alpaca-paper" :stale-minutes 15}
   {:name "OAK" :strategy-id "strategy/steve-v2/oak/v1" :account-id "account/alpaca/oak-paper" :group "alpaca-paper" :stale-minutes 15}
   {:name "PARROT" :strategy-id "strategy/steve-v2/parrot/v1" :account-id "account/alpaca/parrot-paper" :group "alpaca-paper" :stale-minutes 15}
   {:name "DOLPHIN" :strategy-id "strategy/steve-v2/dolphin/v1" :account-id "account/alpaca/dolphin-paper" :group "alpaca-paper" :stale-minutes 15}])

