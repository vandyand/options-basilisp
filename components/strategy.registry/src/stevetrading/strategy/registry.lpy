(ns stevetrading.strategy.registry
  "Strategy declarations, registry, and the pure pipeline composer
  (STRATEGY_PIPELINE_AND_ARTIFACT_MODEL whole doc, ARCHITECTURE §17-§19).

  Strategies are data (§4); this namespace validates declarations
  (structure + artifact compatibility, §8), builds the registry, and
  composes the seven pipeline stages (§3) into one pure invocation:

    market-state selection -> features -> inference -> signal -> risk ->
    execution planning -> order-intent creation

  PURE pipeline component — requires domain.* and the pure stage
  components only. Artifact LOADING (artifact.file-store) and fact
  persistence belong to the composing base; run-pipeline receives loaded
  artifact maps and returns fact envelopes for the caller to append.

  Determinism: every timestamp on emitted facts is the market slice's
  last bar time (never wall clock); decision ids and order-intent ids are
  deterministic hashes (CANONICAL_SCHEMAS §5.2.6, §12). Envelope
  :record/id values are fresh ULIDs — identity lives in the payload ids.

  Lineage/causation convention (documented choice, kept consistent):
  - :record/correlation-id on every emitted fact = the decision id, tying
    the whole decision thread together
  - prediction-produced is caused by the market source watermark; since
    the pure pipeline sees a slice (not bar fact record ids), its
    :record/causation-ids carries the deterministic watermark token
    \"watermark/<instrument-id>/<last-bar-time>\"
  - each later fact is caused by the record id of the previous stage's
    fact: signal <- prediction, risk <- signal, plan <- risk,
    order-intent <- plan"
  (:require [stevetrading.domain.enums :as enums]
            [stevetrading.domain.identifiers :as identifiers]
            [stevetrading.domain.instruments :as instruments]
            [stevetrading.domain.schemas :as schemas]
            [stevetrading.execution.core :as execution]
            [stevetrading.feature.core :as feature]
            [stevetrading.inference.core :as inference]
            [stevetrading.risk.core :as risk]
            [stevetrading.signal.core :as signal]))

;; ---------------------------------------------------------------------------
;; Strategy declaration validation (STRATEGY_PIPELINE §4, §8)
;; ---------------------------------------------------------------------------

(defn- err
  [code path message]
  {:error/code    code
   :error/path    path
   :error/message message})

(defn- check
  [errors pred code path message]
  (if pred errors (conj errors (err code path message))))

(defn- structural-errors
  "STRATEGY_PIPELINE §4 minimum declaration shape, plus
  :strategy/instruments (ARCHITECTURE §17 'required instruments' — needed
  by market-state selection and decision scoping)."
  [decl]
  (-> []
      (check (identifiers/valid-strategy-id? (:strategy/id decl))
             :error/invalid-strategy-id [:strategy/id]
             "must be a strategy/<family>/<name>/v<major> id string")
      (check (keyword? (:strategy/family decl))
             :error/missing-key [:strategy/family] "must be a keyword")
      (check (keyword? (:strategy/name decl))
             :error/missing-key [:strategy/name] "must be a keyword")
      (check (int? (:strategy/version decl))
             :error/missing-key [:strategy/version] "must be an integer")
      (check (and (set? (:strategy/mode-policy decl))
                  (seq (:strategy/mode-policy decl))
                  (every? #(contains? enums/modes %) (:strategy/mode-policy decl)))
             :error/invalid-enum [:strategy/mode-policy]
             "must be a non-empty set of known modes")
      (check (map? (:strategy/schedule decl))
             :error/missing-key [:strategy/schedule] "must be a map")
      (check (and (map? (:strategy/warmup decl))
                  (int? (get-in decl [:strategy/warmup :required-bars]))
                  (not (neg? (get-in decl [:strategy/warmup :required-bars]))))
             :error/missing-key [:strategy/warmup :required-bars]
             "must be a non-negative integer (0 = no bar warmup; valid for chain-snapshot-driven strategies)")
      (check (string? (get-in decl [:strategy/features :manifest-ref]))
             :error/missing-key [:strategy/features :manifest-ref]
             "must be a feature-manifest ref string")
      (check (string? (get-in decl [:strategy/inference :artifact-ref]))
             :error/missing-key [:strategy/inference :artifact-ref]
             "must be a model-artifact ref string")
      (check (keyword? (get-in decl [:strategy/signal :fn-id]))
             :error/missing-key [:strategy/signal :fn-id] "must be a keyword")
      (check (keyword? (get-in decl [:strategy/risk :policy-id]))
             :error/missing-key [:strategy/risk :policy-id] "must be a keyword")
      (check (keyword? (get-in decl [:strategy/execution :policy-id]))
             :error/missing-key [:strategy/execution :policy-id] "must be a keyword")
      (check (and (vector? (:strategy/instruments decl))
                  (seq (:strategy/instruments decl))
                  (every? string? (:strategy/instruments decl)))
             :error/missing-key [:strategy/instruments]
             "must be a non-empty vector of instrument-id strings")))

(defn- compatibility-errors
  "STRATEGY_PIPELINE §8 artifact compatibility: declared refs must resolve
  to artifacts whose ids match, and the model must expect exactly the
  declared feature manifest."
  [decl {:keys [feature-manifest model]}]
  (let [manifest-ref (get-in decl [:strategy/features :manifest-ref])
        model-ref (get-in decl [:strategy/inference :artifact-ref])]
    (-> []
        (check (some? feature-manifest)
               :error/missing-artifact [:strategy/features :manifest-ref]
               (str "feature manifest " manifest-ref " not provided"))
        (check (some? model)
               :error/missing-artifact [:strategy/inference :artifact-ref]
               (str "model artifact " model-ref " not provided"))
        (check (or (nil? feature-manifest)
                   (= manifest-ref (:feature-manifest/id feature-manifest)))
               :error/artifact-incompatible [:strategy/features :manifest-ref]
               (str "declared manifest-ref " manifest-ref
                    " but artifact id is " (:feature-manifest/id feature-manifest)))
        (check (or (nil? model)
                   (= model-ref (:model/id model)))
               :error/artifact-incompatible [:strategy/inference :artifact-ref]
               (str "declared artifact-ref " model-ref
                    " but artifact id is " (:model/id model)))
        (check (or (nil? model)
                   (= manifest-ref (:model/feature-manifest-ref model)))
               :error/artifact-incompatible [:strategy/inference :artifact-ref]
               (str "model expects feature manifest "
                    (:model/feature-manifest-ref model)
                    " but strategy declares " manifest-ref)))))

(defn validate-strategy-decl
  "Validate a strategy declaration. 1-arity checks the §4 minimum
  structural shape; 2-arity additionally checks §8 artifact compatibility
  against loaded artifacts {:feature-manifest m :model m}.

  Returns {:valid? true} or {:valid? false :errors [...]}."
  ([decl]
   (let [errors (structural-errors decl)]
     (if (seq errors) {:valid? false :errors (vec errors)} {:valid? true})))
  ([decl artifacts]
   (let [errors (concat (structural-errors decl)
                        (compatibility-errors decl artifacts))]
     (if (seq errors) {:valid? false :errors (vec errors)} {:valid? true}))))

(defn build-registry
  "Build the strategy registry from a vector of declarations: map of
  strategy-id -> declaration. Throws ex-info on structurally invalid
  declarations or duplicate strategy ids."
  [decls]
  (reduce (fn [registry decl]
            (let [{:keys [valid? errors]} (validate-strategy-decl decl)
                  sid (:strategy/id decl)]
              (when-not valid?
                (throw (ex-info (str "invalid strategy declaration: " (pr-str sid))
                                {:error/code :error/invalid-strategy-decl
                                 :error/strategy-id sid
                                 :error/errors errors})))
              (when (contains? registry sid)
                (throw (ex-info (str "duplicate strategy id: " sid)
                                {:error/code :error/duplicate-strategy-id
                                 :error/strategy-id sid})))
              (assoc registry sid decl)))
          {}
          decls))

;; ---------------------------------------------------------------------------
;; Pipeline composition (STRATEGY_PIPELINE §3, §5)
;; ---------------------------------------------------------------------------

(defn- pipeline-fact
  "Build one deterministic-timestamp fact envelope with the shared
  decision-thread metadata."
  [{:keys [mode run-id strategy-id account-id instrument-id
           decision-id market-time]}
   record-type causation-ids dedupe-key payload]
  (schemas/fact-envelope
   (cond-> {:record/type record-type
            :record/mode mode
            :record/correlation-id decision-id
            :record/causation-ids (vec causation-ids)
            :record/strategy-id strategy-id
            :record/account-id account-id
            :record/instrument-id instrument-id
            :record/source-system :system/strategy-pipeline
            :fact/occurred-at market-time
            :fact/recorded-at market-time
            :fact/dedupe-key dedupe-key
            :fact/payload payload}
     (some? run-id) (assoc :record/run-id run-id))))

(defn run-pipeline
  "Run the full pure strategy pipeline for one strategy over one market
  slice. Input:

  {:strategy decl                          ; validated declaration
   :market-slice {:bars [..] :last-time ..}; engine.state per-instrument slice
   :strategy-local-state {..}              ; explicit posture memory (§6)
   :portfolio-view {..}                    ; portfolio.core/derive-portfolio
   :artifacts {:feature-manifest m :model m}
   :account-id \"account/..\"
   :mode :mode/replay                      ; stamped as :record/mode
   :run-id ..}                             ; optional

  Returns {:facts [fact-envelopes] :strategy-local-state' {..}}.

  Emission rules:
  - insufficient feature history (warmup) -> no decision, no facts
  - :posture/hold -> NO facts (posture memory still updates)
  - otherwise: prediction-produced, signal-decision-produced,
    risk-decision-recorded; then, only when risk allows AND an order is
    planned: execution-plan-produced + one order-intent-created per
    intent (full §11.3 payloads, deterministic ids)."
  [{:keys [strategy market-slice strategy-local-state portfolio-view
           artifacts account-id mode run-id]}]
  (let [features (feature/derive-features (:feature-manifest artifacts) market-slice)]
    (if (:feature/insufficient? features)
      {:facts []
       :strategy-local-state' strategy-local-state}
      (let [prediction (inference/run-inference (:model artifacts) features)
            decision (signal/decide-signal strategy prediction market-slice
                                           strategy-local-state)
            state' (assoc strategy-local-state
                          :last-direction (:prediction/direction prediction))]
        (if (= :posture/hold (:decision/posture decision))
          {:facts []
           :strategy-local-state' state'}
          (let [instrument-id (:decision/instrument-id decision)
                decision-id (:decision/id decision)
                market-time (:decision/market-time decision)
                ctx {:mode mode
                     :run-id run-id
                     :strategy-id (:strategy/id strategy)
                     :account-id account-id
                     :instrument-id instrument-id
                     :decision-id decision-id
                     :market-time market-time}
                watermark-token (str "watermark/" instrument-id "/" market-time)
                prediction-fact
                (pipeline-fact ctx :fact/prediction-produced
                               [watermark-token]
                               (str "prediction/" decision-id)
                               prediction)
                signal-fact
                (pipeline-fact ctx :fact/signal-decision-produced
                               [(:record/id prediction-fact)]
                               (str "signal/" decision-id)
                               (select-keys decision
                                            [:decision/id :decision/posture
                                             :decision/reason-codes
                                             :decision/market-time
                                             :decision/instrument-id]))
                requested-qty (get-in strategy
                                      [:strategy/execution :params :quantity]
                                      "1")
                ;; Spread strike configuration lives in the feature
                ;; manifest params (single source of truth); the derived
                ;; leg/width context is threaded to the risk and execution
                ;; stages through their existing ctx arguments.
                spread-ctx (when-let [spread-params
                                      (get-in artifacts
                                              [:feature-manifest
                                               :feature-manifest/params
                                               :spread])]
                             (instruments/vertical-spread-context spread-params))
                risk-result (risk/evaluate-risk
                             (get-in strategy [:strategy/risk :policy-id])
                             (assoc decision :decision/requested-quantity requested-qty)
                             portfolio-view
                             (cond-> {:account/id account-id
                                      :risk/params (get-in strategy
                                                           [:strategy/risk :params])}
                               (some? spread-ctx) (assoc :risk/spread spread-ctx)))
                risk-fact
                (pipeline-fact ctx :fact/risk-decision-recorded
                               [(:record/id signal-fact)]
                               (str "risk/" decision-id)
                               (assoc (select-keys risk-result
                                                   [:risk/policy-id :risk/decision
                                                    :risk/reason-codes
                                                    :risk/approved-quantity])
                                      :decision/id decision-id))
                base-facts [prediction-fact signal-fact risk-fact]]
            (if (not= :risk/allow (:risk/decision risk-result))
              {:facts base-facts
               :strategy-local-state' state'}
              (let [{:execution/keys [plan order-intents]}
                    (execution/plan-execution
                     (get-in strategy [:strategy/execution :policy-id])
                     (merge decision risk-result)
                     (cond-> {:instrument/id instrument-id}
                       (some? spread-ctx) (assoc :execution/spread spread-ctx))
                     account-id)]
                (if (empty? order-intents)
                  {:facts base-facts
                   :strategy-local-state' state'}
                  (let [plan-fact
                        (pipeline-fact ctx :fact/execution-plan-produced
                                       [(:record/id risk-fact)]
                                       (str "plan/" decision-id)
                                       (assoc plan :decision/id decision-id))
                        intent-facts
                        (mapv (fn [intent]
                                (pipeline-fact ctx :fact/order-intent-created
                                               [(:record/id plan-fact)]
                                               (str "intent/" (:order-intent/id intent))
                                               intent))
                              order-intents)]
                    {:facts (into (conj base-facts plan-fact) intent-facts)
                     :strategy-local-state' state'}))))))))))
