(ns stevetrading.bridge.steve-v2
  "Bridge to the six PROVEN Python production strategy brains
  (CHESTNUT/LYNX/MOOSE H3 direction bots + OAK/DOLPHIN/PARROT 2-of-3
  consensus) trained from the reference Data-Preprocessor artifacts.

  ⚠ NOT REPLAY-SAFE (v0): this component holds mutable Python-side state
  (bar deques, greeks-grid history, torch/xgboost model objects). It is a
  stateful adapter, not a fold. Restart = re-prime from history via
  `prime!`. Do NOT wire this into the deterministic replay path until the
  model-inference layer is ported natively.

  Runtime requirements (NOT needed to load this namespace — everything
  heavy is imported lazily inside `make-bridge` via importlib):
    - torch, xgboost, numpy, scipy, pandas (the REF .venv has them)
    - the REF repo on disk (`:ref-root`), providing:
        encoder architecture modules under REF/models
      Feature vectors and option quote → Black-Scholes → Greeks-grid
      reconstruction are native Basilisp in
      `stevetrading.feature-parity.raw-unlock`.

  Verified Python reference behavior this bridge mirrors:
    - bar_buffers: dict sym→deque of bar dicts for SPY/HYG/TLT/VXX plus
      DERIVED index proxies (data_fetcher.py): SPX = SPY×10, VIX = VXX copy,
      TNX = TLT copy. Production never fetches real SPX/TNX/VIX bars.
    - greeks grids: option chain (strike/right/bid/ask/expiration) →
      BS implied vol + greeks at r=0.043 → (6,21,8) grid (Basilisp).
    - preds: native Basilisp 918-feature vector + grid history → per-bot bundle →
      (p_long, p_gen, p_short).
    - signal: z = pred / final_target_std (mean anchored at 0), AND-gated
      entry, OR-gated exit hysteresis, per multihead_signal_generator.py /
      stevetrading_v2.signals.direction_ensemble (v0_legacy_freeze cal).
    - consensus: 2-of-3 vote (parrot_consensus._consensus_vote); OAK and
      PARROT at threshold-mult 1.0 (identical signal, different execution),
      DOLPHIN at threshold-mult 2.0 applied to all 8 hysteresis params.

  The hysteresis state machine and consensus vote are REIMPLEMENTED here
  as pure Basilisp fns (`direction-step`, `consensus-vote`) so they are
  testable without torch; scripts/bridge_spike.lpy verifies them
  exhaustively against the Python implementations (81 consensus cases,
  direction-step sweep) before trusting this port.

  Call protocol (once per 1-min bar):
    (on-bar! bridge {:symbol \"SPY\" :time dt :open o :high h :low l
                     :close c :volume v})          ; per stock symbol
    (on-chain! bridge {:observed-at dt :contracts [{:strike 600.0
                       :right \"CALL\" :bid 1.2 :ask 1.3
                       :expiration \"2026-06-12\"} ...]})
    (signals bridge) → {:chestnut :long|:short|:flat ... :oak ... :dolphin
                        ... :parrot ... :preds {...} :zs {...}}
  `signals` ADVANCES hysteresis/consensus state ONCE PER NEW BAR and is
  IDEMPOTENT within a bar: the result is memoized by the last ingested
  SPY bar time, so repeated calls before the next on-bar! return the
  cached map without advancing state. This is load-bearing for the
  engine, where run-pipeline runs per strategy per observation — six
  bridge strategies call `signals` up to 6+ times per bar via the shared
  handle.

  ENGINE WIRING (launcher-side; the engine loop itself never touches the
  bridge): construct the bridge + prime! it, then
  - INGESTION via the loop's :on-observation hook, which fires once per
    pulled observation: on :fact/market-bar-observed facts call
    (on-bar! bridge {:symbol <mapped> ...}) — map the fact's
    :record/instrument-id to the bridge symbol (the bridge needs
    SPY/HYG/TLT/VXX bars, so the market-data source must supply all
    four); on :fact/option-chain-observed facts call (on-chain! bridge
    {:observed-at .. :contracts ..}) with the chain payload's contracts
    (strike/right/bid/ask/expiration parsed from the contract
    instrument ids).
  - SIGNALS via the strategy entries: each of the six strategy entries
    carries :bridge {:signals-fn (fn [] (signals bridge))} (the SAME
    bridge — memoization makes the shared calls per-bar idempotent);
    strategy.registry's bridge pipeline path reads its bot's kind from
    the returned map. Tests inject a plain stub
    {:signals-fn (fn [] {:chestnut :long ...})} — no torch needed."
  (:require [stevetrading.bridge.steve-v2.inference :as inference]
            [stevetrading.feature-parity.raw-unlock :as raw-unlock])
  (:import collections
           datetime
           importlib
           json
           math
           os
           os.path
           sys
           types
           zoneinfo))

;; ────────────────────────────────────────────────────────────────────────────
;; Pure logic — verified equivalent to the Python reference (see spike report)
;; ────────────────────────────────────────────────────────────────────────────

(def hysteresis-keys
  "The 8 hysteresis params scaled by per-account threshold-mult
  (ensemble_runner_v2 _HYSTERESIS_KEYS)."
  [:enter-long-sigma :enter-gen-long-sigma :enter-short-sigma
   :enter-gen-short-sigma :exit-long-delta :exit-gen-long-delta
   :exit-short-delta :exit-gen-short-delta])

(defn scale-hysteresis
  "Scale all 8 hysteresis params by mult (OAK/PARROT 1.0, DOLPHIN 2.0)."
  [params mult]
  (reduce (fn [m k] (assoc m k (* (get m k) mult))) params hysteresis-keys))

(def default-direction-state
  {:last-kind :flat :last-z-long 0.0 :last-z-gen 0.0 :last-z-short 0.0})

(defn- finite? [x]
  (and (number? x) (math/isfinite x)))

(defn direction-step
  "One bar of the 3-head direction signal. Pure port of
  stevetrading_v2.signals.direction_ensemble.DirectionEnsembleSignal.evaluate
  (itself a verified port of multihead_signal_generator.py lines 144-212).

  pred  — [p-long p-gen p-short] raw head outputs
  cal   — {:std {:long s :gen s :short s}
           :hysteresis {:enter-long-sigma .. 8 keys ..}
           :regime-active bool (default true)}
  state — {:last-kind :flat|:long|:short :last-z-long .. :last-z-gen ..
           :last-z-short ..} (default-direction-state when nil)

  Returns {:kind k :state next-state :z {:long :gen :short} :fault reason?}."
  [pred cal state]
  (let [state (or state default-direction-state)
        last-kind (:last-kind state)
        [p-long p-gen p-short] pred
        std (:std cal)
        nan-state {:last-kind last-kind :last-z-long ##NaN
                   :last-z-gen ##NaN :last-z-short ##NaN}]
    (cond
      (not (and (finite? p-long) (finite? p-gen) (finite? p-short)))
      {:kind :flat :fault :nan-prediction :state nan-state}

      (or (<= (:long std 0.0) 0.0) (<= (:gen std 0.0) 0.0)
          (<= (:short std 0.0) 0.0))
      {:kind :flat :fault :degenerate-std :state nan-state}

      (false? (:regime-active cal true))
      {:kind :flat :fault nil :reason :regime-gated
       :state default-direction-state}

      :else
      (let [h (:hysteresis cal)
            enter-long  (:enter-long-sigma h)
            exit-long   (:exit-long-delta h)
            enter-gl    (:enter-gen-long-sigma h)
            exit-gl     (:exit-gen-long-delta h)
            enter-gs    (:enter-gen-short-sigma h)
            exit-gs     (:exit-gen-short-delta h)
            enter-short (:enter-short-sigma h)
            exit-short  (:exit-short-delta h)
            z-long  (/ p-long (:long std))
            z-gen   (/ p-gen (:gen std))
            z-short (/ p-short (:short std))
            long-entry  (and (> z-long enter-long) (> z-gen enter-gl))
            short-entry (and (< z-short (- enter-short)) (< z-gen (- enter-gs)))
            long-exit   (or (<= z-long (- enter-long exit-long))
                            (<= z-gen (- enter-gl exit-gl)))
            short-exit  (or (>= z-short (- (- enter-short exit-short)))
                            (>= z-gen (- (- enter-gs exit-gs))))
            new-kind
            (case last-kind
              :flat (cond
                      (and long-entry short-entry)
                      (if (>= (abs z-long) (abs z-short)) :long :short)
                      long-entry :long
                      short-entry :short
                      :else :flat)
              :long (cond
                      long-exit (if short-entry :short :flat)
                      short-entry :short
                      :else :long)
              :short (cond
                       short-exit (if long-entry :long :flat)
                       long-entry :long
                       :else :short)
              :flat)]
        {:kind new-kind
         :z {:long z-long :gen z-gen :short z-short}
         :state {:last-kind new-kind :last-z-long z-long
                 :last-z-gen z-gen :last-z-short z-short}}))))

(defn consensus-vote
  "2-of-3 consensus state machine. Pure port of
  stevetrading_v2.signals.parrot_consensus._consensus_vote.

  votes — seq of 3 kinds (:long/:short/:flat), prior — prior consensus kind."
  [votes prior]
  (let [n-long  (count (filter #(= % :long) votes))
        n-short (count (filter #(= % :short) votes))]
    (case prior
      :flat (cond
              (and (>= n-long 2) (>= n-short 2))
              (cond (> n-long n-short) :long
                    (> n-short n-long) :short
                    :else :flat)
              (>= n-long 2) :long
              (>= n-short 2) :short
              :else :flat)
      :long (cond
              (>= n-short 2) :short
              (< n-long 2) :flat
              :else :long)
      :short (cond
               (>= n-long 2) :long
               (< n-short 2) :flat
               :else :short)
      :flat)))

(defn seed-stats->std
  "Pure: running-sum seed stats {:pred-sum s :pred-sum-sq ss :pred-count n}
  → prediction-distribution std. Used by the :seed-pred-std calibration
  correction (the 4a unit fix, 2026-06-11): v0_legacy_freeze froze
  final_target_std in RAW-RETURN units (~2e-4) while live predictions are
  in STANDARDIZED-target units (~unit scale, seed mean +0.42/std 0.74),
  so z = pred/std blew up to ~1e3-1e4 σ and the Optuna-tuned hysteresis
  bands (0.3-0.65σ) degenerated to sign(pred). Dividing by the PREDICTION
  std restores the σ scale those parameters were tuned for. The zero
  mean-anchor convention of the live signal path is preserved (std-only
  correction)."
  [{:keys [pred-sum pred-sum-sq pred-count]}]
  (let [n (double pred-count)
        mean (/ (double pred-sum) n)
        var (- (/ (double pred-sum-sq) n) (* mean mean))]
    (python/max 1e-9 (math/sqrt (python/max 0.0 var)))))

(defn parse-calibration
  "Parse a v0_legacy_freeze calibration JSON string → bridge cal map.
  Pure (string in, map out) so it's testable without the REF tree."
  [json-str]
  (let [doc (json/loads json-str)
        st (.get doc "state")
        std (.get st "final_target_std")
        h (.get st "hysteresis_params")]
    {:bundle-version (.get doc "bundle_version")
     :std {:long (.get std "long") :gen (.get std "gen")
           :short (.get std "short")}
     :hysteresis {:enter-long-sigma      (.get h "enter_long_sigma")
                  :exit-long-delta       (.get h "exit_long_delta")
                  :enter-gen-long-sigma  (.get h "enter_gen_long_sigma")
                  :exit-gen-long-delta   (.get h "exit_gen_long_delta")
                  :enter-gen-short-sigma (.get h "enter_gen_short_sigma")
                  :exit-gen-short-delta  (.get h "exit_gen_short_delta")
                  :enter-short-sigma     (.get h "enter_short_sigma")
                  :exit-short-delta      (.get h "exit_short_delta")}
     ;; v0_legacy_freeze bundles carry no regime_active key → the live code
     ;; path defaults it to true (direction_ensemble.py line 360).
     :regime-active (if (.__contains__ st "regime_active")
                      (.get st "regime_active")
                      true)}))

;; ────────────────────────────────────────────────────────────────────────────
;; Python-side plumbing (everything below holds live Python objects)
;; ────────────────────────────────────────────────────────────────────────────

(def stock-symbols ["SPY" "HYG" "TLT" "VXX"])
(def bots [:chestnut :lynx :moose])

(defn- ensure-alpaca-stub!
  "Some remaining legacy reference modules import the alpaca SDK at module top.
  When alpaca isn't installed (the REF .venv lacks it), inject empty stub
  modules so those imports succeed."
  []
  (try
    (importlib/import-module "alpaca")
    (catch python/ImportError _
      (let [mods (.-modules sys)
            mk! (fn [name attrs]
                  (let [m (types/ModuleType name)]
                    (doseq [a attrs]
                      (python/setattr m a (python/type a #py () #py {})))
                    (.__setitem__ mods name m)
                    m))]
        (mk! "alpaca" [])
        (mk! "alpaca.trading" [])
        (mk! "alpaca.trading.client" ["TradingClient"])
        (mk! "alpaca.trading.enums" ["AssetStatus"])
        (mk! "alpaca.trading.requests" ["GetOptionContractsRequest"])
        (mk! "alpaca.data" [])
        (mk! "alpaca.data.historical" [])
        (mk! "alpaca.data.historical.option" ["OptionHistoricalDataClient"])
        (mk! "alpaca.data.requests" ["OptionSnapshotRequest"
                                     "StockBarsRequest"
                                     "StockLatestQuoteRequest"])
        nil))))

(defn- ensure-ref-paths! [ref-root]
  (let [spath (.-path sys)
        repo-root (or (os/getenv "STEVE_REPO_ROOT")
                      (os/getcwd))]
    (doseq [p [repo-root ref-root (str ref-root "/src")]]
      (when-not (.__contains__ spath p)
        (.insert spath 0 p)))))

(defn- load-npz-dict
  "np.load an .npz and project the given keys into a python dict."
  [np path keys*]
  (let [npz (.load np path)
        d (python/dict)]
    (doseq [k keys*]
      (.__setitem__ d k (.__getitem__ npz k)))
    d))

(defn- bar->py [bar]
  (let [d #py {"time" (:time bar)
               "open" (double (:open bar))
               "high" (double (:high bar))
               "low" (double (:low bar))
               "close" (double (:close bar))
               "volume" (double (:volume bar 0.0))
               "vwap" (double (:vwap bar (:close bar)))
               "trade_count" (python/int (:trade-count bar 0))}]
    (when (:bid bar) (.__setitem__ d "bid" (double (:bid bar))))
    (when (:ask bar) (.__setitem__ d "ask" (double (:ask bar))))
    d))

(defn- maybe-set-double! [d k v]
  (when (some? v)
    (.__setitem__ d k (double v))))

(defn- maybe-set-int! [d k v]
  (when (some? v)
    (.__setitem__ d k (python/int v))))

(defn- contract->py
  "Convert Basilisp/Python contract maps into JSON-native dicts.

  json.dumps falls back to stringifying Basilisp maps; that produced sidecars
  whose contract rows looked populated but were unusable for formula replay.
  Keep this explicit so capture sidecars are real JSON objects."
  [c]
  (let [d (python/dict)
        right (or (:right c) (get c "right"))
        expiration (or (:expiration c) (get c "expiration"))]
    (maybe-set-double! d "strike" (or (:strike c) (get c "strike")))
    (when (some? right)
      (.__setitem__ d "right" (str right)))
    (maybe-set-double! d "bid" (or (:bid c) (get c "bid")))
    (maybe-set-double! d "ask" (or (:ask c) (get c "ask")))
    (maybe-set-double! d "bid_size" (or (:bid_size c) (:bid-size c)
                                        (get c "bid_size") (get c "bid-size")))
    (maybe-set-double! d "ask_size" (or (:ask_size c) (:ask-size c)
                                        (get c "ask_size") (get c "ask-size")))
    (when (some? expiration)
      (.__setitem__ d "expiration" (str expiration)))
    (maybe-set-double! d "open" (or (:open c) (get c "open")))
    (maybe-set-double! d "high" (or (:high c) (get c "high")))
    (maybe-set-double! d "low" (or (:low c) (get c "low")))
    (maybe-set-double! d "close" (or (:close c) (get c "close")))
    (maybe-set-double! d "volume" (or (:volume c) (get c "volume")))
    (maybe-set-int! d "count" (or (:count c) (get c "count")))
    (maybe-set-double! d "open_interest" (or (:open_interest c)
                                             (:open-interest c)
                                             (get c "open_interest")
                                             (get c "open-interest")))
    (maybe-set-double! d "oi" (or (:oi c) (get c "oi")))
    d))

(defn- contracts->py-list [contracts]
  (python/list (map contract->py contracts)))

(defn- normalize-capture-time-text
  "Canonicalize timezone-aware capture timestamps for stable restart de-dupe.

  Naive strings are left untouched because assuming UTC for an ambiguous local
  wall-clock string would be worse than preserving the caller's exact key."
  [value]
  (let [raw (.strip (str (or value "")))]
    (if (zero? (count raw))
      raw
      (try
        (let [unwrapped (if (and (.startswith raw "#inst \"")
                                 (.endswith raw "\""))
                          (subs raw 7 (dec (count raw)))
                          raw)
              iso (if (.endswith unwrapped "Z")
                    (str (subs unwrapped 0 (- (count unwrapped) 1)) "+00:00")
                    unwrapped)
              parsed (datetime.datetime/fromisoformat iso)]
          (if (some? (.-tzinfo parsed))
            (.strftime (.astimezone parsed (.-utc datetime/timezone))
                       "%Y-%m-%dT%H:%M:%SZ")
            raw))
        (catch python/Exception _
          raw)))))

(defn- rebuild-proxies!
  "Mirror data_fetcher._update_proxies: SPX = SPY×10 (o/h/l/c/vwap),
  VIX = VXX copy, TNX = TLT copy. Full rebuild of the proxy deque."
  [buffers sym]
  (let [rebuild (fn [target f]
                  (let [tgt (.__getitem__ buffers target)
                        src (.__getitem__ buffers sym)]
                    (.clear tgt)
                    (doseq [b (python/list src)]
                      (.append tgt (f b)))))]
    (case sym
      "SPY" (rebuild "SPX"
                     (fn [b]
                       #py {"time" (.__getitem__ b "time")
                            "open" (* (.__getitem__ b "open") 10)
                            "high" (* (.__getitem__ b "high") 10)
                            "low" (* (.__getitem__ b "low") 10)
                            "close" (* (.__getitem__ b "close") 10)
                            "volume" (.__getitem__ b "volume")
                            "vwap" (* (.get b "vwap" (.__getitem__ b "close")) 10)
                            "trade_count" (.get b "trade_count" 0)}))
      "VXX" (rebuild "VIX" (fn [b] (.copy b)))
      "TLT" (rebuild "TNX" (fn [b] (.copy b)))
      nil)))

(defn make-bridge
  "Construct the bridge. config:
    :ref-root        — path to the Data-Preprocessor checkout (REQUIRED)
    :bundle-dirs     — {:chestnut path :lynx path :moose path} model bundles
    :calibrations    — {:chestnut path :lynx path :moose path}
                       v0_legacy_freeze.json paths
    :risk-free-rate  — BS r (default 0.043, OptionsChainFetcher.RISK_FREE_RATE)
    :max-bars        — bar deque maxlen (default 200, data_fetcher.MAX_HISTORY)
    :grid-history    — grid deque maxlen (default 10, main.py GRID_HISTORY_LEN)
    :mult2-scale     — hysteresis multiplier for the second lane
                       (DOLPHIN's consensus input; default 2.0 =
                       production legacy, operator-tuned to 1.5
                       2026-06-12 for the honest-z regime)
    :capture-dir     — when set, every NEW bar's 918-feature vectors (all
                       three engine instances), latest greeks grid, and
                       SPY price are appended to
                       <capture-dir>/live_features_<utc-date>.npz
                       (full rewrite per bar, ~MBs) — the live side of
                       the train/serve feature-parity check
    :capture-provenance — immutable source/semantics map written alongside
                       every captured model input. A capture without this is
                       replayable, but is not eligible to certify a new
                       train/serve data lineage.

  Loads torch/xgboost model inference eagerly — requires the REF venv."
  [{:keys [ref-root bundle-dirs calibrations risk-free-rate max-bars
           grid-history calibration-correction capture-dir capture-provenance mult2-scale]
    :or {risk-free-rate 0.043 max-bars 200 grid-history 10
         calibration-correction :seed-pred-std mult2-scale 2.0}}]
  (ensure-ref-paths! ref-root)
  (ensure-alpaca-stub!)
  (let [np (importlib/import-module "numpy")
        deque (.-deque collections)
        buffers (python/dict)
        _ (doseq [sym ["SPY" "HYG" "TLT" "VXX" "SPX" "TNX" "VIX"]]
    (.__setitem__ buffers sym (deque ** :maxlen max-bars)))
        load-bot (fn [bot]
                   (let [bdir (str (get bundle-dirs bot))
                         feat-names (json/loads (slurp (str bdir "/feature_names.json")))
                         name->idx (into {} (map-indexed (fn [i n] [n i]) feat-names))
                         inference (inference/make-multihead-inference ref-root bdir)
                         hmm (load-npz-dict np (str bdir "/hmm_model.npz")
                                            ["means" "covars" "transmat"
                                             "startprob"])
                         atoms (load-npz-dict np
                                              (str bdir "/dictionary_atoms.npz")
                                              ["components" "train_mean"
                                               "train_std"])
                         cal (parse-calibration (slurp (str (get calibrations bot))))
                         ;; 4a unit fix (see seed-stats->std): replace the
                         ;; frozen raw-return stds with the PREDICTION
                         ;; distribution stds from the bundle's seed files.
                         ;; :calibration-correction :none = bug-faithful
                         ;; parity mode for comparison runs.
                         cal (if (= :seed-pred-std calibration-correction)
                               (let [seed-std
                                     (fn [head]
                                       (let [d (.load np (str bdir "/calibration_seed_" head ".npz"))]
                                         (seed-stats->std
                                          {:pred-sum (python/float (.__getitem__ d "pred_sum"))
                                           :pred-sum-sq (python/float (.__getitem__ d "pred_sum_sq"))
                                           :pred-count (python/float (.__getitem__ d "pred_count"))})))]
                                 (assoc cal
                                        :std-frozen (:std cal)
                                        :correction :seed-pred-std
                                        :std {:long (seed-std "long")
                                              :gen (seed-std "gen")
                                              :short (seed-std "short")}))
                               (assoc cal :correction :none))
                         ;; FEATURE NEUTRALIZATION (2026-06-12 corrected-
                         ;; stats deployment): a corrected bundle may
                         ;; carry neutralize_features.json — feature
                         ;; names whose LIVE source is missing (the
                         ;; engine zero-fills GCS-only chain features) or
                         ;; broken (IEX volume ~3% of SIP, bid/ask close-
                         ;; price fallback). Their values are pinned to
                         ;; the bundle's train MEAN pre-inference (z=0,
                         ;; the same neutral effect they had under the
                         ;; identity-stats bug) so the correctly-computed
                         ;; features can be fixed without injecting
                         ;; wrong-but-now-scaled values from the rest.
                         neutralize
                         (let [path (str bdir "/neutralize_features.json")]
                           (when (os.path/exists path)
                             (let [names* (json/loads (slurp path))
                                   idxs (vec (keep #(get name->idx %) names*))]
                               {:indices (.array np (python/list idxs)
                                                 ** :dtype (.-int64 np))
                                :means (.take (.__getitem__ (.load np (str bdir "/feature_stats.npz")) "mean")
                                              (.array np (python/list idxs) ** :dtype (.-int64 np)))
                                :n (count idxs)})))]
                     {:feature-names feat-names
                      :inference inference :hmm hmm
                      :atoms atoms :cal cal :neutralize neutralize
                      :name->idx name->idx}))]
    {:np np
     :option-feature-fn raw-unlock/compute-spy-option-features
     :generic-option-feature-fn raw-unlock/compute-option-features
     :v2-grid-feature-fn raw-unlock/compute-v2-grid-features
     :spy-greek-grid-feature-fn raw-unlock/compute-spy-greek-grid-features
     :generic-greek-grid-feature-fn raw-unlock/compute-greek-grid-features
     :risk-free-rate risk-free-rate
     :buffers buffers
     :grid-history (deque ** :maxlen grid-history)
     :bots (into {} (map (fn [b] [b (load-bot b)]) bots))
     :capture-dir (when capture-dir (str capture-dir))
     :capture-provenance (or capture-provenance {})
     :capture (atom [])
     :last-chain-json (atom nil)
     :last-option-surfaces-json (atom (python/dict))
     :last-option-surface-status-json (atom (python/dict))
     :last-option-features (atom (python/dict))
     :mult2-scale (double mult2-scale)
     :state (atom {:mult1 (zipmap bots (repeat default-direction-state))
                   :mult2 (zipmap bots (repeat default-direction-state))
                   :oak :flat
                   :dolphin :flat
                   :parrot :flat})}))

(defn on-bar!
  "Append one 1-min bar for a stock symbol (SPY/HYG/TLT/VXX); index proxies
  (SPX/VIX/TNX) are derived automatically, mirroring production."
  [bridge {:keys [symbol] :as bar}]
  (let [buffers (:buffers bridge)]
    (.append (.__getitem__ buffers symbol) (bar->py bar))
    (rebuild-proxies! buffers symbol)
    nil))

(defn spy-price [bridge]
  (let [spy (.__getitem__ (:buffers bridge) "SPY")]
    (when (pos? (python/len spy))
      (.get (.__getitem__ spy -1) "close"))))

(defn on-chain!
  "Convert one option-chain snapshot into a (6,21,8) greeks grid and append
  it to the grid history. Uses native Basilisp Black-Scholes fallback math and
  grid aggregation matching the legacy production path.

  snapshot: {:observed-at tz-aware-datetime (default now ET)
             :contracts [{:strike 600.0 :right \"CALL\"|\"PUT\" :bid f :ask f
                          :expiration \"YYYY-MM-DD\"} ...]}
  Returns {:n-input n :n-gridded n :spy-price p}."
  [bridge {:keys [observed-at contracts]}]
  (let [s (spy-price bridge)
        _ (when-not s
            (throw (ex-info "on-chain! requires a primed SPY bar buffer" {})))
        et (zoneinfo/ZoneInfo "America/New_York")
        now (or observed-at (.now (.-datetime datetime) ** :tz et))
        chain-json (.dumps json
                           (python/dict {"observed_at" (.isoformat now)
                                         "spy" s
                                         "contracts" (contracts->py-list contracts)})
                           ** :default str)
        grid (raw-unlock/build-option-greeks-grid chain-json nil nil nil nil (:risk-free-rate bridge))
        n-gridded (if grid (count contracts) 0)]
    (reset! (:last-chain-json bridge)
            chain-json)
	    (reset! (:last-option-features bridge)
	            ((:option-feature-fn bridge) chain-json))
		    (when grid
		      (.append (:grid-history bridge) grid))
		    {:n-input (count contracts) :n-gridded n-gridded :spy-price s}))

(defn on-option-surface!
  "Store formula-backed option aggregate features for non-grid sidecar symbols.

  This is intentionally separate from on-chain!: SPY still drives the greeks
  grid used by the sequence models, while SPX/VIX/VIXW option aggregates are
  overlaid only when neutralization/audit later proves them safe."
  [bridge {:keys [prefix observed-at underlying contracts]}]
  (let [et (zoneinfo/ZoneInfo "America/New_York")
        now (or observed-at (.now (.-datetime datetime) ** :tz et))
        chain-json (.dumps json
                           (python/dict {"observed_at" (.isoformat now)
                                         "underlying" (double underlying)
                                         "contracts" (contracts->py-list contracts)})
                           ** :default str)
        features ((:generic-option-feature-fn bridge) (name prefix) chain-json)
        grid (raw-unlock/build-option-greeks-grid chain-json nil nil nil nil (:risk-free-rate bridge))
        greek-features (if grid
                         ((:generic-greek-grid-feature-fn bridge) (name prefix) grid)
                         (python/dict))]
    (swap! (:last-option-surfaces-json bridge)
           (fn [m]
             (doto (python/dict m)
               (.__setitem__ (name prefix) chain-json))))
    (swap! (:last-option-features bridge)
           (fn [m]
             (let [merged (python/dict m)]
               (doseq [[k v] (.items features)]
                 (.__setitem__ merged k v))
               (doseq [[k v] (.items greek-features)]
                 (.__setitem__ merged k v))
               merged)))
    {:prefix prefix
     :n-input (count contracts)
     :n-gridded (if grid (count contracts) 0)
     :n-features (+ (python/len features) (python/len greek-features))}))

(defn record-option-surface-status!
  "Persist the latest non-SPY option-surface refresh status for capture
  diagnostics. This is deliberately side-effect-only and never influences
  trading decisions."
  [bridge {:keys [prefix observed-at ok? reason error underlying contracts n-input n-gridded n-features]}]
  (when-let [status-atom (:last-option-surface-status-json bridge)]
    (let [et (zoneinfo/ZoneInfo "America/New_York")
          now (or observed-at (.now (.-datetime datetime) ** :tz et))
          payload (python/dict)]
      (.__setitem__ payload "observed_at" (.isoformat now))
      (.__setitem__ payload "ok" (boolean ok?))
      (when (some? reason)
        (.__setitem__ payload "reason" (name reason)))
      (when (some? error)
        (.__setitem__ payload "error" (str error)))
      (when (some? underlying)
        (.__setitem__ payload "underlying" (double underlying)))
      (.__setitem__ payload "contracts" (int (or contracts n-input 0)))
      (.__setitem__ payload "n_gridded" (int (or n-gridded 0)))
      (.__setitem__ payload "n_features" (int (or n-features 0)))
      (swap! status-atom
             (fn [m]
               (doto (python/dict m)
                 (.__setitem__ (name prefix) (.dumps json payload ** :default str)))))
      nil)))

(defn prime!
  "Seed the bridge from history. bars-seed: {sym [bar-maps...]} for the four
  stock symbols (oldest→newest). chain-seed: [snapshot ...] as per on-chain!."
  [bridge bars-seed chain-seed]
  (doseq [sym stock-symbols
          bar (get bars-seed sym)]
    (on-bar! bridge (assoc bar :symbol sym)))
  ;; on-chain! requires a primed SPY bar buffer (it needs the underlying to
  ;; build greeks grids). The cron fires 09:20 — 10 min BEFORE the open — so a
  ;; thin pre-market IEX feed can return an EMPTY SPY bar seed, leaving
  ;; spy-price nil. Seeding the chain then threw and crashed the whole session
  ;; (observed 2026-06-22; the watchdog relaunched it after the open). Skip the
  ;; chain seed when bars did not prime — the live loop builds grids as soon as
  ;; SPY bars start flowing, so the session warms up cleanly instead of dying.
  (if (spy-price bridge)
    (doseq [snap chain-seed]
      (on-chain! bridge snap))
    (println "prime!: SPY bar buffer empty (pre-market / no IEX bars) —"
             "skipping chain seed; grids build once bars flow"))
  nil)

(defn predictions
  "Run feature engine + the three model bundles on current buffers.
  Returns {:chestnut [p-long p-gen p-short] :lynx ... :moose ...
           :features {:chestnut {:n-zero n :n n}}} — does NOT touch signal
  state."
  [bridge]
  (let [np (:np bridge)
        buffers (:buffers bridge)
        grids (python/list (:grid-history bridge))
        grids-seq (if (pos? (count grids))
                    (.stack np grids)
                    (.zeros np #py (1 6 21 8) ** :dtype (.-float32 np)))]
    (into
     {}
     (map (fn [[bot {:keys [feature-names inference hmm atoms neutralize name->idx]}]]
            (let [feats (raw-unlock/compute-live-feature-vector feature-names buffers grids hmm atoms)
                  ;; Formula-backed SPY option-chain aggregate features.
                  ;; Existing neutralization still pins them to train mean
                  ;; until the raw-source parity gate approves unmasking.
                  _ (doseq [[name value] (.items @(:last-option-features bridge))]
                      (when-let [idx (get name->idx name)]
                        (.__setitem__ feats idx (python/float value))))
                  _ (doseq [[name value] (.items ((:v2-grid-feature-fn bridge) grids))]
                      (when-let [idx (get name->idx name)]
                        (.__setitem__ feats idx (python/float value))))
                  _ (doseq [[name value] (.items ((:spy-greek-grid-feature-fn bridge) grids))]
                      (when-let [idx (get name->idx name)]
                        (.__setitem__ feats idx (python/float value))))
                  ;; pin known-bad live sources to their train mean
                  ;; (z=0) — see load-bot neutralize docstring
                  _ (when neutralize
                      (.__setitem__ feats (:indices neutralize)
                                    (:means neutralize)))
                  pred (inference/predict inference feats grids-seq)]
              [bot {:pred (vec (map double pred))
                    :feats feats
                    :n-features (python/len feats)
                    :n-zero (python/int
                             (.sum np (.equal np feats 0.0)))}]))
          (:bots bridge)))))

(defn- capture-features!
  "Feature-parity capture (live side): append this bar's per-bot
  918-feature vectors + latest greeks grid + SPY price + raw bar buffers to the capture
  log and atomically rewrite <capture-dir>/live_features_<utc-date>.npz.
  Full rewrite per bar (390 bars x 3 bots x 918 f32 + grids — a few MB)
  is acceptable for a diagnostic capture. Never throws (a capture failure
  must not take down the trading session)."
  [bridge bar-time preds]
  (when-let [cdir (:capture-dir bridge)]
    (let [time-text (normalize-capture-time-text bar-time)]
      (when (pos? (count time-text))
        (try
          (let [np (:np bridge)
            grids (python/list (:grid-history bridge))
            grid (if (pos? (count grids))
                   (.__getitem__ grids -1)
                   (.zeros np #py (6 21 8) ** :dtype (.-float32 np)))
            grid-history (if (pos? (count grids))
                           (.stack np grids)
                           (.zeros np #py (1 6 21 8) ** :dtype (.-float32 np)))
            raw-buffers (python/dict)
            _ (doseq [sym ["SPY" "HYG" "TLT" "VXX" "SPX" "TNX" "VIX"]]
                (let [buf (.get (:buffers bridge) sym)]
                  (.__setitem__ raw-buffers sym
                                (if buf (python/list buf) (python/list)))))
            capture-count (inc (count @(:capture bridge)))
                            sidecar-every (try
                            (max 1 (python/int (or (os/getenv "STEVE_CAPTURE_SIDECAR_EVERY")
                                                   "1")))
                            (catch python/Exception _
                              1))
            include-sidecars? (and (not (= "1" (os/getenv "STEVE_CAPTURE_DISABLE_SIDECARS")))
                                   (or (= sidecar-every 1)
                                       (= capture-count 1)
                                       (zero? (mod capture-count sidecar-every))))
	            entry {:time time-text
	                   :spy (python/float (or (spy-price bridge) 0.0))
	                   ;; Source identity and completed-bar semantics are part of
	                   ;; the model input contract, not deployment metadata.
	                   :provenance-json (.dumps json
	                                           (letfn [(jsonable [value]
	                                                     (cond
	                                                       (map? value) (python/dict
	                                                                     (map (fn [[k v]]
	                                                                            (python/tuple [(str k) (jsonable v)]))
	                                                                          value))
	                                                       (or (vector? value) (seq? value) (set? value))
	                                                       (python/list (map jsonable value))
	                                                       :else value))]
	                                             (jsonable (or (:capture-provenance bridge) {})))
	                                           ** :sort_keys true :default str)
	                   :grid grid
                   :bar-buffers-json (if include-sidecars?
                                       (.dumps json raw-buffers ** :default str)
                                       "")
                   :option-chain-json (if include-sidecars?
                                        (if-let [chain-atom (:last-chain-json bridge)]
                                          (or @chain-atom "")
                                          "")
                                        "")
                   :option-surfaces-json (if include-sidecars?
                                           (.dumps json
                                                   (if-let [surfaces-atom (:last-option-surfaces-json bridge)]
                                                     (or @surfaces-atom (python/dict))
                                                     (python/dict))
                                                   ** :default str)
                                           "{}")
                   :option-surface-status-json (if include-sidecars?
                                                 (.dumps json
                                                         (if-let [status-atom (:last-option-surface-status-json bridge)]
                                                           (or @status-atom (python/dict))
                                                           (python/dict))
                                                         ** :default str)
                                                 "{}")
	                   :grid-history-json (if include-sidecars?
	                                        (.dumps json (.tolist grid-history) ** :default str)
	                                        "[]")
	                   :feats (into {} (map (fn [[b m]] [b (:feats m)]) preds))}
	            stamp (.strftime (datetime.datetime/now (.-utc datetime/timezone))
	                             "%Y%m%d")
	            path (str cdir "/live_features_" stamp ".npz")
	            tmp-path (str path ".tmp.npz")
            existing (when (os.path/exists path)
                       (.load np path ** :allow_pickle true))
            existing-files (when existing (set (vec (.-files existing))))
            existing-rows (if (and existing (contains? existing-files "times"))
                            (python/len (.__getitem__ existing "times"))
                            0)
            existing-times (if (and existing (contains? existing-files "times"))
                             (set (map normalize-capture-time-text
                                       (vec (.__getitem__ existing "times"))))
                             (set []))
	            ;; A restart resets the in-memory capture atom, so prefix-length
	            ;; logic can append the restarted process's old rows repeatedly.
	            ;; Timestamp de-dupe is stable across restarts and normal appends.
	            ;; Keep only the current row in memory. Large option sidecars make
	            ;; failed-write backlogs dangerous: one bad write should not cause
	            ;; the next bar to reserialize every previous sidecar and OOM.
	            pending-entries (if (contains? existing-times (:time entry))
	                              []
	                              [entry])
	            _ (reset! (:capture bridge) (vec pending-entries))
	            object-array (fn [xs]
	                           (.array np (python/list xs) ** :dtype (.-object_ np)))
	            as-object-array (fn [arr]
	                              (.astype arr (.-object_ np) ** :copy false))
	            new-times (.array np (python/list (map :time pending-entries)))
	            new-spy (.array np (python/list (map :spy pending-entries)))
	            new-provenance (object-array (map :provenance-json pending-entries))
	            new-bar-buffers (object-array (map :bar-buffers-json pending-entries))
	            new-option-chain (object-array (map :option-chain-json pending-entries))
	            new-option-surfaces (object-array (map :option-surfaces-json pending-entries))
	            new-option-surface-status (object-array (map :option-surface-status-json pending-entries))
	            new-grid-history-json (object-array (map :grid-history-json pending-entries))
	            feature-width (python/len (get-in entry [:feats :chestnut]))
	            new-grids (if (seq pending-entries)
	                        (.stack np (python/list (map :grid pending-entries)))
	                        (.zeros np #py (0 6 21 8) ** :dtype (.-float32 np)))
	            empty-features (.zeros np (python/tuple [0 feature-width]) ** :dtype (.-float32 np))
	            new-chestnut (if (seq pending-entries)
	                           (.stack np (python/list (map #(get-in % [:feats :chestnut]) pending-entries)))
	                           empty-features)
	            new-lynx (if (seq pending-entries)
	                        (.stack np (python/list (map #(get-in % [:feats :lynx]) pending-entries)))
	                        empty-features)
	            new-moose (if (seq pending-entries)
	                         (.stack np (python/list (map #(get-in % [:feats :moose]) pending-entries)))
	                         empty-features)
            append-arr (fn [key new-arr]
                         (if (and existing (contains? existing-files key))
                           (.concatenate np (python/list [(.__getitem__ existing key) new-arr]))
                           new-arr))
	            append-json-arr (fn [key new-arr]
	                              (if existing
	                                (let [old (if (contains? existing-files key)
	                                            (as-object-array (.__getitem__ existing key))
	                                            (object-array (repeat existing-rows "")))]
	                                  (.concatenate np (python/list [old new-arr])))
	                                new-arr))
	            append-option-chain-arr (fn [new-arr]
	                                      (if existing
	                                        (let [old (if (contains? existing-files "option_chain_json")
	                                                    (as-object-array (.__getitem__ existing "option_chain_json"))
	                                                    (object-array (repeat existing-rows "")))]
	                                          (.concatenate np (python/list [old new-arr])))
	                                        new-arr))
	            append-option-surfaces-arr (fn [new-arr]
	                                         (if existing
	                                           (let [old (if (contains? existing-files "option_surfaces_json")
	                                                       (as-object-array (.__getitem__ existing "option_surfaces_json"))
	                                                       (object-array (repeat existing-rows "{}")))]
	                                             (.concatenate np (python/list [old new-arr])))
	                                           new-arr))
	            append-option-surface-status-arr (fn [new-arr]
	                                              (if existing
	                                                (let [old (if (contains? existing-files "option_surface_status_json")
	                                                            (as-object-array (.__getitem__ existing "option_surface_status_json"))
	                                                            (object-array (repeat existing-rows "{}")))]
	                                                  (.concatenate np (python/list [old new-arr])))
	                                                new-arr))
	            append-grid-history-arr (fn [new-arr]
	                                      (if existing
	                                        (let [old (if (contains? existing-files "grid_history_json")
	                                                    (as-object-array (.__getitem__ existing "grid_history_json"))
	                                                    (object-array (repeat existing-rows "[]")))]
	                                          (.concatenate np (python/list [old new-arr])))
	                                           new-arr))]
	        (when (seq pending-entries)
	          (os/makedirs cdir ** :exist_ok true)
	          (when (os.path/exists tmp-path)
	            (os/remove tmp-path))
	          ;; Use a real .npz temp path; numpy appends .npz for non-file handles
	          ;; whose names do not already end with it.
	          (.savez_compressed
	           np tmp-path
	           ** :capture_version (.array np (python/list [2]))
	           :times (append-arr "times" new-times)
	           :spy (append-arr "spy" new-spy)
	           :provenance_json (append-json-arr "provenance_json" new-provenance)
	           :bar_buffers_json (append-json-arr "bar_buffers_json" new-bar-buffers)
	           :option_chain_json (append-option-chain-arr new-option-chain)
	           :option_surfaces_json (append-option-surfaces-arr new-option-surfaces)
	           :option_surface_status_json (append-option-surface-status-arr new-option-surface-status)
	           :grid_history_json (append-grid-history-arr new-grid-history-json)
	           :grids (append-arr "grids" new-grids)
	           :chestnut (append-arr "chestnut" new-chestnut)
	          :lynx (append-arr "lynx" new-lynx)
	          :moose (append-arr "moose" new-moose))
	          (os/replace tmp-path path)))
          (catch python/Exception e
            (println "WARN feature capture failed:" (str e))))))))

(defn- last-spy-bar-time
  "The last ingested SPY bar's time object (the `signals` memoization
  key), or nil when the buffer is empty."
  [bridge]
  (let [spy (.__getitem__ (:buffers bridge) "SPY")]
    (when (pos? (python/len spy))
      (.get (.__getitem__ spy -1) "time"))))

(def required-stock-symbols ["SPY" "HYG" "TLT" "VXX"])

(defn- stock-bar-coherence
  "Require a coherent multi-symbol minute before inference. The engine may
  deliver SPY before its companion bars; using that mixed buffer silently
  changes rolling model inputs versus historical completed-minute features."
  [bridge]
  (let [buffers (:buffers bridge)
        spy-time (last-spy-bar-time bridge)
        rows (vec (for [symbol required-stock-symbols]
                    (let [buffer (.get buffers symbol)]
                      [symbol (when (and buffer (pos? (python/len buffer)))
                                (.get (.__getitem__ buffer -1) "time"))])))
        missing (vec (for [[symbol time] rows :when (nil? time)] symbol))
        lagging (vec (for [[symbol time] rows
                           :when (and time spy-time (not= time spy-time))]
                       {"symbol" symbol "bar_time" (str time)}))]
    {:ok? (and spy-time (empty? missing) (empty? lagging))
     :spy-time spy-time
     :missing missing
     :lagging lagging}))

(defn- max-signal-lag-seconds []
  (try
    (double (or (os/getenv "STEVE_MAX_SIGNAL_LAG_SECONDS") "180"))
    (catch python/Exception _ 180.0)))

(defn- parse-signal-time [value]
  (cond
    (nil? value) nil
    (python/isinstance value (.-datetime datetime)) value
    :else
    (let [text0 (.strip (str value))
          text1 (if (and (.startswith text0 "#inst \"") (.endswith text0 "\""))
                  (subs text0 7 (dec (count text0)))
                  text0)
          text (if (.endswith text1 "Z")
                 (str (subs text1 0 (dec (count text1))) "+00:00")
                 text1)]
      (try
        (.fromisoformat (.-datetime datetime) text)
        (catch python/Exception _ nil)))))

(defn- signal-lag-seconds [bar-time]
  (when-let [parsed (parse-signal-time bar-time)]
    (let [utc (.-utc datetime/timezone)
          t (if (nil? (.-tzinfo parsed))
              (.replace parsed ** :tzinfo utc)
              (.astimezone parsed utc))
          now (.now (.-datetime datetime) utc)]
      (- (.timestamp now) (.timestamp t)))))

(defn- stale-signal? [bar-time]
  (let [max-lag (max-signal-lag-seconds)
        lag (signal-lag-seconds bar-time)]
    (and lag (> max-lag 0.0) (> lag max-lag))))

(defn- flat-stale-result [bar-time]
  {:chestnut :flat
   :lynx :flat
   :moose :flat
   :oak :flat
   :dolphin :flat
   :parrot :flat
   :votes {:mult1 [:flat :flat :flat] :mult2 [:flat :flat :flat]}
   :preds {}
   :feature-stats {}
   :zs {}
   :fault :stale-spy-bar
   :bar-time (str bar-time)
   :bar-lag-seconds (signal-lag-seconds bar-time)
   :max-lag-seconds (max-signal-lag-seconds)})

(defn- flat-incoherent-result [coherence]
  {:chestnut :flat :lynx :flat :moose :flat :oak :flat :dolphin :flat :parrot :flat
   :votes {:mult1 [:flat :flat :flat] :mult2 [:flat :flat :flat]}
   :preds {}
   :feature-stats {}
   :zs {}
   :fault :incoherent-stock-bars
   :bar-time (str (:spy-time coherence))
   :missing-symbols (:missing coherence)
   :lagging-symbols (:lagging coherence)})

(defn- signals!*
  "Compute the six bots' signals for the CURRENT bar and ADVANCE
  hysteresis/consensus state. Internal — `signals` wraps this with the
  per-bar memoization."
  [bridge bar-time]
  (let [preds (predictions bridge)
        _ (capture-features! bridge bar-time preds)
        bots* (:bots bridge)
        st @(:state bridge)
        step (fn [states mult]
               (into {}
                     (map (fn [bot]
                            (let [cal (get-in bots* [bot :cal])
                                  cal (if (== mult 1.0)
                                        cal
                                        (update cal :hysteresis
                                                scale-hysteresis mult))]
                              [bot (direction-step
                                    (get-in preds [bot :pred])
                                    cal
                                    (get states bot))]))
                          bots)))
        r1 (step (:mult1 st) 1.0)
        ;; the second hysteresis lane (DOLPHIN's consensus input).
        ;; Production hardcoded 2.0; tuned against the identity-stats
        ;; bug's saturated signals — under honest z-scores 2.0 never
        ;; reached conviction (Jun 12: dolphin flat all morning), so
        ;; it's configurable now (operator set 1.5, 2026-06-12).
        r2 (step (:mult2 st) (double (:mult2-scale bridge 2.0)))
        votes1 (mapv #(:kind (get r1 %)) bots)
        votes2 (mapv #(:kind (get r2 %)) bots)
        oak (consensus-vote votes1 (:oak st))
        parrot (consensus-vote votes1 (:parrot st))
        dolphin (consensus-vote votes2 (:dolphin st))
        result {:chestnut (:kind (:chestnut r1))
                :lynx (:kind (:lynx r1))
                :moose (:kind (:moose r1))
                :oak oak
                :dolphin dolphin
                :parrot parrot
                :votes {:mult1 votes1 :mult2 votes2}
                :preds (into {} (map (fn [[b m]] [b (:pred m)]) preds))
                :feature-stats (into {} (map (fn [[b m]]
                                               [b {:n (:n-features m)
                                                   :n-zero (:n-zero m)}])
                                             preds))
                :zs (into {} (map (fn [[b r]] [b (:z r)]) r1))}]
    (reset! (:state bridge)
            {:mult1 (into {} (map (fn [[b r]] [b (:state r)]) r1))
             :mult2 (into {} (map (fn [[b r]] [b (:state r)]) r2))
             :oak oak :dolphin dolphin :parrot parrot
             :last-bar-time bar-time
             :last-result result})
    result))

(defn signals
  "The six bots' signals for the CURRENT bar, memoized by the last
  ingested SPY bar time (ns docstring): the FIRST call after a new SPY
  bar computes + advances hysteresis/consensus state; subsequent calls
  before the next bar return the cached result without advancing
  anything. With an empty SPY buffer every call computes (no caching
  key) — production always primes bars first.

  Returns {:chestnut k :lynx k :moose k :oak k :dolphin k :parrot k
           :votes {:mult1 [...] :mult2 [...]}
           :preds {bot [p-long p-gen p-short]}
           :zs {bot {:long z :gen z :short z}}}"
  [bridge]
  (let [bar-time (last-spy-bar-time bridge)
        st @(:state bridge)
        coherence (stock-bar-coherence bridge)]
    (cond
      (and (some? bar-time)
           (some? (:last-result st))
           (= bar-time (:last-bar-time st)))
      (:last-result st)

      (stale-signal? bar-time)
      (let [result (flat-stale-result bar-time)]
        (println "WARN stale SPY bar; forcing flat signals:" result)
        (reset! (:state bridge)
                (assoc st
                       :oak :flat
                       :dolphin :flat
                       :parrot :flat
                       :last-bar-time bar-time
                       :last-result result))
        result)

      (not (:ok? coherence))
      (flat-incoherent-result coherence)

      :else
      (signals!* bridge bar-time))))
