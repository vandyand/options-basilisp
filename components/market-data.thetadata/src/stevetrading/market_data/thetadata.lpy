(ns stevetrading.market-data.thetadata
  "Live ThetaData option-chain source (MARKET_DATA_ADAPTER §4.3, §5-§9).

  ADAPTER component: polls a local ThetaData Terminal v3 (default
  http://127.0.0.1:25503 — the terminal is a separate Java process whose
  lifecycle the operator owns; the account allows ONE terminal session,
  see the Python repo's thetadata_lifecycle.sh) and emits canonical
  `:fact/option-chain-observed` snapshots.

  Quality semantics: `:quality/dropped-contracts` counts only rows the
  adapter could not parse (bad strike/right) — silent data loss per §6.
  Strike-range exclusions are intentional configuration, not loss, and
  do not affect quality flags.

  Wire-shape notes (verified live against Terminal v3 + the proven
  Python reference `scripts_5yr/live/thetadata_fetcher.py`):
  - GET /v3/option/list/expirations?symbol=SPY&format=json
      → columnar {\"symbol\" [...] \"expiration\" [\"2012-06-01\" ...]}
      (includes HISTORICAL expirations — callers must filter >= today)
  - GET /v3/option/snapshot/quote?symbol=SPY&expiration=YYYYMMDD&format=json
      (expiration is COMPACT in the url, dashed in responses)
      → columnar parallel arrays: strike (dollars), right (\"PUT\"/\"CALL\"),
        bid/ask (floats — parsed with parse_float=str so canonical decimal
        STRINGS reach payloads untouched), bid_size/ask_size, expiration
        (dashed), timestamp (NAIVE America/New_York local time —
        normalized here to RFC3339 UTC Z)

  Cursor semantics: TIMESTAMP-ANCHORED from day one (the alpaca-source
  restart-gap lesson): the cursor is the last emitted snapshot's
  observed-at; a fresh post-restart instance resumes correctly because
  emission is 'snapshot strictly fresher than cursor'. next-observations
  BLOCKS (poll + sleep) until a fresher snapshot exists or :until passes."
  (:import json
           time
           urllib.request
           zoneinfo
           datetime)
  (:require [clojure.string]
            [stevetrading.domain.instruments :as ins]
            [stevetrading.domain.schemas :as sch]
            [stevetrading.market-data.protocol :as p]
            [stevetrading.market-data.thetadata-schema :as ts]))

(def provider :market-data/thetadata)
(def stock-provider :market-data/thetadata-stock)

(def default-base-url "http://127.0.0.1:25503")

(def ^:private eastern (zoneinfo/ZoneInfo "America/New_York"))

(defn utc-now-str
  []
  (let [now (datetime.datetime/now (.-utc datetime/timezone))]
    (str (.strftime now "%Y-%m-%dT%H:%M:%S.%f") "Z")))

(defn et->utc
  "Naive ET terminal timestamp \"2026-06-10T16:14:56.020\" → RFC3339 UTC Z.
  nil-safe (nil → nil)."
  [ts]
  (when ts
    (let [naive (datetime.datetime/fromisoformat ts)
          localized (.replace naive ** :tzinfo eastern)
          utc (.astimezone localized (.-utc datetime/timezone))]
      (str (.strftime utc "%Y-%m-%dT%H:%M:%S.%f") "Z"))))

(defn- default-transport
  [{:keys [url]}]
  (try
    (let [req (urllib.request/Request url)]
      (.add-header req "Accept" "application/json")
      (let [resp (urllib.request/urlopen req ** :timeout 20)]
        {:status (.-status resp)
         :body (.decode (.read resp) "utf-8")}))
    (catch python/Exception e
      {:status 0 :error (str e)})))

(defn- get-json
  "Transport + parse with parse_float=str. → parsed | {:error ..}"
  [transport url]
  (let [{:keys [status body error]} (transport {:url url})]
    (if (and (= 200 status) body)
      (try
        (json/loads body ** :parse_float python/str)
        (catch python/Exception e
          {:error (str "unparseable body: " e)}))
      {:error (or error (str "http " status))})))

(defn- invalid-payload-error
  [kind payload]
  (let [r (ts/validation-result kind payload)]
    (when-not (:valid? r)
      {:error (str "invalid " (name kind) " payload: " (:schema/errors r))
       :schema/errors (:schema/errors r)})))

(defn nearest-expiration
  "First expiration >= on-or-after (dashed YYYY-MM-DD) from the
  terminal's expiration list. → dashed date string | {:error ..}"
  [{:keys [transport base-url symbol]} on-or-after]
  (let [url (str (or base-url default-base-url)
                 "/v3/option/list/expirations?symbol=" symbol "&format=json")
        data (get-json transport url)]
    (if (:error data)
      data
      (if-let [invalid (invalid-payload-error :thetadata/expiration-list data)]
        invalid
        (let [normalized (ts/normalize-table data)
              exps (sort (filter #(>= (compare % on-or-after) 0)
                                 (get normalized "expiration")))]
          (if (seq exps)
            (first exps)
            {:error (str "no expiration on/after " on-or-after)}))))))

(defn- right-kw
  [right]
  (case (str right)
    ("CALL" "C" "call" "c") :option-right/call
    ("PUT" "P" "put" "p") :option-right/put
    nil))

(defn rows->contracts
  "Columnar snapshot arrays → {:contracts [...] :unparseable n}.
  Contracts are MARKET_DATA §4.3 maps with canonical option instrument
  ids and decimal-string quotes. `:unparseable` counts rows with bad
  strike/right (real data loss); strike-range exclusions are intentional
  and NOT counted. `strike-range` [lo hi] (decimal strings) bounds
  payload size when supplied."
  [data {:keys [underlying-symbol strike-range]}]
  (let [strikes (get data "strike" [])
        rights (get data "right" [])
        bids (get data "bid" [])
        asks (get data "ask" [])
        exps (get data "expiration" [])
        n (min (count strikes) (count rights) (count bids)
               (count asks) (count exps))
        [lo hi] strike-range
        in-range? (fn [s]
                    (or (nil? strike-range)
                        (let [sv (python/float s)]
                          (and (<= (python/float lo) sv)
                               (<= sv (python/float hi))))))
        acc (reduce
             (fn [acc i]
               (let [strike (str (nth strikes i))
                     right (right-kw (nth rights i))]
                 (cond
                   (nil? right)
                   (update acc :unparseable inc)

                   (not (in-range? strike))
                   acc

                   :else
                   (update acc :contracts conj
                           {:instrument/id (ins/instrument-id
                                            {:instrument/asset-class :asset-class/option
                                             :instrument/venue "OPRA"
                                             :instrument/underlying underlying-symbol
                                             :instrument/expiry (nth exps i)
                                             :instrument/right right
                                             :instrument/strike strike})
                            :quote/bid (str (nth bids i))
                            :quote/ask (str (nth asks i))}))))
             {:contracts [] :unparseable 0}
             (range n))]
    acc))

(defn- snapshot-observed-at
  "Max contract timestamp (ET→UTC) = the snapshot's market time; falls
  back to receive time when the terminal omits timestamps."
  [data]
  (let [ts (seq (remove nil? (get data "timestamp" [])))]
    (if ts
      (et->utc (reduce (fn [a b] (if (> (compare b a) 0) b a)) ts))
      (utc-now-str))))

(defn fetch-chain!
  "One snapshot poll for ONE expiration.
  → {:observed-at ts :contracts [...] :dropped n} | {:error ..}"
  [{:keys [transport base-url symbol expiration] :as opts}]
  (let [compact (.replace expiration "-" "")
        url (str (or base-url default-base-url)
                 "/v3/option/snapshot/quote?symbol=" symbol
                 "&expiration=" compact "&format=json")
        data (get-json transport url)]
    (if (:error data)
      data
      (if-let [invalid (invalid-payload-error :thetadata/quote-snapshot data)]
        invalid
        (let [normalized (ts/normalize-table data)
              {:keys [contracts unparseable]}
              (rows->contracts normalized {:underlying-symbol symbol
                                           :strike-range (:strike-range opts)})]
          {:observed-at (snapshot-observed-at normalized)
           :contracts contracts
           :dropped unparseable})))))

(defn fetch-chains!
  "One snapshot poll across ALL the source's expirations, merged into ONE
  snapshot (term/calendar strategies need every leg's expiration in the
  same observation). Contracts carry fully-qualified option instrument
  ids, so consumers filter by expiry naturally. ALL-OR-NOTHING: any
  failing expiration fails the whole poll — a term-slope computed from a
  partial snapshot is silent garbage, not degraded data.
  → {:observed-at max-ts :contracts [...] :dropped n} | {:error ..}"
  [{:keys [expirations expiration] :as opts}]
  (let [exps (or (seq expirations) [expiration])]
    (reduce
     (fn [acc exp]
       (let [res (fetch-chain! (assoc opts :expiration exp))]
         (if (:error res)
           (reduced {:error (str exp ": " (:error res))})
           {:observed-at (let [a (:observed-at acc)]
                           (if (and a (> (compare a (:observed-at res)) 0))
                             a
                             (:observed-at res)))
            :contracts (into (:contracts acc) (:contracts res))
            :dropped (+ (:dropped acc) (:dropped res))})))
     {:observed-at nil :contracts [] :dropped 0}
     exps)))

(defn chain->fact
  "Wrap one fetched (possibly multi-expiration merged) chain in a
  canonical fact envelope. :chain/expiration stays the FRONT expiration
  (existing consumers); :chain/expirations carries the full list when
  the source polls several."
  [{:keys [underlying-id symbol expiration expirations run-mode]}
   {:keys [observed-at contracts dropped]}]
  (let [exps (or (seq expirations) [expiration])
        exp-key (clojure.string/join "+" exps)
        pref (str "thetadata:chain:" symbol ":" exp-key ":" observed-at)
        payload {:chain/observed-at observed-at
                 :chain/underlying underlying-id
                 :chain/expiration (first exps)
                 :chain/expirations (vec exps)
                 :chain/contracts contracts
                 :data/provider provider
                 :data/provider-ref pref
                 :data/received-at (utc-now-str)
                 :data/quality {:quality/complete? (zero? (or dropped 0))
                                :quality/dropped-contracts (or dropped 0)}}]
    (sch/fact-envelope
     {:record/type :fact/option-chain-observed
      :record/mode (or run-mode :mode/paper)
      :record/source-system provider
      :record/instrument-id underlying-id
      :fact/occurred-at observed-at
      :fact/recorded-at (utc-now-str)
      :fact/source-ref pref
      :fact/dedupe-key (str "md/thetadata/" symbol "/" exp-key "/"
                            observed-at)
      :fact/payload payload})))

(defn- emit-held
  "Emission result when the held snapshot is strictly fresher than the
  (timestamp) cursor, else nil."
  [opts state cursor]
  (let [held (:snapshot @state)]
    (when (and held
               (or (nil? cursor) (= 0 cursor)
                   (> (compare (:observed-at held) cursor) 0)))
      {:observations [(chain->fact opts held)]
       :cursor (:observed-at held)
       :exhausted? false})))

(defn- poll-chain!
  "One snapshot poll (all configured expirations); records the result
  (or degradation) in the state atom. Errors degrade health — they
  never throw across the boundary."
  [opts state]
  (let [res (fetch-chains! opts)]
    (swap! state assoc :polled-once? true)
    (if (:error res)
      (swap! state assoc :last-error (:error res)
             :last-poll-ok? false)
      (swap! state assoc :snapshot res :last-error nil
             :last-poll-ok? true
             :last-poll-at (utc-now-str)))))

(defn- throttled-poll!
  "Non-blocking fetch gate: poll at most once per call, and only when
  at least :poll-seconds have elapsed since the last fetch ATTEMPT
  (first call always may fetch). Records the attempt time (monotonic
  clock) in the state atom."
  [{:keys [poll-seconds] :as opts} state]
  (let [last-mono (:last-fetch-mono @state)
        now (time/monotonic)]
    (when (or (nil? last-mono)
              (>= (- now last-mono) (or poll-seconds 30)))
      (swap! state assoc :last-fetch-mono now)
      (poll-chain! opts state))))

(defrecord ThetaDataChainSource [opts state]
  p/MarketDataSource

  (source-id [this] provider)

  (next-observations [this cursor max-n]
    (let [{:keys [until poll-seconds block?]} opts]
      (if (false? block?)
        ;; non-blocking child mode (:block? false): never sleeps; at
        ;; most one throttled poll per call; empty + :exhausted? false
        ;; means "nothing fresher yet" (a composite parent owns the
        ;; block-poll)
        (or (emit-held opts state cursor)
            (if (and until (>= (compare (utc-now-str) until) 0))
              {:observations [] :cursor cursor :exhausted? true}
              (do (throttled-poll! opts state)
                  (or (emit-held opts state cursor)
                      {:observations [] :cursor cursor :exhausted? false}))))
        (loop []
          (if-let [r (emit-held opts state cursor)]
            ;; emit the held snapshot when strictly fresher than cursor
            r
            (if (and until (>= (compare (utc-now-str) until) 0))
              ;; session over?
              {:observations [] :cursor cursor :exhausted? true}
              ;; block-poll for a fresher snapshot
              (do (when (:polled-once? @state)
                    (time/sleep (or poll-seconds 30)))
                  (poll-chain! opts state)
                  (recur))))))))

  (source-health [this]
    (let [{:keys [snapshot last-error last-poll-ok? last-poll-at]} @state]
      {:source/provider provider
       :source/healthy? (boolean last-poll-ok?)
       :source/last-receipt-at (:observed-at snapshot)
       :source/last-poll-at last-poll-at
       :source/degradations (filterv some? [last-error])
       :source/subscription-status :subscription-status/polling
       :source/contract-count (count (:contracts snapshot))})))

(defn make-thetadata-chain-source
  "Live ThetaData option-chain source. Opts (explicit map — never kwargs):
    :symbol         underlying root, e.g. \"SPY\" (required)
    :underlying-id  canonical underlying id, e.g. \"equity/NASDAQ/SPY\"
                    (required)
    :expiration     dashed \"YYYY-MM-DD\" (required unless :expirations —
                    resolve with nearest-expiration for 'front expiry')
    :expirations    [\"YYYY-MM-DD\" ...] poll SEVERAL expirations into ONE
                    merged snapshot per cycle (term/calendar strategies —
                    every leg's expiry lands in the same observation;
                    all-or-nothing on per-expiration failures)
    :base-url       terminal root (default http://127.0.0.1:25503)
    :strike-range   [\"540\" \"560\"] inclusive decimal-string bounds
                    (optional payload bound)
    :until          RFC3339 Z session end (required for live)
    :poll-seconds   chain poll cadence (default 30); in non-blocking
                    mode it is the minimum interval between fetch
                    attempts (fetch throttle)
    :block? true    (default) next-observations blocks (poll + sleep)
                    until a fresher snapshot or :until. :block? false
                    → child mode for a composite parent: never sleeps,
                    at most one throttled poll per call, and returns
                    {:observations [] :exhausted? false} when nothing
                    fresher is available yet
    :run-mode       envelope mode (default :mode/paper)
    :transport      injectable (fn [{:url ..}] {:status :body})"
  [opts]
  (let [opts (merge {:poll-seconds 30 :run-mode :mode/paper
                     :transport default-transport}
                    opts)]
    (->ThetaDataChainSource opts (atom {:snapshot nil :polled-once? false}))))

;; ---------------------------------------------------------------------------
;; Completed ThetaData stock bars. This is deliberately a separate source from
;; the option-chain adapter so a live strategy can opt into one provider for
;; both stock features and historical/replay reconstruction.

(defn- stock-bar-row [table idx]
  (let [close (get-in table ["close" idx])
        open (get-in table ["open" idx])
        high (get-in table ["high" idx])
        low (get-in table ["low" idx])
        volume (get-in table ["volume" idx])
        count0 (get-in table ["count" idx])
        number (fn [x] (try (python/float x) (catch python/Exception _ 0.0)))
        incomplete? (and (<= (number close) 0.0) (<= (number open) 0.0)
                         (<= (number high) 0.0) (<= (number low) 0.0)
                         (<= (number volume) 0.0) (<= (number count0) 0.0))]
    (when-not incomplete?
      (let [timestamp (get-in table ["timestamp" idx])
            vwap (or (get-in table ["vwap" idx]) close)]
        {:t (et->utc timestamp)
         :o (str open) :h (str high) :l (str low) :c (str close)
         :v (str volume) :vw (str vwap) :n (str (or count0 0))}))))

(defn fetch-stock-bars!
  "Fetch completed regular-session ThetaData one-minute bars for the current
  ET day. The terminal includes a zero-filled in-progress row at the request
  boundary; it is explicitly discarded before any model can consume it."
  [{:keys [transport base-url symbol venue]}]
  (let [now (datetime.datetime/now eastern)
        compact (.strftime now "%Y%m%d")
        end-time (.strftime now "%H:%M:%S")
        url (str (or base-url default-base-url)
                 "/v3/stock/history/ohlc?symbol=" symbol
                 "&start_date=" compact "&end_date=" compact "&date=" compact
                 "&interval=1m&start_time=09:30:00&end_time=" end-time "&format=json")
        url (if venue (str url "&venue=" venue) url)
        data (get-json transport url)]
    (if (:error data)
      data
      (let [table (ts/normalize-table data)
            timestamps (get table "timestamp" [])]
        (vec (keep #(stock-bar-row table %) (range (count timestamps))))))))

(defn- stock-bar->fact [{:keys [instrument-id run-mode venue]} bar]
  (let [at (:t bar)
        venue (or venue "nqb")
        pref (str "thetadata:stock-bar:" venue ":" instrument-id ":" at)
        payload {:bar/time at :bar/timeframe :timeframe/1m
                 :bar/open (:o bar) :bar/high (:h bar) :bar/low (:l bar)
                 :bar/close (:c bar) :bar/volume (:v bar)
                 :bar/vwap (:vw bar) :bar/trade-count (:n bar)
                 :data/request {:endpoint "/v3/stock/history/ohlc"
                                :venue venue
                                :bar-timestamp "open-time"
                                :bar-status "completed"}
                 :data/provider stock-provider :data/provider-ref pref
                 :data/received-at (utc-now-str)
                 :data/quality {:quality/complete? true}}]
    (sch/fact-envelope
     {:record/type :fact/market-bar-observed :record/mode (or run-mode :mode/paper)
      :record/source-system stock-provider :record/instrument-id instrument-id
      :fact/occurred-at at :fact/recorded-at (utc-now-str) :fact/source-ref pref
      :fact/dedupe-key (str "md/thetadata-stock/" instrument-id "/" at)
      :fact/payload payload})))

(defn- emit-stock-bars [opts state cursor max-n]
  (let [cursor (or cursor (:seed-anchor @state))
        bars (:bars @state)
        fresh (filter #(or (nil? cursor) (= 0 cursor) (> (compare (:t %) cursor) 0)) bars)
        selected (vec (take (max 1 (or max-n 1)) fresh))]
    (when (seq selected)
      {:observations (vec (map #(stock-bar->fact opts %) selected))
       :cursor (:t (last selected)) :exhausted? false})))

(defn- poll-stock-bars! [opts state]
  (let [res (fetch-stock-bars! opts)]
    (if (:error res)
      (swap! state assoc :last-error (:error res) :last-poll-ok? false)
      (swap! state (fn [current]
                     (cond-> (assoc current :bars res :last-error nil :last-poll-ok? true
                                     :last-poll-at (utc-now-str))
                       (and (:seed-latest? opts) (nil? (:seed-anchor current)) (seq res))
                       (assoc :seed-anchor (:t (last res)))))))))

(defrecord ThetaDataStockBarsSource [opts state]
  p/MarketDataSource
  (source-id [_] stock-provider)
  (next-observations [_ cursor max-n]
    (let [{:keys [until poll-seconds block?]} opts]
      (if (and (:seed-latest? opts) (not (:seeded? @state)))
        (do (poll-stock-bars! opts state)
            (swap! state assoc :seeded? true)
            {:observations [] :cursor cursor :exhausted? false})
        (if (false? block?)
        (or (emit-stock-bars opts state cursor max-n)
            (if (and until (>= (compare (utc-now-str) until) 0))
              {:observations [] :cursor cursor :exhausted? true}
              (do (when (or (nil? (:last-poll-mono @state))
                            (>= (- (time/monotonic) (:last-poll-mono @state)) poll-seconds))
                    (swap! state assoc :last-poll-mono (time/monotonic))
                    (poll-stock-bars! opts state))
                  (or (emit-stock-bars opts state cursor max-n)
                      {:observations [] :cursor cursor :exhausted? false}))))
        (loop []
          (or (emit-stock-bars opts state cursor max-n)
              (if (and until (>= (compare (utc-now-str) until) 0))
                {:observations [] :cursor cursor :exhausted? true}
                (do (poll-stock-bars! opts state)
                    (time/sleep poll-seconds)
                    (recur)))))))))
  (source-health [_]
    (let [{:keys [bars last-error last-poll-ok? last-poll-at]} @state]
      {:source/provider stock-provider :source/healthy? (boolean last-poll-ok?)
       :source/last-receipt-at (:t (peek bars)) :source/last-poll-at last-poll-at
       :source/degradations (filterv some? [last-error]) :source/bar-count (count bars)})))

(defn make-thetadata-stock-bars-source [opts]
  (->ThetaDataStockBarsSource
   (merge {:base-url default-base-url :venue "nqb" :poll-seconds 15 :run-mode :mode/paper :seed-latest? false
           :transport default-transport :block? true} opts)
   (atom {:bars [] :last-poll-ok? false :seeded? false})))
