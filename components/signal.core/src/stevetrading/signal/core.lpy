(ns stevetrading.signal.core
  "Signal decision stage (STRATEGY_PIPELINE §5.4, ARCHITECTURE §19).

  Pure pipeline component: turns a canonical prediction + market slice +
  strategy-local state into a posture decision, dispatched on the
  strategy declaration's [:strategy/signal :fn-id]. Strategy-local state
  is explicit and replay-safe (§6) — the posture memory lives under
  :last-direction in the strategy-local state map, never in closures.

  Both v0.1 signal fns share the same direction-change semantics —
  posture changes ONLY on a prediction-direction state change:

    direction == (:last-direction local-state)  -> :posture/hold
    changed to :direction/up                    -> :posture/enter-long
    changed to :direction/down|:direction/flat  -> :posture/flatten

  A nil :last-direction (first decision after warmup) counts as a distinct
  state, so the first decided direction always produces a posture.

  Signal fns:

    :signal/sma-crossover-v1 — direction from the SMA crossover model;
      :decision/market-time is the slice's LAST BAR time (bar-driven).

    :signal/credit-threshold-v1 (Phase 9) — direction from the threshold
      model over a chain feature (up = credit at/above threshold ->
      enter the spread; down = credit below threshold -> flatten).
      :decision/market-time is the slice's :last-time (the chain
      snapshot's observed-at when the chain was the latest observation) —
      REQUIRED so two chain snapshots between bars produce DISTINCT
      decision ids. The decision also carries :decision/net-credit (the
      prediction value, i.e. the current spread mid) for the execution
      stage's net-credit/net-debit limit price.

  Determinism: :decision/id is the deterministic hash of the canonical
  decision seed (CANONICAL_SCHEMAS §5.2.6) over strategy-id, decision
  scope (the slice instrument), the source watermark tuple
  [instrument-id market-time], the decision timestamp, and the decision
  slot (0 — one decision per source event set in v0.1)."
  (:require [stevetrading.domain.schemas :as schemas]))

(defn- posture-for
  [last-direction direction]
  (cond
    (= direction last-direction)    :posture/hold
    (= :direction/up direction)     :posture/enter-long
    :else                           :posture/flatten))

(defn- decision-id-for
  [strategy-decl instrument-id market-time]
  (schemas/decision-id
   {:decision/strategy-id (:strategy/id strategy-decl)
    :decision/scope instrument-id
    :decision/source-watermark [instrument-id market-time]
    :decision/at market-time
    :decision/slot 0}))

;; ---------------------------------------------------------------------------
;; :signal/sma-crossover-v1
;; ---------------------------------------------------------------------------

(defn- sma-reason-codes
  [posture direction]
  (case posture
    :posture/hold       [:reason/no-crossover-change]
    :posture/enter-long [:reason/sma-cross-up]
    :posture/flatten    (if (= :direction/flat direction)
                          [:reason/sma-flat]
                          [:reason/sma-cross-down])))

(defn- sma-crossover-decision
  [strategy-decl prediction market-slice strategy-local-state]
  (let [instrument-id (first (:strategy/instruments strategy-decl))
        market-time (or (:bar/time (peek (vec (:bars market-slice))))
                        (:last-time market-slice))
        last-direction (:last-direction strategy-local-state)
        direction (:prediction/direction prediction)
        posture (posture-for last-direction direction)]
    {:decision/id (decision-id-for strategy-decl instrument-id market-time)
     :decision/posture posture
     :decision/reason-codes (sma-reason-codes posture direction)
     :decision/market-time market-time
     :decision/instrument-id instrument-id}))

;; ---------------------------------------------------------------------------
;; :signal/credit-threshold-v1
;; ---------------------------------------------------------------------------

(defn- credit-reason-codes
  [posture]
  (case posture
    :posture/hold       [:reason/no-threshold-change]
    :posture/enter-long [:reason/credit-above-threshold]
    :posture/flatten    [:reason/credit-below-threshold]))

(defn- credit-threshold-decision
  [strategy-decl prediction market-slice strategy-local-state]
  (let [instrument-id (first (:strategy/instruments strategy-decl))
        ;; :last-time FIRST: the chain snapshot's observed-at when the
        ;; chain was the latest observation (distinct decision ids per
        ;; snapshot); bar-time fallback for bar-only slices.
        market-time (or (:last-time market-slice)
                        (:bar/time (peek (vec (:bars market-slice)))))
        last-direction (:last-direction strategy-local-state)
        direction (:prediction/direction prediction)
        posture (posture-for last-direction direction)]
    {:decision/id (decision-id-for strategy-decl instrument-id market-time)
     :decision/posture posture
     :decision/reason-codes (credit-reason-codes posture)
     :decision/market-time market-time
     :decision/instrument-id instrument-id
     :decision/net-credit (:prediction/value prediction)}))

;; ---------------------------------------------------------------------------
;; :signal/steve-v2-bridge
;; ---------------------------------------------------------------------------

(def bridge-kind->posture
  "Bridge signal kind (bridge.steve-v2 vocabulary) → canonical posture."
  {:long  :posture/enter-long
   :short :posture/enter-short
   :flat  :posture/flatten})

(defn- bridge-reason-codes
  [posture]
  (case posture
    :posture/hold        [:reason/no-bridge-kind-change]
    :posture/enter-long  [:reason/bridge-long]
    :posture/enter-short [:reason/bridge-short]
    :posture/flatten     [:reason/bridge-flat]))

(defn decide-bridge-signal
  "Posture decision for a bridge strategy (:signal/steve-v2-bridge). The
  prediction stage is replaced by the bridge's per-bot kind
  (:long/:short/:flat — bridge.steve-v2 `signals`); this fn applies the
  same KIND-CHANGE-ONLY semantics as the v0.1 signal fns, with the memory
  key :last-kind in strategy-local-state:

    kind == (:last-kind local-state) -> :posture/hold (no facts)
    changed to :long                 -> :posture/enter-long
    changed to :short                -> :posture/enter-short
    changed to :flat                 -> :posture/flatten

  A nil :last-kind (first decision after warmup/restart) counts as a
  distinct state, so the first kind always produces a posture — including
  :flat -> :posture/flatten (risk allows; execution plans nothing when
  already flat).

  :decision/market-time is the slice's :last-time first (chain snapshots
  between bars yield distinct decision ids, mirroring
  :signal/credit-threshold-v1), bar-time fallback. The decision-id seed is
  the same deterministic CANONICAL_SCHEMAS §5.2.6 hash used by the other
  signal fns. The decision carries :decision/bridge-kind and
  :decision/bot for the signal fact payload (observability + audit).

  Throws ex-info on an unknown bridge kind (nil = the bridge returned no
  entry for this bot)."
  [strategy-decl bot kind market-slice strategy-local-state]
  (when-not (contains? bridge-kind->posture kind)
    (throw (ex-info (str "unknown bridge signal kind: " (pr-str kind))
                    {:error/code :error/unknown-bridge-kind
                     :error/kind kind
                     :error/bot bot
                     :error/strategy-id (:strategy/id strategy-decl)})))
  (let [instrument-id (first (:strategy/instruments strategy-decl))
        market-time (or (:last-time market-slice)
                        (:bar/time (peek (vec (:bars market-slice)))))
        last-kind (:last-kind strategy-local-state)
        posture (if (= kind last-kind)
                  :posture/hold
                  (get bridge-kind->posture kind))]
    {:decision/id (decision-id-for strategy-decl instrument-id market-time)
     :decision/posture posture
     :decision/reason-codes (bridge-reason-codes posture)
     :decision/market-time market-time
     :decision/instrument-id instrument-id
     :decision/bridge-kind kind
     :decision/bot bot}))

;; ---------------------------------------------------------------------------
;; Dispatch
;; ---------------------------------------------------------------------------

(defn decide-signal
  "Decide the strategy posture from a prediction, dispatching on the
  declaration's [:strategy/signal :fn-id]. Returns the canonical signal
  decision map (CANONICAL_SCHEMAS §11.2 payload shape plus
  :decision/instrument-id, and :decision/net-credit for the
  credit-threshold fn):

  {:decision/id \"dec_...\"
   :decision/posture :posture/enter-long|:posture/flatten|:posture/hold
   :decision/reason-codes [...]
   :decision/market-time ts
   :decision/instrument-id ..}

  Posture memory (:last-direction) is read from strategy-local-state; the
  composing pipeline owns writing the updated memory back (registry
  run-pipeline returns :strategy-local-state'). Throws ex-info on an
  unknown signal fn id."
  [strategy-decl prediction market-slice strategy-local-state]
  (let [fn-id (get-in strategy-decl [:strategy/signal :fn-id])]
    (case fn-id
      :signal/sma-crossover-v1
      (sma-crossover-decision strategy-decl prediction market-slice
                              strategy-local-state)

      :signal/credit-threshold-v1
      (credit-threshold-decision strategy-decl prediction market-slice
                                 strategy-local-state)

      (throw (ex-info (str "unknown signal fn: " (pr-str fn-id))
                      {:error/code :error/unknown-signal-fn
                       :error/fn-id fn-id
                       :error/strategy-id (:strategy/id strategy-decl)})))))
