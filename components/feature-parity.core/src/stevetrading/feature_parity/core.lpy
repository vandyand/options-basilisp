(ns stevetrading.feature-parity.core
  "Operational live-vs-backtest feature parity gates."
  (:require [clojure.set :as set]
            [clojure.string :as str])
  (:import collections csv datetime glob json math numpy operator os os.path))

(def default-analysis-dir "live_runtime/analysis")
(def default-capture-dir "live_runtime/feature-capture")
(def required-raw-replay-arrays #{"bar_buffers_json"
                                  "option_chain_json"
                                  "option_surfaces_json"})
(def required-option-surface-prefixes #{"SPX" "SPXW" "VIX" "VIXW"})

(declare md-table ->jsonable compact-date capture-date-from-name)

(defn reject-duplicate-json-object
  [pairs]
  (loop [remaining (seq pairs)
         seen #{}
         out {}]
    (if-not remaining
      out
      (let [pair (first remaining)
            k (first pair)
            v (second pair)]
        (when (contains? seen k)
          (throw (python/ValueError (str "duplicate JSON key: " k))))
        (recur (next remaining)
               (conj seen k)
               (assoc out k v))))))

(defn read-json
  [path]
  (json/loads (slurp (str path)) ** :object_pairs_hook reject-duplicate-json-object))

(defn clear-artifacts!
  [paths]
  (doseq [path paths]
    (try
      (os/remove path)
      (catch python/FileNotFoundError _ nil))))

