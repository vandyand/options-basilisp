(ns stevetrading.base.engine-replay
  "Replay runtime base: the imperative shell wiring adapters + recovery
  around the SHARED engine loop (stevetrading.engine.loop — extracted in
  Phase 10 so replay and live run the same cycle per POLYLITH §10.5; the
  cycle mechanics and their documented decisions live in that ns).

  Base-owned decisions (documented):
  - Resume: run-replay auto-detects prior work in :out-dir (any facts or
    snapshot) and rebuilds via engine.recovery/run-recovery! first
    (run-mode :mode/replay → plan :replay, no broker reconciliation), then
    continues the loop from the recovered state's :engine/cursors
    {:market-data n} — the snapshot-carried resume cursor. With no
    snapshot the cursor is 0 and the whole fixture is re-processed;
    re-processing is harmless by construction (deterministic
    decision/intent ids + dedupe keys + §12.1 submit dedupe). :resume? in
    opts overrides detection (true forces recovery, false forces a fresh
    loop over an existing out-dir).
  - Broker clock = current market time: the sim broker's clock returns
    the occurred-at of the most recent FOLDED market observation, so
    broker fact timestamps are a deterministic function of replay
    position (never of broker-instance call history) — required for
    restart convergence, since a restarted run constructs a fresh sim
    broker.
  - Sim broker marks track OBSERVED market truth (Phase 11 revision):
    engine.loop/apply-payload-marks per observation;
    engine.loop/marks-at rebuilds the prefix [0, observed-position) on
    resume, where observed-position covers every input at-or-before the
    recovered :watermark/market — after a MID-CYCLE crash the fact log
    (hence the recovered slices/watermark) can be ahead of the
    snapshot's resume cursor, and an intent re-dispatched during
    catch-up must price at the marks the engine had already seen.
    Catch-up observations before the seed watermark never roll marks
    backward (monotone). The sim broker receives (fn [] @marks) and
    resolves it at each pricing moment.
  - The portfolio cache is derived WITHOUT runtime marks (in the shared
    loop) to match the recovery rebuild exactly; mark-based unrealized
    P&L is a reporting concern (Phase 11).
  - Strategy lifecycle: register (idempotent) → :event/strategy-enabled
    with {:route-valid? true} (the replay base has no control plane;
    the live base owns real route validation) → :event/warmup-satisfied
    once the instrument's bar count reaches :strategy/warmup
    :required-bars (both in the shared loop).
  - :facts-appended counts THIS run's loop appends (recovery bookkeeping
    facts are appended by run-recovery! itself and not counted)."
  (:import os os.path)
  (:require [stevetrading.artifact.file-store :as afs]
            [stevetrading.broker.sim :as sim]
            [stevetrading.domain.identifiers :as identifiers]
            [stevetrading.engine.loop :as eloop]
            [stevetrading.engine.recovery :as rec]
            [stevetrading.engine.state :as st]
            [stevetrading.ledger.core :as ledger]
            [stevetrading.market-data.replay :as replay]
            [stevetrading.persistence.fact-store :as fs]
            [stevetrading.persistence.protocol :as p]
            [stevetrading.persistence.snapshot-store :as ss]
            [stevetrading.replay.fixture :as fixture]
            [stevetrading.strategy.registry :as reg]))

(def base-id :base/engine-replay)

(def run-mode :mode/replay)

(def snapshot-scope "runtime-main")

(def default-account-id "account/sim/main")

(def default-strategy-paths
  ["resources/strategies/simple-direction-sma-cross-v1.edn"])

(def default-artifact-root "resources/artifacts")

(defn describe-base
  []
  {:base/id base-id
   :base/modes #{:mode/replay :mode/sim}})

;; ---------------------------------------------------------------------------
;; Summary
;; ---------------------------------------------------------------------------

(defn- expected-outputs-satisfied?
  "True when the fixture's expected-output fact types all appear in the
  fact log, in order (subsequence over the log's fact types)."
  [fact-store expected-outputs]
  (let [log-types (mapv :record/type (p/facts-since fact-store 0))]
    (loop [expected (seq (map :record/type expected-outputs))
           types (seq log-types)]
      (cond
        (nil? expected) true
        (nil? types) false
        (= (first expected) (first types)) (recur (next expected) (next types))
        :else (recur expected (next types))))))

(defn- summary
  [{:keys [run-id recovery fact-store fixture* loop-result]}]
  (let [{:keys [state ledger cursor appended stopped-early? skipped-fills]}
        loop-result]
    {:run/id run-id
     :resumed? (boolean recovery)
     :facts-appended appended
     :cursor cursor
     :stopped-early? stopped-early?
     :orders (eloop/orders-summary state)
     :portfolio (:engine/portfolio state)
     :expected-outputs-satisfied?
     (expected-outputs-satisfied? fact-store
                                  (:fixture/expected-outputs fixture*))
     :engine/state state
     :ledger ledger
     :skipped-ledger-fills skipped-fills}))

;; ---------------------------------------------------------------------------
;; run-replay
;; ---------------------------------------------------------------------------

(defn run-replay
  "Run one replay session end to end. opts (explicit map):
    :fixture-path   replay fixture v0.2 EDN path (required)
    :out-dir        output directory — facts.db + snapshots/ (required)
    :strategy-paths strategy declaration EDN paths
                    (default [resources/strategies/simple-direction-sma-cross-v1.edn])
    :artifact-root  artifact store root (default resources/artifacts)
    :account-id     sim account route (default account/sim/main)
    :snapshot-every snapshot cadence in appended facts (default 50)
    :max-facts      stop at the first cycle boundary where this run's
                    appended count reaches this (no final snapshot —
                    simulated crash) (optional)
    :resume?        override resume auto-detection (optional)
    :crash-after-fact / :crash-before-fact
                    engine.loop crash-injection predicates (test only;
                    see that ns) — the loop's ::crash sentinel is caught
                    here and the run returns
                    {:crashed? true :crash {..} :run/id ..} instead of a
                    summary (no final snapshot; resume by calling
                    run-replay again on the same out-dir)

  Returns the session summary:
    {:run/id .. :facts-appended n :orders {..} :portfolio {..}
     :expected-outputs-satisfied? bool :stopped-early? bool :cursor n
     :resumed? bool :engine/state state :ledger ledger-state
     :skipped-ledger-fills [..]}"
  [{:keys [fixture-path out-dir strategy-paths artifact-root account-id
           snapshot-every max-facts resume? crash-after-fact
           crash-before-fact]}]
  (let [strategy-paths (or strategy-paths default-strategy-paths)
        artifact-root (or artifact-root default-artifact-root)
        account-id (or account-id default-account-id)
        ;; 1. wire adapters
        fixture* (fixture/load-fixture fixture-path)
        source (replay/make-replay-source fixture*)
        _ (os/makedirs out-dir ** :exist_ok true)
        fact-store (fs/make-fact-store (os.path/join out-dir "facts.db"))
        snapshot-store (ss/make-snapshot-store (os.path/join out-dir "snapshots"))
        artifact-store (afs/make-file-artifact-store artifact-root)
        market-clock (atom (:input/at (first (:fixture/inputs fixture*))))
        marks (atom {})
        position-seed (atom [])
        broker (sim/make-sim-broker {:marks (fn [] @marks)
                                     :clock (fn [] @market-clock)
                                     :position-seed (fn [] @position-seed)})
        ;; 2. strategies + engine state (fresh or recovered)
        strategies (mapv #(eloop/load-strategy artifact-store run-mode %)
                         strategy-paths)
        _ (reg/build-registry (mapv :decl strategies))
        run-id (identifiers/new-record-id)
        run-info {:run/id run-id
                  :run/engine-version st/engine-state-version
                  :run/mode run-mode
                  :run/started-at (eloop/utc-now-str)}
        resume? (if (some? resume?)
                  resume?
                  (or (pos? (p/latest-offset fact-store))
                      (some? (p/latest-snapshot snapshot-store snapshot-scope))))
        recovery (when resume?
                   (rec/run-recovery! {:fact-store fact-store
                                       :snapshot-store snapshot-store
                                       :run-mode run-mode
                                       :scope snapshot-scope
                                       :run-info run-info}))
        _ (when (and recovery
                     (not (contains? #{:ready :degraded-ready}
                                     (:recovery/outcome recovery))))
            (throw (ex-info "replay recovery did not reach a ready state"
                            {:error/code :error/recovery-not-ready
                             :recovery/outcome (:recovery/outcome recovery)
                             :recovery/error (:recovery/error recovery)})))
        state0 (if recovery
                 ;; a new process run over the recovered durable state
                 (st/init-run (:engine/state recovery) run-info)
                 (st/init-run (st/fresh-state) run-info))
        ledger0 (if recovery (:recovery/ledger recovery) ledger/empty-ledger)
        state0 (eloop/enable-strategies state0 strategies)
        _ (reset! position-seed
                  (get-in state0 [:engine/portfolio
                                  :portfolio/open-lots] []))
        cursor0 (or (st/cursor state0 :market-data) 0)
        _ (when-let [wm (get-in state0 [:engine/watermarks :watermark/market])]
            (reset! market-clock wm))
        ;; marks are a pure function of OBSERVED market truth: rebuild
        ;; the prefix [0, observed-position) on resume (the log can be
        ;; ahead of the snapshot's cursor after a mid-cycle crash — see
        ;; eloop/observed-position), then advance per observation.
        ;; Catch-up observations BEFORE the seeded watermark must not
        ;; roll marks backward (monotone in observed time), or an intent
        ;; re-dispatched during catch-up would price at a stale mark.
        seed-wm (get-in state0 [:engine/watermarks :watermark/market])
        _ (reset! marks (eloop/marks-at fixture*
                                        (eloop/observed-position
                                         fixture* state0 cursor0)))
        ;; 3. the shared loop — one observation per cycle. An injected
        ;; ::crash sentinel (test hook) is caught here: the run ends
        ;; exactly where the matching append left the store.
        loop-result
        (try
          (eloop/run-loop
           {:fact-store fact-store
            :snapshot-store snapshot-store
            :broker broker
            :source source
            :strategies strategies
            :account-id account-id
            :run-id run-id
            :run-mode run-mode
            :state0 state0
            :ledger0 ledger0
            :cursor0 cursor0
            :snapshot-every snapshot-every
            :snapshot-scope snapshot-scope
            :max-facts max-facts
            :crash-after-fact crash-after-fact
            :crash-before-fact crash-before-fact
            :on-observation
            (fn [obs new?]
              (when new?
                (reset! market-clock (:fact/occurred-at obs)))
              ;; advance marks (independent of append acceptance, but
              ;; monotone: never roll back behind the recovery seed)
              (when (or (nil? seed-wm)
                        (>= (compare (:fact/occurred-at obs) seed-wm) 0))
                (swap! marks eloop/apply-payload-marks (:record/type obs)
                       (:record/instrument-id obs) (:fact/payload obs))))})
          (catch python/Exception e
            (if (eloop/crash-ex? e)
              {:crashed? true :crash (ex-data e)}
              (throw e))))]
    ;; 4. finish: summary (or the simulated-crash marker)
    (if (:crashed? loop-result)
      {:crashed? true
       :crash (:crash loop-result)
       :run/id run-id
       :resumed? (boolean recovery)}
      (summary {:run-id run-id :recovery recovery :fact-store fact-store
                :fixture* fixture* :loop-result loop-result}))))

;; ---------------------------------------------------------------------------
;; CLI
;; ---------------------------------------------------------------------------

(defn- parse-args
  "Parse --flag value pairs into a map of keyword → string."
  [args]
  (loop [args (seq args) acc {}]
    (if (nil? args)
      acc
      (let [flag (first args)
            value (second args)]
        (if (and (string? flag) (.startswith flag "--") (some? value))
          (recur (nnext args) (assoc acc (keyword (subs flag 2)) value))
          (recur (next args) acc))))))

(defn -main
  "CLI entry:
    basilisp run -n stevetrading.base.engine-replay -- \\
      --fixture resources/fixtures/replay/simple-paper-session-v0.2.edn \\
      --out /tmp/replay-out [--strategies p1,p2] [--artifact-root dir] \\
      [--snapshot-every n]"
  [& args]
  (let [{:keys [fixture out strategies artifact-root snapshot-every]}
        (parse-args args)]
    (when (or (nil? fixture) (nil? out))
      (println "usage: basilisp run -n stevetrading.base.engine-replay --"
               "--fixture <fixture.edn> --out <dir>"
               "[--strategies p1,p2] [--artifact-root dir] [--snapshot-every n]")
      (throw (ex-info "missing required --fixture/--out"
                      {:error/code :error/missing-cli-args})))
    (let [result (run-replay
                  {:fixture-path fixture
                   :out-dir out
                   :strategy-paths (when strategies
                                     (vec (.split strategies ",")))
                   :artifact-root artifact-root
                   :snapshot-every (when snapshot-every
                                     (int snapshot-every))})]
      (println (pr-str (dissoc result :engine/state :ledger)))
      result)))

;; `basilisp run -n stevetrading.base.engine-replay -- <args>` loads the
;; namespace with *main-ns* set; -main is invoked explicitly (Basilisp's
;; python -m style entry-point idiom).
(when (= *main-ns* 'stevetrading.base.engine-replay)
  (apply -main *command-line-args*))
