[Unit]
Description=ThetaData Terminal for SteveTrading
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=bot
WorkingDirectory=/opt/stevetrading/shared/Data-Preprocessor
ExecStart=/opt/stevetrading/current/projects/ops/scripts/run_theta_terminal.sh
Restart=on-failure
RestartSec=10
SuccessExitStatus=143 SIGTERM
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
