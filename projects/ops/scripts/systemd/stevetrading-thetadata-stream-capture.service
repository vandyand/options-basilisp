[Unit]
Description=Capture raw ThetaData option and index stream events
Wants=network-online.target theta-terminal.service
After=network-online.target theta-terminal.service

[Service]
Type=oneshot
User=bot
WorkingDirectory=/opt/stevetrading/current
EnvironmentFile=/etc/stevetrading/env
Environment=THETADATA_STREAM_LANDING_ROOT=/opt/stevetrading/shared/thetadata-parity-v1
Environment=THETADATA_STREAM_DURATION_S=900
ExecStart=/opt/stevetrading/current/projects/ops/scripts/run_thetadata_stream_capture.sh
StandardOutput=append:/var/log/stevetrading/thetadata-stream-capture.log
StandardError=append:/var/log/stevetrading/thetadata-stream-capture.log
