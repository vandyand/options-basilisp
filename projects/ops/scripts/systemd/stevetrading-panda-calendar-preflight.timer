[Unit]
Description=Run Panda calendar quote-only preflight after the shared market-data service starts

[Timer]
OnCalendar=Mon..Fri *-*-* 09:40:00 America/New_York
AccuracySec=1s
RandomizedDelaySec=0
Persistent=true
Unit=stevetrading-panda-calendar-preflight.service

[Install]
WantedBy=timers.target
