[Unit]
Description=SteveTrading live watchdog check
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=bot
WorkingDirectory=/opt/stevetrading/current
EnvironmentFile=/etc/stevetrading/env
ExecStart=/opt/stevetrading/current/scripts/steve_watchdog.sh
StandardOutput=append:/var/log/stevetrading/watchdog.log
StandardError=append:/var/log/stevetrading/watchdog.log
