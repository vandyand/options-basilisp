[Unit]
Description=Serve SteveTrading reports
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=bot
WorkingDirectory=/opt/stevetrading/current
EnvironmentFile=/etc/stevetrading/reports.env
EnvironmentFile=-/etc/stevetrading/env
ExecStart=/bin/bash -lc 'exec "${BASILISP_BIN:?BASILISP_BIN not set}" run /opt/stevetrading/current/scripts/reports_static_server.lpy'
Restart=on-failure
RestartSec=10
StandardOutput=append:/var/log/stevetrading/reports-web.log
StandardError=append:/var/log/stevetrading/reports-web.log

[Install]
WantedBy=multi-user.target
