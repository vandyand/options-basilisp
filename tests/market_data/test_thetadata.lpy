(ns market-data.test-thetadata
  "ThetaData chain source — emission contract, timestamp cursors,
  ET→UTC normalization, quality semantics. All stub-transport."
  (:import json)
  (:require [basilisp.test :refer [deftest is testing]]
            [stevetrading.domain.validation :as v]
            [stevetrading.market-data.protocol :as mdp]
            [stevetrading.market-data.thetadata :as td]))

(defn- columnar
  "Build a columnar v3 snapshot body from row maps."
  [rows]
  (let [col (fn [k] (python/list (map #(get % k) rows)))]
    (json/dumps
     (python/dict {"strike" (col "strike") "right" (col "right")
                   "bid" (col "bid") "ask" (col "ask")
                   "bid_size" (col "bid_size") "ask_size" (col "ask_size")
                   "expiration" (col "expiration")
                   "timestamp" (col "timestamp")}))))

(defn- header-response
  "Build a ThetaData header/response body from row maps."
  [rows]
  (let [fields ["strike" "right" "bid" "ask" "bid_size" "ask_size"
                "expiration" "timestamp"]]
    (json/dumps
     (python/dict
      {"header" (python/dict {"format" (python/list fields)})
       "response" (python/list
                   (map (fn [row]
                          (python/list (map #(get row %) fields)))
                        rows))}))))

(def snapshot-1
  [{"strike" 550.0 "right" "PUT" "bid" 2.15 "ask" 2.2 "bid_size" 5
    "ask_size" 7 "expiration" "2026-06-12" "timestamp" "2026-06-10T15:30:00.100"}
   {"strike" 545.0 "right" "PUT" "bid" 0.93 "ask" 0.97 "bid_size" 3
    "ask_size" 9 "expiration" "2026-06-12" "timestamp" "2026-06-10T15:30:00.200"}
   {"strike" 555.0 "right" "CALL" "bid" 1.4 "ask" 1.45 "bid_size" 2
    "ask_size" 2 "expiration" "2026-06-12" "timestamp" "2026-06-10T15:29:59.000"}])

(def snapshot-2
  [{"strike" 550.0 "right" "PUT" "bid" 2.4 "ask" 2.45 "bid_size" 5
    "ask_size" 7 "expiration" "2026-06-12" "timestamp" "2026-06-10T15:31:00.000"}])

(defn- stub-transport
  "Serves the snapshot held in the `current` atom."
  [current]
  (fn [{:keys [url]}]
    (if (>= (.find url "/v3/option/snapshot/quote") 0)
      {:status 200 :body (columnar @current)}
      {:status 404 :body "?"})))

(defn- make-source
  [current opts]
  (td/make-thetadata-chain-source
   (merge {:symbol "SPY"
           :underlying-id "equity/NASDAQ/SPY"
           :expiration "2026-06-12"
           :poll-seconds 0
           :until "2099-01-01T00:00:00Z"
           :transport (stub-transport current)}
          opts)))

(deftest chain-emission-contract
  (let [current (atom snapshot-1)
        src (make-source current {})
        r (mdp/next-observations src 0 1)
        fact (first (:observations r))
        contracts (get-in fact [:fact/payload :chain/contracts])]
    (testing "canonical §4.3 chain fact, validate-fact green"
      (is (= :fact/option-chain-observed (:record/type fact)))
      (is (true? (:valid? (v/validate-fact fact))))
      (is (= "equity/NASDAQ/SPY"
             (get-in fact [:fact/payload :chain/underlying]))))
    (testing "contracts carry canonical option ids + decimal-string quotes"
      (is (= 3 (count contracts)))
      (is (= #{"option/OPRA/SPY/2026-06-12/P/550.000"
               "option/OPRA/SPY/2026-06-12/P/545.000"
               "option/OPRA/SPY/2026-06-12/C/555.000"}
             (set (map :instrument/id contracts))))
      (is (= "2.15" (:quote/bid (first (filter #(= "option/OPRA/SPY/2026-06-12/P/550.000"
                                                   (:instrument/id %))
                                               contracts))))))
    (testing "observed-at = max contract ts, ET normalized to UTC Z"
      (is (= "2026-06-10T19:30:00.200000Z"
             (get-in fact [:fact/payload :chain/observed-at])))
      (is (= (get-in fact [:fact/payload :chain/observed-at])
             (:cursor r))))
    (testing "schema-valid snapshots report complete quality"
      (is (= 0 (get-in fact [:fact/payload :data/quality
                             :quality/dropped-contracts])))
      (is (true? (get-in fact [:fact/payload :data/quality
                               :quality/complete?]))))))

(deftest row-level-contract-parser-counts-internal-unparseable-rows
  (let [normalized {"strike" ["550.0" "555.0"]
                    "right" ["PUT" "???"]
                    "bid" ["2.15" "1.0"]
                    "ask" ["2.20" "1.1"]
                    "expiration" ["2026-06-12" "2026-06-12"]}
        result (td/rows->contracts normalized {:underlying-symbol "SPY"})]
    (is (= 1 (count (:contracts result))))
    (is (= 1 (:unparseable result)))))

(deftest header-response-snapshot-emits-chain-fact
  (let [transport (fn [{:keys [url]}]
                    (if (>= (.find url "/v3/option/snapshot/quote") 0)
                      {:status 200 :body (header-response snapshot-2)}
                      {:status 404 :body "?"}))
        src (td/make-thetadata-chain-source
             {:symbol "SPY"
              :underlying-id "equity/NASDAQ/SPY"
              :expiration "2026-06-12"
              :poll-seconds 0
              :until "2099-01-01T00:00:00Z"
              :transport transport})
        fact (first (:observations (mdp/next-observations src 0 1)))
        contracts (get-in fact [:fact/payload :chain/contracts])]
    (is (= "2026-06-10T19:31:00.000000Z"
           (get-in fact [:fact/payload :chain/observed-at])))
    (is (= ["option/OPRA/SPY/2026-06-12/P/550.000"]
           (mapv :instrument/id contracts)))
    (is (:valid? (v/validate-fact fact)))))

(deftest timestamp-cursor-and-freshness
  (let [current (atom snapshot-1)
        src (make-source current {})
        r1 (mdp/next-observations src 0 1)
        cursor1 (:cursor r1)]
    (testing "a fresher snapshot emits; cursor advances to its observed-at"
      (reset! current snapshot-2)
      (let [r2 (mdp/next-observations src cursor1 1)]
        (is (= 1 (count (:observations r2))))
        (is (= "2026-06-10T19:31:00.000000Z" (:cursor r2)))
        ;; json parse_float=str preserves the wire text exactly: 2.4 → "2.4"
        (is (= "2.4" (-> (:observations r2) first
                         (get-in [:fact/payload :chain/contracts])
                         first :quote/bid)))))
    (testing "fresh post-restart instance resumes at the timestamp cursor"
      (let [src-b (make-source current {})
            rb (mdp/next-observations src-b cursor1 1)]
        (is (= "2026-06-10T19:31:00.000000Z" (:cursor rb)))))
    (testing "stale snapshot + expired :until → exhausted, no emission"
      (let [src-c (make-source current {:until "2000-01-01T00:00:00Z"})
            rc (mdp/next-observations src-c "2026-06-10T19:31:00.000000Z" 1)]
        (is (empty? (:observations rc)))
        (is (true? (:exhausted? rc)))))))

(deftest strike-range-is-config-not-loss
  (let [current (atom snapshot-1)
        src (make-source current {:strike-range ["546" "556"]})
        fact (first (:observations (mdp/next-observations src 0 1)))]
    (is (= #{"option/OPRA/SPY/2026-06-12/P/550.000"
             "option/OPRA/SPY/2026-06-12/C/555.000"}
           (set (map :instrument/id
                     (get-in fact [:fact/payload :chain/contracts])))))
    (testing "range exclusions do NOT count as dropped"
      (is (= 0 (get-in fact [:fact/payload :data/quality
                             :quality/dropped-contracts]))))))

(deftest et->utc-normalization
  (is (= "2026-06-10T20:14:56.020000Z" (td/et->utc "2026-06-10T16:14:56.020")))
  (is (nil? (td/et->utc nil)))
  (testing "winter (EST) offset"
    (is (= "2026-01-10T21:14:56.000000Z" (td/et->utc "2026-01-10T16:14:56")))))

(deftest completed-thetadata-stock-bars-emit-canonical-facts
  (let [body (json/dumps
              (python/dict {"timestamp" (python/list ["2026-06-10T10:00:00.000" "2026-06-10T10:01:00.000"])
                            "open" (python/list [600.0 0.0])
                            "high" (python/list [601.0 0.0])
                            "low" (python/list [599.0 0.0])
                            "close" (python/list [600.5 0.0])
                            "volume" (python/list [1000 0])
                            "vwap" (python/list [600.25 600.25])
                            "count" (python/list [15 0])}))
        seen-url (atom nil)
        transport (fn [{:keys [url]}]
                    (reset! seen-url url)
                    (if (>= (.find url "/v3/stock/history/ohlc") 0)
                      {:status 200 :body body}
                      {:status 404 :body "?"}))
        src (td/make-thetadata-stock-bars-source
             {:symbol "SPY" :instrument-id "equity/NASDAQ/SPY"
              :poll-seconds 0 :block? false :until "2099-01-01T00:00:00Z"
              :transport transport})
        result (mdp/next-observations src 0 10)
        fact (first (:observations result))]
    (is (= 1 (count (:observations result))))
    (is (= "2026-06-10T14:00:00.000000Z" (:cursor result)))
    (is (= "600.25" (get-in fact [:fact/payload :bar/vwap])))
    (is (= "15" (get-in fact [:fact/payload :bar/trade-count])))
    (is (>= (.find @seen-url "venue=nqb") 0))
    (is (= "nqb" (get-in fact [:fact/payload :data/request :venue])))
    (is (= "open-time" (get-in fact [:fact/payload :data/request :bar-timestamp])))
    (is (:valid? (v/validate-fact fact)))))

(deftest thetadata-stock-source-can-seed-at-latest-completed-bar
  (let [body (json/dumps (python/dict {"timestamp" (python/list ["2026-06-10T10:00:00.000"])
                                       "open" (python/list [600.0]) "high" (python/list [601.0])
                                       "low" (python/list [599.0]) "close" (python/list [600.5])
                                       "volume" (python/list [1000]) "vwap" (python/list [600.25])
                                       "count" (python/list [15])}))
        src (td/make-thetadata-stock-bars-source
             {:symbol "SPY" :instrument-id "equity/NASDAQ/SPY" :seed-latest? true
              :poll-seconds 0 :block? false :until "2099-01-01T00:00:00Z"
              :transport (fn [_] {:status 200 :body body})})
        result (mdp/next-observations src 0 1)]
    (is (empty? (:observations result)))
    (is (= 0 (:cursor result)))))

;; ---------------------------------------------------------------------------
;; Multi-expiration merged snapshots (2026-06-12 — term/calendar feeds)
;; ---------------------------------------------------------------------------

(defn- per-exp-transport
  "Serves a DIFFERENT snapshot per expiration compact date; unknown
  expirations 500."
  [by-exp]
  (fn [{:keys [url]}]
    (if-let [[_ body] (first (filter (fn [[exp _]]
                                       (>= (.find url (str "expiration=" exp)) 0))
                                     by-exp))]
      {:status 200 :body body}
      {:status 500 :body "boom"})))

(def front-rows
  [{"strike" 550.0 "right" "PUT" "bid" 2.15 "ask" 2.2 "bid_size" 5
    "ask_size" 7 "expiration" "2026-06-12" "timestamp" "2026-06-10T15:30:00.100"}])

(def back-rows
  [{"strike" 550.0 "right" "PUT" "bid" 3.4 "ask" 3.5 "bid_size" 4
    "ask_size" 6 "expiration" "2026-06-13" "timestamp" "2026-06-10T15:30:00.500"}])

(deftest multi-expiration-merged-snapshot
  (let [src (td/make-thetadata-chain-source
             {:symbol "SPY"
              :underlying-id "equity/NASDAQ/SPY"
              :expirations ["2026-06-12" "2026-06-13"]
              :poll-seconds 0
              :until "2099-01-01T00:00:00Z"
              :transport (per-exp-transport {"20260612" (columnar front-rows)
                                             "20260613" (columnar back-rows)})})
        fact (first (:observations (mdp/next-observations src 0 1)))
        payload (:fact/payload fact)
        ids (mapv :instrument/id (:chain/contracts payload))]
    (testing "ONE fact carries both expirations' contracts"
      (is (= 2 (count ids)))
      (is (some #(>= (.find % "2026-06-12") 0) ids))
      (is (some #(>= (.find % "2026-06-13") 0) ids)))
    (testing "front expiration + full list on the payload"
      (is (= "2026-06-12" (:chain/expiration payload)))
      (is (= ["2026-06-12" "2026-06-13"] (:chain/expirations payload))))
    (testing "observed-at is the max across expirations"
      (is (= "2026-06-10T19:30:00.500000Z" (:chain/observed-at payload))))
    (testing "envelope still canonically valid"
      (is (:valid? (v/validate-fact fact))))))

(deftest multi-expiration-all-or-nothing
  (testing "any failing expiration fails the WHOLE poll (no partial
            snapshots — a term slope from half a chain is silent garbage)"
    (let [src (td/make-thetadata-chain-source
               {:symbol "SPY"
                :underlying-id "equity/NASDAQ/SPY"
                :expirations ["2026-06-12" "2026-06-13"]
                :poll-seconds 0
                :until "2099-01-01T00:00:00Z"
                :block? false
                :transport (per-exp-transport {"20260612" (columnar front-rows)})})
          r (mdp/next-observations src 0 1)]
      (is (= [] (:observations r)))
      (is (false? (:source/healthy? (mdp/source-health src)))))))
