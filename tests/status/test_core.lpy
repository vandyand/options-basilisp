(deftest daily-report-status-targets-prior-report-before-close-and-today-after-report-build
  (let [tmp (tempfile/TemporaryDirectory)]
    (try
      (let [daily-dir (.-name tmp)
            morning (datetime/datetime 2026 7 2 10 0 0 0 et)
            after-report (datetime/datetime 2026 7 2 17 0 0 0 et)
            holiday (datetime/datetime 2026 7 5 12 0 0 0 et)]
        (with-redefs [status/daily-reports-dir (fn [] daily-dir)]
          (let [morning-row (status/daily-report-status morning
                                                        (status/session-state morning)
                                                        (.isoformat morning ** :timespec "seconds"))
                after-row (status/daily-report-status after-report
                                                      (status/session-state after-report)
                                                      (.isoformat after-report ** :timespec "seconds"))
                holiday-row (status/daily-report-status holiday
                                                        (status/session-state holiday)
                                                        (.isoformat holiday ** :timespec "seconds"))]
            (is (= "2026-07-01" (get-in morning-row ["evidence" "expected_date"])))
            (is (= "2026-07-02" (get-in after-row ["evidence" "expected_date"])))
            (is (= "2026-07-02" (get-in holiday-row ["evidence" "expected_date"]))))))
      (finally
        (.cleanup tmp)))))

(deftest daily-report-status-uses-report-timer-due-on-early-close-days
  (let [tmp (tempfile/TemporaryDirectory)]
    (try
      (let [daily-dir (.-name tmp)
            after-early-close (datetime/datetime 2026 11 27 13 31 0 0 et)
            before-report-timer (datetime/datetime 2026 11 27 16 4 0 0 et)
            after-report-timer (datetime/datetime 2026 11 27 16 45 0 0 et)]
        (with-redefs [status/daily-reports-dir (fn [] daily-dir)]
          (doseq [dt [after-early-close before-report-timer]]
            (let [row (status/daily-report-status dt
                                                  (status/session-state dt)
                                                  (.isoformat dt ** :timespec "seconds"))]
              (is (= "2026-11-25" (get-in row ["evidence" "expected_date"])))))
          (let [row (status/daily-report-status after-report-timer
                                                (status/session-state after-report-timer)
                                                (.isoformat after-report-timer ** :timespec "seconds"))]
            (is (= "2026-11-27" (get-in row ["evidence" "expected_date"]))))))
      (finally
        (.cleanup tmp)))))

(deftest daily-report-status-calendar-stress-targets-reachable-report-days
  (let [tmp (tempfile/TemporaryDirectory)]
    (try
      (let [daily-dir (.-name tmp)
            start (datetime/date 2026 1 1)]
        (with-redefs [status/daily-reports-dir (fn [] daily-dir)]
          (doseq [offset (range 365)]
            (let [day (+ start (datetime/timedelta ** :days offset))
                  noon (datetime.datetime/combine day (datetime/time 12 0) et)
                  after-report (datetime.datetime/combine day (datetime/time 17 0) et)
                  noon-session (status/session-state noon)
                  after-session (status/session-state after-report)
                  noon-row (status/daily-report-status noon noon-session (.isoformat noon ** :timespec "seconds"))
                  after-row (status/daily-report-status after-report after-session (.isoformat after-report ** :timespec "seconds"))
                  noon-expected (datetime.date/fromisoformat (get-in noon-row ["evidence" "expected_date"]))
                  after-expected (datetime.date/fromisoformat (get-in after-row ["evidence" "expected_date"]))]
              (is (not (> (.toordinal noon-expected) (.toordinal day))))
              (is (not (> (.toordinal after-expected) (.toordinal day))))
              (when (get noon-session "is_trading_day")
                (is (< (.toordinal noon-expected) (.toordinal day))))
              (if (get after-session "is_trading_day")
                (is (= day after-expected))
                (is (< (.toordinal after-expected) (.toordinal day))))))))
      (finally
        (.cleanup tmp)))))

(deftest market-evidence-status-is-idle-before-collector-and-on-non-trading-days
