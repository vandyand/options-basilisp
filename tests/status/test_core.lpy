(ns status.test-core
  (:import datetime json os os.path sqlite3 tempfile)
  (:require [basilisp.test :refer [deftest is testing]]
            [stevetrading.reporting.artifact-audit :as report-artifacts]
            [stevetrading.status.core :as status]))

(def et status/et)
(def utc datetime.timezone/utc)
(def original-analysis-dir (os.environ/pop "ANALYSIS_DIR" nil))

(deftest strategy-status-marks-stale-during-market-hours
  (let [now (datetime/datetime 2026 7 2 10 0 0 0 et)
        session (status/session-state now)
        [state detail age] (status/strategy-status
                            now
                            session
                            {:last-at (.astimezone (- now (datetime/timedelta ** :minutes 45)) utc)
                             :counts {}
                             :stale-minutes 15
                             :source "test"})]
    (is (= "bad" state))
    (is (>= (.find detail "stale") 0))
    (is (= 45.0 age))))

(deftest session-state-marks-july-3-2026-observed-holiday-closed
  (let [session (status/session-state (datetime/datetime 2026 7 3 10 0 0 0 et))]
    (is (false? (get session "is_trading_day")))
    (is (false? (get session "is_market_hours")))
    (is (= "market-closed-holiday-or-weekend" (get session "label")))))

(deftest session-state-uses-nyse-early-close-time
  (let [open-session (status/session-state (datetime/datetime 2026 11 27 12 30 0 0 et))
        closed-session (status/session-state (datetime/datetime 2026 11 27 14 0 0 0 et))]
    (is (true? (get open-session "is_trading_day")))
    (is (true? (get open-session "is_early_close")))
    (is (= "early-close" (get open-session "session_kind")))
    (is (= "2026-11-27T13:00-05:00" (get open-session "close_at")))
    (is (= "market-open" (get open-session "label")))
    (is (= "post-market" (get closed-session "label")))
    (is (false? (get closed-session "is_market_hours")))))

(deftest target-session-now-treats-past-date-as-completed-session
  (let [generated-now (datetime/datetime 2026 7 5 4 0 0 0 et)
        session-now (status/target-session-now (datetime/date 2026 7 2) generated-now)]
    (is (= "2026-07-02T17:00:00-04:00" (.isoformat session-now ** :timespec "seconds")))))

(deftest theta-remote-health-requires-successful-http-200-body
  (is (= {:healthy? true :http-status "200" :body "{\"response\":[]}"}
         (status/theta-remote-health 0 "{\"response\":[]}\n200")))
  (is (false? (:healthy? (status/theta-remote-health 0 "<html>not found</html>\n404"))))
  (is (false? (:healthy? (status/theta-remote-health 22 "curl: (22) failed\n404"))))
  (is (false? (:healthy? (status/theta-remote-health 0 "{\"error\":\"down\"}\n200"))))
  (is (false? (:healthy? (status/theta-remote-health 0 "\n200")))))

(deftest active-always-systemd-timers-fail-closed-when-inactive
  (let [session (status/session-state (datetime/datetime 2026 7 2 10 0 0 0 et))]
    (with-redefs [status/run-cmd (fn [_cmd _timeout] [3 "inactive"])]
      (let [row (status/systemctl-status "stevetrading-market-evidence-collect.timer"
                                         {:remote nil
                                          :expected "active always"
                                          :session session})]
        (is (= "bad" (get row "status")))
        (is (>= (.find (get row "detail") "inactive") 0))))))

(deftest scheduled-oneshot-systemd-services-surface-failed-last-runs
  (let [session (status/session-state (datetime/datetime 2026 7 2 10 0 0 0 et))
        expected "inactive unless scheduled; last run must not be failed"]
    (with-redefs [status/run-cmd (fn [_cmd _timeout] [3 "inactive"])]
      (let [row (status/systemctl-status "stevetrading-market-evidence-collect.service"
                                         {:remote nil
                                          :expected expected
                                          :session session})]
        (is (= "ok" (get row "status")))
        (is (>= (.find (get row "detail") "last run not failed") 0))))
    (with-redefs [status/run-cmd (fn [_cmd _timeout] [3 "failed"])]
      (let [row (status/systemctl-status "stevetrading-market-evidence-collect.service"
                                         {:remote nil
                                          :expected expected
                                          :session session})]
        (is (= "bad" (get row "status")))
        (is (>= (.find (get row "detail") "failed last run") 0))))))

