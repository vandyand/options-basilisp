                      (status/validate-payload (assoc data "dependencies" deps) {:now now})))]
    (doseq [[evidence expected-code]
            [[(dissoc base-evidence "matched_feature_parity_max_abs_deviation")
              :status/market-evidence-matched-parity-max-abs-dev-missing]
             [(dissoc base-evidence "matched_feature_parity_min_correlation")
              :status/market-evidence-matched-parity-min-corr-missing]
             [(dissoc base-evidence "matched_feature_parity_start")
              :status/market-evidence-matched-parity-start-missing]
             [(dissoc base-evidence "matched_feature_parity_end")
              :status/market-evidence-matched-parity-end-missing]]]
      (let [result (mk-result evidence)
            codes (set (map :code (:issues result)))]
        (is (false? (:valid? result)))
        (is (contains? codes expected-code))))))

