(deftest status-publication-audit-fails-stale-self-consistent-bundle
  (let [tmp (tempfile/TemporaryDirectory)]
    (try
      (let [old-now (- (status/now-et) (datetime/timedelta ** :minutes 45))
            data (minimal-valid-status-payload old-now)
            validation (status/validate-payload data {:now old-now})
            data (assoc data "artifact_validation" validation)
            status-json (json/dumps (status/->jsonable data) ** :indent 2 :sort_keys true)
            validation-json (json/dumps (status/->jsonable validation) ** :indent 2 :sort_keys true)
            html "<html>stale</html>"
            artifacts {"status.json" status-json
                       "status.validation.json" validation-json
                       "index.html" html}
            manifest (assoc (status/status-publication-manifest data artifacts)
                            "published_at" (.isoformat old-now ** :timespec "seconds"))]
        (spit (os.path/join (.-name tmp) "status.json") status-json)
        (spit (os.path/join (.-name tmp) "status.validation.json") validation-json)
        (spit (os.path/join (.-name tmp) "index.html") html)
        (spit (os.path/join (.-name tmp) "status.publish.json")
              (json/dumps (status/->jsonable manifest)))
        (let [audit (status/audit-status-publication (.-name tmp))]
          (is (false? (:valid? audit)))
          (is (contains? (set (map :code (:issues audit)))
                         :status/published-status-validation-failed))
          (is (contains? (set (map :code (:issues audit)))
                         :status/publish-manifest-published-at-stale))))
      (finally
        (.cleanup tmp)))))

