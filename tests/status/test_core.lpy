(deftest status-publication-audit-fails-tampered-validation-artifact
  (let [tmp (tempfile/TemporaryDirectory)]
    (try
      (write-valid-status-publication! (.-name tmp))
      (spit (os.path/join (.-name tmp) "status.validation.json")
            (json/dumps (status/->jsonable
                         {"valid?" true
                          "issues" [{"severity" "bad"
                                     "code" "status/fake-clean"
                                     "detail" "tampered"}]})))
      (let [old-manifest (json/loads (slurp (os.path/join (.-name tmp) "status.publish.json")))
            status-json (slurp (os.path/join (.-name tmp) "status.json"))
            validation-json (slurp (os.path/join (.-name tmp) "status.validation.json"))
            html (slurp (os.path/join (.-name tmp) "index.html"))
            entry (fn [content]
                    {"sha256" (status/sha256-text content)
                     "bytes" (count (.encode content "utf-8"))})
            manifest {"generated_at" (get old-manifest "generated_at")
                      "published_at" (get old-manifest "published_at")
                      "artifacts" {"status.json" (entry status-json)
                                   "status.validation.json" (entry validation-json)
                                   "index.html" (entry html)}}]
        (spit (os.path/join (.-name tmp) "status.publish.json")
              (json/dumps (status/->jsonable manifest)))
        (let [audit (status/audit-status-publication (.-name tmp))]
          (is (false? (:valid? audit)))
          (is (contains? (set (map :code (:issues audit)))
                         :status/published-validation-issues-mismatch))))
      (finally
        (.cleanup tmp)))))

