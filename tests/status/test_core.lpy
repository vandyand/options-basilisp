      (finally
        (.cleanup tmp)))))

(deftest status-publication-audit-rejects-artifact-entry-extra-and-missing-keys
  (let [tmp (tempfile/TemporaryDirectory)]
    (try
      (write-valid-status-publication! (.-name tmp))
      (let [manifest-path (os.path/join (.-name tmp) "status.publish.json")
            manifest (json/loads (slurp manifest-path))
            artifacts (get manifest "artifacts")
            status-entry (get artifacts "status.json")]
        (aset status-entry "unexpected" "fake")
        (spit manifest-path (json/dumps manifest))
        (let [audit (status/audit-status-publication (.-name tmp))]
          (is (false? (:valid? audit)))
          (is (contains? (set (map :code (:issues audit)))
                         :status/publish-manifest-artifact-extra-keys)))
        (.pop status-entry "unexpected")
        (.pop status-entry "sha256")
        (spit manifest-path (json/dumps manifest))
        (let [audit (status/audit-status-publication (.-name tmp))]
          (is (false? (:valid? audit)))
          (is (contains? (set (map :code (:issues audit)))
                         :status/publish-manifest-artifact-missing-keys))))
      (finally
        (.cleanup tmp)))))

