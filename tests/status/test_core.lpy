(deftest status-payload-validation-rejects-invalid-strategy-row-metrics
  (let [now (datetime/datetime 2026 7 2 10 0 0 0 et)
        data (minimal-valid-status-payload now)
        rows (get data "strategy_rows")
        mutate-first-row (fn [f]
                           (assoc data "strategy_rows"
                                  (assoc rows 0 (f (first rows)))))]
    (doseq [[label mutated expected-code]
            [["negative facts"
              (mutate-first-row #(assoc % "facts" -1))
              :status/strategy-row-counter-invalid]
             ["string facts"
              (mutate-first-row #(assoc % "facts" "1"))
              :status/strategy-row-counter-invalid]
             ["boolean facts"
              (mutate-first-row #(assoc % "facts" true))
              :status/strategy-row-counter-invalid]
             ["fills exceed facts"
              (mutate-first-row #(assoc % "facts" 1 "fills" 2))
              :status/strategy-row-counter-exceeds-facts]
             ["bad age"
              (mutate-first-row #(assoc % "age_minutes" "fresh"))
              :status/strategy-row-age-invalid]]]
      (testing label
        (let [result (status/validate-payload mutated {:now now})
              codes (set (map :code (:issues result)))]
          (is (false? (:valid? result)))
          (is (contains? codes expected-code)))))))

