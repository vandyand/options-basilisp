(deftest facts-dbs-project-into-strategy-rows
  (let [tmp (tempfile/TemporaryDirectory)
        root (.-name tmp)
        runtime (os.path/join root "live_runtime" "steve-session-2026-07-02")
        facts (os.path/join runtime "facts.db")]
    (try
      (os/makedirs runtime ** :exist_ok true)
      (let [con (sqlite3/connect facts)]
        (.execute con "create table facts (strategy_id text, account_id text, order_intent_id text, fact_type text, occurred_at text)")
        (.execute con
                  "insert into facts values (?, ?, ?, ?, ?)"
                  ["strategy/steve-v2/lynx/v1" "account/alpaca/lynx-paper" "oi-1" ":fact/signal-decision-produced" "2026-07-02T13:59:00Z"])
        (.execute con
                  "insert into facts values (?, ?, ?, ?, ?)"
                  ["strategy/steve-v2/lynx/v1" "account/alpaca/lynx-paper" "oi-1" ":fact/order-intent-created" "2026-07-02T13:59:30Z"])
        (.execute con
                  "insert into facts values (?, ?, ?, ?, ?)"
                  [nil "account/alpaca/lynx-paper" "oi-1" ":fact/fill-observed" "2026-07-02T14:00:00Z"])
        (.commit con)
        (.close con))
      (let [now (datetime/datetime 2026 7 2 10 1 0 0 et)
            session (status/session-state now)
            [rows sources] (status/build-strategy-rows root now session)
            lynx (first (filter #(= "LYNX" (get % "name")) rows))]
        (is (= [facts] sources))
        (is (= "ok" (get lynx "status")))
        (is (= 3 (get lynx "facts")))
        (is (= 1 (get lynx "signals")))
        (is (= 1 (get lynx "intents")))
        (is (= 1 (get lynx "fills"))))
      (finally
        (.cleanup tmp)))))

(deftest corrupt-facts-db-is-surfaced-as-source-error
  (let [tmp (tempfile/TemporaryDirectory)
        root (.-name tmp)
        runtime (os.path/join root "live_runtime" "steve-session-2026-07-02")
        facts (os.path/join runtime "facts.db")]
    (try
      (os/makedirs runtime ** :exist_ok true)
      (spit facts "not sqlite")
      (let [now (datetime/datetime 2026 7 2 10 1 0 0 et)
            session (status/session-state now)
            [_ _ errors] (status/build-strategy-rows root now session)]
        (is (= 1 (count errors)))
        (is (>= (.find (first errors) "facts.db") 0)))
      (finally
        (.cleanup tmp)))))

(defn write-market-evidence-status!
  [root date payload]
  (let [stamp (.replace date "-" "")
        dir (os.path/join root "live_runtime" "analysis")
        path (os.path/join dir (str "market_evidence_status_" stamp ".json"))
        default-updated-at (datetime.datetime/fromisoformat (str date "T11:00:00-04:00"))
        default-ts (.timestamp default-updated-at)]
    (os/makedirs dir ** :exist_ok true)
    (spit path (json/dumps (status/->jsonable payload) ** :indent 2 :sort_keys true))
    (os/utime path (python/tuple [default-ts default-ts]))
    path))

