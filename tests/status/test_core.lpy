(deftest status-publication-writes-auditable-manifest
  (let [tmp (tempfile/TemporaryDirectory)]
    (try
      (write-valid-status-publication! (.-name tmp))
      (let [manifest-path (os.path/join (.-name tmp) "status.publish.json")
            manifest (json/loads (slurp manifest-path))
            audit (status/audit-status-publication (.-name tmp))]
        (is (true? (os.path/exists manifest-path)))
        (is (= 1 (get manifest "manifest_version")))
        (is (= "stevetrading/status-publication/v1" (get manifest "manifest_kind")))
        (is (= #{"status.json" "status.validation.json" "index.html"}
               (set (.keys (get manifest "artifacts")))))
        (is (true? (:valid? audit)))
        (is (= [] (:issues audit))))
      (finally
        (.cleanup tmp)))))

