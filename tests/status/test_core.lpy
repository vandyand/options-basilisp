                  :status/market-evidence-status-file-target-stamp-mismatch]
                 [(assoc-in base-status ["manifest_verification" "valid?"] false)
                  :status/market-evidence-status-file-manifest-not-verified]
                 [(assoc-in base-status ["readiness" "verdict"] "FAIL")
                  :status/market-evidence-status-file-readiness-not-pass]
                 [(assoc-in base-status ["manifest" "payload_example_count"] 1)
                  :status/market-evidence-status-file-payload-count-mismatch]
                 [(assoc-in base-status ["manifest" "diagnostics" "prediction_delta" "available"] false)
                  :status/market-evidence-status-file-prediction-delta-mismatch]
                 [(assoc-in base-status ["manifest" "diagnostics" "parity_gate" "available"] false)
                  :status/market-evidence-status-file-parity-gate-mismatch]
                 [(assoc-in base-status ["readiness" "matched_feature_parity" "max_abs_deviation"] 1.25)
                  :status/market-evidence-status-file-matched-parity-max-abs-dev-mismatch]
                 [(assoc-in base-status ["readiness" "matched_feature_parity" "min_correlation"] 0.5)
                  :status/market-evidence-status-file-matched-parity-min-corr-mismatch]
                 [(assoc-in base-status ["readiness" "matched_feature_parity" "matched_start"] "2026-07-02T13:31:00Z")
                  :status/market-evidence-status-file-matched-parity-start-mismatch]
                 [(assoc-in base-status ["readiness" "matched_feature_parity" "matched_end"] "2026-07-02T15:31:00Z")
                  :status/market-evidence-status-file-matched-parity-end-mismatch]
                 [(assoc base-status "unmask_apply_ready?" false)
                  :status/market-evidence-status-file-unmask-apply-ready-mismatch]
                 [(assoc-in base-status ["verified_apply_validation" "apply_safe"] false)
                  :status/market-evidence-status-file-verified-apply-safe-mismatch]
                 [(assoc-in base-status ["verified_apply_validation" "candidate_count"] 3)
                  :status/market-evidence-status-file-verified-apply-candidate-count-mismatch]]]
          (spit status-path (json/dumps (status/->jsonable mutated) ** :indent 2 :sort_keys true))
          (let [result (status/validate-payload (mk-data) {:now now})
                codes (set (map :code (:issues result)))]
            (is (false? (:valid? result)))
            (is (contains? codes expected-code)))))
      (finally
        (.cleanup tmp)))))

