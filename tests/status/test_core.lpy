        analysis-tmp (tempfile/TemporaryDirectory)]
    (try
      (let [now (datetime/datetime 2026 7 2 11 0 0 0 et)
            session (status/session-state now)
            generated-at (.isoformat now ** :timespec "seconds")]
        (os.environ/update (python/dict {"ANALYSIS_DIR" (.-name analysis-tmp)}))
        (let [path (os.path/join (.-name analysis-tmp)
                                 "market_evidence_status_20260702.json")
              updated-at (datetime.datetime/fromisoformat "2026-07-02T11:00:00-04:00")
              ts (.timestamp updated-at)]
          (spit path (json/dumps (status/->jsonable (green-market-evidence-status))
                                 ** :indent 2 :sort_keys true))
          (os/utime path (python/tuple [ts ts])))
        (let [row (status/market-evidence-status (.-name root-tmp) now session generated-at)]
          (is (= "ok" (get row "status")))
          (is (= (os.path/join (.-name analysis-tmp)
                               "market_evidence_status_20260702.json")
                 (get-in row ["evidence" "status_path"])))))
      (finally
        (os.environ/pop "ANALYSIS_DIR" nil)
        (.cleanup root-tmp)
        (.cleanup analysis-tmp)))))

(deftest market-evidence-capture-smoke-status-validates-same-day-sidecar-artifact
  (let [tmp (tempfile/TemporaryDirectory)]
    (try
      (let [generated-at "2026-07-02T10:00:00-04:00"
            pending-now (datetime/datetime 2026 7 2 9 30 0 0 et)
            due-now (datetime/datetime 2026 7 2 10 0 0 0 et)
            pending-session (status/session-state pending-now)
            due-session (status/session-state due-now)
            good {"generated_at" "2026-07-02T13:45:00Z"
                  "target_date" "2026-07-02"
                  "ok" true
                  "status" "ok"
                  "row_count" 5
                  "unique_time_count" 5
                  "option_surface_prefixes" ["SPX" "SPXW" "VIX" "VIXW"]
                  "sidecar_dtypes" {"bar_buffers_json" "object"
                                    "option_chain_json" "object"
                                    "option_surfaces_json" "object"
                                    "grid_history_json" "object"}
                  "sidecar_malformed_contracts" {"option_chain_json" 0
                                                 "option_surfaces_json" 0}
                  "option_surface_malformed_contracts_by_prefix" {"SPX" 0
                                                                  "SPXW" 0
                                                                  "VIX" 0
                                                                  "VIXW" 0}}]
        (let [row (status/market-evidence-capture-smoke-status
                   (.-name tmp) pending-now pending-session generated-at)]
          (is (= "idle" (get row "status")))
          (is (= "capture-smoke-pending" (get-in row ["evidence" "phase"]))))
        (let [row (status/market-evidence-capture-smoke-status
                   (.-name tmp) due-now due-session generated-at)]
          (is (= "bad" (get row "status")))
          (is (= "capture-smoke-missing" (get-in row ["evidence" "phase"]))))
        (write-capture-smoke! (.-name tmp) "2026-07-02" good)
        (let [row (status/market-evidence-capture-smoke-status
                   (.-name tmp) due-now due-session generated-at)]
          (is (= "ok" (get row "status")))
          (is (= true (get-in row ["evidence" "capture_smoke_ok"])))
          (is (= true (get-in row ["evidence" "sidecar_dtypes_ok"])))
          (is (= 5.0 (get-in row ["evidence" "unique_time_count"]))))
        (write-capture-smoke!
         (.-name tmp)
         "2026-07-02"
         (assoc good "unique_time_count" 2 "row_count" 2))
        (let [row (status/market-evidence-capture-smoke-status
                   (.-name tmp) due-now due-session generated-at)]
          (is (= "bad" (get row "status")))
          (is (= "capture-smoke-failed" (get-in row ["evidence" "phase"])))
          (is (= 2.0 (get-in row ["evidence" "unique_time_count"]))))
        (write-capture-smoke!
         (.-name tmp)
         "2026-07-02"
         (assoc-in good ["sidecar_dtypes" "option_chain_json"] "<U1351078"))
        (let [row (status/market-evidence-capture-smoke-status
                   (.-name tmp) due-now due-session generated-at)]
          (is (= "bad" (get row "status")))
          (is (= "capture-smoke-failed" (get-in row ["evidence" "phase"])))
          (is (= false (get-in row ["evidence" "sidecar_dtypes_ok"])))
          (is (= "<U1351078" (get-in row ["evidence" "sidecar_dtypes" "option_chain_json"]))))
        (write-capture-smoke!
         (.-name tmp)
         "2026-07-02"
         (assoc good "option_surface_prefixes" ["SPX" "SPXW"]))
        (let [row (status/market-evidence-capture-smoke-status
                   (.-name tmp) due-now due-session generated-at)]
          (is (= "bad" (get row "status")))
          (is (= ["VIX" "VIXW"]
                 (get-in row ["evidence" "missing_option_surface_prefixes"])))))
      (finally
        (.cleanup tmp)))))

