(defn minimal-valid-status-payload
  [now]
  (let [report-due (datetime/datetime 2026 7 2 16 5 0 0 et)
        session-now (datetime/datetime 2026 7 2
                                       (.-hour now)
                                       (.-minute now)
                                       (.-second now)
                                       0
                                       et)
        expected-report-date (if (< (.timestamp now) (.timestamp report-due))
                               "2026-07-01"
                               "2026-07-02")
        expected-report-stamp (.replace expected-report-date "-" "")]
    {"generated_at" (.isoformat now ** :timespec "seconds")
     "target_date" "2026-07-02"
     "session" (status/session-state session-now)
     "probes_enabled" true
     "overall" {"status" "ok"}
     "strategy_rows" (vec
                      (concat
                       (map (fn [s]
                              {"name" (:name s)
                               "status" "idle"
                               "strategy_id" (:strategy-id s)
                               "account_id" (:account-id s)
                               "group" (:group s)
                               "detail" "test"
                               "last_fact_at" nil
                               "age_minutes" nil
                               "facts" 0
                               "signals" 0
                               "intents" 0
                               "fills" 0
                               "rejects" 0
                               "faults" 0})
                            status/steve-strategies)
                       (map (fn [family]
                              {"name" (:name family)
                               "status" "idle"
                               "strategy_id" (:prefix family)
                               "account_id" "sim"
                               "group" (:group family)
                               "detail" "test"
                               "last_fact_at" nil
                               "age_minutes" nil
                               "facts" 0
                               "signals" 0
                               "intents" 0
                               "fills" 0
                               "rejects" 0
                               "faults" 0})
                            status/sim-families)))
     "dependencies" (vec
                     (map (fn [name]
                            (let [row {"name" name
                                       "status" "ok"
                                       "detail" "test"
                                       "expected" "test"
                                       "updated_at" (.isoformat now ** :timespec "seconds")}]
                              (cond
                                (= name "Daily Reports")
                                (assoc row
                                       "evidence"
                                       {"expected_date" expected-report-date
                                        "expected_stamp" expected-report-stamp
                                        "due_at" "2026-07-02T16:05:00-04:00"
                                        "daily_dir" "/tmp/reports/daily"
                                        "validation_path" (str "/tmp/reports/daily/" expected-report-stamp ".validation.json")
                                        "html_path" (str "/tmp/reports/daily/" expected-report-stamp ".html")
                                        "validation_exists" true
                                        "html_exists" true
                                        "report_date" expected-report-date
                                        "report_date_matches" true
                                        "rendered" true
                                        "validation_status" "ok"
                                        "validation_valid" true
                                        "validation_issue_count" 0})

                                (= name "Market Evidence")
                                (assoc row
                                       "status" "idle"
                                       "evidence"
                                       {"phase" "preflight-pending"
                                        "target_date" "2026-07-02"
                                        "target_stamp" "20260702"
                                        "preflight_due_at" "2026-07-02T09:10:00-04:00"
                                        "collector_due_at" "2026-07-02T10:45:00-04:00"})

                                :else
                                row)))
                          ["stevetrading-six.service"
                           "stevetrading-watchdog.timer"
                           "stevetrading-reports-build.timer"
                           "Daily Reports"
                           "stevetrading-status-dashboard.timer"
                           "stevetrading-market-evidence-preflight.timer"
                           "stevetrading-market-evidence-capture-smoke.service"
                           "stevetrading-market-evidence-capture-smoke.timer"
                           "Market Evidence Capture Smoke"
                           "stevetrading-market-evidence-collect.service"
                           "stevetrading-market-evidence-collect.timer"
                           "ThetaData Terminal"
                           "Market Evidence"]))
     "initiatives" (status/initiatives)}))

(defn write-valid-status-publication!
  [dir]
  (let [now (status/now-et)
        reports-dir (os.path/dirname dir)
        data (minimal-valid-status-payload now)
        validation (status/validate-payload data {:now now})
        data (assoc data "artifact_validation" validation)
        status-json (json/dumps (status/->jsonable data) ** :indent 2 :sort_keys true)
        validation-json (json/dumps (status/->jsonable validation) ** :indent 2 :sort_keys true)
        html "<html>ok</html>"
        artifacts {"status.json" status-json
                   "status.validation.json" validation-json
                   "index.html" html}
        manifest-json (json/dumps
                       (status/->jsonable (status/status-publication-manifest data artifacts))
                       ** :indent 2 :sort_keys true)]
    (doseq [target status/required-nav-targets]
      (let [target-dir (os.path/join reports-dir target)]
        (os/makedirs target-dir ** :exist_ok true)
        (spit (os.path/join target-dir "index.html") "<html>ok</html>\n")))
    (spit (os.path/join dir "status.json") status-json)
    (spit (os.path/join dir "status.validation.json") validation-json)
    (spit (os.path/join dir "index.html") html)
    (spit (os.path/join dir "status.publish.json") manifest-json)))

