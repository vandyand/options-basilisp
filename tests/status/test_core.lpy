(deftest status-payload-validation-stress-checks-required-identity-sets
  (let [now (datetime/datetime 2026 7 2 10 0 0 0 et)
        data (minimal-valid-status-payload now)
        rows (get data "strategy_rows")
        deps (get data "dependencies")
        reversed-data (assoc data
                             "strategy_rows" (vec (reverse rows))
                             "dependencies" (vec (reverse deps)))]
    (is (true? (:valid? (status/validate-payload reversed-data {:now now}))))
    (doseq [idx (range (count rows))]
      (let [mutated (assoc data "strategy_rows"
                           (assoc rows idx (assoc (get rows idx)
                                                  "strategy_id"
                                                  (str "strategy/fuzz/" idx))))
            result (status/validate-payload mutated {:now now})
            codes (set (map :code (:issues result)))]
        (is (false? (:valid? result)))
        (is (contains? codes :status/strategy-rows-required-missing))
        (is (contains? codes :status/strategy-rows-unknown))))
    (doseq [idx (range (count deps))]
      (let [mutated (assoc data "dependencies"
                           (assoc deps idx (assoc (get deps idx)
                                                  "name"
                                                  (str "Fake Probe " idx))))
            result (status/validate-payload mutated {:now now})
            codes (set (map :code (:issues result)))]
        (is (false? (:valid? result)))
        (is (contains? codes :status/dependencies-required-missing))
        (is (contains? codes :status/dependencies-unknown))))))

(deftest deterministic-fuzz-status-payload-rejects-scalar-containers-and-rows
  (let [now (datetime/datetime 2026 7 2 10 0 0 0 et)
        data (minimal-valid-status-payload now)
        cases [["strategy_rows" "not-a-vector" :status/strategy-rows-missing]
               ["dependencies" 42 :status/dependencies-missing]
               ["initiatives" true :status/initiatives-missing]
               ["strategy_rows" [(first (get data "strategy_rows")) "scalar-row"] :status/strategy-row-malformed]
               ["dependencies" [(first (get data "dependencies")) "scalar-dep"] :status/dependency-malformed]
               ["initiatives" [(first (get data "initiatives")) "scalar-initiative"] :status/initiative-malformed]]]
    (doseq [[field value expected-code] cases]
      (let [result (status/validate-payload (assoc data field value) {:now now})
            codes (set (map :code (:issues result)))]
        (is (false? (:valid? result)))
        (is (contains? codes expected-code))))))

