      (let [holiday-now (datetime/datetime 2026 7 3 12 0 0 0 et)
            holiday-session (status/session-state holiday-now)
            pre-now (datetime/datetime 2026 7 2 9 0 0 0 et)
            pre-session (status/session-state pre-now)
            holiday-row (status/market-evidence-status (.-name tmp)
                                                       holiday-now
                                                       holiday-session
                                                       (.isoformat holiday-now ** :timespec "seconds"))
            pre-row (status/market-evidence-status (.-name tmp)
                                                   pre-now
                                                   pre-session
                                                   (.isoformat pre-now ** :timespec "seconds"))]
        (is (= "idle" (get holiday-row "status")))
        (is (>= (.find (get holiday-row "detail") "non-trading day") 0))
        (is (= "idle" (get pre-row "status")))
        (is (>= (.find (get pre-row "detail") "not due yet") 0)))
      (finally
        (.cleanup tmp)))))

