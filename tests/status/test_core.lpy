(defn write-market-evidence-preflight!
  [root date payload]
  (let [stamp (.replace date "-" "")
        dir (os.path/join root "live_runtime" "analysis")
        path (os.path/join dir (str "market_evidence_preflight_" stamp ".json"))]
    (os/makedirs dir ** :exist_ok true)
    (spit path (json/dumps (status/->jsonable payload) ** :indent 2 :sort_keys true))
    path))

(defn write-capture-smoke!
  [root date payload]
  (let [stamp (.replace date "-" "")
        dir (os.path/join root "live_runtime" "analysis")
        path (os.path/join dir (str "capture_v2_sidecar_smoke_" stamp ".json"))
        default-updated-at (datetime.datetime/fromisoformat (str date "T09:46:00-04:00"))
        default-ts (.timestamp default-updated-at)]
    (os/makedirs dir ** :exist_ok true)
    (spit path (json/dumps (status/->jsonable payload) ** :indent 2 :sort_keys true))
    (os/utime path (python/tuple [default-ts default-ts]))
    path))

(defn write-daily-report!
  [daily-dir date payload]
  (let [stamp (.replace date "-" "")
        validation-path (os.path/join daily-dir (str stamp ".validation.json"))
        html-path (os.path/join daily-dir (str stamp ".html"))]
    (os/makedirs daily-dir ** :exist_ok true)
    (spit validation-path (json/dumps (status/->jsonable payload) ** :indent 2 :sort_keys true))
    (spit html-path "<html>ok</html>\n")
    validation-path))

(defn write-daily-artifact-manifest!
  [daily-dir date]
  (report-artifacts/audit-daily-validations
   {:daily-dir daily-dir
    :date date
    :write-manifests? true
    :require-manifests? true}))

(deftest daily-report-status-fails-missing-artifact-and-accepts-expected-report
  (let [tmp (tempfile/TemporaryDirectory)]
    (try
      (let [daily-dir (.-name tmp)
            now (datetime/datetime 2026 7 5 12 0 0 0 et)
            session (status/session-state now)
            generated-at (.isoformat now ** :timespec "seconds")]
        (with-redefs [status/daily-reports-dir (fn [] daily-dir)]
          (let [missing-row (status/daily-report-status now session generated-at)]
            (is (= "bad" (get missing-row "status")))
            (is (= "2026-07-02" (get-in missing-row ["evidence" "expected_date"])))
            (is (false? (get-in missing-row ["evidence" "validation_exists"]))))
          (write-daily-report!
           daily-dir
           "2026-07-02"
           {"report/date" "2026-07-02"
            "report/rendered?" true
            "accounts" [{"account/id" "account/alpaca/parrot-paper"
                         "report/date" "2026-07-02"
                         "trade/closed-count" 1
                         "order/count" 2
                         "positions/open-count" 0
                         "positions/open" []
                         "pnl/equity-day" "25.00"
                         "pnl/realized" "25.00"
                         "pnl/unrealized" "0.00"
                         "pnl/closed-trades" "25.00"
                         "broker/equity-observed?" true
                         "report/explanations" []}]})
          (write-daily-artifact-manifest! daily-dir "2026-07-02")
          (let [ok-row (status/daily-report-status now session generated-at)]
            (is (= "ok" (get ok-row "status")))
            (is (= true (get-in ok-row ["evidence" "validation_exists"])))
            (is (= true (get-in ok-row ["evidence" "html_exists"])))
            (is (= "ok" (get-in ok-row ["evidence" "validation_status"])))
            (is (= true (get-in ok-row ["evidence" "validation_valid"]))))))
      (finally
        (.cleanup tmp)))))

(deftest daily-report-status-checks-remote-artifacts-over-ssh
  (let [now (datetime/datetime 2026 7 5 12 0 0 0 et)
        session (status/session-state now)
        generated-at (.isoformat now ** :timespec "seconds")
        seen (atom [])]
    (with-redefs [status/daily-reports-dir (fn [] "/remote/reports/daily")
                  status/run-cmd (fn [cmd _timeout]
                                   (swap! seen conj cmd)
                                   (let [path (last cmd)]
                                     (cond
                                       (= "cat" (nth cmd (- (count cmd) 2)))
                                       [0 (json/dumps (status/->jsonable
                                                       {"report/date" "2026-07-02"
                                                        "report/rendered?" true}))]

                                       (contains? #{"/remote/reports/daily/20260702.validation.json"
                                                    "/remote/reports/daily/20260702.html"
                                                    "/remote/reports/daily/20260702.validation.json.manifest.edn"}
                                                  path)
                                       [0 ""]

                                       :else
                                       [1 "missing"])))]
      (let [row (status/daily-report-status now session generated-at "bot@example")]
        (is (= "ok" (get row "status")))
        (is (= true (get-in row ["evidence" "validation_exists"])))
        (is (= true (get-in row ["evidence" "html_exists"])))
        (is (= true (get-in row ["evidence" "manifest_exists"])))
        (is (= "ok" (get-in row ["evidence" "validation_status"])))
        (is (= true (get-in row ["evidence" "validation_valid"])))
        (is (some #(and (= "ssh" (first %))
                        (= "bot@example" (nth % 5))
                        (= "cat" (nth % (- (count %) 2))))
                  @seen))))))

(deftest daily-report-status-rejects-invalid-validation-artifact
  (let [tmp (tempfile/TemporaryDirectory)]
    (try
      (let [daily-dir (.-name tmp)
            now (datetime/datetime 2026 7 5 12 0 0 0 et)
            session (status/session-state now)
            generated-at (.isoformat now ** :timespec "seconds")]
        (with-redefs [status/daily-reports-dir (fn [] daily-dir)]
          (write-daily-report!
           daily-dir
           "2026-07-02"
           {"report/date" "2026-07-02"
            "report/rendered?" true
            "accounts" []})
          (let [row (status/daily-report-status now session generated-at)]
            (is (= "bad" (get row "status")))
            (is (= "error" (get-in row ["evidence" "validation_status"])))
            (is (= false (get-in row ["evidence" "validation_valid"])))
            (is (pos? (get-in row ["evidence" "validation_issue_count"]))))))
      (finally
        (.cleanup tmp)))))

