                         "verified_apply_validation" {"apply_safe" true
                                                      "candidate_count" 4}}
            base-evidence (merge (valid-market-evidence-proof-fields)
                                 {"phase" "collector-ok"
                                  "target_date" "2026-07-02"
                                  "target_stamp" "20260702"
                                  "collector_due_at" "2026-07-02T10:45:00-04:00"
                                  "status_path" status-path
                                  "status_updated_at" "2026-07-02T11:00:00-04:00"
                                  "collector_ok" true
                                  "ok" true
                                  "artifact_status" "ok"
                                  "manifest_valid" true
                                  "manifest_verified" true
                                  "target_matches_request" true
                                  "readiness_verdict" "PASS"
                                  "payload_example_count" 8
                                  "prediction_delta_available" true
                                  "parity_gate_available" true
                                  "unmask_apply_ready" true
                                  "verified_apply_validation_apply_safe" true
                                  "verified_apply_validation_candidate_count" 4})
            mk-data (fn []
                      (let [data (minimal-valid-status-payload now)]
