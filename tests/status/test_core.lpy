(deftest status-publication-audit-requires-all-published-artifact-entries
  (let [tmp (tempfile/TemporaryDirectory)]
    (try
      (let [status-json "{\"ok\":true}\n"
            validation-json "{\"valid\":true}\n"
            manifest {"generated_at" "2026-07-05T12:00:00-04:00"
                      "published_at" "2026-07-05T12:00:00-04:00"
                      "artifacts" {"status.json" {"sha256" (status/sha256-text status-json)
                                                  "bytes" (count (.encode status-json "utf-8"))}
                                   "status.validation.json" {"sha256" (status/sha256-text validation-json)
                                                             "bytes" (count (.encode validation-json "utf-8"))}}}]
        (spit (os.path/join (.-name tmp) "status.json") status-json)
        (spit (os.path/join (.-name tmp) "status.validation.json") validation-json)
