(deftest status-payload-validation-rejects-malformed-session-shapes
  (let [now (datetime/datetime 2026 7 2 10 0 0 0 et)
        data (minimal-valid-status-payload now)
        cases [["scalar session"
                "not-a-session"
                :status/session-invalid-shape]
               ["missing label"
                (dissoc (get data "session") "label")
                :status/session-missing-keys]
               ["bad market-hours boolean"
                (assoc (get data "session") "is_market_hours" "true")
                :status/session-market-hours-invalid]
               ["bad label"
                (assoc (get data "session") "label" "definitely-open")
                :status/session-label-invalid]
               ["bad session kind"
                (assoc (get data "session") "session_kind" "half-day-ish")
                :status/session-kind-invalid]
               ["bad close"
                (assoc (get data "session") "close_at" "not-a-time")
                :status/session-close-at-invalid]]]
    (doseq [[label session expected-code] cases]
      (testing label
        (let [result (status/validate-payload (assoc data "session" session)
                                              {:now now})
              codes (set (map :code (:issues result)))]
	          (is (false? (:valid? result)))
	          (is (contains? codes expected-code)))))))

(deftest status-payload-validation-rejects-contradictory-session-semantics
  (let [now (datetime/datetime 2026 7 2 10 0 0 0 et)
        data (minimal-valid-status-payload now)
        session (get data "session")
        cases [["market-open but not market-hours"
                (assoc session "is_market_hours" false)
                :status/session-label-state-mismatch]
               ["post-market while market-hours"
                (assoc session
                       "label" "post-market"
                       "is_market_hours" true)
                :status/session-label-state-mismatch]
               ["early-close flag on regular session"
                (assoc session
                       "session_kind" "regular"
                       "is_early_close" true)
                :status/session-kind-state-mismatch]
               ["regular kind on closed holiday"
                (assoc session
                       "label" "market-closed-holiday-or-weekend"
                       "is_trading_day" false
                       "is_market_hours" false
                       "session_kind" "regular")
                :status/session-kind-state-mismatch]
               ["close before open"
                (assoc session
                       "open_at" "2026-07-02T16:00:00-04:00"
                       "close_at" "2026-07-02T09:30:00-04:00")
                :status/session-window-invalid]
               ["window date drift"
                (assoc session
                       "open_at" "2026-07-01T09:30:00-04:00")
                :status/session-window-date-mismatch]]]
    (doseq [[label forged-session expected-code] cases]
      (testing label
        (let [result (status/validate-payload
                      (assoc data "session" forged-session)
                      {:now now})
              codes (set (map :code (:issues result)))]
          (is (false? (:valid? result)))
          (is (contains? codes expected-code)
              (str label " expected " expected-code " got " codes)))))))

