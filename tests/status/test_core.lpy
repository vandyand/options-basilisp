(deftest status-publication-audit-rejects-unsafe-artifact-names
  (let [tmp (tempfile/TemporaryDirectory)]
    (try
      (let [status-json "{\"ok\":true}\n"
            validation-json "{\"valid\":true}\n"
            html "<html>ok</html>\n"
            evil "stolen\n"
            manifest {"generated_at" "2026-07-05T12:00:00-04:00"
                      "published_at" "2026-07-05T12:00:00-04:00"
                      "artifacts" {"status.json" {"sha256" (status/sha256-text status-json)
                                                  "bytes" (count (.encode status-json "utf-8"))}
                                   "status.validation.json" {"sha256" (status/sha256-text validation-json)
                                                             "bytes" (count (.encode validation-json "utf-8"))}
                                   "index.html" {"sha256" (status/sha256-text html)
                                                 "bytes" (count (.encode html "utf-8"))}
                                   "../outside.json" {"sha256" (status/sha256-text evil)
                                                      "bytes" (count (.encode evil "utf-8"))}}}]
        (spit (os.path/join (.-name tmp) "status.json") status-json)
        (spit (os.path/join (.-name tmp) "status.validation.json") validation-json)
        (spit (os.path/join (.-name tmp) "index.html") html)
        (spit (os.path/join (.-name tmp) "status.publish.json")
              (json/dumps (status/->jsonable manifest)))
        (let [audit (status/audit-status-publication (.-name tmp))]
          (is (false? (:valid? audit)))
          (is (contains? (set (map :code (:issues audit)))
                         :status/publish-manifest-unsafe-artifact-name))))
      (finally
        (.cleanup tmp)))))
