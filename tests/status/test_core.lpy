                      (assoc-in green ["readiness" "matched_feature_parity" "available"] false)
                      (assoc-in green ["readiness" "matched_feature_parity" "matched_rows"] 0)
                      (assoc-in green ["readiness" "matched_feature_parity" "matched_rows"] 2)
                      (assoc-in green ["readiness" "matched_feature_parity" "problem_feature_count"] 1)]]
