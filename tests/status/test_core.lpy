(deftest market-evidence-status-rejects-forged-ok-artifacts
  (let [tmp (tempfile/TemporaryDirectory)]
    (try
      (let [now (datetime/datetime 2026 7 2 11 0 0 0 et)
            session (status/session-state now)
            generated-at (.isoformat now ** :timespec "seconds")
            green (green-market-evidence-status)
            variants [(assoc-in green ["manifest" "valid?"] false)
                      (assoc green "status" "error")
                      (assoc green "reasons" ["forced reason"])
                      (assoc-in green ["manifest_verification" "valid?"] false)
                      (assoc-in green ["readiness" "verdict"] "FAIL")
                      (assoc-in green ["manifest" "payload_example_count"] 0)
                      (assoc-in green ["manifest" "payload_example_count"] true)
                      (assoc-in green ["manifest" "diagnostics" "capture_v2_sidecars" "ok"] false)
                      (assoc-in green ["manifest" "diagnostics" "capture_v2_sidecars" "option_surface_prefixes"]
                                ["SPXW"])
                      (assoc-in green ["manifest" "diagnostics" "capture_v2_sidecars" "sidecar_dtypes" "option_chain_json"]
                                "<U1351078")
                      (assoc-in green ["manifest" "diagnostics" "capture_v2_sidecars" "sidecar_malformed_contracts"]
                                {"option_chain_json" 1
