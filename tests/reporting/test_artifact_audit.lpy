(deftest validation-symlink-outside-daily-dir-fails
  (let [dir (tempfile/mkdtemp)
        outside (tempfile/mkdtemp)
        external-validation (os.path/join outside "external.validation.json")
        validation (os.path/join dir "20260702.validation.json")
        html (os.path/join dir "20260702.html")]
    (write-json external-validation (valid-payload "2026-07-02"))
    (os/symlink external-validation validation)
    (spit html "<html>ok</html>")
    (let [result (audit/audit-daily-validations {:daily-dir dir
                                                 :date "2026-07-02"
                                                 :write-manifests? true
                                                 :require-manifests? true})
          codes (set (map :code (:issues result)))]
      (is (false? (:valid? result)))
      (is (contains? codes :report/daily-validation-artifact-outside-daily-dir))
      (is (= 0 (count (:manifest-writes result)))))))

(deftest html-symlink-outside-daily-dir-fails
  (let [dir (tempfile/mkdtemp)
        outside (tempfile/mkdtemp)
        validation (os.path/join dir "20260702.validation.json")
        external-html (os.path/join outside "external.html")
        html (os.path/join dir "20260702.html")]
    (write-json validation (valid-payload "2026-07-02"))
    (spit external-html "<html>ok</html>")
    (os/symlink external-html html)
    (let [result (audit/audit-daily-validations {:daily-dir dir
                                                 :date "2026-07-02"
                                                 :write-manifests? true
                                                 :require-manifests? true})
          codes (set (map :code (:issues result)))]
      (is (false? (:valid? result)))
      (is (contains? codes :report/daily-html-artifact-outside-daily-dir))
      (is (= 0 (count (:manifest-writes result)))))))

(deftest manifest-symlink-outside-daily-dir-fails
  (let [dir (tempfile/mkdtemp)
        outside (tempfile/mkdtemp)
        validation (os.path/join dir "20260702.validation.json")
        html (os.path/join dir "20260702.html")
        external-manifest (os.path/join outside "external.manifest.edn")
        manifest (str validation ".manifest.edn")]
    (write-json validation (valid-payload "2026-07-02"))
    (spit html "<html>ok</html>")
    (audit/audit-daily-validations {:daily-dir dir
                                    :date "2026-07-02"
                                    :write-manifests? true
                                    :require-manifests? true})
    (spit external-manifest (slurp manifest))
    (os/remove manifest)
    (os/symlink external-manifest manifest)
    (let [result (audit/audit-daily-validations {:daily-dir dir
                                                 :date "2026-07-02"
                                                 :require-manifests? true})]
      (is (false? (:valid? result)))
      (is (some #(= :report/daily-artifact-manifest-outside-daily-dir
                    (:code %))
                (:issues result))))))

(deftest manifest-write-does-not-follow-outside-symlink
  (let [dir (tempfile/mkdtemp)
        outside (tempfile/mkdtemp)
        validation (os.path/join dir "20260702.validation.json")
        html (os.path/join dir "20260702.html")
        external-manifest (os.path/join outside "external.manifest.edn")
        manifest (str validation ".manifest.edn")]
    (write-json validation (valid-payload "2026-07-02"))
    (spit html "<html>ok</html>")
    (spit external-manifest "sentinel")
    (os/symlink external-manifest manifest)
    (let [result (audit/audit-daily-validations {:daily-dir dir
                                                 :date "2026-07-02"
                                                 :write-manifests? true
                                                 :require-manifests? true})]
      (is (false? (:valid? result)))
      (is (= "sentinel" (slurp external-manifest)))
      (is (= 0 (count (:manifest-writes result))))
      (is (some #(= :report/daily-artifact-manifest-outside-daily-dir
                    (:code %))
                (:issues result))))))

(deftest validation-manifest-semantic-forgery-fails
  (let [dir (tempfile/mkdtemp)
        validation (os.path/join dir "20260702.validation.json")
        html (os.path/join dir "20260702.html")
        manifest (str validation ".manifest.edn")]
    (write-json validation (valid-payload "2026-07-02"))
    (spit html "<html>ok</html>")
    (audit/audit-daily-validations {:daily-dir dir
                                    :date "2026-07-02"
                                    :write-manifests? true
                                    :require-manifests? true})
    (rewrite-edn manifest
                 #(assoc %
                         :validation/status :error
                         :validation/valid? false
                         :validation/account-count 999))
    (let [result (audit/audit-daily-validations {:daily-dir dir
                                                 :date "2026-07-02"
                                                 :require-manifests? true})
          codes (set (map :code (:issues result)))]
      (is (false? (:valid? result)))
      (is (contains? codes :report/daily-artifact-manifest-validation-status-mismatch))
      (is (contains? codes :report/daily-artifact-manifest-validation-result-mismatch))
      (is (contains? codes :report/daily-artifact-manifest-account-count-mismatch)))))

