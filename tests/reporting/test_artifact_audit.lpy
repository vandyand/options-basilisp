(ns reporting.test-artifact-audit
  (:import json os os.path tempfile)
  (:require [basilisp.edn :as edn]
            [basilisp.test :refer [deftest is]]
            [stevetrading.reporting.artifact-audit :as audit]))

(defn jsonable
  [x]
  (cond
    (map? x) (python/dict
              (map (fn [[k v]] (python/tuple [k (jsonable v)])) x))
    (or (vector? x) (seq? x)) (python/list (map jsonable x))
    :else x))

(defn write-json
  [path payload]
  (spit path (str (json/dumps (jsonable payload) ** :indent 2 :sort_keys true) "\n")))

(defn rewrite-edn
  [path f]
  (spit path (str (edn/write-string (f (edn/read-string (slurp path)))) "\n")))

(defn valid-payload
  [date]
  {"report/date" date
   "report/rendered?" true
   "accounts" [{"account/id" "account/alpaca/parrot-paper"
                "report/date" date
                "trade/closed-count" 1
                "order/count" 2
                "positions/open-count" 0
                "positions/open" []
                "pnl/equity-day" "25.00"
                "pnl/realized" "25.00"
                "pnl/unrealized" "0.00"
                "pnl/closed-trades" "25.00"
                "broker/equity-observed?" true
                "report/explanations" []}]})

(defn invalid-payload
  [date]
  {"report/date" date
   "report/rendered?" true
   "accounts" [{"account/id" "account/alpaca/oak-paper"
                "report/date" date
                "trade/closed-count" 3
                "order/count" 6
                "positions/open-count" 0
                "positions/open" []
                "pnl/equity-day" "-150.00"
                "pnl/realized" "0.00"
                "pnl/unrealized" "0.00"
                "pnl/closed-trades" "-150.00"
                "broker/equity-observed?" true
                "report/explanations" []}]})

(defn realized-without-closed-trades-payload
  [date]
  {"report/date" date
   "report/rendered?" true
   "accounts" [{"account/id" "account/alpaca/oak-paper"
                "report/date" date
                "trade/closed-count" 0
                "order/count" 2
                "positions/open-count" 0
                "positions/open" []
                "pnl/equity-day" "-150.00"
                "pnl/realized" "-150.00"
                "pnl/unrealized" "0.00"
                "pnl/closed-trades" "0.00"
                "broker/equity-observed?" true
                "report/explanations" []}]})

(defn broker-missing-active-payload
  [date]
  {"report/date" date
   "report/rendered?" true
   "accounts" [{"account/id" "account/alpaca/chestnut-paper"
                "report/date" date
                "trade/closed-count" 1
                "order/count" 2
                "positions/open-count" 0
                "positions/open" []
                "pnl/equity-day" "0.00"
                "pnl/realized" "20.00"
                "pnl/unrealized" "0.00"
                "pnl/closed-trades" "20.00"
                "broker/equity-observed?" false
                "report/explanations" []}]})

(deftest valid-trading-day-artifact-with-html-passes
  (let [dir (tempfile/mkdtemp)
        validation (os.path/join dir "20260702.validation.json")
        html (os.path/join dir "20260702.html")]
    (write-json validation (valid-payload "2026-07-02"))
    (spit html "<html>ok</html>")
    (let [result (audit/audit-daily-validations {:daily-dir dir
                                                 :date "2026-07-02"})]
      (is (true? (:valid? result)))
      (is (= :ok (:status result)))
      (is (= 1 (:checked result)))
      (is (empty? (:issues result))))))

(deftest broker-missing-active-html-must-not-render-na-headline
  (let [dir (tempfile/mkdtemp)
        validation (os.path/join dir "20260702.validation.json")
        html (os.path/join dir "20260702.html")]
    (write-json validation (broker-missing-active-payload "2026-07-02"))
    (spit html "<html><div class=\"pnl neutral\">n/a</div><div class=\"stat-row\"><span class=\"k\">Broker equity P&amp;L</span><span>n/a</span></div></html>")
    (let [result (audit/audit-daily-validations {:daily-dir dir
                                                 :date "2026-07-02"})
          codes (set (map :code (:issues result)))]
      (is (false? (:valid? result)))
      (is (contains? codes :report/daily-html-broker-equity-missing-renders-na-headline)))))

(deftest broker-missing-active-html-realized-fallback-passes
  (let [dir (tempfile/mkdtemp)
        validation (os.path/join dir "20260702.validation.json")
        html (os.path/join dir "20260702.html")]
    (write-json validation (broker-missing-active-payload "2026-07-02"))
    (spit html "<html><div class=\"pnl positive\" title=\"Broker day P&amp;L was unavailable; headline falls back to realized closed-trade P&amp;L.\">$20.00</div><div class=\"stat-row\"><span class=\"k\">Broker equity P&amp;L</span><span>unavailable</span></div></html>")
    (let [result (audit/audit-daily-validations {:daily-dir dir
                                                 :date "2026-07-02"})]
      (is (true? (:valid? result))))))

(deftest valid-trading-day-artifact-writes-and-verifies-manifest
  (let [dir (tempfile/mkdtemp)
        validation (os.path/join dir "20260702.validation.json")
        html (os.path/join dir "20260702.html")
        manifest (str validation ".manifest.edn")]
    (write-json validation (valid-payload "2026-07-02"))
    (spit html "<html>ok</html>")
    (let [result (audit/audit-daily-validations {:daily-dir dir
                                                 :date "2026-07-02"
                                                 :write-manifests? true
                                                 :require-manifests? true})]
      (is (true? (:valid? result)))
      (is (= :ok (:status result)))
      (is (os.path/exists manifest))
      (is (= 1 (count (:manifest-writes result))))
      (is (empty? (:issues result))))))

