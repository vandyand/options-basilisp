(deftest validation-manifest-artifact-non-map-forgery-fails
  (let [dir (tempfile/mkdtemp)
        validation (os.path/join dir "20260702.validation.json")
        html (os.path/join dir "20260702.html")
        manifest (str validation ".manifest.edn")]
    (write-json validation (valid-payload "2026-07-02"))
    (spit html "<html>ok</html>")
    (audit/audit-daily-validations {:daily-dir dir
                                    :date "2026-07-02"
                                    :write-manifests? true
                                    :require-manifests? true})
    (rewrite-edn manifest #(assoc % :validation/artifact
                                  [:path validation
                                   :sha256 "not-a-map"]))
    (let [result (audit/audit-daily-validations {:daily-dir dir
                                                 :date "2026-07-02"
                                                 :require-manifests? true})
          codes (set (map :code (:issues result)))]
      (is (false? (:valid? result)))
      (is (contains? codes
                     :report/daily-artifact-manifest-artifact-invalid-shape))
      (is (contains? codes
                     :report/daily-artifact-manifest-artifact-missing-keys)))))

