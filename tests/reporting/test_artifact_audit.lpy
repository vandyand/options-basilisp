(deftest all-mode-audits-every-validation-artifact
  (let [dir (tempfile/mkdtemp)]
    (write-json (os.path/join dir "20260701.validation.json")
                (valid-payload "2026-07-01"))
    (spit (os.path/join dir "20260701.html") "<html>ok</html>")
    (write-json (os.path/join dir "20260702.validation.json")
                (invalid-payload "2026-07-02"))
    (spit (os.path/join dir "20260702.html") "<html>bad</html>")
    (let [result (audit/audit-daily-validations {:daily-dir dir
                                                 :all? true})]
      (is (false? (:valid? result)))
      (is (= 2 (:checked result)))
      (is (some #(= :pnl/realized-closed-trades-gap (:code %))
                (:issues result))))))

(deftest all-mode-empty-directory-fails
  (let [dir (tempfile/mkdtemp)
        result (audit/audit-daily-validations {:daily-dir dir
                                               :all? true})]
    (is (false? (:valid? result)))
    (is (= 0 (:checked result)))
    (is (some #(= :report/no-daily-validation-artifacts (:code %))
              (:issues result)))))

(deftest all-mode-orphan-html-without-validation-fails
  (let [dir (tempfile/mkdtemp)]
    (write-json (os.path/join dir "20260702.validation.json")
                (valid-payload "2026-07-02"))
    (spit (os.path/join dir "20260702.html") "<html>ok</html>")
    (spit (os.path/join dir "20260701.html") "<html>unchecked</html>")
    (let [result (audit/audit-daily-validations {:daily-dir dir
                                                 :all? true})]
      (is (false? (:valid? result)))
      (is (= 1 (:checked result)))
      (is (some #(= :report/orphan-daily-html-artifact (:code %))
                (:issues result))))))

(deftest all-mode-non-trading-day-stale-artifacts-fail
  (let [dir (tempfile/mkdtemp)]
    (write-json (os.path/join dir "20260703.validation.json")
                (valid-payload "2026-07-03"))
    (spit (os.path/join dir "20260703.html") "<html>stale holiday report</html>")
    (let [result (audit/audit-daily-validations {:daily-dir dir
                                                 :all? true})
          codes (set (map :code (:issues result)))]
      (is (false? (:valid? result)))
      (is (= 1 (:checked result)))
      (is (contains? codes :report/non-trading-day-validation-artifact))
      (is (contains? codes :report/non-trading-day-html-artifact)))))

(deftest all-mode-fails-validation-filename-date-drift
  (let [dir (tempfile/mkdtemp)]
    (write-json (os.path/join dir "20260702.validation.json")
                (valid-payload "2026-07-01"))
    (spit (os.path/join dir "20260702.html") "<html>wrong day</html>")
    (let [result (audit/audit-daily-validations {:daily-dir dir
                                                 :all? true})]
      (is (false? (:valid? result)))
      (is (= 1 (:checked result)))
      (is (some #(= :report/validation-date-filename-mismatch (:code %))
                (:issues result))))))

(deftest all-mode-deterministic-fuzz-malformed-validation-filenames-fail-cleanly
  (let [prefixes ["abcdefgh"
                  "20261301"
                  "20260230"
                  "00000000"
                  "2026abcd"]]
    (doseq [prefix prefixes]
      (let [dir (tempfile/mkdtemp)
            path (os.path/join dir (str prefix ".validation.json"))]
        (write-json path (valid-payload "2026-07-02"))
        (let [result (audit/audit-daily-validations {:daily-dir dir
                                                     :all? true})
              codes (set (map :code (:issues result)))]
          (is (false? (:valid? result)))
          (is (= 1 (:checked result)))
          (is (contains? codes :report/validation-filename-date-unparseable))
          (is (contains? codes :report/validation-date-filename-mismatch)))))))
