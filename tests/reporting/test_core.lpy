              (:issues result)))))

(deftest malformed-numeric-report-values-return-validation-error
  (let [result (reporting/validate-account-day
                {:account/id "account/alpaca/bad-paper"
                 :report/date "2026-07-02"
                 :pnl/equity-day "lol"
                 :pnl/realized "0.00"
                 :pnl/unrealized "0.00"
                 :trade/closed-count 0
                 :order/count 0
                 :positions/open-count 0
                 :broker/equity-observed? true})]
    (is (false? (:valid? result)))
    (is (= :error (:status result)))
    (is (some #(= :report/invalid-account-day-shape (:code %))
              (:issues result)))))

(deftest equity-gap-without-explanation-warns
  (let [result (reporting/validate-account-day
                {:account/id "account/alpaca/parrot-paper"
                 :report/date "2026-07-02"
                 :pnl/equity-day "-35.87"
                 :pnl/realized "-35.87"
                 :pnl/unrealized "0.00"
                 :pnl/closed-trades "-35.87"
                 :trade/closed-count 52
                 :order/count 104
                 :positions/open-count 0
                 :positions/open []
                 :broker/equity-observed? false})]
    (is (true? (:valid? result)))
    (is (= :warn (:status result)))
    (is (some #(= :broker/missing-equity-observation (:code %))
              (:issues result)))))

(deftest malformed-broker-equity-observation-fails-closed
  (let [base {:account/id "account/alpaca/parrot-paper"
              :report/date "2026-07-02"
              :pnl/equity-day "0.00"
              :pnl/realized "0.00"
              :pnl/unrealized "0.00"
              :pnl/closed-trades "0.00"
              :trade/closed-count 0
              :order/count 0
              :positions/open-count 0
              :positions/open []}
        cases [["string false" "false"]
               ["string true" "true"]
               ["explicit nil" nil]
               ["numeric one" 1]]]
    (doseq [[label broker-observed] cases]
      (testing label
        (let [result (reporting/validate-account-day
                      (assoc base :broker/equity-observed?
                             broker-observed))]
          (is (false? (:valid? result)))
          (is (= :error (:status result)))
          (is (contains? (issue-codes result)
                         :broker/equity-observed-malformed)))))))

