                          "\"side\":\"BUY\",\"is_long\":false,"
                          "\"open_price\":2.0,\"close_price\":2.5,"
                          "\"qty\":1,\"pnl_dollars\":50.0,"
                          "\"hold_minutes\":5.0}]}")
        bad-payload (str "{\"report_date\":\"2026-06-09\","
