(deftest stress-pairs-many-independent-symbols-with-invariants
  (let [orders (vec
                (mapcat (fn [i]
                          (let [sym (str "SPY260610C" (python/format (+ 650000 i) "08d"))
                                q (inc (mod i 3))
                                open (+ 1.0 (/ i 100.0))
                                close (+ open 0.25)]
                            [(fo sym "BUY" open q (* 2 i) "stress")
                             (fo sym "SELL" close q (inc (* 2 i)) "stress")]))
                        (range 1000)))
        {:keys [round-trips open-entries unmatched-closes]} (rm/pair-round-trips orders)
        m (rm/compute-all-metrics round-trips)]
    (is (= 1000 (count round-trips)))
    (is (empty? open-entries))
    (is (empty? unmatched-closes))
    (is (= 1000 (:n-trades m)))
    (is (= 1000 (:n-wins m)))
    (is (= 0 (:n-losses m)))
    (is (= (reduce + (map #(* 0.25 100.0 (inc (mod % 3))) (range 1000)))
           (:total-pnl-dollars m)))
    (is (= 100.0 (:pct-time-in-market m)))))

(deftest stress-partial-fifo-pnl-is-sum-of-consumed-lots
  (let [orders (vec
                (mapcat (fn [i]
                          (let [sym (str "SPY260610C" (python/format (+ 700000 i) "08d"))
                                account (str "acct-" (mod i 7))
                                open (+ 1.0 (/ (mod i 11) 100.0))
                                c1 (+ open 0.10)
                                c2 (+ open 0.25)
                                q (+ 2 (mod i 5))
                                q1 (inc (mod i (dec q)))
                                q2 (- q q1)]
                            [(fo sym "BUY" open q (* 3 i) account)
                             (fo sym "SELL" c1 q1 (inc (* 3 i)) account)
                             (fo sym "SELL" c2 q2 (+ 2 (* 3 i)) account)]))
                        (range 300)))
        {:keys [round-trips open-entries unmatched-closes]} (rm/pair-round-trips orders)
        expected (reduce +
                         (map (fn [i]
                                (let [q (+ 2 (mod i 5))
                                      q1 (inc (mod i (dec q)))
                                      q2 (- q q1)]
                                  (+ (* 0.10 100.0 q1)
                                     (* 0.25 100.0 q2))))
                              (range 300)))]
    (is (= 600 (count round-trips)))
    (is (empty? open-entries))
    (is (empty? unmatched-closes))
    (is (< (abs (- expected (:total-pnl-dollars (rm/compute-all-metrics round-trips))))
           1e-6))))

(defn- lcg
  [seed]
  (mod (+ (* 1103515245 seed) 12345) 2147483648))

(defn- fuzz-equity-orders
  [n]
  (loop [i 0
         seed 424242
         out []]
    (if (= i n)
      out
      (let [seed1 (lcg seed)
            seed2 (lcg seed1)
            seed3 (lcg seed2)
            seed4 (lcg seed3)
            account (nth ["acct-a" "acct-b" "acct-c"] (mod seed1 3))
            symbol (nth ["SPY" "QQQ"] (mod seed2 2))
            side (if (zero? (mod seed3 2)) "BUY" "SELL")
            qty (inc (mod seed4 5))
            price (+ 100.0 (/ (mod seed1 1000) 100.0))]
        (recur (inc i)
               seed4
               (conj out (fo symbol side price qty i account)))))))

(defn- oracle-match-one
  [queue signed-qty price]
  (loop [remaining signed-qty
         lots queue
         pnl 0.0
         trades 0]
    (if (or (zero? remaining)
            (empty? lots)
            (pos? (* remaining (:signed-qty (first lots)))))
      {:remaining remaining
       :lots lots
       :pnl pnl
       :trades trades}
      (let [lot (first lots)
            lot-qty (:signed-qty lot)
            matched (min (abs remaining) (abs lot-qty))
            trade-pnl (if (pos? lot-qty)
                        (* (- price (:price lot)) matched)
                        (* (- (:price lot) price) matched))
            remaining' (+ remaining
                          (if (pos? remaining) (- matched) matched))
            lot-qty' (+ lot-qty
                        (if (pos? lot-qty) (- matched) matched))
            lots' (if (zero? lot-qty')
                    (vec (rest lots))
                    (vec (cons (assoc lot :signed-qty lot-qty') (rest lots))))]
        (recur remaining'
               lots'
               (+ pnl trade-pnl)
               (inc trades))))))

(defn- oracle-equity
  [orders]
  (let [lots-by-key (atom {})
        total-pnl (atom 0.0)
        trade-count (atom 0)]
    (doseq [o (sort-by :filled-at orders)]
      (let [k [(:account o) (:symbol o)]
            signed-qty (if (= "BUY" (:side o)) (:qty o) (- (:qty o)))
            matched (oracle-match-one (vec (get @lots-by-key k []))
                                      signed-qty
                                      (:filled-avg-price o))
            residual (:remaining matched)
            lots' (cond-> (:lots matched)
                    (not (zero? residual))
                    (conj {:signed-qty residual
                           :price (:filled-avg-price o)}))]
        (swap! total-pnl + (:pnl matched))
        (swap! trade-count + (:trades matched))
        (swap! lots-by-key assoc k lots')))
    {:total-pnl @total-pnl
     :trade-count @trade-count
     :open-qty-by-key (into {}
                            (map (fn [[k lots]]
                                   [k (reduce + 0 (map :signed-qty lots))])
                                 @lots-by-key))}))

(defn- open-qty-by-key
  [open-entries]
  (reduce (fn [acc e]
            (let [k [(:account e) (:symbol e)]
                  signed-qty (if (= "BUY" (:side e)) (:qty e) (- (:qty e)))]
              (update acc k (fnil + 0) signed-qty)))
          {}
          open-entries))

(deftest deterministic-fuzz-equity-pairing-matches-signed-fifo-oracle
  (let [orders (fuzz-equity-orders 500)
        expected (oracle-equity orders)
        {:keys [round-trips open-entries unmatched-closes]} (rm/pair-round-trips orders)]
    (is (empty? unmatched-closes))
    (is (= (:trade-count expected) (count round-trips)))
    (is (< (abs (- (:total-pnl expected)
                   (:total-pnl-dollars (rm/compute-all-metrics round-trips))))
           1e-6))
    (is (= (:open-qty-by-key expected) (open-qty-by-key open-entries)))
    (is (every? #(pos? (:qty %)) round-trips))
    (is (every? #(pos? (:qty %)) open-entries))))
