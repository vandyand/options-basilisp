                        "after as_of")))))

(deftest report-metrics-cli-rejects-malformed-explicit-report-dates
  (let [entry (str "\"open_entries\":[{\"account\":\"oak\","
                   "\"symbol\":\"SPY\",\"side\":\"BUY\","
                   "\"open_time\":\"2026-06-09T09:35:00-04:00\","
                   "\"open_price\":100.0,\"qty\":1,"
                   "\"is_long\":true,\"is_option\":false}]")
        cases [(str "{\"report_date\":\"zzzz\"," entry "}")
               (str "{\"report_date\":\"20260609\"," entry "}")
               (str "{\"report_date\":\"2026-13-09\"," entry "}")
               (str "{\"report_date\":true," entry "}")]]
    (doseq [payload cases]
      (let [result (run-report-metrics-cli payload)
            output (str (.-stderr result) (.-stdout result))]
        (is (not= 0 (.-returncode result))
            (str "malformed report_date should fail: " payload))
        (is (not= -1 (.find output "invalid report_date field"))
            output)))))

