                  (:issues verification)))))))

(deftest same-pop-manifest-schema-rejects-malformed-artifact-digests
  (let [dir (tempfile/mkdtemp)
        paths (write-readiness-artifacts! dir {})
        result (analysis/same-population-statistics
                (assoc paths :bootstrap-reps 10 :permutation-reps 10))
        manifest (:manifest result)]
    (doseq [bad-sha ["abc"
                     (apply str (repeat 64 "A"))
                     (apply str (repeat 64 "g"))
                     1234]]
      (let [forged (assoc-in manifest
                             [:artifacts :live-tape :sha256]
                             bad-sha)
            verification (analysis/verify-same-pop-manifest forged)]
        (is (false? (:valid? verification))
            (str "bad sha should fail: " (pr-str bad-sha)))
        (is (= :manifest/invalid (:status verification)))
        (is (some #(= :manifest/invalid-shape (:code %))
                  (:issues verification)))))))

(deftest calibration-artifact-schema-rejects-malformed-source-digests
  (let [artifact {:calibration/version 1
                  :calibration/kind :sim-fill/calibration-v1
                  :calibration/generated-at "2026-07-02T21:00:00Z"
                  :source/facts-dbs ["facts.db"]
                  :source/facts-fingerprints
                  [{:path "facts.db"
                    :sha256 (apply str (repeat 64 "0"))}]
                  :matching/max-lag-seconds 90.0
                  :estimator/prior-strength 20.0
                  :input/option-fills 1
                  :input/matched-fills 1
                  :global {:n 1
                           :conservative-price-improvement 0.0}
                  :buckets []}]
    (is (:valid? (analysis-schema/validation-result
                  :analysis/calibration-artifact artifact)))
    (doseq [bad-sha ["abc" (apply str (repeat 64 "Z")) false]]
      (let [forged (assoc-in artifact
                             [:source/facts-fingerprints 0 :sha256]
                             bad-sha)
            validation (analysis-schema/validation-result
                        :analysis/calibration-artifact forged)]
        (is (false? (:valid? validation))
            (str "bad source sha should fail: " (pr-str bad-sha)))))))

(deftest same-pop-manifest-verifier-rejects-extra-artifact-entry
  (let [dir (tempfile/mkdtemp)
        paths (write-readiness-artifacts! dir {})
        result (analysis/same-population-statistics
                (assoc paths :bootstrap-reps 10 :permutation-reps 10))
        extra-path (os.path/join dir "legacy-extra.txt")
        _ (spit extra-path "legacy\n")
        manifest (assoc-in (:manifest result)
                           [:artifacts :legacy-extra]
                           {:path extra-path
                            :sha256 (analysis/artifact-sha256 extra-path)})
        verification (analysis/verify-same-pop-manifest manifest)]
    (is (false? (:valid? verification)))
    (is (= :manifest/failed (:status verification)))
    (is (some #(and (= :manifest/extra-artifact-entry (:code %))
                    (= [:legacy-extra] (get-in % [:details :extra])))
              (:issues verification)))))

(deftest same-pop-manifest-verifier-rejects-extra-manifest-fields
  (let [dir (tempfile/mkdtemp)
        paths (write-provenance-readiness-artifacts!
               dir (repeat 40 1.0) (repeat 40 1.0))
        result (analysis/same-population-statistics
                (assoc paths :bootstrap-reps 10 :permutation-reps 10))
        manifest (:manifest result)
        top-level (assoc manifest :legacy/status :looks-valid)
        parameters (assoc-in manifest
                             [:parameters :legacy-bootstrap-reps]
                             10)
        artifact-ref (assoc-in manifest
                               [:artifacts :live-tape :legacy-size-bytes]
                               1234)]
    (doseq [[forged code field] [[top-level
                                  :manifest/extra-top-level-keys
                                  :legacy/status]
                                 [parameters
                                  :manifest/parameters-extra-keys
                                  :legacy-bootstrap-reps]
                                 [artifact-ref
                                  :manifest/artifact-ref-extra-keys
                                  :legacy-size-bytes]]]
      (let [verification (analysis/verify-same-pop-manifest forged)]
        (is (false? (:valid? verification)))
        (is (= :manifest/failed (:status verification)))
        (is (some #(and (= code (:code %))
                        (= [field] (get-in % [:details :fields])))
                  (:issues verification)))))))

(deftest deterministic-fuzz-same-pop-manifest-extra-key-mutations-fail
  (let [dir (tempfile/mkdtemp)
        paths (write-provenance-readiness-artifacts!
               dir (repeat 40 1.0) (repeat 40 1.0))
        result (analysis/same-population-statistics
                (assoc paths :bootstrap-reps 10 :permutation-reps 10))
        manifest (:manifest result)
        structural-cases [[[:legacy/fuzz-marker]
                           :manifest/extra-top-level-keys]
                          [[:cohort :legacy/fuzz-marker]
                           :manifest/cohort-extra-keys]
                          [[:gates :legacy/fuzz-marker]
                           :manifest/gates-extra-keys]
                          [[:parameters :legacy/fuzz-marker]
                           :manifest/parameters-extra-keys]]
        artifact-cases (mapv (fn [artifact-key]
                               [[:artifacts artifact-key :legacy/fuzz-marker]
                                :manifest/artifact-ref-extra-keys])
                             [:live-tape :replay-tape :live-episodes
                              :replay-episodes :calibration])
        cases (concat structural-cases artifact-cases)]
    (doseq [[mutation-path expected-code] cases]
      (let [forged (assoc-in manifest mutation-path "forged-green")
            field (last mutation-path)
            verification (analysis/verify-same-pop-manifest forged)]
        (is (false? (:valid? verification)))
        (is (= :manifest/failed (:status verification)))
        (is (some #(and (= expected-code (:code %))
                        (= [field] (get-in % [:details :fields])))
                  (:issues verification)))))))

(deftest same-pop-manifest-verifier-rejects-semantic-forgery
  (let [dir (tempfile/mkdtemp)
        paths (write-provenance-readiness-artifacts!
               dir (repeat 40 1.0) (repeat 40 1.0))
        result (analysis/same-population-statistics
                (assoc paths :bootstrap-reps 10 :permutation-reps 10))
        wrong-kind (assoc (:manifest result)
                          :manifest/kind :wrong/kind)
        wrong-readiness (assoc-in (:manifest result)
                                  [:gates :readiness-status]
                                  :same-pop/watch)
        wrong-alignment (assoc-in (:manifest result)
                                  [:gates :alignment-status]
                                  :alignment/review-mismatches)]
    (doseq [manifest [wrong-kind wrong-readiness wrong-alignment]]
      (let [verification (analysis/verify-same-pop-manifest manifest)]
        (is (false? (:valid? verification)))
        (is (= :manifest/invalid (:status verification)))
        (is (some #(= :manifest/invalid-shape (:code %))
                  (:issues verification)))))))

(deftest same-pop-manifest-verifier-rejects-schema-valid-semantic-forgery
  (let [dir (tempfile/mkdtemp)
        paths (write-provenance-readiness-artifacts!
               dir (repeat 40 1.0) (repeat 40 1.0))
        result (analysis/same-population-statistics
                (assoc paths :bootstrap-reps 10 :permutation-reps 10))
        manifest (:manifest result)
        forged-cohort (assoc-in manifest
                                [:cohort :accounts]
                                ["account/fake/schema-valid"])
        forged-gates (assoc-in manifest
                               [:gates :mismatch-count]
                               42)]
    (doseq [[manifest field] [[forged-cohort :cohort]
                              [forged-gates :gates.mismatch-count]]]
      (let [verification (analysis/verify-same-pop-manifest manifest)]
        (is (false? (:valid? verification)))
        (is (= :manifest/failed (:status verification)))
        (is (some #(and (= :manifest/semantic-mismatch (:code %))
                        (= field (get-in % [:details :field])))
                  (:issues verification)))))))

(deftest same-pop-manifest-verifier-rejects-impossible-generated-at
  (let [dir (tempfile/mkdtemp)
        paths (write-provenance-readiness-artifacts!
               dir (repeat 40 1.0) (repeat 40 1.0))
        result (analysis/same-population-statistics
                (assoc paths :bootstrap-reps 10 :permutation-reps 10))
        manifest (:manifest result)
        future (assoc manifest :manifest/generated-at "2999-01-01T00:00:00Z")
        malformed (assoc manifest :manifest/generated-at "not-a-timestamp")]
    (doseq [[forged expected-code] [[future :manifest/generated-at-in-future]
                                    [malformed
                                     :manifest/generated-at-unparseable]]]
      (let [verification (analysis/verify-same-pop-manifest forged)
            codes (set (map :code (:issues verification)))]
        (is (false? (:valid? verification)))
        (is (= :manifest/failed (:status verification)))
        (is (contains? codes expected-code))))))
