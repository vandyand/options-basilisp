(deftest run-same-pop-stats-cli-exits-nonzero-on-small-sample-watch
  (let [dir (tempfile/mkdtemp)
        paths (write-provenance-readiness-artifacts!
               dir [1.0 2.0 3.0] [1.0 2.0 3.0])
        report-path (os.path/join dir "same_population_report.md")
        manifest-path (os.path/join dir "same_population_manifest.edn")
        cmd [".venv/bin/basilisp" "run" "scripts/run_same_pop_stats.lpy" "--"
             "--live-tape" (:live-tape paths)
             "--replay-tape" (:replay-tape paths)
             "--live-episodes" (:live-episodes paths)
             "--replay-episodes" (:replay-episodes paths)
             "--calibration" (:calibration paths)
             "--out" report-path
             "--manifest-out" manifest-path
             "--bootstrap-reps" "50"
             "--permutation-reps" "50"
             "--min-samples" "30"
             "--practical-mean-threshold" "0.0"]
        result (subprocess/run (python/list cmd)
                               ** :capture_output true
                                  :text true
                                  :check false)]
    (is (= 1 (.-returncode result)))
    (is (not= -1 (.find (.-stdout result) ":same-pop/watch")))
    (is (os.path/exists report-path))
    (is (os.path/exists manifest-path))))

(deftest same-pop-clis-reject-malformed-numeric-arguments-before-analysis
  (let [dir (tempfile/mkdtemp)
        missing (os.path/join dir "missing.csv")
        report-path (os.path/join dir "same_population_report.md")
        readiness-result
        (subprocess/run
         (python/list
          [".venv/bin/basilisp" "run"
           "scripts/validate_same_pop_readiness.lpy" "--"
           "--live-tape" missing
           "--replay-tape" missing
           "--live-episodes" missing
           "--replay-episodes" missing
           "--calibration" missing
           "--bucket-seconds" "1.5"])
         ** :capture_output true
            :text true
            :check false)
        stats-result
        (subprocess/run
         (python/list
          [".venv/bin/basilisp" "run"
           "scripts/run_same_pop_stats.lpy" "--"
           "--live-tape" missing
           "--replay-tape" missing
           "--live-episodes" missing
           "--replay-episodes" missing
           "--calibration" missing
           "--out" report-path
           "--bootstrap-reps" "0"])
         ** :capture_output true
            :text true
            :check false)
        align-result
        (subprocess/run
         (python/list
          [".venv/bin/basilisp" "run"
           "scripts/align_behavior.lpy" "--"
           "--live" missing
           "--replay" missing
           "--out" (os.path/join dir "alignment.md")
           "--bucket-seconds" "nan"])
         ** :capture_output true
            :text true
            :check false)]
    (doseq [[result expected] [[readiness-result "invalid integer argument: 1.5"]
                               [stats-result "invalid integer argument: 0"]
                               [align-result "invalid integer argument: nan"]]]
      (is (not= 0 (.-returncode result)))
      (is (not= -1 (.find (str (.-stderr result) (.-stdout result))
                          expected))
          (str expected " in " (.-stderr result) (.-stdout result))))))

(deftest same-pop-clis-reject-unknown-options-before-analysis
  (let [cases [["scripts/validate_same_pop_readiness.lpy" "--liv-tape"]
               ["scripts/run_same_pop_stats.lpy" "--manifestoutput"]
               ["scripts/verify_same_pop_manifest.lpy" "--manfiest"]]]
    (doseq [[script bad-flag] cases]
      (let [result (subprocess/run
                    (python/list
                     [".venv/bin/basilisp" "run" script "--" bad-flag "x"])
                    ** :capture_output true
                       :text true
                       :check false)
            output (str (.-stderr result) (.-stdout result))]
        (is (not= 0 (.-returncode result)))
        (is (not= -1 (.find output (str "unknown argument: " bad-flag)))
            (str script " should reject " bad-flag " before analysis: "
                 output))))))

(deftest same-pop-clis-reject-missing-option-values-before-analysis
  (let [dir (tempfile/mkdtemp)
        report-path (os.path/join dir "same_population_report.md")
        manifest-path (os.path/join dir "same_population_manifest.edn")
        cases [["scripts/validate_same_pop_readiness.lpy"
                ["--live-tape" "live.csv"
                 "--replay-tape" "replay.csv"
                 "--live-episodes" "live_episodes.csv"
                 "--replay-episodes" "replay_episodes.csv"
                 "--calibration" "calibration.edn"
                 "--bucket-seconds" "--out"]
                "missing value for --bucket-seconds"]
               ["scripts/run_same_pop_stats.lpy"
                ["--live-tape" "live.csv"
                 "--replay-tape" "replay.csv"
                 "--live-episodes" "live_episodes.csv"
                 "--replay-episodes" "replay_episodes.csv"
                 "--calibration" "calibration.edn"
                 "--out" "--bootstrap-reps"]
                "missing value for --out"]
               ["scripts/run_same_pop_stats.lpy"
                ["--live-tape" "live.csv"
                 "--replay-tape" "replay.csv"
                 "--live-episodes" "live_episodes.csv"
                 "--replay-episodes" "replay_episodes.csv"
                 "--calibration" "calibration.edn"
                 "--out" report-path
                 "--manifest-out"]
                "missing value for --manifest-out"]
               ["scripts/verify_same_pop_manifest.lpy"
                ["--manifest" "--out"]
                "missing value for --manifest"]
               ["scripts/verify_same_pop_manifest.lpy"
                ["--manifest" manifest-path
                 "--out"]
                "missing value for --out"]]]
    (doseq [[script args expected] cases]
      (let [result (subprocess/run
                    (python/list
                     (concat [".venv/bin/basilisp" "run" script "--"] args))
                    ** :capture_output true
                       :text true
                       :check false)
            output (str (.-stderr result) (.-stdout result))]
        (is (= 2 (.-returncode result))
            (str script " should exit 2 for " expected ": " output))
        (is (not= -1 (.find output expected))
            (str script " should report " expected ": " output))))))

(deftest run-same-pop-stats-cli-writes-verifiable-report-manifest
  (let [dir (tempfile/mkdtemp)
        paths (write-provenance-readiness-artifacts!
               dir (repeat 40 1.0) (repeat 40 1.0))
        report-path (os.path/join dir "same_population_report.md")
        manifest-path (os.path/join dir "same_population_manifest.edn")
        cmd [".venv/bin/basilisp" "run" "scripts/run_same_pop_stats.lpy" "--"
             "--live-tape" (:live-tape paths)
             "--replay-tape" (:replay-tape paths)
             "--live-episodes" (:live-episodes paths)
             "--replay-episodes" (:replay-episodes paths)
             "--calibration" (:calibration paths)
             "--out" report-path
             "--manifest-out" manifest-path
             "--bootstrap-reps" "50"
             "--permutation-reps" "50"
             "--min-samples" "30"]
        result (subprocess/run (python/list cmd)
                               ** :capture_output true
                                  :text true
                                  :check false)
        manifest (edn/read-string (slurp manifest-path))
        verify-ok (subprocess/run
                   (python/list
                    [".venv/bin/basilisp" "run"
                     "scripts/verify_same_pop_manifest.lpy" "--"
                     "--manifest" manifest-path])
                   ** :capture_output true
                      :text true
                      :check false)]
    (is (= 0 (.-returncode result)))
    (is (= (os.path/abspath report-path)
           (get-in manifest [:artifacts :report :path])))
    (is (not (contains? (:artifacts manifest) :report-out)))
    (is (= 0 (.-returncode verify-ok)))
    (os/remove (str (:live-tape paths) ".manifest.edn"))
    (let [verify-missing-sidecar
          (subprocess/run
           (python/list
            [".venv/bin/basilisp" "run"
             "scripts/verify_same_pop_manifest.lpy" "--"
             "--manifest" manifest-path])
           ** :capture_output true
              :text true
              :check false)]
      (is (= 1 (.-returncode verify-missing-sidecar)))
      (is (not= -1 (.find (.-stdout verify-missing-sidecar)
                          ":same-pop/missing-provenance-sidecar"))))
    (spit report-path (str (slurp report-path) "\nmutated\n"))
    (let [verify-mutated
          (subprocess/run
           (python/list
            [".venv/bin/basilisp" "run"
             "scripts/verify_same_pop_manifest.lpy" "--"
             "--manifest" manifest-path])
           ** :capture_output true
              :text true
              :check false)]
      (is (= 1 (.-returncode verify-mutated)))
      (is (not= -1 (.find (.-stdout verify-mutated)
                          ":manifest/checksum-mismatch")))
      (is (not= -1 (.find (.-stdout verify-mutated)
                          ":report"))))))

(deftest same-pop-clis-run-from-non-repo-cwd-with-real-artifacts
  (let [dir (tempfile/mkdtemp)
        cwd (tempfile/mkdtemp)
        repo-root (os.path/abspath ".")
        basilisp-bin (os.path/abspath ".venv/bin/basilisp")
        paths (write-provenance-readiness-artifacts!
               dir (repeat 40 1.0) (repeat 40 1.0))
        readiness-path (os.path/join dir "same_population_readiness.edn")
        report-path (os.path/join dir "same_population_report.md")
        manifest-path (os.path/join dir "same_population_manifest.edn")
        env (os.environ/copy)]
    (.update env (python/dict {"STEVE_REPO_ROOT" repo-root}))
    (let [readiness-result
          (subprocess/run
           (python/list
            [basilisp-bin "run"
             (os.path/join repo-root "scripts/validate_same_pop_readiness.lpy")
             "--"
             "--live-tape" (:live-tape paths)
             "--replay-tape" (:replay-tape paths)
             "--live-episodes" (:live-episodes paths)
             "--replay-episodes" (:replay-episodes paths)
             "--calibration" (:calibration paths)
             "--out" readiness-path])
           ** :capture_output true
              :text true
              :check false
              :cwd cwd
              :env env)
          stats-result
          (subprocess/run
           (python/list
            [basilisp-bin "run"
             (os.path/join repo-root "scripts/run_same_pop_stats.lpy")
             "--"
             "--live-tape" (:live-tape paths)
             "--replay-tape" (:replay-tape paths)
             "--live-episodes" (:live-episodes paths)
             "--replay-episodes" (:replay-episodes paths)
             "--calibration" (:calibration paths)
             "--out" report-path
             "--manifest-out" manifest-path
             "--bootstrap-reps" "50"
             "--permutation-reps" "50"
             "--min-samples" "30"])
           ** :capture_output true
              :text true
              :check false
              :cwd cwd
              :env env)
          verify-result
          (subprocess/run
           (python/list
            [basilisp-bin "run"
             (os.path/join repo-root "scripts/verify_same_pop_manifest.lpy")
             "--"
             "--manifest" manifest-path])
           ** :capture_output true
              :text true
              :check false
              :cwd cwd
              :env env)
          manifest (edn/read-string (slurp manifest-path))]
      (is (= 0 (.-returncode readiness-result))
          (str (.-stdout readiness-result) (.-stderr readiness-result)))
      (is (= 0 (.-returncode stats-result))
          (str (.-stdout stats-result) (.-stderr stats-result)))
      (is (= 0 (.-returncode verify-result))
          (str (.-stdout verify-result) (.-stderr verify-result)))
      (is (os.path/exists readiness-path))
      (is (os.path/exists report-path))
      (is (os.path/exists manifest-path))
      (is (not= "unknown" (:code/revision manifest)))
      (is (= (os.path/abspath report-path)
             (get-in manifest [:artifacts :report :path]))))))

(deftest same-population-statistics-fails-material-underperformance
