    (is (not= -1 (.find valid-report "## Manifest")))
    (is (not= -1 (.find valid-report "code_revision")))
    (is (not= -1 (.find valid-report "sha256=")))
    (is (not= -1 (.find valid-report "## Tests")))
    (is (not= -1 (.find missing-report "## Gate Failure")))))

(deftest same-pop-manifest-schema-catches-parameter-drift
  (let [dir (tempfile/mkdtemp)
        paths (write-readiness-artifacts! dir {})
        result (analysis/same-population-statistics
                (assoc paths
                       :bootstrap-reps 50
                       :permutation-reps 60
                       :min-samples 7
                       :practical-mean-threshold 1.25))
        manifest (:manifest result)
        bad-reps (assoc-in manifest [:parameters :bootstrap-reps] 0)
        bad-threshold (assoc-in manifest
                                [:parameters :practical-mean-threshold]
                                -0.01)]
    (is (= 50 (get-in manifest [:parameters :bootstrap-reps])))
    (is (= 60 (get-in manifest [:parameters :permutation-reps])))
    (is (= 7 (get-in manifest [:parameters :min-samples])))
    (is (= 1.25 (get-in manifest [:parameters :practical-mean-threshold])))
    (is (= :same-population/performance-v1 (:manifest/kind manifest)))
    (is (thrown? python/Exception
                 (analysis/validate-artifact!
                  :analysis/same-pop-manifest bad-reps)))
    (is (thrown? python/Exception
                 (analysis/validate-artifact!
                  :analysis/same-pop-manifest bad-threshold)))))

(deftest same-pop-manifest-checksums-detect-overwritten-artifacts
  (let [dir (tempfile/mkdtemp)
        paths (write-readiness-artifacts! dir {})
        result-a (analysis/same-population-statistics
                  (assoc paths :bootstrap-reps 10 :permutation-reps 10))
        digest-a (get-in result-a
                         [:manifest :artifacts :live-episodes :sha256])
        _ (spit (:live-episodes paths)
                (str (slurp (:live-episodes paths)) "\n"))
        result-b (analysis/same-population-statistics
                  (assoc paths :bootstrap-reps 10 :permutation-reps 10))
        digest-b (get-in result-b
                         [:manifest :artifacts :live-episodes :sha256])]
    (is (not= digest-a digest-b))
    (is (= (os.path/abspath (:live-episodes paths))
           (get-in result-b
                   [:manifest :artifacts :live-episodes :path])))))

