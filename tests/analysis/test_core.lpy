(deftest same-pop-manifest-verifier-rejects-symlink-escape
  (let [dir (tempfile/mkdtemp)
        outside (tempfile/mkdtemp)
        paths (write-provenance-readiness-artifacts!
               dir (repeat 40 1.0) (repeat 40 1.0))
        result (analysis/same-population-statistics
                (assoc paths :bootstrap-reps 10 :permutation-reps 10))
        original-live-tape (:live-tape paths)
        external-live-tape (os.path/join outside "live_tape.csv")]
    (spit external-live-tape (slurp original-live-tape))
    (os/remove original-live-tape)
    (os/symlink external-live-tape original-live-tape)
    (let [manifest (assoc-in (:manifest result)
                             [:artifacts :live-tape :sha256]
                             (analysis/artifact-sha256 original-live-tape))
          verification (analysis/verify-same-pop-manifest manifest)
          codes (set (map :code (:issues verification)))]
      (is (false? (:valid? verification)))
      (is (= :manifest/failed (:status verification)))
      (is (contains? codes :manifest/artifact-path-outside-bundle)))))

(deftest deterministic-fuzz-same-pop-manifest-rejects-duplicate-artifact-roles
  (let [dir (tempfile/mkdtemp)
        paths (write-provenance-readiness-artifacts!
               dir (repeat 40 1.0) (repeat 40 1.0))
        result (analysis/same-population-statistics
                (assoc paths :bootstrap-reps 10 :permutation-reps 10))
        manifest (:manifest result)
        artifact-keys [:live-tape :replay-tape :live-episodes
                       :replay-episodes :calibration]]
    (doseq [source-key artifact-keys
            target-key artifact-keys
            :when (not= source-key target-key)]
      (let [forged (assoc-in manifest
                             [:artifacts target-key]
                             (get-in manifest [:artifacts source-key]))
            verification (analysis/verify-same-pop-manifest forged)
            duplicate-issues (filter #(= :manifest/duplicate-artifact-path
                                         (:code %))
                                     (:issues verification))]
        (is (false? (:valid? verification))
            (str "duplicate role should fail: " source-key " -> " target-key))
        (is (= :manifest/failed (:status verification)))
        (is (seq duplicate-issues)
            (str "duplicate issue should be present for "
                 source-key " -> " target-key))
        (is (some #(= (set [source-key target-key])
                      (set (get-in % [:details :artifacts])))
                  duplicate-issues))))))

