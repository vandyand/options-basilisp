    (let [result (analysis/same-pop-readiness paths)]
      (is (= :same-pop/blocked-data (:status result)))
      (is (some #(= :same-pop/provenance-artifact-checksum-mismatch
                    (:code %))
                (:issues result))))))

(deftest same-pop-readiness-blocks-noncanonical-csv-columns
  (let [dir (tempfile/mkdtemp)
        paths (write-readiness-artifacts! dir {})
        lines (.splitlines (slurp (:live-tape paths)))
        mutated-header (str (first lines) ",unexpected-extra-column")
        mutated (bstr/join "\n" (cons mutated-header (rest lines)))]
    (spit (:live-tape paths) (str mutated "\n"))
    (let [result (analysis/same-pop-readiness paths)]
      (is (= :same-pop/blocked-data (:status result)))
      (is (some #(and (= :same-pop/invalid-artifact-columns (:code %))
                      (= :analysis/tape-row
                         (get-in % [:details :artifact/kind])))
                (:issues result))))))

(deftest same-pop-readiness-blocks-provenance-column-forgery
  (let [dir (tempfile/mkdtemp)
        paths (exported-provenance-artifacts! dir)
        sidecar-path (str (:live-episodes paths) ".manifest.edn")
        sidecar (edn/read-string (slurp sidecar-path))
        forged (assoc sidecar
                      :artifact/columns
                      (conj (:artifact/columns sidecar)
                            "unexpected-extra-column"))]
    (spit sidecar-path (str (edn/write-string forged) "\n"))
    (let [result (analysis/same-pop-readiness paths)]
      (is (= :same-pop/blocked-data (:status result)))
      (is (some #(and (= :same-pop/provenance-column-mismatch (:code %))
                      (= (mapv name analysis/episode-columns)
                         (get-in % [:details :expected])))
                (:issues result))))))

(deftest same-pop-readiness-blocks-provenance-extra-key-forgery
  (let [dir (tempfile/mkdtemp)
        paths (exported-provenance-artifacts! dir)
        sidecar-path (str (:live-tape paths) ".manifest.edn")
        sidecar (edn/read-string (slurp sidecar-path))
        top-level-forgery (assoc sidecar
                                 :legacy/validation-status
                                 :looks-valid)
        source-forgery (assoc-in sidecar
                                 [:source/facts-db :legacy/row-count]
                                 999)]
    (doseq [[forged code field] [[top-level-forgery
                                  :same-pop/provenance-sidecar-extra-keys
                                  :legacy/validation-status]
                                 [source-forgery
                                  :same-pop/provenance-source-fingerprint-extra-keys
                                  :legacy/row-count]]]
      (spit sidecar-path (str (edn/write-string forged) "\n"))
      (let [result (analysis/same-pop-readiness paths)]
        (is (= :same-pop/blocked-data (:status result)))
        (is (some #(and (= code (:code %))
                        (= [field] (get-in % [:details :fields])))
                  (:issues result)))))))

(deftest deterministic-fuzz-provenance-sidecar-extra-key-mutations-fail
  (let [dir (tempfile/mkdtemp)
        paths (exported-provenance-artifacts! dir)
        artifacts [(:live-tape paths)
                   (:replay-tape paths)
                   (:live-episodes paths)
                   (:replay-episodes paths)]
        cases [[:top-level [:legacy/fuzz-marker]
                :same-pop/provenance-sidecar-extra-keys]
               [:source-fingerprint [:source/facts-db :legacy/fuzz-marker]
                :same-pop/provenance-source-fingerprint-extra-keys]]]
    (doseq [artifact-path artifacts
            [label mutation-path expected-code] cases]
      (let [sidecar-path (str artifact-path ".manifest.edn")
            original (edn/read-string (slurp sidecar-path))
            forged (assoc-in original mutation-path
                             (str "forged-" (name label)))
            field (last mutation-path)]
        (spit sidecar-path (str (edn/write-string forged) "\n"))
        (let [result (analysis/same-pop-readiness paths)]
          (is (= :same-pop/blocked-data (:status result)))
          (is (some #(and (= expected-code (:code %))
                          (= [field] (get-in % [:details :fields])))
                    (:issues result))))
        (spit sidecar-path (str (edn/write-string original) "\n"))))))

(deftest same-pop-readiness-blocks-source-facts-db-mutated-after-export
  (let [dir (tempfile/mkdtemp)
        paths (exported-provenance-artifacts! dir)
        conn (sqlite3/connect (:facts-db paths))]
    (.execute conn
              "UPDATE facts SET record = record || ' ' WHERE \"offset\" = 1")
    (.commit conn)
    (.close conn)
    (let [result (analysis/same-pop-readiness paths)]
      (is (= :same-pop/blocked-data (:status result)))
      (is (some #(= :same-pop/provenance-source-checksum-mismatch
                    (:code %))
                (:issues result))))))

