                          :replay-episodes (synthetic-episodes [1.0 2.0 3.0])})
        valid-result (analysis/same-population-statistics
                      (assoc valid-paths
                             :bootstrap-reps 10
                             :permutation-reps 10))
        valid-report (analysis/same-population-report-md valid-result)
        missing-result (analysis/same-population-statistics
                        (assoc valid-paths
                               :calibration
                               (os.path/join dir "missing.edn")))
        missing-report (analysis/same-population-report-md missing-result)]
