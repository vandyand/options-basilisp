    (is (some #(= :same-pop/missing-artifact (:code %))
              (:issues missing-result)))
    (spit bad-calibration-path "{:calibration/version 1")
    (let [bad-result (analysis/same-pop-readiness paths)]
      (is (= :same-pop/blocked-data (:status bad-result)))
      (is (some #(= :same-pop/unreadable-artifact (:code %))
                (:issues bad-result))))))

