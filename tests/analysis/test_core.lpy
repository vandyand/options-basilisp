(defn raw-row
  [offset fact]
  (let [pl (:fact/payload fact)]
    {:offset offset
     :fact-type (str (:record/type fact))
     :account-id (:record/account-id fact)
     :strategy-id (:record/strategy-id fact)
     :instrument-id (:record/instrument-id fact)
     :order-intent-id (:order-intent/id pl)
     :broker-order-id (:broker/order-id pl)
     :occurred-at (:fact/occurred-at fact)
     :correlation-id (:record/correlation-id fact)
     :record (edn/write-string fact)}))

(deftest live-tape-normalizes-core-events
  (let [rows (analysis/live-tape-rows [signal-fact intent-fact fill-fact])]
    (is (= 3 (count rows)))
    (is (= {:valid? true :rows 3}
           (analysis/validate-artifact-rows! :analysis/tape-row rows)))
    (testing "signal posture is explicit"
      (is (= :posture/enter-short (:posture (first rows)))))
    (testing "intent row carries target option leg"
      (let [row (second rows)]
        (is (= "intent" (:event-type row)))
        (is (= "oi-1" (:order-intent-id row)))
        (is (= "option/OPRA/SPY/2026-06-25/P/735.000"
               (:instrument-id row)))))
    (testing "fill row carries broker fill economics"
      (let [row (nth rows 2)]
        (is (= "fill" (:event-type row)))
        (is (= "2.29" (:fill-price row)))
        (is (= "bo-1" (:broker-order-id row)))))))

(deftest live-tape-preserves-rejected-orders
  (let [rows (analysis/live-tape-rows [intent-fact reject-fact])
        reject-row (second rows)]
    (is (= 2 (count rows)))
    (is (= "broker_reject" (:event-type reject-row)))
    (is (= "oi-2" (:order-intent-id reject-row)))
    (is (= :broker-status/rejected (:broker-status reject-row)))
    (is (= [:broker-rejection/insufficient-buying-power
            "insufficient buying power"]
           (:reason-codes reject-row)))))

(deftest episodes-preserve-completed-and-incomplete-trades
  (let [unfilled-intent (assoc-in intent-fact
                                  [:fact/payload :order-intent/id]
                                  "oi-unfilled")
        rows (map-indexed (fn [idx fact] (raw-row (inc idx) fact))
                          [intent-fact fill-fact lot-open-fact lot-close-fact
                           unfilled-intent])
        episodes (analysis/episode-rows-fast rows)
        by-id (group-by :order-intent-id episodes)
        completed (first (get by-id "oi-1"))
        incomplete (first (get by-id "oi-unfilled"))]
    (is (= 2 (count episodes)))
    (is (= {:valid? true :rows 2}
           (analysis/validate-artifact-rows! :analysis/episode-row episodes)))
    (testing "completed lot episode carries realized economics"
      (is (= "lot-1" (:lot-id completed)))
      (is (= "2.29" (:entry-price completed)))
      (is (= "2.40" (:exit-price completed)))
      (is (= "11.00" (:gross-pnl completed)))
      (is (= 30.0 (:holding-minutes completed))))
    (testing "entry intent without a fill remains visible"
      (is (= [:episode/missing-fill] (:data-quality-flags incomplete)))
      (is (= :exit/missing-fill (:exit-reason incomplete))))))

(deftest behavior-alignment-reports-precision-recall-and-mismatches
  (let [live (analysis/live-tape-rows [signal-fact intent-fact fill-fact])
        replay (analysis/live-tape-rows
                [signal-fact
                 intent-fact
                 (assoc-in fill-fact
                           [:fact/payload :fill/instrument-id]
                           "option/OPRA/SPY/2026-06-25/P/730.000")])
        alignment (analysis/behavior-alignment
                   {:live-rows live
                    :replay-rows replay
                    :bucket-seconds 60})
        by-event (into {} (map (fn [m] [(:event-type m) m])
                               (:metrics alignment)))]
    (is (= :alignment/review-mismatches (:status alignment)))
    (is (= 1 (:mismatch-count alignment)))
    (testing "signals and intents align exactly"
      (is (= 1 (:precision (get by-event "signal"))))
      (is (= 1 (:recall (get by-event "intent")))))
    (testing "fill instrument mismatch is visible on both sides"
      (is (= 1 (:matched-count (get by-event "fill"))))
      (is (= 1 (:instrument-mismatches (get by-event "fill"))))
      (is (= #{"field-mismatch"}
             (set (map :side (:mismatches alignment))))))))

(deftest behavior-alignment-invalidates-mismatched-cohorts
  (let [live (analysis/live-tape-rows [signal-fact intent-fact fill-fact])
        replay (analysis/live-tape-rows
                [(assoc signal-fact
                        :record/account-id "account/sim/vol-term"
                        :record/strategy-id "strategy/sim-term/calendar-slope/v1")
                 (assoc intent-fact
                        :record/account-id "account/sim/vol-term"
                        :record/strategy-id "strategy/sim-term/calendar-slope/v1")])
        alignment (analysis/behavior-alignment
                   {:live-rows live
                    :replay-rows replay
                    :bucket-seconds 60})
        cohort (:cohort alignment)
        checks (into {} (map (fn [row] [(:check row) row])
                             (:checks cohort)))]
    (is (= :alignment/invalid-cohort (:status alignment)))
    (is (= :cohort/fail (:status cohort)))
    (is (= :fail (:status (get checks :cohort/strategy-set))))
    (is (= :fail (:status (get checks :cohort/account-set))))
    (is (= :fail (:status (get checks :cohort/account-strategy-set))))))

(deftest behavior-alignment-invalidates-identity-incomplete-alignable-rows
  (let [live (analysis/live-tape-rows [signal-fact intent-fact fill-fact])
        replay (analysis/live-tape-rows [signal-fact intent-fact fill-fact])
        bad-replay (mapv #(if (= "fill" (:event-type %))
                            (assoc % :strategy-id nil)
                            %)
                         replay)
        alignment (analysis/behavior-alignment
                   {:live-rows live
                    :replay-rows bad-replay
                    :bucket-seconds 60})
        checks (into {} (map (fn [row] [(:check row) row])
                             (get-in alignment [:cohort :checks])))]
    (is (= :alignment/invalid-cohort (:status alignment)))
    (is (= :fail (:status (get checks :cohort/identity-complete))))
    (is (= 1 (get-in checks
                     [:cohort/identity-complete
                      :details
                      :replay-missing-identity])))))

(deftest behavior-alignment-invalidates-event-count-drift
  (let [live (analysis/live-tape-rows [signal-fact intent-fact fill-fact])
        replay (analysis/live-tape-rows [signal-fact intent-fact])
        alignment (analysis/behavior-alignment
                   {:live-rows live
                    :replay-rows replay
                    :bucket-seconds 60})
        checks (into {} (map (fn [row] [(:check row) row])
                             (get-in alignment [:cohort :checks])))]
    (is (= :alignment/invalid-cohort (:status alignment)))
    (is (= :fail (:status (get checks :cohort/event-counts))))
    (is (= {"fill" 1 "intent" 1 "signal" 1}
           (get-in checks [:cohort/event-counts :details :live])))
    (is (= {"intent" 1 "signal" 1}
           (get-in checks [:cohort/event-counts :details :replay])))))

(deftest behavior-alignment-rejects-invalid-bucket-parameters
  (let [rows (analysis/live-tape-rows [signal-fact intent-fact fill-fact])]
    (doseq [bucket [0 -1 1.5 true false "60" nil]]
      (try
        (analysis/behavior-alignment
         {:live-rows rows
          :replay-rows rows
          :bucket-seconds bucket})
        (is false (str "expected invalid bucket to fail: " (pr-str bucket)))
        (catch python/ValueError e
          (is (not= -1 (.find (str e) "bucket-seconds must be a positive integer"))
              (str bucket " -> " e)))))))

(deftest analysis-schemas-reject-malformed-artifact-rows
  (testing "tape rows require a known event type and timestamp"
    (let [bad (assoc (first (analysis/live-tape-rows [signal-fact]))
                     :event-type "profit"
                     :occurred-at "")]
      (is (false? (:valid? (analysis-schema/validation-result
                            :analysis/tape-row bad))))))
  (testing "episode rows require the canonical identity and forced-flatten flag"
    (let [episode (first (analysis/episode-rows-fast
                          (map-indexed (fn [idx fact] (raw-row (inc idx) fact))
                                       [intent-fact fill-fact lot-open-fact
                                        lot-close-fact])))
          bad (dissoc episode :episode-id)]
      (is (false? (:valid? (analysis-schema/validation-result
                            :analysis/episode-row bad)))))))

(defn- shifted-fact
  [fact idx]
  (let [ts (format "2026-06-25T14:%02d:00Z" (+ 10 idx))
        suffix (str "-" idx)]
    (-> fact
        (assoc :fact/occurred-at ts)
        (update :record/correlation-id #(when % (str % suffix)))
        (update :record/id #(str % suffix))
        (update-in [:fact/payload :decision/id] #(when % (str % suffix)))
        (update-in [:fact/payload :order-intent/id] #(when % (str % suffix)))
        (update-in [:fact/payload :order-intent/decision-id]
                   #(when % (str % suffix)))
        (update-in [:fact/payload :broker/order-id] #(when % (str % suffix)))
        (update-in [:fact/payload :fill/id] #(when % (str % suffix))))))

(defn- fuzz-session-facts
  [n]
  (vec
   (mapcat
    (fn [idx]
      [(shifted-fact signal-fact idx)
       (shifted-fact intent-fact idx)
       (shifted-fact fill-fact idx)])
    (range n))))

(defn- valid-calibration-artifact
  []
  (let [rows [{:side :order-side/buy :spread 0.01 :improvement 0.02
               :lag-seconds 1.0}
              {:side :order-side/buy :spread 0.01 :improvement 0.01
               :lag-seconds 2.0}
              {:side :order-side/sell :spread 0.05 :improvement 0.00
               :lag-seconds 1.5}]
        global (analysis/summarize-calibration-rows rows)]
    {:calibration/version 1
     :calibration/kind :sim-fill/alpaca-paper-empirical-bayes-v1
     :calibration/generated-at "2026-06-25T20:00:00+00:00"
     :source/facts-dbs ["facts.db"]
     :source/facts-fingerprints [{:path "facts.db" :sha256 (apply str (repeat 64 "0"))}]
     :matching/max-lag-seconds 90.0
     :estimator/prior-strength 30.0
     :input/option-fills 3
     :input/matched-fills 3
     :global global
     :buckets (analysis/bucket-summaries rows global 30.0)}))

(defn- completed-episode-rows
  []
  (analysis/episode-rows-fast
   (map-indexed (fn [idx fact] (raw-row (inc idx) fact))
                [intent-fact fill-fact lot-open-fact lot-close-fact])))

(defn- write-readiness-artifacts!
  [dir {:keys [replay-rows calibration-artifact live-episodes replay-episodes]
        :or {replay-rows nil calibration-artifact nil
             live-episodes nil replay-episodes nil}}]
  (let [live-path (os.path/join dir "live_tape.csv")
        replay-path (os.path/join dir "replay_tape.csv")
        live-episodes-path (os.path/join dir "live_episodes.csv")
        replay-episodes-path (os.path/join dir "replay_episodes.csv")
        calibration-path (os.path/join dir "calibration.edn")
        live-rows (analysis/live-tape-rows [signal-fact intent-fact fill-fact])
        replay-rows (or replay-rows live-rows)
        episodes (completed-episode-rows)
        live-episodes (or live-episodes episodes)
        replay-episodes (or replay-episodes episodes)
        calibration-artifact (or calibration-artifact
                                 (valid-calibration-artifact))]
    (analysis/write-csv! live-path analysis/live-tape-columns live-rows)
    (analysis/write-csv! replay-path analysis/live-tape-columns replay-rows)
    (analysis/write-csv! live-episodes-path analysis/episode-columns live-episodes)
    (analysis/write-csv! replay-episodes-path analysis/episode-columns replay-episodes)
    (spit calibration-path (edn/write-string calibration-artifact))
    {:live-tape live-path
     :replay-tape replay-path
     :live-episodes live-episodes-path
     :replay-episodes replay-episodes-path
     :calibration calibration-path
     :require-provenance? false}))

(defn- write-facts-db!
  [path facts]
  (let [conn (sqlite3/connect path)]
    (.execute conn
              (str "CREATE TABLE facts ("
                   "\"offset\" INTEGER PRIMARY KEY, "
                   "fact_type TEXT, account_id TEXT, strategy_id TEXT, "
                   "instrument_id TEXT, order_intent_id TEXT, "
                   "broker_order_id TEXT, occurred_at TEXT, "
                   "correlation_id TEXT, record TEXT)"))
    (doseq [[idx fact] (map-indexed vector facts)]
      (let [pl (:fact/payload fact)]
        (.execute conn
                  (str "INSERT INTO facts "
                       "(\"offset\", fact_type, account_id, strategy_id, "
                       "instrument_id, order_intent_id, broker_order_id, "
                       "occurred_at, correlation_id, record) "
                       "VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)")
                  (python/tuple
                   [(inc idx)
                    (str (:record/type fact))
                    (:record/account-id fact)
                    (:record/strategy-id fact)
                    (or (:record/instrument-id fact)
                        (:fill/instrument-id pl)
                        (:lot/instrument-id pl))
                    (:order-intent/id pl)
                    (:broker/order-id pl)
                    (:fact/occurred-at fact)
                    (:record/correlation-id fact)
                    (edn/write-string fact)]))))
    (.commit conn)
    (.close conn)
    path))

(defn- exported-provenance-artifacts!
  [dir]
  (let [facts-db (os.path/join dir "facts.db")
        live-tape (os.path/join dir "live_tape.csv")
        replay-tape (os.path/join dir "replay_tape.csv")
        live-episodes (os.path/join dir "live_episodes.csv")
        replay-episodes (os.path/join dir "replay_episodes.csv")
        calibration (os.path/join dir "calibration.edn")]
    (write-facts-db! facts-db
                     [signal-fact intent-fact fill-fact
                      quote-fact lot-open-fact lot-close-fact])
    (analysis/write-live-tape! {:facts-db facts-db :out live-tape})
    (analysis/write-replay-tape! {:facts-db facts-db :out replay-tape})
    (analysis/write-episodes! {:facts-db facts-db :out live-episodes})
    (analysis/write-episodes! {:facts-db facts-db :out replay-episodes})
    (analysis/write-calibration! {:facts-dbs [facts-db]
                                  :out calibration
                                  :max-lag-seconds 90.0
                                  :prior-strength 30.0})
    {:facts-db facts-db
     :live-tape live-tape
     :replay-tape replay-tape
     :live-episodes live-episodes
     :replay-episodes replay-episodes
     :calibration calibration}))

(deftest deterministic-fuzz-alignment-remains-exact-under-identical-tapes
  (doseq [n [1 2 3 5 8 13 21 34]]
    (let [rows (analysis/live-tape-rows (fuzz-session-facts n))
          alignment (analysis/behavior-alignment
                     {:live-rows rows
                      :replay-rows rows
                      :bucket-seconds 60})]
      (is (= :alignment/pass-exact (:status alignment)) (str "n=" n))
      (is (= 0 (:mismatch-count alignment)) (str "n=" n))
      (is (= (* 3 n) (get-in alignment
                             [:cohort :live :alignable-rows]))
          (str "n=" n)))))

(deftest deterministic-fuzz-alignment-detects-one-sided-losses
  (doseq [n [2 5 13 34]]
    (let [rows (analysis/live-tape-rows (fuzz-session-facts n))
          replay (vec (butlast rows))
          alignment (analysis/behavior-alignment
                     {:live-rows rows
                      :replay-rows replay
                      :bucket-seconds 60})]
      (is (= :alignment/invalid-cohort (:status alignment)) (str "n=" n))
      (is (= :cohort/fail (get-in alignment [:cohort :status]))
          (str "n=" n)))))

(deftest behavior-alignment-writes-report-and-mismatch-csv
  (let [dir (tempfile/mkdtemp)
        live-path (os.path/join dir "live_tape.csv")
        replay-path (os.path/join dir "replay_tape.csv")
        report-path (os.path/join dir "alignment_report.md")
        mismatch-path (os.path/join dir "mismatches.csv")
        live (analysis/live-tape-rows [signal-fact intent-fact fill-fact])
        replay (analysis/live-tape-rows
                [signal-fact
                 intent-fact
                 (assoc-in fill-fact
                           [:fact/payload :fill/instrument-id]
                           "option/OPRA/SPY/2026-06-25/P/730.000")])
        _ (analysis/write-csv! live-path analysis/live-tape-columns live)
        _ (analysis/write-csv! replay-path analysis/live-tape-columns replay)
        summary (analysis/write-behavior-alignment!
                 {:live-tape live-path
                  :replay-tape replay-path
                  :out report-path
                  :mismatches-out mismatch-path
                  :bucket-seconds 60})]
    (is (= :alignment/review-mismatches
           (get-in summary [:alignment :status])))
    (is (= 1 (get-in summary [:alignment :mismatch-count])))
    (is (os.path/exists report-path))
    (is (os.path/exists mismatch-path))
    (is (.startswith (slurp report-path) "# Behavior Alignment Report"))))

(deftest calibration-matches-fill-to-nearest-quote
  (let [rows (analysis/matched-fill-rows [intent-fact fill-fact quote-fact] 90.0)
        row (first rows)]
    (is (= 1 (count rows)))
    (is (= :order-side/buy (:side row)))
    (is (= 2.30 (:ask row)))
    (is (= 2.29 (:price row)))
    (is (< (abs (- 0.01 (:improvement row))) 1e-9))
    (is (< (abs (- (/ 1.0 3.0) (:improvement-frac row))) 1e-9))))

(deftest calibration-artifact-shrinks-sparse-buckets
  (let [rows [{:side :order-side/buy :spread 0.01 :improvement 0.02
               :lag-seconds 1.0}
              {:side :order-side/buy :spread 0.01 :improvement 0.01
               :lag-seconds 1.0}
              {:side :order-side/sell :spread 0.05 :improvement -0.01
               :lag-seconds 1.0}]
        global (analysis/summarize-calibration-rows rows)
        buckets (analysis/bucket-summaries rows global 30.0)]
    (is (= 3 (:n global)))
    (is (= 2 (count buckets)))
    (is (every? #(contains? % :shrunk-conservative-price-improvement)
                buckets))
    (is (every? #(>= (:shrunk-conservative-price-improvement %) 0.0)
                buckets))))

(deftest calibration-artifact-schema-catches-bad-artifacts
  (let [valid (valid-calibration-artifact)
        bad (assoc valid :input/matched-fills -1)]
    (is (= {:valid? true}
           (analysis/validate-artifact! :analysis/calibration-artifact valid)))
    (is (thrown? python/Exception
                 (analysis/validate-artifact!
                  :analysis/calibration-artifact bad)))))

(deftest same-pop-readiness-passes-valid-artifacts
  (let [dir (tempfile/mkdtemp)
        paths (write-readiness-artifacts! dir {})
        result (analysis/same-pop-readiness paths)]
    (is (true? (:valid? result)))
    (is (= :same-pop/ready-for-stat-tests (:status result)))
    (is (empty? (filter #(= :error (:severity %)) (:issues result))))
    (is (= :alignment/pass-exact (get-in result [:alignment :status])))
    (is (= 3 (get-in result [:artifact-counts :live-tape])))
    (is (= 1 (get-in result [:artifact-counts :live-episodes])))))

(deftest exported-artifact-provenance-passes-readiness
  (let [dir (tempfile/mkdtemp)
        paths (exported-provenance-artifacts! dir)
        result (analysis/same-pop-readiness paths)]
    (is (true? (:valid? result)))
    (is (= :same-pop/ready-for-stat-tests (:status result)))
    (is (os.path/exists (str (:live-tape paths) ".manifest.edn")))
    (is (os.path/exists (str (:live-episodes paths) ".manifest.edn")))))

(deftest same-pop-readiness-blocks-missing-provenance-sidecar
