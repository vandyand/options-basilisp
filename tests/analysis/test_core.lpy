(defn- synthetic-episodes
  [pnls]
  (mapv (fn [idx pnl]
          (let [base (first (completed-episode-rows))]
            (assoc base
                   :episode-id (str "episode/synthetic/" idx)
                   :lot-id (str "lot-" idx)
                   :order-intent-id (str "oi-" idx)
                   :gross-pnl (format "%.2f" (float pnl))
                   :net-pnl (format "%.2f" (float pnl)))))
        (range)
        pnls))

(defn- write-csv-with-sidecar!
  [path columns rows facts-db artifact-kind]
  (analysis/write-csv! path columns rows)
  (analysis/write-artifact-sidecar!
   {:artifact-kind artifact-kind
    :path path
    :facts-db facts-db
    :row-count (count rows)
    :columns columns
    :source-kind :source/test-facts})
  path)

(defn- write-provenance-readiness-artifacts!
  [dir live-pnls replay-pnls]
  (let [facts-db (os.path/join dir "facts.db")
        live-path (os.path/join dir "live_tape.csv")
        replay-path (os.path/join dir "replay_tape.csv")
        live-episodes-path (os.path/join dir "live_episodes.csv")
        replay-episodes-path (os.path/join dir "replay_episodes.csv")
        calibration-path (os.path/join dir "calibration.edn")
        tape-rows (analysis/live-tape-rows [signal-fact intent-fact fill-fact])
        live-episodes (synthetic-episodes live-pnls)
        replay-episodes (synthetic-episodes replay-pnls)]
    (write-facts-db! facts-db
                     [signal-fact intent-fact fill-fact
                      quote-fact lot-open-fact lot-close-fact])
    (write-csv-with-sidecar! live-path analysis/live-tape-columns
                             tape-rows facts-db :analysis/tape-row)
    (write-csv-with-sidecar! replay-path analysis/live-tape-columns
                             tape-rows facts-db :analysis/tape-row)
    (write-csv-with-sidecar! live-episodes-path analysis/episode-columns
                             live-episodes facts-db :analysis/episode-row)
    (write-csv-with-sidecar! replay-episodes-path analysis/episode-columns
                             replay-episodes facts-db :analysis/episode-row)
    (analysis/write-calibration! {:facts-dbs [facts-db]
                                  :out calibration-path
                                  :max-lag-seconds 90.0
                                  :prior-strength 30.0})
    {:live-tape live-path
     :replay-tape replay-path
     :live-episodes live-episodes-path
     :replay-episodes replay-episodes-path
     :calibration calibration-path}))

(deftest same-population-statistics-refuses-when-readiness-fails
  (let [dir (tempfile/mkdtemp)
        live-rows (analysis/live-tape-rows [signal-fact intent-fact fill-fact])
        replay-rows (mapv #(if (= "fill" (:event-type %))
                             (assoc % :instrument-id
                                    "option/OPRA/SPY/2026-06-25/P/730.000")
                             %)
                          live-rows)
        paths (write-readiness-artifacts! dir {:replay-rows replay-rows})
        result (analysis/same-population-statistics paths)]
    (is (false? (:valid? result)))
    (is (= :same-pop/fail-behavior (:status result)))
    (is (nil? (:statistics result)))))

(deftest same-population-statistics-watches-small-valid-samples
  (let [dir (tempfile/mkdtemp)
        paths (write-readiness-artifacts!
               dir {:live-episodes (synthetic-episodes [1.0 2.0 3.0])
                    :replay-episodes (synthetic-episodes [1.0 2.0 3.0])})
        result (analysis/same-population-statistics
                (assoc paths
                       :bootstrap-reps 100
                       :permutation-reps 100
                       :min-samples 30))]
    (is (false? (:valid? result)))
    (is (= :same-pop/watch (:status result)))
    (is (= 3 (get-in result [:statistics :live :n])))
    (is (= 0.0 (get-in result [:statistics :effect-sizes :mean-pnl-delta])))
    (is (= {:valid? true}
           (analysis/validate-artifact! :analysis/same-pop-manifest
                                        (:manifest result))))
    (is (= (os.path/abspath (:live-tape paths))
           (get-in result [:manifest :artifacts :live-tape :path])))
    (is (true? (boolean
                (re/fullmatch
                 #"[0-9a-f]{64}"
                 (get-in result [:manifest :artifacts :live-tape :sha256])))))
    (is (= 100
           (get-in result [:manifest :parameters :bootstrap-reps])))
    (is (= 100
           (get-in result [:manifest :parameters :permutation-reps])))
    (is (= 30
           (get-in result [:manifest :parameters :min-samples])))
    (is (true? (get-in result [:statistics :decision :small-sample?])))))

