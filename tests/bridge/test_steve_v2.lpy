(ns bridge.test-steve-v2
  "bridge.steve-v2 — pure signal logic (consensus vote, hysteresis state
  machine, calibration parsing) + torch-dependent bundle smoke tests.

  The pure parts were verified equivalent to the Python reference by
  scripts/bridge_spike.lpy (81/81 consensus cases vs
  parrot_consensus._consensus_vote; 3090/3090 direction cases vs
  DirectionEnsembleSignal.evaluate, run 2026-06-11) — these tests pin the
  ported behavior so it can't drift.

  Torch-dependent tests SKIP (assert true + println) when torch/the REF
  tree are unavailable — the engine .venv has neither; run the full suite
  with the REF .venv's basilisp to exercise them."
  (:import datetime importlib json math numpy os os.path tempfile types zoneinfo)
  (:require [basilisp.test :refer [deftest is testing]]
            [clojure.string :as str]
            [stevetrading.bridge.steve-v2 :as b]))

(def ref-root "/home/kingjames/contracting/upwork/steven-tran/SteveTrading/ref/Data-Preprocessor")

;; ────────────────────────────────────────────────────────────────────────────
;; consensus-vote — 2-of-3 state machine (parrot_consensus._consensus_vote)
;; ────────────────────────────────────────────────────────────────────────────

(deftest consensus-vote-table
  (testing "FLAT entries"
    (is (= :long (b/consensus-vote [:long :long :flat] :flat)))
    (is (= :long (b/consensus-vote [:long :long :long] :flat)))
    (is (= :long (b/consensus-vote [:long :long :short] :flat)))
    (is (= :short (b/consensus-vote [:short :short :flat] :flat)))
    (is (= :short (b/consensus-vote [:short :short :long] :flat)))
    (is (= :flat (b/consensus-vote [:long :short :flat] :flat)))
    (is (= :flat (b/consensus-vote [:flat :flat :flat] :flat)))
    (is (= :flat (b/consensus-vote [:long :flat :flat] :flat))))
  (testing "LONG holds, drops, flips"
    (is (= :long (b/consensus-vote [:long :long :flat] :long)))
    (is (= :flat (b/consensus-vote [:long :flat :flat] :long)))
    (is (= :flat (b/consensus-vote [:long :short :flat] :long)))
    (is (= :short (b/consensus-vote [:short :short :flat] :long)))
    (is (= :short (b/consensus-vote [:short :short :long] :long))))
  (testing "SHORT holds, drops, flips"
    (is (= :short (b/consensus-vote [:short :short :flat] :short)))
    (is (= :flat (b/consensus-vote [:short :flat :flat] :short)))
    (is (= :long (b/consensus-vote [:long :long :short] :short)))
    (is (= :long (b/consensus-vote [:long :long :flat] :short)))))

;; ────────────────────────────────────────────────────────────────────────────
;; direction-step — hysteresis state machine
;; (z thresholds chosen vs a unit calibration: std=1 ⇒ pred IS the z-score)
;; ────────────────────────────────────────────────────────────────────────────

(def unit-cal
  "std=1.0 calibration with the DirectionEnsembleSignal default hysteresis
  (enter 0.75σ / exit-delta 0.50 → exit band at 0.25σ)."
  {:std {:long 1.0 :gen 1.0 :short 1.0}
   :hysteresis {:enter-long-sigma 0.75 :exit-long-delta 0.50
                :enter-gen-long-sigma 0.50 :exit-gen-long-delta 0.50
                :enter-gen-short-sigma 0.50 :exit-gen-short-delta 0.50
                :enter-short-sigma 0.75 :exit-short-delta 0.50}
   :regime-active true})

(defn- step [pred state] (b/direction-step pred unit-cal state))
(defn- in-kind [k] (assoc b/default-direction-state :last-kind k))

(deftest direction-entry
  (testing "AND-gated long entry: specialist AND generalist must agree"
    (is (= :long (:kind (step [0.8 0.6 0.0] nil))))
    (is (= :flat (:kind (step [0.8 0.4 0.0] nil))) "gen below gate")
    (is (= :flat (:kind (step [0.7 0.6 0.0] nil))) "long head below gate"))
  (testing "AND-gated short entry (sign-flipped)"
    (is (= :short (:kind (step [0.0 -0.6 -0.8] nil))))
    (is (= :flat (:kind (step [0.0 -0.4 -0.8] nil))))
    (is (= :flat (:kind (step [0.0 -0.6 -0.7] nil)))))
  (testing "gen head sign decides side when gates are zero"
    ;; NOTE: simultaneous long+short entry (the |z| tiebreak branch) is
    ;; structurally unreachable — it needs z-gen > enter-gen-long AND
    ;; z-gen < -enter-gen-short at once, impossible for gates >= 0. The
    ;; branch is kept verbatim for parity with the Python reference.
    (let [cal (assoc unit-cal :hysteresis
                     (zipmap b/hysteresis-keys (repeat 0.0)))]
      (is (= :long (:kind (b/direction-step [0.9 0.1 -0.5] cal nil))))
      (is (= :short (:kind (b/direction-step [0.5 -0.1 -0.9] cal nil)))))))

(deftest direction-exit-and-hold
  (testing "hold inside hysteresis band"
    ;; entered at >0.75; holds while z-long > 0.25 AND z-gen > 0.0
    (is (= :long (:kind (step [0.3 0.1 0.0] (in-kind :long))))))
  (testing "OR-gated exit: either head crossing band exits"
    (is (= :flat (:kind (step [0.2 0.1 0.0] (in-kind :long)))) "specialist exit")
    (is (= :flat (:kind (step [0.3 -0.1 0.0] (in-kind :long)))) "generalist exit"))
  (testing "exit straight into opposite entry"
    (is (= :short (:kind (step [0.0 -0.6 -0.8] (in-kind :long)))))
    (is (= :long (:kind (step [0.8 0.6 0.0] (in-kind :short))))))
  (testing "short side hold/exit mirror"
    (is (= :short (:kind (step [0.0 -0.1 -0.3] (in-kind :short)))))
    (is (= :flat (:kind (step [0.0 -0.1 -0.2] (in-kind :short)))))
    (is (= :flat (:kind (step [0.0 0.1 -0.3] (in-kind :short)))))))

(deftest direction-faults
  (testing "NaN prediction → REFUSE → flat + nan state"
    (let [r (step [##NaN 0.0 0.0] (in-kind :long))]
      (is (= :flat (:kind r)))
      (is (= :nan-prediction (:fault r)))
      (is (= :long (get-in r [:state :last-kind])) "prior kind carried")))
  (testing "degenerate std → flat"
    (is (= :degenerate-std
           (:fault (b/direction-step [1.0 1.0 1.0]
                                     (assoc-in unit-cal [:std :gen] 0.0)
                                     nil)))))
  (testing "regime gate forces flat"
    (let [r (b/direction-step [5.0 5.0 0.0]
                              (assoc unit-cal :regime-active false)
                              (in-kind :long))]
      (is (= :flat (:kind r)))
      (is (= :regime-gated (:reason r))))))

(deftest direction-state-roundtrip
  (testing "emitted state feeds the next bar (hysteresis persistence)"
    (let [r1 (step [0.8 0.6 0.0] nil)
          r2 (step [0.3 0.1 0.0] (:state r1))
          r3 (step [0.2 0.1 0.0] (:state r2))]
      (is (= [:long :long :flat] [(:kind r1) (:kind r2) (:kind r3)])))))

;; ────────────────────────────────────────────────────────────────────────────
;; calibration parsing + DOLPHIN scaling
;; ────────────────────────────────────────────────────────────────────────────

(def cal-fixture
  "Mini v0_legacy_freeze-shaped doc (values from the real chestnut bundle)."
  "{\"bundle_version\": \"v0_legacy_freeze\",
    \"state\": {\"final_target_std\": {\"gen\": 0.00033154842094518244,
                                       \"long\": 0.00022409101075027138,
                                       \"short\": 0.00022416624415200204},
                \"hysteresis_params\": {\"enter_gen_long_sigma\": 0.4427,
                                        \"enter_gen_short_sigma\": 0.6499,
                                        \"enter_long_sigma\": 0.4175,
                                        \"enter_short_sigma\": 0.3618,
                                        \"exit_gen_long_delta\": 0.3081,
                                        \"exit_gen_short_delta\": 0.568,
                                        \"exit_long_delta\": 0.3321,
                                        \"exit_short_delta\": 0.1655}}}")

(deftest calibration-parsing
  (let [cal (b/parse-calibration cal-fixture)]
    (is (= "v0_legacy_freeze" (:bundle-version cal)))
    (is (= 0.00022409101075027138 (get-in cal [:std :long])))
    (is (= 0.4175 (get-in cal [:hysteresis :enter-long-sigma])))
    (is (= 0.568 (get-in cal [:hysteresis :exit-gen-short-delta])))
    (is (true? (:regime-active cal))
        "freeze bundles lack regime_active → defaults true (live behavior)")))

(deftest dolphin-scaling
  (let [h (:hysteresis (b/parse-calibration cal-fixture))
        h2 (b/scale-hysteresis h 2.0)]
    (is (= 8 (count b/hysteresis-keys)))
    (doseq [k b/hysteresis-keys]
      (is (= (* 2.0 (get h k)) (get h2 k)) (str k " doubled")))))

(deftest entry-threshold-from-real-calibration
  (testing "entry expectations derived from chestnut v0_legacy_freeze numbers"
    (let [cal (b/parse-calibration cal-fixture)
          std (:std cal)
          ;; preds sitting exactly 1σ above each enter gate → LONG
          p [(* 0.4176 (:long std)) (* 0.4428 (:gen std)) 0.0]]
      (is (= :long (:kind (b/direction-step p cal nil))))
      ;; just under the long gate → flat
      (is (= :flat (:kind (b/direction-step
                           [(* 0.4174 (:long std)) (* 0.4428 (:gen std)) 0.0]
                           cal nil)))))))

;; ────────────────────────────────────────────────────────────────────────────
;; signals memoization — idempotent per ingested SPY bar (no torch needed:
;; the cache-hit path never reaches predictions, and the cache-bypass path
;; is detected by the fake bridge blowing up when it DOES reach them)
;; ────────────────────────────────────────────────────────────────────────────

(deftest signals-memoized-per-bar
  (let [spy-buf (python/list [#py {"time" "2026-06-11T10:00" "close" 600.0}])
        hyg-buf (python/list [#py {"time" "2026-06-11T10:00" "close" 80.0}])
        tlt-buf (python/list [#py {"time" "2026-06-11T10:00" "close" 90.0}])
        vxx-buf (python/list [#py {"time" "2026-06-11T10:00" "close" 20.0}])
        cached {:chestnut :long :lynx :flat :moose :flat
                :oak :flat :dolphin :flat :parrot :flat}
        bridge {:buffers #py {"SPY" spy-buf "HYG" hyg-buf "TLT" tlt-buf "VXX" vxx-buf}
                :state (atom {:last-bar-time "2026-06-11T10:00"
                              :last-result cached})}
        previous (.get (.-environ os) "STEVE_MAX_SIGNAL_LAG_SECONDS")]
    (try
      (.__setitem__ (.-environ os) "STEVE_MAX_SIGNAL_LAG_SECONDS" "0")
      (testing "repeated calls within the same bar return the cached result"
        (is (= cached (b/signals bridge)))
        (is (= cached (b/signals bridge))))
      (testing "a NEW bar time bypasses the cache (recompute is attempted)"
        (.append spy-buf #py {"time" "2026-06-11T10:01" "close" 600.5})
        (.append hyg-buf #py {"time" "2026-06-11T10:01" "close" 80.0})
        (.append tlt-buf #py {"time" "2026-06-11T10:01" "close" 90.0})
        (.append vxx-buf #py {"time" "2026-06-11T10:01" "close" 20.0})
        (is (= :recomputed
               (try
                 (b/signals bridge)
                 :served-stale-cache
                 (catch python/Exception _ :recomputed)))))
      (finally
        (if (some? previous)
          (.__setitem__ (.-environ os) "STEVE_MAX_SIGNAL_LAG_SECONDS" previous)
          (.pop (.-environ os) "STEVE_MAX_SIGNAL_LAG_SECONDS" nil))))))

(deftest signals-refuse-misaligned-stock-bars
  (let [bridge {:buffers #py {"SPY" (python/list [#py {"time" "2026-06-11T10:01" "close" 600.0}])
                              "HYG" (python/list [#py {"time" "2026-06-11T10:01" "close" 80.0}])
                              "TLT" (python/list [#py {"time" "2026-06-11T10:00" "close" 90.0}])
                              "VXX" (python/list [#py {"time" "2026-06-11T10:01" "close" 20.0}])}
                :state (atom {})}
        previous (.get (.-environ os) "STEVE_MAX_SIGNAL_LAG_SECONDS")]
    (try
      (.__setitem__ (.-environ os) "STEVE_MAX_SIGNAL_LAG_SECONDS" "0")
      (let [result (b/signals bridge)]
        (is (= :incoherent-stock-bars (:fault result)))
        (is (= :flat (:chestnut result)))
        (is (= [{"symbol" "TLT" "bar_time" "2026-06-11T10:00"}]
               (:lagging-symbols result))))
      (finally
        (if (some? previous)
          (.__setitem__ (.-environ os) "STEVE_MAX_SIGNAL_LAG_SECONDS" previous)
          (.pop (.-environ os) "STEVE_MAX_SIGNAL_LAG_SECONDS" nil))))))

(deftest signals-force-flat-for-stale-spy-bar
  (let [old-time (- (.now (.-datetime datetime) (.-utc datetime/timezone))
                    (datetime/timedelta ** :minutes 10))
        spy-buf (python/list [#py {"time" old-time "close" 600.0}])
        bridge {:buffers #py {"SPY" spy-buf}
                :state (atom {})}
        previous (.get (.-environ os) "STEVE_MAX_SIGNAL_LAG_SECONDS")]
    (try
      (.__setitem__ (.-environ os) "STEVE_MAX_SIGNAL_LAG_SECONDS" "60")
      (let [s (b/signals bridge)]
        (is (= :stale-spy-bar (:fault s)))
        (is (= :flat (:chestnut s)))
        (is (= :flat (:lynx s)))
        (is (= :flat (:moose s)))
        (is (= :flat (:oak s)))
        (is (= :flat (:dolphin s)))
        (is (= :flat (:parrot s)))
        (is (> (:bar-lag-seconds s) 60.0)))
      (finally
        (if (some? previous)
          (.__setitem__ (.-environ os) "STEVE_MAX_SIGNAL_LAG_SECONDS" previous)
          (.pop (.-environ os) "STEVE_MAX_SIGNAL_LAG_SECONDS" nil))))))

(deftest bridge-uses-native-feature-vector-not-legacy-feature-engine
  (let [source (slurp "components/bridge.steve-v2/src/stevetrading/bridge/steve_v2.lpy")]
    (is (str/includes? source "raw-unlock/compute-live-feature-vector"))
    (is (not (str/includes? source "scripts_5yr.live.feature_engine")))
    (is (not (str/includes? source "scripts_5yr.live.model_inference")))
    (is (not (str/includes? source ".compute_all_features")))
    (is (not (str/includes? source ":engine engine")))))

(deftest feature-capture-writes-atomically-and-preserves_required_arrays
  (let [dir (tempfile/mkdtemp ** :prefix "steve-v2-capture-test-")
        grid (numpy/zeros #py (6 21 8))
        feats (numpy/array [1.0 2.0 3.0])
        spy-buf (python/list [#py {"time" "2026-06-11T10:00" "close" 600.0}])
        bridge {:np numpy
                :grid-history (python/list [grid])
                :buffers #py {"SPY" spy-buf}
                :capture-dir dir
                :capture-provenance {"schema_version" 1
                                     "stock" {"provider" "thetadata" "bar_status" "completed"}}
                :capture (atom [])
                :last-chain-json (atom (json/dumps
                                         (python/dict
                                          {"contracts"
                                           (python/list
                                            [(python/dict {"strike" 600.0
                                                           "right" "CALL"
                                                           "bid" 1.0
                                                           "ask" 1.2
                                                           "expiration" "2026-07-10"})])})))
                :last-option-surfaces-json (atom
                                             (python/dict
                                              {"SPXW" (json/dumps
                                                       (python/dict
                                                        {"contracts"
                                                         (python/list
                                                          [(python/dict {"strike" 6000.0
                                                                         "right" "PUT"
                                                                         "bid" 10.0
                                                                         "ask" 10.5
                                                                         "expiration" "2026-07-10"})])}))}))}
        preds {:chestnut {:feats feats}
               :lynx {:feats (numpy/add feats 10.0)}
               :moose {:feats (numpy/add feats 20.0)}}]
    (#'b/capture-features! bridge "2026-06-11T10:00" preds)
    (let [files (vec (os/listdir dir))
          npz-files (filter #(.endswith % ".npz") files)
          tmp-files (filter #(not= -1 (.find % ".tmp")) files)
          path (os.path/join dir (first npz-files))
          data (numpy/load path ** :allow_pickle true)
          data-files (set (vec (.-files data)))]
      (is (= 1 (count npz-files)))
      (is (= 0 (count tmp-files)))
      (is (contains? data-files "capture_version"))
	      (doseq [k ["times" "spy" "provenance_json" "bar_buffers_json" "option_chain_json"
	                 "option_surfaces_json"
	                 "grid_history_json"
	                 "grids" "chestnut" "lynx" "moose"]]
	        (is (contains? data-files k) k))
	      (is (= 2 (int (aget (aget data "capture_version") 0))))
	      (is (= "thetadata"
	             (get-in (json/loads (str (aget (aget data "provenance_json") 0)))
	                     ["stock" "provider"])))
	      (doseq [k ["bar_buffers_json" "option_chain_json"
	                 "option_surfaces_json" "grid_history_json"]]
	        (is (= "object" (str (.-dtype (aget data k))))
	            (str k " must stay object dtype so appends do not allocate huge fixed-width Unicode arrays")))
	      (is (= 600.0
	             (float (get-in (json/loads (str (aget (aget data "bar_buffers_json") 0)))
	                            ["SPY" 0 "close"]))))
	      (is (= 1
	             (python/len (get (json/loads
	                                (str (aget (aget data "option_chain_json") 0)))
	                               "contracts"))))
	      (is (= 600.0
	             (float (get-in (json/loads
	                              (str (aget (aget data "option_chain_json") 0)))
	                             ["contracts" 0 "strike"]))))
	      (is (= 1
	             (python/len
	              (get (json/loads
	                    (get (json/loads
	                          (str (aget (aget data "option_surfaces_json") 0)))
	                         "SPXW"))
	                   "contracts"))))
      (is (= 6000.0
	             (float
	              (get-in (json/loads
	                       (get (json/loads
	                             (str (aget (aget data "option_surfaces_json") 0)))
	                            "SPXW"))
	                      ["contracts" 0 "strike"]))))
      (is (= [1 6 21 8]
             (vec (.-shape (numpy/array
                            (json/loads (str (aget (aget data "grid_history_json") 0))))))))
      (is (= [1 3] (vec (.-shape (aget data "chestnut")))))
      (is (= 600.0 (float (aget (aget data "spy") 0)))))))

(deftest feature-capture-skips-blank-bar-times
  (let [dir (tempfile/mkdtemp ** :prefix "steve-v2-capture-blank-time-test-")
        grid (numpy/zeros #py (6 21 8))
        feats (numpy/array [1.0 2.0 3.0])
        bridge {:np numpy
                :grid-history (python/list [grid])
                :buffers #py {"SPY" (python/list)}
                :capture-dir dir
                :capture (atom [])}
        preds {:chestnut {:feats feats}
               :lynx {:feats (numpy/add feats 10.0)}
               :moose {:feats (numpy/add feats 20.0)}}]
    (#'b/capture-features! bridge nil preds)
    (#'b/capture-features! bridge "   " preds)
    (is (= [] @(:capture bridge)))
    (is (= [] (vec (os/listdir dir))))))

(deftest feature-capture-appends-across-bars-and-process-restarts
  (let [dir (tempfile/mkdtemp ** :prefix "steve-v2-capture-append-test-")
        grid (numpy/zeros #py (6 21 8))
        feats (numpy/array [1.0 2.0 3.0])
        preds {:chestnut {:feats feats}
               :lynx {:feats (numpy/add feats 10.0)}
               :moose {:feats (numpy/add feats 20.0)}}
        spy-buf-a (python/list [#py {"time" "2026-06-11T10:00" "close" 600.0}])
        bridge-a {:np numpy
                  :grid-history (python/list [grid])
                  :buffers #py {"SPY" spy-buf-a}
                  :capture-dir dir
                  :capture (atom [])}]
    (#'b/capture-features! bridge-a "2026-06-11T10:00" preds)
    (.append spy-buf-a #py {"time" "2026-06-11T10:01" "close" 601.0})
    (#'b/capture-features! bridge-a "2026-06-11T10:01" preds)
    (let [path (os.path/join dir (first (filter #(.endswith % ".npz") (os/listdir dir))))
          data (numpy/load path ** :allow_pickle true)]
      (is (= 2 (python/len (aget data "times"))))
      (is (= ["2026-06-11T10:00" "2026-06-11T10:01"]
             (vec (aget data "times"))))
      (is (every? #(pos? (count (str %)))
                  (vec (aget data "bar_buffers_json")))
          "default capture must include raw sidecars every bar for parity evidence"))
    (let [spy-buf-b (python/list [#py {"time" "2026-06-11T10:02" "close" 602.0}])
          bridge-b {:np numpy
                    :grid-history (python/list [grid])
                    :buffers #py {"SPY" spy-buf-b}
                    :capture-dir dir
                    :capture (atom [])}]
      (#'b/capture-features! bridge-b "2026-06-11T10:02" preds)
      (.append spy-buf-b #py {"time" "2026-06-11T10:03" "close" 603.0})
      (#'b/capture-features! bridge-b "2026-06-11T10:03" preds))
    (let [path (os.path/join dir (first (filter #(.endswith % ".npz") (os/listdir dir))))
          data (numpy/load path ** :allow_pickle true)]
      (is (= 4 (python/len (aget data "times"))))
	      (doseq [k ["bar_buffers_json" "option_chain_json"
	                 "option_surfaces_json" "grid_history_json"]]
	        (is (= "object" (str (.-dtype (aget data k))))
	            (str k " must remain object dtype across process restarts")))
	      (is (= ["2026-06-11T10:00" "2026-06-11T10:01"
                "2026-06-11T10:02" "2026-06-11T10:03"]
	             (vec (aget data "times")))))))

(deftest feature-capture-dedupes-equivalent-time-encodings-across-restarts
  (let [dir (tempfile/mkdtemp ** :prefix "steve-v2-capture-time-dedupe-test-")
        grid (numpy/zeros #py (6 21 8))
        feats (numpy/array [1.0 2.0 3.0])
        preds {:chestnut {:feats feats}
               :lynx {:feats (numpy/add feats 10.0)}
               :moose {:feats (numpy/add feats 20.0)}}
        bridge-a {:np numpy
                  :grid-history (python/list [grid])
                  :buffers #py {"SPY" (python/list [#py {"time" "#inst \"2026-07-07T16:43:00+00:00\""
                                                        "close" 600.0}])}
                  :capture-dir dir
                  :capture (atom [])}
        bridge-b {:np numpy
                  :grid-history (python/list [grid])
                  :buffers #py {"SPY" (python/list [#py {"time" "2026-07-07T16:43:00Z"
                                                        "close" 600.0}])}
                  :capture-dir dir
                  :capture (atom [])}]
    (#'b/capture-features! bridge-a "#inst \"2026-07-07T16:43:00+00:00\"" preds)
    (#'b/capture-features! bridge-b "2026-07-07T16:43:00Z" preds)
    (let [path (os.path/join dir (first (filter #(.endswith % ".npz") (os/listdir dir))))
          data (numpy/load path ** :allow_pickle true)]
      (is (= 1 (python/len (aget data "times"))))
      (is (= ["2026-07-07T16:43:00Z"] (vec (aget data "times")))))))

(deftest feature-capture-recovers-from-fixed-width-unicode-sidecar-file
  (let [dir (tempfile/mkdtemp ** :prefix "steve-v2-capture-unicode-recover-test-")
        stamp (.strftime (datetime.datetime/now (.-utc datetime/timezone))
                          "%Y%m%d")
        path (os.path/join dir (str "live_features_" stamp ".npz"))
        grid (numpy/zeros #py (6 21 8))
        feats (numpy/array [1.0 2.0 3.0])
        corrupt-surface (apply str (repeat 10000 "x"))
        _ (numpy/savez_compressed
           path
           ** :capture_version (numpy/array (python/list [2]))
           :times (numpy/array (python/list ["2026-07-07T16:00:00Z"]))
           :spy (numpy/array (python/list [600.0]))
           :bar_buffers_json (numpy/array (python/list ["{}"]))
           :option_chain_json (numpy/array (python/list ["{}"]))
           :option_surfaces_json (numpy/array (python/list [corrupt-surface]))
           :grid_history_json (numpy/array (python/list ["[]"]))
           :grids (numpy/zeros #py (1 6 21 8))
           :chestnut (numpy/zeros #py (1 3))
           :lynx (numpy/zeros #py (1 3))
           :moose (numpy/zeros #py (1 3)))
        spy-buf (python/list [#py {"time" "2026-07-07T16:01:00Z" "close" 601.0}])
        bridge {:np numpy
                :grid-history (python/list [grid])
                :buffers #py {"SPY" spy-buf}
                :capture-dir dir
                :capture (atom [])
                :last-chain-json (atom "{}")
                :last-option-surfaces-json (atom (python/dict))}
        preds {:chestnut {:feats feats}
               :lynx {:feats (numpy/add feats 10.0)}
               :moose {:feats (numpy/add feats 20.0)}}]
    (#'b/capture-features! bridge "2026-07-07T16:01:00Z" preds)
    (let [data (numpy/load path ** :allow_pickle true)]
      (is (= 2 (python/len (aget data "times"))))
      (doseq [k ["bar_buffers_json" "option_chain_json"
                 "option_surfaces_json" "grid_history_json"]]
        (is (= "object" (str (.-dtype (aget data k))))
            (str k " must be normalized to object dtype after recovery"))))))

(deftest feature-capture-failed-writes-do-not-accumulate-sidecar-backlog
  (let [dir (tempfile/mkdtemp ** :prefix "steve-v2-capture-fail-test-")
        grid (numpy/zeros #py (6 21 8))
        big-sidecar (.dumps json (python/dict {"contracts"
                                                (python/list
                                                 (map (fn [i]
                                                        (python/dict {"strike" i
                                                                      "right" "CALL"
                                                                      "bid" 1.0
                                                                      "ask" 1.1
                                                                      "expiration" "2026-07-10"}))
                                                      (range 5000))) }))
        feats (numpy/array [1.0 2.0 3.0])
        bridge {:np numpy
                :grid-history (python/list [grid])
                :buffers #py {"SPY" (python/list)}
                :capture-dir dir
                :capture (atom [])
                :last-chain-json (atom big-sidecar)
                :last-option-surfaces-json (atom (python/dict {"SPXW" big-sidecar}))}
        preds {:chestnut {:feats feats}
               :lynx {:feats (numpy/add feats 10.0)}
               :moose {:feats (numpy/add feats 20.0)}}]
    (os/chmod dir 320)
    (try
      (#'b/capture-features! bridge "2026-06-11T10:00" preds)
      (#'b/capture-features! bridge "2026-06-11T10:01" preds)
      (#'b/capture-features! bridge "2026-06-11T10:02" preds)
      (finally
        (os/chmod dir 448)))
    (is (= 1 (count @(:capture bridge))))
    (is (= "2026-06-11T10:02" (:time (first @(:capture bridge)))))))

(deftest option-surface-sidecar-merges-formula-features
  (let [bridge {:generic-option-feature-fn
	                (fn [prefix chain-json]
	                  (python/dict {(str prefix "_opt_contract_count") 4.0}))
                :last-option-surfaces-json (atom (python/dict))
                :last-option-features (atom (python/dict))}
        result (b/on-option-surface!
	                bridge
	                {:prefix "VIX"
	                 :observed-at ((.-datetime datetime) 2026 7 7 15 30
	                               ** :tzinfo (zoneinfo/ZoneInfo "America/New_York"))
                 :underlying 16.0
                 :contracts [{:strike 16.0 :right "CALL" :bid 0.5 :ask 0.7
                              :expiration "2026-07-08"}
                             {:strike 16.0 :right "PUT" :bid 0.4 :ask 0.5
                              :expiration "2026-07-08"}]})]
    (is (= "VIX" (:prefix result)))
    (is (= 1 (:n-features result)))
    (is (= 4.0 (.get @(:last-option-features bridge)
                     "VIX_opt_contract_count")))
    (is (contains? (set (vec (.keys @(:last-option-surfaces-json bridge))))
                   "VIX"))
    (is (= 16.0
           (float
            (get-in (json/loads (.get @(:last-option-surfaces-json bridge) "VIX"))
                    ["contracts" 0 "strike"])))) ))

(deftest live-option-sidecars-serialize-basilisp-contracts-as-json-objects
  (let [dir (tempfile/mkdtemp ** :prefix "steve-v2-live-sidecar-test-")
        grid (numpy/zeros #py (6 21 8))
        observed ((.-datetime datetime) 2026 7 7 15 30
                  ** :tzinfo (zoneinfo/ZoneInfo "America/New_York"))
        spy-buf (python/list [#py {"time" "2026-07-07T15:30:00-04:00"
                                   "close" 746.0}])
        bridge {:np numpy
                :grid-builder (types/SimpleNamespace
                               ** :build_grid (fn [_contracts _underlying _observed-at]
                                                 grid))
                :grid-history (python/list)
                :buffers #py {"SPY" spy-buf}
                :capture-dir dir
                :capture (atom [])
                :risk-free-rate 0.01
                :greeks-fns {:time-to-expiry (fn [_expiration _observed-at] 0.01)
                             :implied-vol (fn [& _args] 0.2)
                             :bs-greeks (fn [& _args]
                                          (python/dict {"delta" 0.5
                                                        "vega" 0.1
                                                        "theta" -0.01
                                                        "rho" 0.02}))}
                :option-feature-fn (fn [_chain-json] (python/dict))
                :generic-option-feature-fn (fn [_prefix _chain-json] (python/dict))
                :generic-greek-grid-feature-fn (fn [_prefix _grid] (python/dict))
                :last-chain-json (atom nil)
                :last-option-surfaces-json (atom (python/dict))
                :last-option-surface-status-json (atom (python/dict))
                :last-option-features (atom (python/dict))}
        preds {:chestnut {:feats (numpy/array [1.0 2.0 3.0])}
               :lynx {:feats (numpy/array [4.0 5.0 6.0])}
               :moose {:feats (numpy/array [7.0 8.0 9.0])}}]
    (b/on-chain!
     bridge
     {:observed-at observed
      :contracts [{:strike 746.0
                   :right "CALL"
                   :bid 1.0
                   :ask 1.2
                   :bid-size 10
                   :ask-size 11
                   :expiration "2026-07-08"
                   :open-interest 42}]})
    (b/on-option-surface!
     bridge
     {:prefix "VIXW"
      :observed-at observed
      :underlying 16.0
      :contracts [{:strike 16.0
                   :right "PUT"
                   :bid 0.4
                   :ask 0.5
                   :bid-size 20
                   :ask-size 21
                   :expiration "2026-07-08"
                   :open-interest 84}]})
    (b/record-option-surface-status!
     bridge
     {:prefix "VIXW"
      :observed-at observed
      :ok? true
      :underlying 16.0
      :contracts 1
      :n-gridded 1
      :n-features 2})
    (#'b/capture-features! bridge "2026-07-07T15:30:00-04:00" preds)
    (let [path (os.path/join dir (first (filter #(.endswith % ".npz") (os/listdir dir))))
          data (numpy/load path ** :allow_pickle true)
          chain-payload (json/loads (str (aget (aget data "option_chain_json") 0)))
          chain-contract (get-in chain-payload ["contracts" 0])
          surfaces-payload (json/loads (str (aget (aget data "option_surfaces_json") 0)))
          vixw-payload (json/loads (get surfaces-payload "VIXW"))
          vixw-contract (get-in vixw-payload ["contracts" 0])
          status-payload (json/loads (str (aget (aget data "option_surface_status_json") 0)))
          vixw-status (json/loads (get status-payload "VIXW"))]
      (is (python/isinstance chain-contract python/dict))
      (is (= 746.0 (float (get chain-contract "strike"))))
      (is (= "CALL" (get chain-contract "right")))
      (is (= 10.0 (float (get chain-contract "bid_size"))))
      (is (= 42.0 (float (get chain-contract "open_interest"))))
      (is (python/isinstance vixw-contract python/dict))
      (is (= 16.0 (float (get vixw-contract "strike"))))
      (is (= "PUT" (get vixw-contract "right")))
      (is (= 21.0 (float (get vixw-contract "ask_size"))))
      (is (= 84.0 (float (get vixw-contract "open_interest"))))
      (is (= true (get vixw-status "ok")))
      (is (= 1 (int (get vixw-status "contracts"))))
      (is (= 2 (int (get vixw-status "n_features")))))))

;; ────────────────────────────────────────────────────────────────────────────
;; torch/xgboost-dependent: bundle load + deterministic synthetic predict
;; (skips unless torch + the REF tree are available — e.g. under REF/.venv)
;; ────────────────────────────────────────────────────────────────────────────

(defn- ref-env-available? []
  (try
    (importlib/import-module "torch")
    (importlib/import-module "xgboost")
    true
    (catch python/ImportError _ false)))

(defn- synthetic-bars
  "70 deterministic bars (gentle ramp so TA indicators are non-degenerate)."
  [base]
  (let [dt-cls (.-datetime datetime)
        et (zoneinfo/ZoneInfo "America/New_York")]
    (vec (for [i (range 70)]
           (let [px (+ base (* 0.01 i))]
             {:time (dt-cls 2026 6 11 ** :hour 10 :minute (mod i 60)
                            :second (quot i 60) :tzinfo et)
              :open px :high (+ px 0.05) :low (- px 0.05) :close px
              :volume 1000.0})))))

(deftest bundle-load-and-synthetic-predict
  (if-not (ref-env-available?)
    (do (println "SKIP bundle-load-and-synthetic-predict: torch/xgboost not"
                 "importable (run under the REF .venv for full coverage)")
        (is true))
    (let [mk #(str ref-root "/pipeline_data/" %)
          bridge (b/make-bridge
                  {:ref-root ref-root
                   :bundle-dirs {:chestnut (mk "live_model_chestnut_multihead")
                                 :lynx (mk "live_model_lynx_multihead")
                                 :moose (mk "live_model_moose_multihead")}
                   :calibrations
                   {:chestnut (mk "calibrations/dir_cal_chestnut_h3_v1/v0_legacy_freeze.json")
                    :lynx (mk "calibrations/dir_cal_lynx_h3_v1/v0_legacy_freeze.json")
                    :moose (mk "calibrations/dir_cal_moose_h3_v1/v0_legacy_freeze.json")}})]
      ;; deterministic inputs: fixed synthetic bars, NO chain → zero grids
      (b/prime! bridge
                {"SPY" (synthetic-bars 600.0) "HYG" (synthetic-bars 80.0)
                 "TLT" (synthetic-bars 85.0) "VXX" (synthetic-bars 26.0)}
                [])
      (let [preds (b/predictions bridge)]
        (doseq [bot [:chestnut :lynx :moose]]
          (let [{:keys [pred n-features]} (get preds bot)]
            (is (= 918 n-features) (str bot " feature count"))
            (is (= 3 (count pred)) (str bot " 3-head pred"))
            (is (every? #(and (number? %) (math/isfinite %)) pred)
                (str bot " finite preds: " pred)))))
      ;; signals end-to-end: six kinds emitted, consensus consistent
      (let [s (b/signals bridge)]
        (doseq [bot [:chestnut :lynx :moose :oak :dolphin :parrot]]
          (is (contains? #{:long :short :flat} (get s bot)) (str bot)))
        (is (= (:oak s) (:parrot s))
            "OAK and PARROT share the mult-1.0 consensus vote")))))

(deftest prime-tolerates-empty-bar-seed
  "2026-06-22 regression: the 09:20 cron fires 10 min pre-market, so a thin IEX
  feed can return an EMPTY SPY bar seed. on-chain! requires a primed SPY bar
  buffer — priming the chain anyway threw and crashed the whole session. prime!
  must instead SKIP the chain seed (spy-price nil) and not throw; the live loop
  builds grids once bars flow."
  (if-not (ref-env-available?)
    (do (println "SKIP prime-tolerates-empty-bar-seed: torch/xgboost not importable")
        (is true))
    (let [mk #(str ref-root "/pipeline_data/" %)
          bridge (b/make-bridge
                  {:ref-root ref-root
                   :bundle-dirs {:chestnut (mk "live_model_chestnut_multihead")
                                 :lynx (mk "live_model_lynx_multihead")
                                 :moose (mk "live_model_moose_multihead")}
                   :calibrations
                   {:chestnut (mk "calibrations/dir_cal_chestnut_h3_v1/v0_legacy_freeze.json")
                    :lynx (mk "calibrations/dir_cal_lynx_h3_v1/v0_legacy_freeze.json")
                    :moose (mk "calibrations/dir_cal_moose_h3_v1/v0_legacy_freeze.json")}})
          ;; a chain snapshot that WOULD build a grid if it ran — proves the
          ;; skip is driven by the empty bar buffer, not by an empty chain.
          chain-seed [{:observed-at nil
                       :contracts [{:strike 600.0 :right "CALL" :bid 1.0 :ask 1.1
                                    :expiration "2026-06-30"}]}]]
      (testing "empty SPY bar seed → prime! skips chain, does not throw"
        (is (nil? (b/prime! bridge {} chain-seed))))
      (testing "bar buffer is still unprimed (chain was skipped, not crashed)"
        (is (nil? (#'b/spy-price bridge)))))))
