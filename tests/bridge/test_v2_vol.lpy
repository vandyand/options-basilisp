(ns bridge.test-v2-vol
  "bridge.v2-vol pure logic: verified VOL sign convention is z<-enter
  -> SHORT_VOL. The bridge exposes only the tradable short-vol state as
  :long so the existing iron-condor executor enters a short-vol structure."
  (:import datetime)
  (:require [basilisp.test :refer [deftest is testing]]
            [clojure.string :as str]
            [stevetrading.bridge.v2-vol :as v2v]))

(deftest core-bridge-keeps-legacy-loading-out-of-band
  (let [core-source (slurp "components/bridge.v2-vol/src/stevetrading/bridge/v2_vol.lpy")
        legacy-source (slurp "components/bridge.v2-vol/src/stevetrading/bridge/v2_vol/legacy.lpy")]
    (is (not (str/includes? core-source "stevetrading_v2")))
    (is (not (str/includes? core-source "importlib/import-module")))
    (is (str/includes? core-source "requires :prediction-factory"))
    (is (str/includes? legacy-source "stevetrading_v2.strategies._vol_predictor_builder"))
    (is (str/includes? legacy-source "core/make-v2-vol-bridge"))))

(deftest vol-state-machine
  (testing "flat + small z stays flat"
    (is (= :flat (v2v/vol-state-step :flat -1.9 2.0 0.5)))
    (is (= :flat (v2v/vol-state-step :flat 1.9 2.0 0.5))))
  (testing "negative z enters short-vol, positive z enters long-vol"
    (is (= :short-vol (v2v/vol-state-step :flat -2.01 2.0 0.5)))
    (is (= :long-vol (v2v/vol-state-step :flat 2.01 2.0 0.5))))
  (testing "held state exits only inside exit band"
    (is (= :short-vol (v2v/vol-state-step :short-vol -0.51 2.0 0.5)))
    (is (= :flat (v2v/vol-state-step :short-vol -0.49 2.0 0.5)))
    (is (= :long-vol (v2v/vol-state-step :long-vol 0.51 2.0 0.5)))
    (is (= :flat (v2v/vol-state-step :long-vol 0.49 2.0 0.5))))
  (testing "nil z holds the prior state"
    (is (= :short-vol (v2v/vol-state-step :short-vol nil 2.0 0.5)))
    (is (= :flat (v2v/vol-state-step :flat nil 2.0 0.5)))))

(deftest bridge-kind-mapping
  (is (= :long (v2v/vol-state->bridge-kind :short-vol)))
  (is (= :flat (v2v/vol-state->bridge-kind :long-vol)))
  (is (= :flat (v2v/vol-state->bridge-kind :flat))))

(deftest injected-predictor-factory-memoizes-per-minute-and-maps-short-vol
  (let [now (atom ((.-datetime datetime) 2026 7 9 14 0 0
                   ** :tzinfo (.-utc datetime/timezone)))
        calls (atom 0)
        values (atom [-3.0 0.0])
        bridge (v2v/make-v2-vol-bridge
                {:strategies {:test-vol {:enter-sigma 2.0 :exit-sigma 0.5}}
                 :now-fn (fn [] @now)
                 :prediction-factory
                 (fn [_bot _params]
                   {:pred-fn (fn [_instant]
                               (swap! calls inc)
                               (let [v (first @values)]
                                 (swap! values subvec 1)
                                 v))})})
        signals (:signals-fn bridge)]
    (is (= {:test-vol :long} (signals)))
    (is (= {:test-vol :long} (signals)))
    (is (= 1 @calls))
    (is (= :short-vol (get-in @(:state bridge) [:vol-states :test-vol])))
    (reset! now ((.-datetime datetime) 2026 7 9 14 1 0
                 ** :tzinfo (.-utc datetime/timezone)))
    (is (= {:test-vol :flat} (signals)))
    (is (= 2 @calls))))

(deftest injected-predictor-factory-records-errors-and-holds-state
  (let [now (atom ((.-datetime datetime) 2026 7 9 14 0 0
                   ** :tzinfo (.-utc datetime/timezone)))
        calls (atom 0)
        bridge (v2v/make-v2-vol-bridge
                {:strategies {:test-vol {:enter-sigma 2.0 :exit-sigma 0.5}}
                 :now-fn (fn [] @now)
                 :prediction-factory
                 (fn [_bot _params]
                   {:pred-fn (fn [_instant]
                               (swap! calls inc)
                               (if (= 1 @calls)
                                 -3.0
                                 (throw (python/RuntimeError "boom"))))})})
        signals (:signals-fn bridge)]
    (is (= {:test-vol :long} (signals)))
    (reset! now ((.-datetime datetime) 2026 7 9 14 1 0
                 ** :tzinfo (.-utc datetime/timezone)))
    (is (= {:test-vol :long} (signals)))
    (is (= 2 @calls))
    (is (= :short-vol (get-in @(:state bridge) [:vol-states :test-vol])))
    (is (not= -1 (.find (get-in @(:state bridge) [:last-error]) "test-vol: boom")))))
