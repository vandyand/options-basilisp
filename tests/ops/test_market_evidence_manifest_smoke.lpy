(ns ops.test-market-evidence-manifest-smoke
  (:import json os pathlib shutil subprocess sys tempfile)
  (:require [basilisp.test :refer [deftest is]]))

(def root (pathlib/Path (os/getcwd)))
(def script (.joinpath root "scripts/market_evidence_manifest.lpy"))
(def stamp "20260705")

(def required-artifacts
  {"thetadata_capability_probe" [".json" ".md"]
   "thetadata_payload_verification" [".json"]
   "live_feature_parity_baseline" [".json" ".csv" ".md"]
   "live_feature_model_usage" [".json" ".csv" ".md"]
   "neutralization_audit" [".json" ".csv" ".md"]
   "market_evidence_readiness" [".json" ".md"]})

(def optional-artifacts
  {"live_feature_prediction_delta_aggregate" [".json" ".csv" ".md"]
   "live_feature_parity_gate" [".json" ".md"]
   "neutralized_feature_unlock_plan" [".json" ".csv" ".md"]
   "neutralized_feature_evidence_report" [".json" ".csv" ".md"]
   "blocked_feature_provenance_audit" [".json" ".csv" ".md"]
   "legacy_greek_formula_search" [".json" ".csv" ".md"]
   "greek_feature_reconstruction_audit" [".json" ".csv" ".md"]
   "raw_feature_unlock_audit" [".json" ".csv" ".md"]
   "raw_feature_unlock_candidates" [".json"]
   "v3_grid_unlock_audit" [".json" ".csv" ".md"]
   "greek_reconstruction_promotion_gate" [".json" ".csv" ".md"]
   "neutralization_unmask_dry_run" [".json"]
   "capture_v2_runtime_preflight" [".json"]
   "capture_v2_sidecar_check" [".json"]
   "option_surface_sidecar" [".json" ".npz"]
   "option_surface_sidecar_check" [".json"]
   "historical_feature_cohort" [".json"]
   "historical_features" [".npz"]
   "grid_feature_input_parity" [".json" ".md"]
   "matched_feature_parity" [".json" ".csv" ".md"]})

(defn jsonable [x]
  (cond
    (map? x) (python/dict (map (fn [[k v]] (python/tuple [(str k) (jsonable v)])) x))
    (python/isinstance x python/dict) (python/dict (map (fn [[k v]] (python/tuple [(str k) (jsonable v)])) (.items x)))
    (or (vector? x) (seq? x) (python/isinstance x python/list)) (python/list (map jsonable x))
    :else x))

(defn dumps [x] (json/dumps (jsonable x)))
(defn read-json [p] (json/loads (.read_text p)))
(defn path [parent child] (.joinpath parent child))

(defn resolve-basilisp []
  (cond
    (os.environ/get "BASILISP_BIN") (pathlib/Path (os.environ/get "BASILISP_BIN"))
    (.exists (.joinpath root ".venv/bin/basilisp")) (.joinpath root ".venv/bin/basilisp")
    (.exists (.with_name (pathlib/Path sys/executable) "basilisp")) (.with_name (pathlib/Path sys/executable) "basilisp")
    (shutil/which "basilisp") (pathlib/Path (shutil/which "basilisp"))
    :else (.joinpath root ".venv/bin/basilisp")))

(def basilisp (str (resolve-basilisp)))

(defn write-json! [p payload]
  (.write_text p (str (dumps payload) "\n")))

(defn write-text! [p text]
  (.write_text p text))

(defn write-artifact! [analysis name ext]
  (let [p (path analysis (str name "_" stamp ext))]
    (cond
      (and (= name "thetadata_capability_probe") (= ext ".json"))
      (write-json!
       p
       {"target_date" "2026-07-05"
        "generated_at" "2026-07-05T14:00:00Z"
        "summary" {"total" 2 "ok" 2 "usable" 2 "failed" 0 "payload_examples" 2 "error_classes" {}}
        "results" [{"name" "option.expirations"
                    "ok" true
                    "usable" true
                    "summary" {"required_ok" true "row_width_valid" true}
                    "payload_example" "PAYLOAD_QUOTE"}
                   {"name" "option.snapshot.quote"
                    "ok" true
                    "usable" true
                    "summary" {"required_ok" true "row_width_valid" true}
                    "payload_example" "PAYLOAD_TRADE"}]})

      (and (= name "thetadata_payload_verification") (= ext ".json"))
      (write-json!
       p
       {"target_date" stamp
        "generated_at" "2026-07-05T14:01:00Z"
        "status" "ok"
        "valid?" true
        "total" 2
        "checked" 2
        "skipped" 0
        "invalid" 0
        "example_generated_date_counts" {stamp 2}
        "example_path_date_counts" {stamp 2}
        "results" [{"probe" "option.expirations" "path" "PAYLOAD_QUOTE" "status" "ok" "valid?" true}
                   {"probe" "option.snapshot.quote" "path" "PAYLOAD_TRADE" "status" "ok" "valid?" true}]})

      (and (= name "market_evidence_readiness") (= ext ".json"))
      (write-json!
       p
       {"target_date" "2026-07-05"
        "verdict" "PASS"
        "reasons" []
        "fail_reasons" []
        "watch_reasons" []
        "thetadata_probe" {"available" true
                           "total" 2
                           "usable" 2
                           "failed" 0
                           "payload_examples" 2
                           "error_classes" {}
                           "result_counts" {"total" 2 "ok" 2 "usable" 2 "failed" 0 "payload_examples" 2}}
        "thetadata_payload_verification" {"available" true
                                          "status" "ok"
                                          "total" 2
                                          "checked" 2
                                          "skipped" 0
                                          "invalid" 0
                                          "valid" true
                                          "result_counts" {"total" 2 "checked" 2 "skipped" 0 "invalid" 0}}
        "legacy_greek_formula_search" {"available" false
                                       "candidate_formula_hits" 0
                                       "legacy_formula_provenance_hits" 0
                                       "candidate_reconstruction_hits" 0
                                       "manifest_reference_count" 0
                                       "manifest_impl_classes_missing" 0}})

      (and (#{"live_feature_parity_baseline" "live_feature_model_usage" "neutralization_audit"} name) (= ext ".json"))
      (write-json! p {"target_date" "2026-07-05" "summary" {}})

      :else
      (write-text! p (str name ext "\n")))))

(defn patch-payload-paths! [analysis payloads]
  (let [quote (str (path (path payloads stamp) "quote.json"))
        trade (str (path (path payloads stamp) "trade.json"))]
    (doseq [filename [(str "thetadata_capability_probe_" stamp ".json")
                      (str "thetadata_payload_verification_" stamp ".json")]]
      (let [p (path analysis filename)
            text (.read_text p)]
        (.write_text p (-> text
                           (.replace "PAYLOAD_QUOTE" quote)
                           (.replace "PAYLOAD_TRADE" trade)))))))

(defn patch-probe-payload-paths-to-remote! [analysis]
  (let [probe (path analysis (str "thetadata_capability_probe_" stamp ".json"))
        payload (read-json probe)
        results (get payload "results")]
    (aset (get results 0)
          "payload_example"
          (str "/opt/stevetrading/shared/payload_examples/" stamp "/quote.json"))
    (aset (get results 1)
          "payload_example"
          (str "/opt/stevetrading/shared/payload_examples/" stamp "/trade.json"))
    (write-json! probe payload)))

(defn write-parity-proof! [analysis]
  (write-json! (path analysis (str "capture_v2_sidecar_check_" stamp ".json"))
               {"ok" true "status" "ok" "target_date" "2026-07-05" "rows" 120})
  (write-json! (path analysis (str "capture_v2_runtime_preflight_" stamp ".json"))
               {"ok" true
                "status" "ok"
                "target_date" "2026-07-05"
                "sidecar_every" {"effective" 1
                                  "ok" true
                                  "parity_evidence_complete" true}
                "target_capture_check" {"ok" true
                                        "status" "ok"
                                        "row_count" 120}
                "issues" []
                "warnings" []})
  (write-json! (path analysis (str "historical_feature_cohort_" stamp ".json"))
               {"ok" true
                "status" "ok"
                "target_date" "2026-07-05"
                "rows" 120
                "features" 918
                "row_provenance_summary" {"rows" 120
                                          "chain_present_rows" 120
                                          "grid_appended_rows" 120
                                          "carried_grid_rows" 0
                                          "min_grid_history_len" 1
                                          "max_grid_history_len" 10}
                "contract_field_coverage" {"SPY" {"contracts" 24000
                                                  "field_counts" {"volume" 24000 "open_interest" 24000}
                                                  "field_coverage" {"volume" 1.0 "open_interest" 1.0}}}})
  (.write_bytes (path analysis (str "historical_features_" stamp ".npz"))
                (.encode "synthetic historical tensor\n" "utf-8"))
  (write-json! (path analysis (str "matched_feature_parity_" stamp ".json"))
               {"summary" {"target_date" "2026-07-05"
                           "generated_at" "2026-07-05T14:30:00Z"
                           "matched_rows" 120
                           "feature_count" 918
                           "problem_feature_count" 0
                           "status_counts" {"MATCH" 918}}
                "features" []})
  (write-text! (path analysis (str "matched_feature_parity_" stamp ".csv"))
               "feature,status,correlation,max_abs_deviation\nspy_close,MATCH,1.0,0.0\n")
  (write-text! (path analysis (str "matched_feature_parity_" stamp ".md"))
               "# Matched Feature Parity\n"))

(defn write-bundle! [analysis payloads]
  (.mkdir analysis ** :parents true :exist_ok true)
  (doseq [[name exts] required-artifacts
          ext exts]
    (write-artifact! analysis name ext))
  (let [payload-dir (path payloads stamp)]
    (.mkdir payload-dir ** :parents true :exist_ok true)
    (write-text! (path payload-dir "quote.json") "{\"header\":[\"ms_of_day\",\"bid\"],\"response\":[[34200000,1.23]]}\n")
    (write-text! (path payload-dir "trade.json") "{\"header\":[\"ms_of_day\",\"price\"],\"response\":[[34200001,1.24]]}\n"))
  (patch-payload-paths! analysis payloads)
  (write-parity-proof! analysis))

