(defn run-manifest [args & [opts]]
  (let [cwd (or (get opts :cwd) root)
        env (.copy os/environ)]
    (when-let [extra-env (get opts :env)]
      (.update env (jsonable extra-env)))
    (subprocess/run
     (python/list (concat [basilisp "run" (str script) "--"] args))
     ** :cwd (str cwd)
        :env env
        :text true
        :capture_output true
        :check false)))

(deftest market-evidence-manifest-writes-and-verifies-complete-bundle
  (with-open [tmp-dir (tempfile/TemporaryDirectory)]
    (let [tmp (pathlib/Path tmp-dir)
          analysis (path tmp "analysis")
          payloads (path tmp "payloads")
          manifest (path analysis (str "market_evidence_manifest_" stamp ".json"))]
      (write-bundle! analysis payloads)
      (let [written (run-manifest ["--target-date" "2026-07-05"
                                   "--analysis-dir" (str analysis)
                                   "--payload-dir" (str payloads)
                                   "--out" (str manifest)])]
        (is (= 0 (.-returncode written)) (.-stderr written))
        (let [payload (read-json manifest)]
          (is (= true (get payload "valid?")))
          (is (= stamp (get payload "target_stamp")))
          (is (= 2 (get payload "payload_example_count")))
          (is (= true (get-in payload ["artifacts" "market_evidence_readiness.json" "exists"]))))))))

(deftest market-evidence-manifest-accepts-rsynced-remote-payload-example-paths
  (with-open [tmp-dir (tempfile/TemporaryDirectory)]
    (let [tmp (pathlib/Path tmp-dir)
          analysis (path tmp "analysis")
          payloads (path tmp "payloads")
          manifest (path analysis (str "market_evidence_manifest_" stamp ".json"))]
      (write-bundle! analysis payloads)
      (patch-probe-payload-paths-to-remote! analysis)
      (let [written (run-manifest ["--target-date" "2026-07-05"
                                   "--analysis-dir" (str analysis)
                                   "--payload-dir" (str payloads)
                                   "--out" (str manifest)])]
        (is (= 0 (.-returncode written)) (.-stderr written))
        (let [payload (read-json manifest)
              codes (set (map #(get % "code") (get payload "issues")))]
          (is (= true (get payload "valid?")))
          (is (not (contains? codes "market-evidence/probe-payload-example-not-covered"))))))))

(deftest market-evidence-manifest-includes-optional-diagnostics-when-present
  (with-open [tmp-dir (tempfile/TemporaryDirectory)]
    (let [tmp (pathlib/Path tmp-dir)
          analysis (path tmp "analysis")
          payloads (path tmp "payloads")
          manifest (path analysis (str "market_evidence_manifest_" stamp ".json"))]
      (write-bundle! analysis payloads)
      (write-optional-diagnostics! analysis)
      (let [written (run-manifest ["--target-date" "2026-07-05"
                                   "--analysis-dir" (str analysis)
                                   "--payload-dir" (str payloads)
                                   "--out" (str manifest)])]
        (is (= 0 (.-returncode written)) (.-stderr written))
        (let [payload (read-json manifest)
              artifacts (get payload "artifacts")]
          (is (= true (get payload "valid?")))
          (doseq [artifact ["live_feature_prediction_delta_aggregate.csv"
                            "live_feature_parity_gate.json"
                            "neutralized_feature_unlock_plan.json"
                            "neutralized_feature_evidence_report.json"
                            "blocked_feature_provenance_audit.json"
                            "legacy_greek_formula_search.json"
                            "greek_feature_reconstruction_audit.json"
                            "greek_reconstruction_promotion_gate.json"
                            "capture_v2_runtime_preflight.json"
                            "capture_v2_sidecar_check.json"
                            "historical_feature_cohort.json"
                            "historical_features.npz"
                            "matched_feature_parity.json"
                            "matched_feature_parity.csv"]]
            (is (= true (get-in artifacts [artifact "exists"])) artifact)))))))
