      (write-validation! analysis manifest status ref)
      (let [payload (read-json status)]
        (aset (.get payload "verified_apply_validation") "apply_safe" false)
        (write-json! status payload)
        (let [result (run-script "--target-date" target-date "--analysis-dir" (str analysis)
                                 "--manifest-json" (str manifest) "--status-json" (str status)
                                 "--ref-root" (str ref) "--apply")]
          (is (not= 0 (.-returncode result)))
          (is (str/includes? (.-stderr result) "apply_safe is not true")))))))

(deftest rejects-status-validation-path-mismatch
