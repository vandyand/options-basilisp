        (write-json! dry-run payload)
        (let [result (run-script "--target-date" target-date "--analysis-dir" (str analysis)
                                 "--manifest-json" (str manifest) "--status-json" (str status)
                                 "--ref-root" (str ref) "--apply")]
          (is (not= 0 (.-returncode result)))
          (is (str/includes? (.-stderr result) "mismatch")))))))

(deftest rejects-duplicate-manifest-keys
  (with-fixture
    (fn [_ ref analysis manifest status]
      (.write_text manifest (.replace (.read_text manifest) "\"valid?\": true" "\"valid?\": true, \"valid?\": false" 1))
      (let [result (run-script "--target-date" target-date "--analysis-dir" (str analysis)
                               "--manifest-json" (str manifest) "--status-json" (str status)
                               "--ref-root" (str ref))]
        (is (not= 0 (.-returncode result)))
        (is (str/includes? (.-stderr result) "duplicate JSON key: valid?"))))))

(deftest rejects-forged-manifest-candidate-union
  (with-fixture
    (fn [_ ref analysis manifest status]
      (let [dry-run (path analysis (str "neutralization_unmask_dry_run_" stamp ".json"))
            dry-payload (read-json dry-run)]
        (aset dry-payload "candidate_count" 3)
        (aset dry-payload "candidate_features" (python/list ["raw_0" "v3_0" "forged_0"]))
        (doseq [row (.get dry-payload "results")]
          (aset row "removed" 3)
          (aset row "missing" 0))
        (write-json! dry-run dry-payload)
        (refresh-manifest-artifact! manifest "neutralization_unmask_dry_run.json" dry-run)
        (let [result (run-script "--target-date" target-date "--analysis-dir" (str analysis)
                                 "--manifest-json" (str manifest) "--status-json" (str status)
                                 "--ref-root" (str ref))]
          (is (not= 0 (.-returncode result)))
          (is (str/includes? (.-stderr result) "candidate_features do not match audit union"))
          (is (str/includes? (.-stderr result) "forged_0")))))))

