(deftest rejects-non-input-manifest-artifact-tamper
  (with-fixture
    (fn [_ ref analysis manifest status]
      (write-validation! analysis manifest status ref)
      (let [probe (path analysis (str "thetadata_capability_probe_" stamp ".json"))]
        (write-json! probe {"target_date" target-date "summary" {"usable" 0}})
        (let [result (run-script "--target-date" target-date "--analysis-dir" (str analysis)
                                 "--manifest-json" (str manifest) "--status-json" (str status)
                                 "--ref-root" (str ref) "--apply")]
          (is (not= 0 (.-returncode result)))
          (is (str/includes? (.-stderr result) "thetadata_capability_probe.json"))
          (is (str/includes? (.-stderr result) "mismatch")))))))

(deftest rejects-recorded-missing-artifact-that-now-exists
  (with-fixture
    (fn [_ ref analysis manifest status]
      (write-validation! analysis manifest status ref)
      (let [late-artifact (path analysis (str "late_optional_" stamp ".json"))
            payload (read-json manifest)]
        (aset (.get payload "artifacts") "late_optional.json" {"exists" false "path" (str late-artifact)})
        (write-json! manifest payload)
        (.write_text late-artifact "{}")
        (let [result (run-script "--target-date" target-date "--analysis-dir" (str analysis)
                                 "--manifest-json" (str manifest) "--status-json" (str status)
                                 "--ref-root" (str ref) "--apply")]
          (is (not= 0 (.-returncode result)))
          (is (str/includes? (.-stderr result) "recorded artifact missing but it now exists")))))))
