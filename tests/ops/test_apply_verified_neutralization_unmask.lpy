(deftest allows-extra-audit-row-candidates-without-summary-count
  (with-fixture
    (fn [_ ref analysis manifest status]
      (let [v3-audit (path analysis (str "v3_grid_unlock_audit_" stamp ".json"))
            payload (read-json v3-audit)]
        (.pop (.get payload "summary") "candidate_count")
        (.pop (.get payload "summary") "candidate_features")
        (aset payload "features" (python/list [{"feature" "v3_0" "candidate" true}
                                               {"feature" "ignored" "candidate" false}]))
        (write-json! v3-audit payload)
        (refresh-manifest-artifact! manifest "v3_grid_unlock_audit.json" v3-audit)
        (let [result (run-script "--target-date" target-date "--analysis-dir" (str analysis)
                                 "--manifest-json" (str manifest) "--status-json" (str status)
                                 "--ref-root" (str ref))
              payload (loads (.-stdout result))]
          (is (= 0 (.-returncode result)) (.-stderr result))
          (is (= 2 (.get payload "candidate_count"))))))))

(defn write-greek-audit! [analysis payload]
  (let [greek-audit (path analysis (str "greek_reconstruction_promotion_gate_" stamp ".json"))]
    (write-json! greek-audit payload)
    greek-audit))

(deftest rejects-bad-greek-promotion-coverage
  (with-fixture
    (fn [_ ref analysis manifest status]
      (let [greek-audit (write-greek-audit!
                         analysis
                         {"summary" {"target_date" target-date "capture_ok" true "capture_reasons" []
                                     "coverage_ok" false "coverage_reasons" ["evaluated rows 45 below minimum 60"]
                                     "evaluated_count" 45 "min_evaluated_count" 60
                                     "candidate_count" 0 "candidate_features" []}
                          "features" []})]
        (refresh-manifest-artifact! manifest "greek_reconstruction_promotion_gate.json" greek-audit)
        (let [result (run-script "--target-date" target-date "--analysis-dir" (str analysis)
                                 "--manifest-json" (str manifest) "--status-json" (str status)
                                 "--ref-root" (str ref))]
          (is (not= 0 (.-returncode result)))
          (is (str/includes? (.-stderr result) "Greek promotion audit coverage_ok is not true")))))))

(deftest rejects-bad-greek-promotion-capture
  (with-fixture
    (fn [_ ref analysis manifest status]
      (let [greek-audit (write-greek-audit!
                         analysis
                         {"summary" {"target_date" target-date "capture_ok" false "capture_reasons" ["capture check has issues"]
                                     "coverage_ok" true "coverage_reasons" []
                                     "evaluated_count" 60 "min_evaluated_count" 60
                                     "candidate_count" 1 "candidate_features" ["v3_0"]}
                          "features" [{"feature" "v3_0" "candidate" true}]})]
        (refresh-manifest-artifact! manifest "greek_reconstruction_promotion_gate.json" greek-audit)
        (let [result (run-script "--target-date" target-date "--analysis-dir" (str analysis)
                                 "--manifest-json" (str manifest) "--status-json" (str status)
                                 "--ref-root" (str ref))]
          (is (not= 0 (.-returncode result)))
          (is (str/includes? (.-stderr result) "Greek promotion audit capture_ok is not true")))))))

(deftest rejects-boolean-greek-evaluated-count
  (with-fixture
    (fn [_ ref analysis manifest status]
      (let [greek-audit (write-greek-audit!
                         analysis
                         {"summary" {"target_date" target-date "capture_ok" true "capture_reasons" []
                                     "coverage_ok" true "coverage_reasons" []
                                     "evaluated_count" true "min_evaluated_count" 0
                                     "candidate_count" 0 "candidate_features" []}
                          "features" []})]
        (refresh-manifest-artifact! manifest "greek_reconstruction_promotion_gate.json" greek-audit)
        (let [result (run-script "--target-date" target-date "--analysis-dir" (str analysis)
                                 "--manifest-json" (str manifest) "--status-json" (str status)
                                 "--ref-root" (str ref))]
          (is (not= 0 (.-returncode result)))
          (is (str/includes? (.-stderr result) "Greek promotion audit evaluated_count must be a nonnegative integer")))))))

(deftest rejects-stale-raw-audit-target
  (with-fixture
    (fn [_ ref analysis manifest status]
      (let [raw-audit (path analysis (str "raw_feature_unlock_audit_" stamp ".json"))
            payload (read-json raw-audit)]
        (aset (.get payload "summary") "target_date" "2026-07-04")
        (write-json! raw-audit payload)
        (refresh-manifest-artifact! manifest "raw_feature_unlock_audit.json" raw-audit)
        (let [result (run-script "--target-date" target-date "--analysis-dir" (str analysis)
                                 "--manifest-json" (str manifest) "--status-json" (str status)
                                 "--ref-root" (str ref))]
          (is (not= 0 (.-returncode result)))
          (is (str/includes? (.-stderr result) "audit target_date '2026-07-04' does not match '2026-07-05'")))))))

