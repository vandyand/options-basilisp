(deftest rejects-boolean-audit-candidate-count
  (with-fixture
    (fn [_ ref analysis manifest status]
      (let [raw-audit (path analysis (str "raw_feature_unlock_audit_" stamp ".json"))
            payload (read-json raw-audit)]
        (aset (.get payload "summary") "candidate_count" true)
        (write-json! raw-audit payload)
        (refresh-manifest-artifact! manifest "raw_feature_unlock_audit.json" raw-audit)
        (let [result (run-script "--target-date" target-date "--analysis-dir" (str analysis)
                                 "--manifest-json" (str manifest) "--status-json" (str status)
                                 "--ref-root" (str ref))]
