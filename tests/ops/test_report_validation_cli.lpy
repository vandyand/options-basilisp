(deftest audit-daily-report-validations-fails-bad-bundles
  (with-open [tmp-dir (tempfile/TemporaryDirectory)]
    (let [tmp (pathlib/Path tmp-dir)
          empty-dir (path tmp "empty")
          orphan-dir (path tmp "orphan")
          malformed-dir (path tmp "malformed")]
      (.mkdir empty-dir)
      (.mkdir orphan-dir)
      (.mkdir malformed-dir)
      (write-validation! orphan-dir "2026-07-02")
      (.write_text (path orphan-dir "20260701.html") "<html>unchecked</html>\n")
      (write-json! (path malformed-dir "20261301.validation.json") (valid-report-payload "2026-07-02"))
      (let [empty-result (run-basilisp audit-script :args ["--daily-dir" (str empty-dir) "--all"])
            orphan-result (run-basilisp audit-script :args ["--daily-dir" (str orphan-dir) "--all"])
            malformed-result (run-basilisp audit-script :args ["--daily-dir" (str malformed-dir) "--all"])
            empty-payload (read-json-from-stdout empty-result)
            orphan-payload (read-json-from-stdout orphan-result)
            malformed-payload (read-json-from-stdout malformed-result)
            malformed-codes (issue-codes malformed-payload)]
        (is (= 1 (.-returncode empty-result)))
        (is (= false (.get empty-payload "valid?")))
        (is (= 0 (.get empty-payload "checked")))
        (is (contains? (issue-codes empty-payload) "no-daily-validation-artifacts"))
        (is (= 1 (.-returncode orphan-result)))
        (is (= 1 (.get orphan-payload "checked")))
        (is (contains? (issue-codes orphan-payload) "orphan-daily-html-artifact"))
        (is (= 1 (.-returncode malformed-result)))
        (is (contains? malformed-codes "validation-filename-date-unparseable"))
        (is (contains? malformed-codes "validation-date-filename-mismatch"))))))

(deftest audit-daily-report-validations-warns-and-writes-manifest
  (with-open [tmp-dir (tempfile/TemporaryDirectory)]
    (let [tmp (pathlib/Path tmp-dir)
          warn-dir (path tmp "warn")
          ok-dir (path tmp "ok")]
      (.mkdir warn-dir)
      (.mkdir ok-dir)
      (let [validation (assoc-in (valid-report-payload "2026-07-02")
                                 ["accounts" 0 "broker/equity-observed?"]
                                 false)]
        (write-json! (path warn-dir "20260702.validation.json") validation)
        (.write_text (path warn-dir "20260702.html") "<html>warning</html>\n"))
      (write-validation! ok-dir "2026-07-02")
      (let [warn-result (run-basilisp audit-script :args ["--daily-dir" (str warn-dir) "--date" "2026-07-02"])
            ok-result (run-basilisp audit-script :args ["--daily-dir" (str ok-dir) "--date" "2026-07-02" "--write-manifests" "--require-manifests"])
            warn-payload (read-json-from-stdout warn-result)
            ok-payload (read-json-from-stdout ok-result)]
        (is (= 0 (.-returncode warn-result)))
        (is (= true (.get warn-payload "valid?")))
        (is (= "warn" (.get warn-payload "status")))
        (is (= true (.get (first (.get warn-payload "results")) "valid?")))
        (is (= "warn" (.get (first (.get warn-payload "results")) "status")))
        (is (some #(= "missing-equity-observation" (.get % "code"))
                  (mapcat #(.get % "issues") (.get warn-payload "results"))))
        (is (= 0 (.-returncode ok-result)) (.-stderr ok-result))
        (is (= true (.get ok-payload "valid?")))
        (is (= 1 (.get ok-payload "checked")))
        (is (.exists (path ok-dir "20260702.validation.json.manifest.edn")))))))

(deftest audit-daily-report-validations-rejects-manifest-tampering
  (with-open [tmp-dir (tempfile/TemporaryDirectory)]
    (let [tmp (pathlib/Path tmp-dir)
          mutators [(python/tuple ["validated-at-unparseable"
                                   (fn [daily-dir]
                                     (write-daily-artifact-manifest! daily-dir :validated-at "not-a-timestamp")
                                     "daily-artifact-manifest-validated-at-unparseable")])
                    (python/tuple ["validated-at-future"
                                   (fn [daily-dir]
                                     (write-daily-artifact-manifest! daily-dir :validated-at "2999-01-01T00:00:00Z")
                                     "daily-artifact-manifest-validated-at-in-future")])
                    (python/tuple ["wrong-daily-dir"
                                   (fn [daily-dir]
                                     (let [other (path (.-parent daily-dir) "other-daily")]
                                       (.mkdir other)
                                       (write-daily-artifact-manifest! daily-dir :manifest-daily-dir other)
                                       "daily-artifact-manifest-daily-dir-mismatch"))])
                    (python/tuple ["short-validation-sha"
                                   (fn [daily-dir]
                                     (let [manifest (write-daily-artifact-manifest! daily-dir)
                                           sha (get (file-artifact (path daily-dir "20260702.validation.json")) "sha256")]
                                       (.write_text manifest (str/replace-first (.read_text manifest) sha "abc"))
                                       "daily-artifact-manifest-artifact-sha256-invalid"))])
                    (python/tuple ["uppercase-validation-sha"
                                   (fn [daily-dir]
                                     (let [manifest (write-daily-artifact-manifest! daily-dir)
                                           sha (get (file-artifact (path daily-dir "20260702.validation.json")) "sha256")]
                                       (.write_text manifest (str/replace-first (.read_text manifest) sha (.upper sha)))
                                       "daily-artifact-manifest-artifact-sha256-invalid"))])
                    (python/tuple ["nonhex-html-sha"
                                   (fn [daily-dir]
                                     (let [manifest (write-daily-artifact-manifest! daily-dir)
                                           sha (get (file-artifact (path daily-dir "20260702.html")) "sha256")]
                                       (.write_text manifest (str/replace-first (.read_text manifest) sha (apply str (repeat 64 "g"))))
                                       "daily-artifact-manifest-artifact-sha256-invalid"))])
                    (python/tuple ["nonstring-html-sha"
                                   (fn [daily-dir]
                                     (let [manifest (write-daily-artifact-manifest! daily-dir)
                                           sha (get (file-artifact (path daily-dir "20260702.html")) "sha256")]
                                       (.write_text manifest (str/replace-first (.read_text manifest) (edn-string sha) "1234"))
                                       "daily-artifact-manifest-artifact-sha256-invalid"))])]]
      (doseq [[idx pair] (map-indexed vector mutators)]
        (let [[name mutate] pair
              daily-dir (path tmp (str "case-" idx))]
          (.mkdir daily-dir)
          (write-validation! daily-dir "2026-07-02")
          (let [expected-code (mutate daily-dir)
                result (run-basilisp audit-script :args ["--daily-dir" (str daily-dir) "--date" "2026-07-02" "--require-manifests"])
                payload (read-json-from-stdout result)]
            (is (= 1 (.-returncode result)) (str name " " (.-stdout result) " " (.-stderr result)))
            (is (contains? (issue-codes payload) expected-code))))))))

(deftest audit-status-publication-cli-and-valid-manifest
  (with-open [tmp-dir (tempfile/TemporaryDirectory)]
    (let [tmp (pathlib/Path tmp-dir)
          valid-dir (path tmp "valid")
          help (run-basilisp status-audit-script :args ["--help"])
          unknown (run-basilisp status-audit-script :args ["--wat"])
          missing (run-basilisp status-audit-script :args ["--out-dir"])]
      (.mkdir valid-dir)
      (write-status-publication! valid-dir)
      (let [valid (run-basilisp status-audit-script :args ["--out-dir" (str valid-dir)])
            payload (read-json-from-stdout valid)]
        (is (= 0 (.-returncode help)))
        (is (str/includes? (.-stdout help) "audit_status_publication.lpy"))
        (is (= 2 (.-returncode unknown)))
        (is (str/includes? (.-stderr unknown) "unknown argument: --wat"))
        (is (= 2 (.-returncode missing)))
        (is (str/includes? (.-stderr missing) "missing value for --out-dir"))
        (is (= 0 (.-returncode valid)) (str (.-stdout valid) (.-stderr valid)))
        (is (= true (.get payload "valid?")) (str payload))))))

(deftest audit-status-publication-rejects-deterministic-tampering
  (with-open [tmp-dir (tempfile/TemporaryDirectory)]
    (let [tmp (pathlib/Path tmp-dir)
          mutators [(python/tuple ["remove-required-entry"
                                   (fn [out-dir]
                                     (let [manifest (read-json (path out-dir "status.publish.json"))]
                                       (.pop (.get manifest "artifacts") "index.html")
                                       (write-json! (path out-dir "status.publish.json") manifest)
                                       "publish-manifest-missing-artifact-entry"))])
                    (python/tuple ["unsafe-artifact-name"
                                   (fn [out-dir]
                                     (let [manifest (read-json (path out-dir "status.publish.json"))]
                                       (.__setitem__ (.get manifest "artifacts") "../outside.json" (jsonable (artifact-entry "outside\n")))
                                       (write-json! (path out-dir "status.publish.json") manifest)
                                       "publish-manifest-unsafe-artifact-name"))])
                    (python/tuple ["extra-safe-artifact-name"
                                   (fn [out-dir]
                                     (let [extra "legacy-status.json"
                                           manifest (read-json (path out-dir "status.publish.json"))]
                                       (.write_text (path out-dir extra) "{}\n")
                                       (.__setitem__ (.get manifest "artifacts") extra (jsonable (artifact-entry "{}\n")))
                                       (write-json! (path out-dir "status.publish.json") manifest)
                                       "publish-manifest-extra-artifact-entry"))])
                    (python/tuple ["symlink-escape"
                                   (fn [out-dir]
                                     (let [escaped (path (.-parent out-dir) "escaped-status.json")
                                           status (path out-dir "status.json")]
                                       (.write_text escaped (.read_text status))
                                       (.unlink status)
                                       (.symlink_to status escaped)
                                       (refresh-status-manifest! out-dir)
                                       "published-artifact-path-escape"))])
                    (python/tuple ["wrong-kind"
                                   (fn [out-dir]
                                     (let [manifest (read-json (path out-dir "status.publish.json"))]
                                       (.__setitem__ manifest "manifest_kind" "wrong/status-manifest")
                                       (write-json! (path out-dir "status.publish.json") manifest)
                                       "publish-manifest-kind-invalid"))])
                    (python/tuple ["wrong-version"
                                   (fn [out-dir]
                                     (let [manifest (read-json (path out-dir "status.publish.json"))]
                                       (.__setitem__ manifest "manifest_version" 999)
                                       (write-json! (path out-dir "status.publish.json") manifest)
                                       "publish-manifest-version-invalid"))])
                    (python/tuple ["extra-manifest-key"
                                   (fn [out-dir]
                                     (let [manifest (read-json (path out-dir "status.publish.json"))]
                                       (.__setitem__ manifest "unexpected" true)
                                       (write-json! (path out-dir "status.publish.json") manifest)
                                       "publish-manifest-extra-keys"))])
                    (python/tuple ["remove-manifest-key"
                                   (fn [out-dir]
                                     (let [manifest (read-json (path out-dir "status.publish.json"))]
                                       (.pop manifest "generated_at")
                                       (write-json! (path out-dir "status.publish.json") manifest)
                                       "publish-manifest-missing-keys"))])
                    (python/tuple ["bad-artifact-shape"
                                   (fn [out-dir]
                                     (let [manifest (read-json (path out-dir "status.publish.json"))]
                                       (.__setitem__ (.get manifest "artifacts") "status.json" "not an artifact entry")
                                       (write-json! (path out-dir "status.publish.json") manifest)
                                       "publish-manifest-artifact-invalid-shape"))])
                    (python/tuple ["bad-sha"
                                   (fn [out-dir]
                                     (let [manifest (read-json (path out-dir "status.publish.json"))]
                                       (.__setitem__ (.get (.get manifest "artifacts") "status.json") "sha256" "abc")
                                       (write-json! (path out-dir "status.publish.json") manifest)
                                       "publish-manifest-artifact-sha256-invalid"))])
                    (python/tuple ["status-stale"
                                   (fn [out-dir]
                                     (let [ny (zoneinfo/ZoneInfo "America/New_York")
                                           stale (.replace (- (.now datetime/datetime ny) (datetime/timedelta ** :minutes 45)) ** :microsecond 0)
                                           status-payload (read-json (path out-dir "status.json"))]
                                       (.__setitem__ status-payload "generated_at" (.isoformat stale))
                                       (write-json! (path out-dir "status.json") status-payload)
                                       (let [manifest (refresh-status-manifest! out-dir)]
                                         (.__setitem__ manifest "generated_at" (.isoformat stale))
                                         (write-json! (path out-dir "status.publish.json") manifest))
                                       "published-status-validation-failed"))])
                    (python/tuple ["fake-validation"
                                   (fn [out-dir]
                                     (write-json! (path out-dir "status.validation.json")
                                                  {"valid?" true
                                                   "issues" [{"severity" "bad" "code" "status/fake-clean" "detail" "tampered"}]})
                                     (refresh-status-manifest! out-dir)
                                     "published-validation-issues-mismatch")])
                    (python/tuple ["missing-embedded-validation"
                                   (fn [out-dir]
                                     (let [status-payload (read-json (path out-dir "status.json"))]
                                       (.pop status-payload "artifact_validation")
                                       (write-json! (path out-dir "status.json") status-payload)
                                       (refresh-status-manifest! out-dir)
                                       "published-embedded-validation-unreadable"))])
                    (python/tuple ["duplicate-strategy"
                                   (fn [out-dir]
                                     (let [status-payload (read-json (path out-dir "status.json"))
                                           rows (.get status-payload "strategy_rows")]
                                       (.__setitem__ status-payload "strategy_rows" (python/list (concat [(.__getitem__ rows 0)] (butlast rows))))
                                       (write-json! (path out-dir "status.json") status-payload)
                                       (refresh-status-manifest! out-dir)
                                       "published-status-validation-failed"))])
                    (python/tuple ["manifest-generated-at-mismatch"
                                   (fn [out-dir]
                                     (let [manifest (read-json (path out-dir "status.publish.json"))]
                                       (.__setitem__ manifest "generated_at" "2026-07-05T00:00:00-04:00")
                                       (write-json! (path out-dir "status.publish.json") manifest)
                                       "publish-manifest-generated-at-mismatch"))])
                    (python/tuple ["remove-nav-target"
                                   (fn [out-dir]
                                     (.unlink (path (path (.-parent out-dir) "daily") "index.html"))
                                     "nav-target-missing")])
                    (python/tuple ["remove-required-initiative"
                                   (fn [out-dir]
                                     (let [status-payload (read-json (path out-dir "status.json"))
                                           initiatives (.get status-payload "initiatives")]
                                       (.__setitem__ status-payload "initiatives"
                                                     (python/list (filter #(not= "L4 Options Paper Brokerage" (.get % "name")) initiatives)))
                                       (write-json! (path out-dir "status.json") status-payload)
                                       (refresh-status-manifest! out-dir)
                                       "published-status-validation-failed"))])]]
      (doseq [[idx pair] (map-indexed vector mutators)]
        (let [[name mutate] pair
              out-dir (path tmp (str "case-" idx))]
          (.mkdir out-dir)
          (write-status-publication! out-dir)
          (let [expected-suffix (mutate out-dir)
                result (run-basilisp status-audit-script :args ["--out-dir" (str out-dir)])
                payload (read-json-from-stdout result)
                codes (issue-codes payload)]
            (is (= 1 (.-returncode result)) (str name " " (.-stdout result) " " (.-stderr result)))
            (is (some #(.endswith % expected-suffix) codes) (str name " " codes))))))))

(deftest report-validation-clis-run-from-non-repo-cwd
  (with-open [tmp-dir (tempfile/TemporaryDirectory)]
    (let [tmp (pathlib/Path tmp-dir)
          scratch (path tmp "scratch")
          daily-dir (path tmp "daily")
          status-dir (path tmp "status")]
      (.mkdir scratch)
      (.mkdir daily-dir)
      (.mkdir status-dir)
      (write-validation! daily-dir "2026-07-02")
      (write-status-publication! status-dir)
      (let [validation (run-basilisp validate-script
                                      :args [(str (path daily-dir "20260702.validation.json"))]
                                      :cwd scratch
                                      :env {"STEVE_REPO_ROOT" (str root)})
            daily-audit (run-basilisp audit-script
                                      :args ["--daily-dir" (str daily-dir)
                                             "--date" "2026-07-02"
                                             "--write-manifests"
                                             "--require-manifests"]
                                      :cwd scratch
                                      :env {"STEVE_REPO_ROOT" (str root)})
            status-audit (run-basilisp status-audit-script
                                       :args ["--out-dir" (str status-dir)]
                                       :cwd scratch
                                       :env {"STEVE_REPO_ROOT" (str root)})]
        (is (= 0 (.-returncode validation)) (.-stderr validation))
        (is (= 0 (.-returncode daily-audit)) (.-stderr daily-audit))
        (is (= 0 (.-returncode status-audit)) (str (.-stdout status-audit) (.-stderr status-audit)))
        (is (= true (.get (read-json-from-stdout daily-audit) "valid?")))
        (is (= true (.get (read-json-from-stdout status-audit) "valid?"))
            (str (read-json-from-stdout status-audit)))))))

(deftest run-reports-script-guards-current-report-flow
  (let [script (.read_text run-reports-script)]
    (doseq [snippet ["REPORTS_TARGET_DATE"
                     "REPORTS_DATE"
                     "scripts/report_target_date.lpy"
                     "could not determine completed report target date"
                     "generate_daily_validation"
                     "scripts/generate_daily_validation.lpy"
                     "Report artifact build attempt"
                     "Reports target date - $TODAY"
                     "Reports mode - $MODE"
                     "--date \"$TODAY\""
                     "if [[ \"$MODE\" != \"backfill\" && ! -f \"$daily_dir/${TODAY//-/}.validation.json\" ]]"
                     "scripts/previous_trading_day.lpy"
                     "could not determine previous trading day"
                     "latest_validation="
                     "-name '*.validation.json'"
                     "| tail -n 1"
                     "if [[ \"$latest_date\" != \"$expected_latest\" ]]"
                     "latest report validation artifact is stale"
                     "Auditing latest existing daily validation artifact"
                     "--date \"$latest_date\""
                     "WARN: latest report validation audit found issues"
                     "no prior daily validation artifact found"
                     "BASILISP=\"${BASILISP_BIN:-$BASILISP_ROOT/.venv/bin/basilisp}\""
                     "BASILISP=\"/opt/stevetrading/shared/Data-Preprocessor/.venv/bin/basilisp\""
                     "export BASILISP_BIN=\"$BASILISP\""
                     "if [[ -x \"$BASILISP\""
                     "-f \"$BASILISP_ROOT/scripts/audit_daily_report_validations.lpy\""
                     "runner not executable: $BASILISP"
                     "exit 2"
                     "rm \"$plural\""
                     "cp -a \"$singular\" \"$plural\""
                     "normalize_report_nav"
                     "render_daily_report"
                     "scripts/render_daily_report.lpy"
                     "render_weekly_report"
                     "scripts/render_weekly_report.lpy"
                     "render_classic_reports"
                     "render_account_reports"
                     "scripts/render_account_reports.lpy"
                     "RESULT: FAILED classic report render"
                     "build_daily_report_index"
                     "scripts/build_daily_report_index.lpy"
                     "--weekly-dir \"$weekly_dir\""
                     "--accounts-dir \"$accounts_dir\""
                     "build_reports_overview_index"
                     "scripts/build_reports_overview_index.lpy"
                     "--reports-dir \"$reports_dir\""
                     "verify_local_daily_report_index"
                     "local daily index does not link"
                     "RESULT: FAILED local daily report index verification"
                     "/reports/account/index\\.html#/reports/accounts/index.html"
                     "<a href=\"/reports/status/index.html\">System</a>"
                     "build_mode=\"skip-deploy\""
                     "DEPLOY_ATTEMPTS=\"${REPORTS_DEPLOY_ATTEMPTS:-3}\""
                     "VERIFY_ATTEMPTS=\"${REPORTS_VERIFY_ATTEMPTS:-9}\""
                     "publish_reports_site"
                     "Publication attempt $attempt/$DEPLOY_ATTEMPTS"
                     "report publication after $DEPLOY_ATTEMPTS attempts"
                     "Public report verification diagnostic:"
                     "verify_public_classic_overview"
                     "Public classic overview verified"
                     "public overview is not the classic report UI"
                     "RESULT: FAILED report publication exit=$rc"]]
      (is (str/includes? script snippet) snippet))
    (is (< (.index script "ensure_accounts_nav_target") (.index script "publish_reports_site")))
    (is (< (.index script "normalize_report_nav") (.index script "publish_reports_site")))
    (let [build-ok-block (subs script (.index script "if [[ \"$build_ok\" == \"1\" ]]"))]
      (is (< (.index build-ok-block "render_classic_reports") (.index build-ok-block "verify_local_daily_report_index")))
      (is (not (str/includes? build-ok-block "render_daily_report &&"))))
    (is (< (.index script "verify_local_daily_report_index") (.index script "publish_reports_site")))
    (is (not (str/includes? script "PATH=\"$REF_ROOT/.venv/bin:$PATH\"")))
    (is (not (str/includes? script "REPORTS_RENDERER")))
    (is (str/includes? script "render_classic_reports"))
    (is (str/includes? script "$REF_ROOT/.venv/bin/python3"))
    (is (not (str/includes? script "REPORTS_SKIP_PYTHON")))
    (is (not (str/includes? script "bash deploy_reports.sh")))))

(deftest trading-day-and-report-target-helpers
  (let [previous (run-basilisp previous-trading-day-script :args ["2026-07-05"])
        before-close (run-basilisp report-target-date-script :args ["--now" "2026-07-09T04:03:00-04:00"])
        after-close (run-basilisp report-target-date-script :args ["--now" "2026-07-08T16:05:00-04:00"])
        holiday-weekend (run-basilisp report-target-date-script :args ["--now" "2026-07-05T12:00:00-04:00"])]
    (is (= 0 (.-returncode previous)))
    (is (= "2026-07-02" (.strip (.-stdout previous))))
    (is (= 0 (.-returncode before-close)))
    (is (= "2026-07-08" (.strip (.-stdout before-close))))
    (is (= 0 (.-returncode after-close)))
    (is (= "2026-07-08" (.strip (.-stdout after-close))))
    (is (= 0 (.-returncode holiday-weekend)))
    (is (= "2026-07-02" (.strip (.-stdout holiday-weekend))))))

(deftest build-status-cli-contract
  (with-open [tmp-dir (tempfile/TemporaryDirectory)]
    (let [tmp (pathlib/Path tmp-dir)
          help (run-basilisp build-status-script :args ["--help"])
          unknown (run-basilisp build-status-script :args ["--oops"])
          missing (run-basilisp build-status-script :args ["--out-dir" "--no-probes"])
          invalid-date (run-basilisp build-status-script :args ["--date" "2026-02-31" "--out-dir" (str tmp) "--no-probes"])
          no-probes (run-basilisp build-status-script :args ["--date" "2026-07-03" "--out-dir" (str tmp) "--no-probes"])]
      (is (= 0 (.-returncode help)))
      (is (str/includes? (.-stdout help) "build_status.lpy"))
      (is (= 2 (.-returncode unknown)))
      (is (str/includes? (.-stderr unknown) "unknown argument: --oops"))
      (is (= 2 (.-returncode missing)))
      (is (str/includes? (.-stderr missing) "missing value for --out-dir"))
      (is (= 2 (.-returncode invalid-date)))
      (is (str/includes? (.-stderr invalid-date) "invalid date for --date: 2026-02-31"))
      (is (= 1 (.-returncode no-probes)))
      (is (str/includes? (.-stderr no-probes) "dependency probes were disabled"))
      (is (not (.exists (path tmp "status.publish.json")))))))
