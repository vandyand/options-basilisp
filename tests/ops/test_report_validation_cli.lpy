(ns ops.test-report-validation-cli
  (:import datetime hashlib json os pathlib shutil subprocess sys tempfile zoneinfo)
  (:require [basilisp.test :refer [deftest is]]
            [clojure.string :as str]
            [stevetrading.status.core :as status]))

(def root (pathlib/Path (os/getcwd)))
(def validate-script "scripts/validate_report_day.lpy")
(def audit-script "scripts/audit_daily_report_validations.lpy")
(def status-audit-script "scripts/audit_status_publication.lpy")
(def build-status-script "scripts/build_status.lpy")
(def previous-trading-day-script "scripts/previous_trading_day.lpy")
(def report-target-date-script "scripts/report_target_date.lpy")
(def repair-daily-index-script "scripts/repair_daily_report_index.lpy")
(def build-daily-index-script "scripts/build_daily_report_index.lpy")
(def build-overview-index-script "scripts/build_reports_overview_index.lpy")
(def render-daily-report-script "scripts/render_daily_report.lpy")
(def render-weekly-report-script "scripts/render_weekly_report.lpy")
(def render-account-reports-script "scripts/render_account_reports.lpy")
(def generate-daily-validation-script "scripts/generate_daily_validation.lpy")
(def run-reports-script (.joinpath root "projects/ops/scripts/run_reports.sh"))

(defn resolve-basilisp []
  (cond
    (os.environ/get "BASILISP_BIN") (pathlib/Path (os.environ/get "BASILISP_BIN"))
    (.exists (.joinpath root ".venv/bin/basilisp")) (.joinpath root ".venv/bin/basilisp")
    (.exists (.with_name (pathlib/Path sys/executable) "basilisp")) (.with_name (pathlib/Path sys/executable) "basilisp")
    (shutil/which "basilisp") (pathlib/Path (shutil/which "basilisp"))
    :else (.joinpath root ".venv/bin/basilisp")))

(def basilisp-bin (str (resolve-basilisp)))

(defn jsonable [x]
  (cond
    (map? x) (python/dict (map (fn [[k v]] (python/tuple [(str k) (jsonable v)])) x))
    (python/isinstance x python/dict) (python/dict (map (fn [[k v]] (python/tuple [(str k) (jsonable v)])) (.items x)))
    (or (vector? x) (seq? x) (python/isinstance x python/list)) (python/list (map jsonable x))
    :else x))

(defn dumps
  ([x] (json/dumps (jsonable x)))
  ([x & kwargs] (apply json/dumps (jsonable x) kwargs)))

(defn read-json [p] (json/loads (.read_text p)))
(defn write-json! [p payload] (.write_text p (str (json/dumps (jsonable payload) ** :indent 2 :sort_keys true) "\n")))
(defn path [parent child] (.joinpath parent child))

(defn merged-env [env]
  (let [out (.copy os/environ)]
    (.update out (jsonable (or env {})))
    out))

(defn run-basilisp [script & opts]
  (let [opts-map (into {} (map vec (partition 2 opts)))
        cwd (get opts-map :cwd root)
        env (get opts-map :env {})
        args (get opts-map :args [])
        script-path (let [candidate (pathlib/Path script)]
                      (if (.is_absolute candidate) candidate (.joinpath root script)))]
    (subprocess/run
     (python/list (concat [basilisp-bin "run" (str script-path) "--"] args))
     ** :cwd (str cwd)
        :env (merged-env env)
        :text true
        :capture_output true
        :check false)))

(defn valid-report-payload
  ([] (valid-report-payload "2026-07-02"))
  ([date]
   {"report/date" date
    "report/rendered?" true
    "accounts" [{"account/id" "account/alpaca/parrot-paper"
                 "report/date" date
                 "trade/closed-count" 1
                 "order/count" 2
                 "positions/open-count" 0
                 "positions/open" []
                 "pnl/equity-day" "25.00"
                 "pnl/realized" "25.00"
                 "pnl/unrealized" "0.00"
                 "pnl/closed-trades" "25.00"
                 "broker/equity-observed?" true
                 "report/explanations" []}]}))

(defn write-validation!
  ([daily-dir] (write-validation! daily-dir "2026-07-02"))
  ([daily-dir date]
   (let [stamp (str/replace date "-" "")
         validation (path daily-dir (str stamp ".validation.json"))
         html (path daily-dir (str stamp ".html"))]
     (write-json! validation (valid-report-payload date))
     (.write_text html "<html>ok</html>\n")
     validation)))

(defn sha256-text [text]
  (.hexdigest (hashlib/sha256 (.encode text "utf-8"))))

(defn artifact-entry [text]
  {"sha256" (sha256-text text)
   "bytes" (python/len (.encode text "utf-8"))})

(defn file-artifact [p]
  (let [data (.read_bytes p)]
    {"path" (str p)
     "sha256" (.hexdigest (hashlib/sha256 data))
     "bytes" (python/len data)}))

(defn edn-string [value] (json/dumps value))

(defn write-daily-artifact-manifest!
  ([daily-dir] (write-daily-artifact-manifest! daily-dir :date "2026-07-02"))
  ([daily-dir & opts]
   (let [opts-map (into {} (map vec (partition 2 opts)))
         date (get opts-map :date "2026-07-02")
         validated-at (get opts-map :validated-at "2026-07-02T21:00:00+00:00")
         manifest-daily-dir (get opts-map :manifest-daily-dir daily-dir)
         compact (str/replace date "-" "")
         validation-path (path daily-dir (str compact ".validation.json"))
         html-path (path daily-dir (str compact ".html"))
         validation (file-artifact validation-path)
         html (file-artifact html-path)
         manifest-path (path daily-dir (str (.-name validation-path) ".manifest.edn"))]
     (.write_text
      manifest-path
      (str/join
       "\n"
       ["{:manifest/version 1"
        " :manifest/kind :reporting/daily-report-artifacts-v1"
        (str " :report/date " (edn-string date))
        (str " :report/validated-at " (edn-string validated-at))
        (str " :daily-dir " (edn-string (str manifest-daily-dir)))
        (str " :validation/artifact "
             "{:path " (edn-string (get validation "path"))
             " :sha256 " (edn-string (get validation "sha256"))
             " :bytes " (get validation "bytes") "}")
        " :validation/status :ok"
        " :validation/valid? true"
        " :validation/account-count 1"
        (str " :html/artifact "
             "{:path " (edn-string (get html "path"))
             " :sha256 " (edn-string (get html "sha256"))
             " :bytes " (get html "bytes") "}}}")
        ""]))
     manifest-path)))

(defn refresh-status-manifest! [out-dir]
  (let [manifest-path (path out-dir "status.publish.json")
        manifest (read-json manifest-path)
        artifacts (.setdefault manifest "artifacts" (python/dict))]
    (doseq [name ["status.json" "status.validation.json" "index.html"]]
      (let [p (path out-dir name)]
        (when (.exists p)
          (.__setitem__ artifacts name (jsonable (artifact-entry (.read_text p)))))))
    (write-json! manifest-path manifest)
    manifest))

(defn previous-weekday [d]
  (loop [candidate d]
    (if (< (.weekday candidate) 5)
      candidate
      (recur (- candidate (datetime/timedelta ** :days 1))))))

(defn write-status-publication! [out-dir]
  (let [ny (zoneinfo/ZoneInfo "America/New_York")
        now-dt (.replace (.now datetime/datetime ny) ** :microsecond 0)
        now (.isoformat now-dt)
        session-date (.date now-dt)
        report-due (.replace now-dt ** :hour 16 :minute 5 :second 0 :microsecond 0)
        expected-date (previous-weekday (if (>= now-dt report-due)
                                          session-date
                                          (- session-date (datetime/timedelta ** :days 1))))
        expected-iso (.isoformat expected-date)
        expected-stamp (str/replace expected-iso "-" "")
        reports-dir (.-parent out-dir)
        session-iso (.isoformat session-date)
        session-stamp (str/replace session-iso "-" "")
        market-evidence-status (path out-dir (str "market_evidence_status_" session-stamp ".json"))
        strategy-rows [["CHESTNUT" "strategy/steve-v2/chestnut/v1" "account/alpaca/chestnut-paper" "alpaca-paper"]
                       ["LYNX" "strategy/steve-v2/lynx/v1" "account/alpaca/lynx-paper" "alpaca-paper"]
                       ["MOOSE" "strategy/steve-v2/moose/v1" "account/alpaca/moose-paper" "alpaca-paper"]
                       ["OAK" "strategy/steve-v2/oak/v1" "account/alpaca/oak-paper" "alpaca-paper"]
                       ["PARROT" "strategy/steve-v2/parrot/v1" "account/alpaca/parrot-paper" "alpaca-paper"]
                       ["DOLPHIN" "strategy/steve-v2/dolphin/v1" "account/alpaca/dolphin-paper" "alpaca-paper"]
                       ["Local Sim Fleet" "sim-local-fleet" "sim" "local-sim"]
                       ["V2 Vol/Term Sim" "sim-vt-session" "sim" "local-sim"]]
        dependencies ["stevetrading-six.service"
                      "stevetrading-watchdog.timer"
                      "stevetrading-reports-build.timer"
                      "Daily Reports"
                      "stevetrading-status-dashboard.timer"
                      "stevetrading-market-evidence-preflight.timer"
                      "stevetrading-market-evidence-capture-smoke.service"
                      "stevetrading-market-evidence-capture-smoke.timer"
                      "Market Evidence Capture Smoke"
                      "stevetrading-market-evidence-collect.service"
                      "stevetrading-market-evidence-collect.timer"
                      "ThetaData Terminal"
                      "Market Evidence"]]
    (write-json! market-evidence-status
                 {"target_date" session-iso
                  "target_stamp" session-stamp
                  "ok?" true
                  "status" "ok"
                  "reasons" []
                  "manifest" {"valid?" true
                              "target_matches_request?" true
                              "payload_example_count" 8
                              "diagnostics" {"prediction_delta" {"available" true}
                                             "parity_gate" {"available" true}}}
                  "manifest_verification" {"valid?" true "returncode" 0}
                  "readiness" {"verdict" "PASS"}})
    (let [strategy-payloads (vec (for [[name strategy-id account-id group] strategy-rows]
                                   {"name" name
                                    "status" "idle"
                                    "strategy_id" strategy-id
                                    "account_id" account-id
                                    "group" group
                                    "detail" "test"
                                    "last_fact_at" nil
                                    "age_minutes" nil
                                    "facts" 0
                                    "signals" 0
                                    "intents" 0
                                    "fills" 0
                                    "rejects" 0
                                    "faults" 0}))
          dependency-payloads (vec (for [name dependencies]
                                     (merge {"name" name
                                             "status" (if (= name "Market Evidence") "idle" "ok")
                                             "detail" "test"
                                             "expected" "test"
                                             "updated_at" now}
                                            (cond
                                              (= name "Market Evidence")
                                              {"evidence" {"phase" "preflight-pending"
                                                           "target_date" session-iso
                                                           "target_stamp" session-stamp
                                                           "preflight_due_at" (str session-iso "T09:10:00-04:00")
                                                           "collector_due_at" (str session-iso "T10:45:00-04:00")
                                                           "status_path" (str market-evidence-status)
                                                           "status_updated_at" now}}
                                              (= name "Daily Reports")
                                              {"evidence" {"expected_date" expected-iso
                                                           "expected_stamp" expected-stamp
                                                           "due_at" (str session-iso "T16:05:00-04:00")
                                                           "daily_dir" "/tmp/reports/daily"
                                                           "validation_path" (str "/tmp/reports/daily/" expected-stamp ".validation.json")
                                                           "html_path" (str "/tmp/reports/daily/" expected-stamp ".html")
                                                           "validation_exists" true
                                                           "html_exists" true
                                                           "report_date" expected-iso
                                                           "report_date_matches" true
                                                           "rendered" true
                                                           "validation_status" "ok"
                                                           "validation_valid" true
                                                           "validation_issue_count" 0}}
                                              :else {}))))
          status-payload {"generated_at" now
                          "target_date" session-iso
                          "session" {"date" session-iso
                                     "label" "post-market"
                                     "is_trading_day" true
                                     "is_market_hours" false
                                     "session_kind" "regular"
                                     "is_early_close" false
                                     "open_at" (str session-iso "T09:30:00-04:00")
                                     "close_at" (str session-iso "T16:00:00-04:00")
                                     "market_reason" nil}
                          "probes_enabled" true
                          "overall" (status/overall strategy-payloads dependency-payloads)
                          "initiatives" [{"priority" "P0" "name" "ThetaData Feature Unlock" "status" "active" "detail" "test"}
                                         {"priority" "P0" "name" "Live Safety" "status" "active" "detail" "test"}
                                         {"priority" "P0" "name" "Execution Fixes" "status" "active" "detail" "test"}
                                         {"priority" "P1" "name" "Evidence Pipeline" "status" "active" "detail" "test"}
                                         {"priority" "P1" "name" "Feature/Behavior Parity" "status" "watch" "detail" "test"}
                                         {"priority" "P2" "name" "Same-Population Stats" "status" "blocked" "detail" "test"}
                                         {"priority" "P2" "name" "L4 Options Paper Brokerage" "status" "needed" "detail" "test"}]
                          "strategy_rows" strategy-payloads
                          "dependencies" dependency-payloads}
          validation-payload (status/validate-payload status-payload {:now now-dt})
          status-payload (assoc status-payload "artifact_validation" validation-payload)
          status-json (str (json/dumps (status/->jsonable status-payload) ** :indent 2 :sort_keys true) "\n")
          validation-json (str (json/dumps (status/->jsonable validation-payload) ** :indent 2 :sort_keys true) "\n")
          html "<html>ok</html>\n"
          artifacts {"status.json" status-json
                     "status.validation.json" validation-json
                     "index.html" html}
          manifest-json (str (json/dumps (status/->jsonable (status/status-publication-manifest status-payload artifacts))
                                          ** :indent 2 :sort_keys true)
                             "\n")]
      (doseq [target ["daily" "weekly" "accounts"]]
        (let [target-dir (path reports-dir target)]
          (.mkdir target-dir ** :parents true :exist_ok true)
          (.write_text (path target-dir "index.html") "<html>ok</html>\n")))
      (.write_text (path out-dir "status.json") status-json)
      (.write_text (path out-dir "status.validation.json") validation-json)
      (.write_text (path out-dir "index.html") html)
      (.write_text (path out-dir "status.publish.json") manifest-json))))

(defn temp-path []
  (pathlib/Path (tempfile/mkdtemp)))

(defn issue-codes [payload]
  (set (map #(.get % "code") (.get payload "issues"))))

(defn read-json-from-stdout [result]
  (json/loads (.-stdout result)))

(deftest validate-report-day-cli-contract
  (let [help (run-basilisp validate-script :args ["--help"])
        unknown (run-basilisp validate-script :args ["--wat"])]
    (is (= 0 (.-returncode help)))
    (is (str/includes? (.-stdout help) "validate_report_day.lpy"))
    (is (= 2 (.-returncode unknown)))
    (is (str/includes? (.-stderr unknown) "unknown argument: --wat"))))

(deftest validate-report-day-rejects-invalid-projections
  (with-open [tmp-dir (tempfile/TemporaryDirectory)]
    (let [tmp (pathlib/Path tmp-dir)
          non-trading (path tmp "non-trading.json")
          no-closed (path tmp "no-closed.json")
          warning (path tmp "warning.json")
          payload-a (valid-report-payload "2026-07-03")
          payload-b (-> (valid-report-payload "2026-07-02")
                        (assoc-in ["accounts" 0 "trade/closed-count"] 0)
                        (assoc-in ["accounts" 0 "order/count"] 2)
                        (assoc-in ["accounts" 0 "pnl/equity-day"] "-150.00")
                        (assoc-in ["accounts" 0 "pnl/realized"] "-150.00")
                        (assoc-in ["accounts" 0 "pnl/unrealized"] "0.00")
                        (assoc-in ["accounts" 0 "pnl/closed-trades"] "0.00")
                        (assoc "pnl/equity-day" "-150.00")
                        (assoc "pnl/realized" "-150.00")
                        (assoc "pnl/unrealized" "0.00")
                        (assoc "pnl/closed-trades" "0.00"))
          payload-c (valid-report-payload "2026-07-02")]
      (write-json! non-trading payload-a)
      (write-json! no-closed payload-b)
      (write-json! warning (assoc-in payload-c ["accounts" 0 "broker/equity-observed?"] false))
      (let [non-trading-result (run-basilisp validate-script :args [(str non-trading)])
            no-closed-result (run-basilisp validate-script :args [(str no-closed)])
            warning-result (run-basilisp validate-script :args [(str warning)])]
        (is (= 1 (.-returncode non-trading-result)))
        (is (str/includes? (.-stdout non-trading-result) ":report/non-trading-day-rendered"))
        (is (= 1 (.-returncode no-closed-result)))
        (is (str/includes? (.-stdout no-closed-result) ":pnl/realized-without-closed-trades"))
        (is (= 1 (.-returncode warning-result)))
        (is (str/includes? (.-stdout warning-result) ":broker/missing-equity-observation"))))))

(deftest audit-daily-report-validations-cli-contract
  (with-open [tmp-dir (tempfile/TemporaryDirectory)]
    (let [tmp (pathlib/Path tmp-dir)
          help (run-basilisp audit-script :args ["--help"])
          unknown (run-basilisp audit-script :args ["--daily-dir" "/tmp" "--typo"])
          missing (run-basilisp audit-script :args ["--daily-dir" "--date" "2026-07-02"])
          mutually-exclusive (run-basilisp audit-script :args ["--daily-dir" (str tmp) "--all" "--date" "2026-07-02"])]
      (is (= 0 (.-returncode help)))
      (is (str/includes? (.-stdout help) "audit_daily_report_validations.lpy"))
      (is (= 2 (.-returncode unknown)))
      (is (str/includes? (.-stderr unknown) "unknown argument: --typo"))
      (is (= 2 (.-returncode missing)))
      (is (str/includes? (.-stderr missing) "missing value for --daily-dir"))
      (is (= 2 (.-returncode mutually-exclusive)))
      (is (str/includes? (.-stderr mutually-exclusive) "--all and --date are mutually exclusive")))))

(deftest repair-daily-report-index-links-rendered-validation
  (with-open [tmp-dir (tempfile/TemporaryDirectory)]
    (let [tmp (pathlib/Path tmp-dir)
          daily-dir (path tmp "daily")]
      (.mkdir daily-dir ** :parents true)
      (write-validation! daily-dir "2026-07-08")
      (.write_text
       (path daily-dir "index.html")
       (str "<html><body>\n"
            "<h2>Calendar — 1 reports</h2>\n"
            "<div class=\"calendar-day empty\">\n"
            "  <div class=\"cd-num\">Jul 8</div>\n"
            "</div>\n"
            "</body></html>\n"))
      (let [result (run-basilisp repair-daily-index-script
                                 :args ["--daily-dir" (str daily-dir) "--date" "2026-07-08"])
            index-text (.read_text (path daily-dir "index.html"))]
        (is (= 0 (.-returncode result)))
        (is (str/includes? index-text "href=\"20260708.html\""))
        (is (str/includes? index-text "Calendar — 1 reports"))
        (is (str/includes? index-text "$25.00"))
        (is (str/includes? index-text "1 trades &middot; WR n/a"))))))

(deftest build-daily-report-index-uses-local-validation-artifacts
  (with-open [tmp-dir (tempfile/TemporaryDirectory)]
    (let [tmp (pathlib/Path tmp-dir)
          daily-dir (path tmp "daily")
          weekly-dir (path tmp "weekly")
          accounts-dir (path tmp "accounts")]
      (.mkdir daily-dir ** :parents true)
      (.mkdir weekly-dir ** :parents true)
      (.mkdir accounts-dir ** :parents true)
      (write-validation! daily-dir "2026-07-08")
      (.write_text
       (path daily-dir "20260709.html")
       (str "<html><body><section><h3>Total Daily PnL</h3>"
            "<div class=\"value negative\">-$12.50</div>"
            "<h3>Total Trades</h3><div class=\"value neutral\">3</div>"
            "</section></body></html>\n"))
      (.write_text (path weekly-dir "2026-W28.html") "<html>week</html>\n")
      (.write_text (path weekly-dir "2026-W29.html") "<html>week</html>\n")
      (.write_text (path accounts-dir "chestnut.html") "<html>account</html>\n")
      (let [result (run-basilisp build-daily-index-script
                                 :args ["--daily-dir" (str daily-dir)
                                        "--weekly-dir" (str weekly-dir)
                                        "--accounts-dir" (str accounts-dir)])
            index-text (.read_text (path daily-dir "index.html"))
            weekly-text (.read_text (path weekly-dir "index.html"))
            accounts-text (.read_text (path accounts-dir "index.html"))]
        (is (= 0 (.-returncode result)) (str (.-stdout result) (.-stderr result)))
        (is (str/includes? index-text "href=\"20260708.html\""))
        (is (str/includes? index-text "href=\"20260709.html\""))
        (is (str/includes? index-text "Calendar &mdash; 2 reports"))
        (is (str/includes? index-text "$25.00"))
        (is (str/includes? index-text "1 trades &middot; validated"))
        (is (str/includes? index-text "-$12.50"))
        (is (str/includes? index-text "3 trades &middot; legacy HTML"))
        (is (str/includes? index-text "/reports/status/index.html\">System"))
        (is (str/includes? weekly-text "href=\"2026-W28.html\""))
        (is (str/includes? weekly-text "Weekly Reports"))
        (is (str/includes? accounts-text "href=\"chestnut.html\""))
        (is (str/includes? accounts-text "CHESTNUT"))))))

(deftest build-reports-overview-index-uses-local-artifacts
  (with-open [tmp-dir (tempfile/TemporaryDirectory)]
    (let [tmp (pathlib/Path tmp-dir)
          reports-dir (path tmp "reports")
          daily-dir (path reports-dir "daily")
          weekly-dir (path reports-dir "weekly")
          accounts-dir (path reports-dir "accounts")
          status-dir (path reports-dir "status")]
      (doseq [dir [daily-dir weekly-dir accounts-dir status-dir]]
        (.mkdir dir ** :parents true))
      (write-validation! daily-dir "2026-07-08")
      (.write_text
       (path daily-dir "20260709.html")
       (str "<html><body><section><h3>Total Daily PnL</h3>"
            "<div class=\"value negative\">-$12.50</div>"
            "<h3>Total Trades</h3><div class=\"value neutral\">3</div>"
            "</section></body></html>\n"))
      (.write_text (path weekly-dir "2026-W28.html") "<html>week</html>\n")
      (.write_text (path weekly-dir "2026-W29.html") "<html>week</html>\n")
      (.write_text (path accounts-dir "parrot.html") "<html>account</html>\n")
      (write-json! (path status-dir "status.json")
                   {"status" "ok"
                    "generated_at" "2026-07-09T16:05:00-04:00"})
      (let [result (run-basilisp build-overview-index-script
                                 :args ["--reports-dir" (str reports-dir)])
            index-text (.read_text (path reports-dir "index.html"))]
        (is (= 0 (.-returncode result)) (str (.-stdout result) (.-stderr result)))
        (is (str/includes? index-text "href=\"daily/20260709.html\""))
        (is (str/includes? index-text "href=\"weekly/2026-W29.html\""))
        (is (str/includes? index-text "href=\"accounts/index.html\""))
        (is (str/includes? index-text "href=\"status/index.html\""))
        (is (str/includes? index-text "Latest Daily"))
        (is (str/includes? index-text "-$12.50"))
        (is (str/includes? index-text "$25.00"))
        (is (str/includes? index-text "3</td><td>html"))
        (is (str/includes? index-text "1</td><td>validation"))
        (is (str/includes? index-text "Status: ok"))))))

(deftest render-daily-report-uses-canonical-validation-json
  (with-open [tmp-dir (tempfile/TemporaryDirectory)]
    (let [tmp (pathlib/Path tmp-dir)
          daily-dir (path tmp "daily")
          date "2026-07-02"
          stamp "20260702"]
      (.mkdir daily-dir ** :parents true)
      (write-json!
       (path daily-dir (str stamp ".validation.json"))
       {"report/date" date
        "report/rendered?" true
        "accounts" [{"account/id" "account/alpaca/parrot-paper"
                     "account/display" "PARROT"
                     "report/date" date
                     "trade/closed-count" 2
                     "order/count" 4
                     "positions/open-count" 1
                     "positions/open" [{"instrument/id" "equity/NASDAQ/SPY"
                                        "position/side" "long"
                                        "position/quantity" "1"
                                        "position/unrealized-pnl" "3.00"}]
                     "pnl/equity-day" "28.00"
                     "pnl/realized" "25.00"
                     "pnl/unrealized" "3.00"
                     "pnl/closed-trades" "25.00"
                     "broker/equity-observed?" true
                     "report/explanations" ["explanation/open-position-carryover"]}]})
      (let [result (run-basilisp render-daily-report-script
                                 :args ["--daily-dir" (str daily-dir)
                                        "--date" date])
            html (.read_text (path daily-dir (str stamp ".html")))]
        (is (= 0 (.-returncode result)) (str (.-stdout result) (.-stderr result)))
        (is (str/includes? html "Rendered by Basilisp from canonical validation JSON"))
        (is (str/includes? html "Daily Report &mdash; 2026-07-02"))
        (is (str/includes? html "Total broker equity P&amp;L"))
        (is (str/includes? html "$28.00"))
        (is (str/includes? html "$25.00"))
        (is (str/includes? html "$3.00"))
        (is (str/includes? html "PARROT"))
        (is (str/includes? html "equity/NASDAQ/SPY"))
        (is (str/includes? html "Validation</span><strong>ok / 0 issues"))))))

(deftest generate-daily-validation-from-cached-orders-and-state-fixture
  (with-open [tmp-dir (tempfile/TemporaryDirectory)]
    (let [tmp (pathlib/Path tmp-dir)
          daily-dir (path tmp "daily")
          cache-dir (path tmp "cache")
          state-path (path tmp "state.json")
          date "2026-07-02"
          accounts ["chestnut" "lynx" "moose" "oak" "parrot" "dolphin"]]
      (.mkdir daily-dir ** :parents true)
      (.mkdir cache-dir ** :parents true)
      (doseq [slug accounts]
        (write-json! (path cache-dir (str "orders_" slug "_" date ".json"))
                     {"version" 1
                      "orders" (if (= slug "parrot")
                                 [{"account" "parrot"
                                   "order_id" "p-open"
                                   "symbol" "SPY"
                                   "side" "BUY"
                                   "filled_at" "2026-07-02T10:00:00-04:00"
                                   "filled_avg_price" 600.0
                                   "qty" 1
                                   "order_type" "market"}
                                  {"account" "parrot"
                                   "order_id" "p-close"
                                   "symbol" "SPY"
                                   "side" "SELL"
                                   "filled_at" "2026-07-02T10:05:00-04:00"
                                   "filled_avg_price" 601.5
                                   "qty" 1
                                   "order_type" "market"}]
                                 [])}))
      (write-json! state-path
                   {"chestnut" {"equity_day_pnl" 0.0 "positions" []}
                    "lynx" {"equity_day_pnl" 0.0 "positions" []}
                    "moose" {"equity_day_pnl" 0.0 "positions" []}
                    "oak" {"equity_day_pnl" 0.0 "positions" []}
                    "parrot" {"equity_day_pnl" 1.5 "positions" []}
                    "dolphin" {"equity_day_pnl" 0.0 "positions" []}})
      (let [result (run-basilisp generate-daily-validation-script
                                 :args ["--daily-dir" (str daily-dir)
                                        "--date" date
                                        "--orders-cache-dir" (str cache-dir)
                                        "--state-fixture" (str state-path)
                                        "--allow-cache"])]
        (is (= 0 (.-returncode result)) (str (.-stdout result) (.-stderr result)))
        (is (.exists (path daily-dir "20260702.validation.json")))
        (when (.exists (path daily-dir "20260702.validation.json"))
          (let [payload (read-json (path daily-dir "20260702.validation.json"))
                parrot (first (filter #(= "account/alpaca/parrot-paper" (.get % "account/id"))
                                      (.get payload "accounts")))]
            (is (= date (.get payload "report/date")))
            (is (= 6 (python/len (.get payload "accounts"))))
            (is (= 1 (.get parrot "trade/closed-count")))
            (is (= 2 (.get parrot "order/count")))
            (is (= 1.5 (.get parrot "pnl/equity-day")))
            (is (= 1.5 (.get parrot "pnl/realized")))
            (is (= true (.get parrot "broker/equity-observed?")))))))))

