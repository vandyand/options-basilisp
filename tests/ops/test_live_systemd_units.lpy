        preflight-timer (read-file "projects/ops/scripts/systemd/stevetrading-market-evidence-preflight.timer")
        smoke-timer (read-file "projects/ops/scripts/systemd/stevetrading-market-evidence-capture-smoke.timer")
        collect-timer (read-file "projects/ops/scripts/systemd/stevetrading-market-evidence-collect.timer")
        raw-parity-timer (read-file "projects/ops/scripts/systemd/stevetrading-raw-thetadata-parity.timer")]
    (contains-all? six-timer ["OnCalendar=Mon..Fri *-*-* 09:20:00 America/New_York"
                              "Unit=stevetrading-six.service"
                              "Persistent=true"])
    (contains-all? preflight-timer ["OnCalendar=Mon..Fri *-*-* 09:10:00 America/New_York"
                                    "Unit=stevetrading-market-evidence-preflight.service"
                                    "Persistent=true"])
    (contains-all? smoke-timer ["OnCalendar=Mon..Fri *-*-* 09:45:00 America/New_York"
                                "Unit=stevetrading-market-evidence-capture-smoke.service"
                                "Persistent=true"])
    (contains-all? collect-timer ["OnCalendar=Mon..Fri *-*-* 10:45:00 America/New_York"
                                  "Unit=stevetrading-market-evidence-collect.service"
                                  "Persistent=true"])
    (contains-all? raw-parity-timer ["OnCalendar=Mon..Fri *-*-* 09:31:00 America/New_York"
                                     "Unit=stevetrading-raw-thetadata-parity.service"
                                     "Persistent=true"])))

(deftest market-evidence-services-use-shared-wrapper-and-modes
  (let [preflight (read-file "projects/ops/scripts/systemd/stevetrading-market-evidence-preflight.service")
        smoke (read-file "projects/ops/scripts/systemd/stevetrading-market-evidence-capture-smoke.service")
        collect (read-file "projects/ops/scripts/systemd/stevetrading-market-evidence-collect.service")
        raw-parity (read-file "projects/ops/scripts/systemd/stevetrading-raw-thetadata-parity.service")
        theta (read-file "projects/ops/scripts/systemd/theta-terminal.service")]
    (contains-all? preflight ["EnvironmentFile=/etc/stevetrading/env"
                              "Environment=MARKET_EVIDENCE_MODE=preflight"
                              "Environment=HISTORICAL_FEATURE_JOBS=4"
                              "ExecStart=/opt/stevetrading/current/projects/ops/scripts/run_market_evidence.sh"])
    (contains-all? smoke ["Wants=network-online.target theta-terminal.service"
                          "Environment=MARKET_EVIDENCE_MODE=capture-smoke"
                          "After=network-online.target theta-terminal.service stevetrading-six.service"
                          "ExecStart=/opt/stevetrading/current/projects/ops/scripts/run_market_evidence.sh"])
    (contains-all? collect ["Wants=network-online.target theta-terminal.service"
                            "Environment=MARKET_EVIDENCE_MODE=collect"
                            "Environment=MARKET_EVIDENCE_TIMEOUT_SECONDS=3600"
                            "Environment=HISTORICAL_FEATURE_JOBS=4"
                            "After=network-online.target theta-terminal.service stevetrading-six.service"
                            "ExecStart=/opt/stevetrading/current/projects/ops/scripts/run_market_evidence.sh"])
    (contains-all? raw-parity ["Wants=network-online.target theta-terminal.service"
                               "Environment=RAW_THETADATA_PARITY_LANDING_ROOT=/opt/stevetrading/shared/thetadata-parity-v1"
                               "ExecStart=/opt/stevetrading/current/projects/ops/scripts/run_raw_thetadata_parity.sh"])
    (contains-all? theta ["Restart=on-failure"
                          "SuccessExitStatus=143 SIGTERM"])))

