                            "does not accept CLI args"
                            "MARKET_EVIDENCE_COLLECT_SCRIPT:-scripts/collect_market_evidence.sh"
                            "require_preflight_status_ok"
                            "missing same-day preflight status"
                            "scripts/check_market_evidence_preflight.lpy"
                            "scripts/is_trading_day.lpy"
                            "DEFAULT_RUNTIME_ROOT=/opt/stevetrading/shared"
                            "STEVE_REF_ROOT=\"${STEVE_REF_ROOT:-$DEFAULT_RUNTIME_ROOT/Data-Preprocessor}\""
                            "export STEVE_REPO_ROOT=\"$ROOT\""
                            "export STEVE_REF_ROOT"
                            "\"$STEVE_REF_ROOT/.venv/bin/basilisp\""
                            "ANALYSIS_DIR=\"${ANALYSIS_DIR:-$DEFAULT_RUNTIME_ROOT/live_runtime/analysis}\""
                            "CAPTURE_DIR=\"${CAPTURE_DIR:-$DEFAULT_RUNTIME_ROOT/live_runtime/feature-capture}\""
                            "PAYLOAD_DIR=\"${PAYLOAD_DIR:-$DEFAULT_RUNTIME_ROOT/payload_examples}\""
                            "RESULT: SKIPPED - non-trading day"
                            "--preflight"
                            "capture-smoke)"
                            "scripts/capture_v2_sidecar_check.lpy"
                            "--min-rows \"$CAPTURE_SMOKE_MIN_ROWS\""
                            "--dry-run"
                            "--target-date \"$TARGET_DATE\""
                            "unknown MARKET_EVIDENCE_MODE"])
    (contains-all? preflight-validator ["duplicate JSON key"
                                        "preflight status mode"
                                        "preflight status target_stamp"
                                        "preflight status generated_at ET date"])))

