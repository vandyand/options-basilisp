(deftest steve-six-launcher-honors-shared-capture-dir-env
  (let [launcher (read-file "scripts/launch_steve_six.lpy")]
    (is (str/includes? launcher ":capture-dir (or (os/getenv \"CAPTURE_DIR\") \"live_runtime/feature-capture\")"))))

(deftest is-trading-day-helper-identifies-holiday-and-trading-day
  (let [trading (subprocess/run
                 (python/list [(basilisp-bin) "run" "scripts/is_trading_day.lpy" "--" "2026-07-02"])
                 ** :cwd (str root) :text true :capture_output true :check false)
        holiday (subprocess/run
                 (python/list [(basilisp-bin) "run" "scripts/is_trading_day.lpy" "--" "2026-07-03"])
                 ** :cwd (str root) :text true :capture_output true :check false)]
    (is (= 0 (.-returncode trading)))
    (is (str/includes? (.-stdout trading) "trading-day"))
    (is (= 1 (.-returncode holiday)))
    (is (str/includes? (.-stdout holiday) "non-trading-day"))))

