      "sudo systemctl enable --now stevetrading-six.timer stevetrading-watchdog.timer stevetrading-reports-build.timer stevetrading-status-dashboard.timer stevetrading-market-evidence-preflight.timer stevetrading-market-evidence-capture-smoke.timer stevetrading-market-evidence-collect.timer stevetrading-raw-thetadata-parity.timer"
