(deftest market-evidence-collect-waits-for-recovered-preflight-status
  (with-open [tmp-dir (tempfile/TemporaryDirectory)]
    (let [tmp (pathlib/Path tmp-dir)
          analysis (path tmp "analysis")
          captures (path tmp "captures")
          payloads (path tmp "payloads")
          _ (doseq [p [analysis captures payloads]] (.mkdir p))
          status (path analysis "market_evidence_preflight_20260702.json")
          _ (write-json! status (preflight-status "2026-07-02T04:16:27Z" "ok" 0 :detail "too early to satisfy scheduled preflight"))
          [fake-python fake-basilisp calls] (write-fake-collect-runners! tmp)
          fake-collect (write-fake-collect-script! tmp calls)
          env (py-env {"MARKET_EVIDENCE_MODE" "collect"
                       "MARKET_EVIDENCE_DATE" "2026-07-02"
                       "MARKET_EVIDENCE_LOG_DIR" (str (path tmp "logs"))
                       "BASILISP_BIN" (str fake-basilisp)
                       "ANALYSIS_DIR" (str analysis)
                       "CAPTURE_DIR" (str captures)
                       "PAYLOAD_DIR" (str payloads)
                       "MARKET_EVIDENCE_REQUIRE_THETADATA_HEALTH" "0"
                       "MARKET_EVIDENCE_COLLECT_SCRIPT" (str fake-collect)
                       "MARKET_EVIDENCE_PREFLIGHT_WAIT_SECONDS" "5"
                       "MARKET_EVIDENCE_PREFLIGHT_POLL_SECONDS" "0.1"})
          proc (subprocess/Popen
                (python/list [(str (.joinpath root "projects/ops/scripts/run_market_evidence.sh"))])
                ** :cwd (str root)
                   :env env
                   :text true
                   :stdout subprocess/PIPE
                   :stderr subprocess/PIPE)]
      (time/sleep 0.3)
      (write-json! status (preflight-status "2026-07-02T13:10:00Z" "ok" 0 :detail "recovered preflight passed"))
      (let [[stdout stderr] (.communicate proc ** :timeout 10)
            log (.read_text (.joinpath tmp "logs" "market-evidence.log"))]
        (is (= 0 (.-returncode proc)) (str stdout stderr log))
        (is (str/includes? log "OK: same-day preflight status passed"))
        (is (str/includes? (.read_text calls) "COLLECT --target-date 2026-07-02"))))))

