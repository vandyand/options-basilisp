(deftest market-evidence-capture-smoke-runs-sidecar-check-after-ok-preflight-status
  (with-open [tmp-dir (tempfile/TemporaryDirectory)]
    (let [tmp (pathlib/Path tmp-dir)
          analysis (path tmp "analysis")
          captures (path tmp "captures")
          payloads (path tmp "payloads")
          _ (doseq [p [analysis captures payloads]] (.mkdir p))
          _ (write-text! (path captures "live_features_20260702.npz") "placeholder\n")
          _ (write-json! (path analysis "market_evidence_preflight_20260702.json")
                         (preflight-status "2026-07-02T13:10:00Z" "ok" 0 :detail "preflight passed"))
          [fake-python fake-basilisp calls] (write-fake-collect-runners! tmp)]
      (write-text! fake-basilisp
                   (str "#!/usr/bin/env bash\n"
                        "set -euo pipefail\n"
                        "echo \"BASILISP $*\" >> " calls "\n"
                        "REAL_BASILISP='" (basilisp-bin) "'\n"
                        "case \"$*\" in\n"
                        "  *scripts/check_market_evidence_preflight.lpy*|*scripts/wait_thetadata_health.lpy*)\n"
                        "    exec \"$REAL_BASILISP\" \"$@\"\n"
                        "    ;;\n"
                        "  *capture_v2_sidecar_check.lpy*)\n"
                        "    out=\"\"\n"
                        "    while [[ $# -gt 0 ]]; do\n"
                        "      if [[ \"$1\" == \"--out-json\" ]]; then out=\"$2\"; break; fi\n"
                        "      shift\n"
                        "    done\n"
                        "    mkdir -p \"$(dirname \"$out\")\"\n"
                        "    printf '{\"ok\":true,\"status\":\"ok\"}\\n' > \"$out\"\n"
                        "    ;;\n"
                        "esac\n"))
      (chmod-exec! fake-basilisp)
      (let [result (run-market-evidence {"MARKET_EVIDENCE_MODE" "capture-smoke"
                                         "MARKET_EVIDENCE_DATE" "2026-07-02"
                                         "MARKET_EVIDENCE_LOG_DIR" (str (path tmp "logs"))
                                         "MARKET_EVIDENCE_CAPTURE_SMOKE_MIN_ROWS" "3"
                                         "BASILISP_BIN" (str fake-basilisp)
                                         "ANALYSIS_DIR" (str analysis)
                                         "CAPTURE_DIR" (str captures)
                                         "PAYLOAD_DIR" (str payloads)
                                         "MARKET_EVIDENCE_REQUIRE_THETADATA_HEALTH" "0"})
            log (.read_text (.joinpath tmp "logs" "market-evidence.log"))
            call-text (.read_text calls)]
        (is (= 0 (.-returncode result)) (.-stderr result))
        (is (str/includes? log "OK: same-day preflight status passed"))
        (contains-all? call-text ["capture_v2_sidecar_check.lpy"
                                  "--capture "
                                  "live_features_20260702.npz"
                                  "--min-rows 3"])
        (is (.exists (path analysis "capture_v2_sidecar_smoke_20260702.json")))
        (is (str/includes? log "RESULT: SUCCESS"))))))

