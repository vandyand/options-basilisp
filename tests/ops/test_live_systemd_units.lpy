(deftest watchdog-restarts-systemd-six-unit-not-orphan-child
  (let [watchdog (read-file "scripts/steve_watchdog.sh")]
    (contains-all? watchdog ["SYSTEMD_SIX_UNIT"
                             "service_active()"
                             "session_alive()"
                             "systemctl is-active --quiet \"$SYSTEMD_SIX_UNIT\""
                             "sudo -n systemctl restart \"$SYSTEMD_SIX_UNIT\""
                             "watchdog Type=oneshot must not own the background child process directly"
                             "relaunch verified alive"
                             "if ! session_alive; then"])))

(defn write-aligned-corrected-ref! [tmp]
  (let [ref (path tmp "Data-Preprocessor")]
    (doseq [account ["chestnut" "lynx" "moose"]]
      (let [bundle (.joinpath ref "pipeline_data" (str "live_model_" account "_multihead_corrected"))]
        (.mkdir bundle ** :parents true)
        (write-text! (path bundle "feature_names.json") "[\"a\",\"b\"]\n")
        (write-text! (path bundle "neutralize_features.json") "[\"b\"]\n")))
    ref))

(defn run-market-evidence [env]
  (run-command [(str (.joinpath root "projects/ops/scripts/run_market_evidence.sh"))] env))

(defn write-fake-collect-runners! [tmp]
  (let [fake-python (path tmp "fake-python")
        fake-basilisp (path tmp "fake-basilisp")
        calls (path tmp "calls.txt")
        real-basilisp (basilisp-bin)]
    (write-text! fake-python
                 (str "#!/usr/bin/env bash\n"
                      "set -euo pipefail\n"
                      "printf 'PY %s\\n' \"$*\" >> " calls "\n"
                      "if [[ \"$1\" == \"-\" ]]; then exec python3 \"$@\"; fi\n"
                      "exit 0\n"))
    (write-text! fake-basilisp
                 (str "#!/usr/bin/env bash\n"
                      "set -euo pipefail\n"
                      "printf 'BASILISP %s\\n' \"$*\" >> " calls "\n"
                      "REAL_BASILISP='" real-basilisp "'\n"
                      "case \"$*\" in\n"
                      "  *scripts/check_market_evidence_preflight.lpy*|*scripts/wait_thetadata_health.lpy*)\n"
                      "    exec \"$REAL_BASILISP\" \"$@\"\n"
                      "    ;;\n"
                      "esac\n"
                      "exit 0\n"))
    (chmod-exec! fake-python)
    (chmod-exec! fake-basilisp)
    [fake-python fake-basilisp calls]))

(defn write-fake-collect-script! [tmp calls]
  (let [fake-collect (path tmp "fake-collect-market-evidence")]
    (write-text! fake-collect
                 (str "#!/usr/bin/env bash\n"
                      "set -euo pipefail\n"
                      "printf 'COLLECT %s\\n' \"$*\" >> " calls "\n"
                      "exit 0\n"))
    (chmod-exec! fake-collect)
    fake-collect))

(defn preflight-status [generated-at status returncode & {:keys [detail]
                                                          :or {detail nil}}]
  (let [base {"generated_at" generated-at
              "target_date" "2026-07-02"
              "target_stamp" "20260702"
              "mode" "preflight"
              "status" status
              "returncode" returncode}]
    (if detail (assoc base "detail" detail) base)))

(deftest steve-six-session-after-hours-guard-exits-before-preflight
  (with-open [tmp-dir (tempfile/TemporaryDirectory)]
    (let [tmp (pathlib/Path tmp-dir)
          calls (path tmp "calls.log")
          fake-basilisp (path tmp "fake-basilisp")
          fake-python (path tmp "fake-python")
          fake-lifecycle (path tmp "fake-lifecycle")]
      (doseq [script [fake-basilisp fake-python fake-lifecycle]]
        (write-text! script (str "#!/usr/bin/env bash\n"
                                 "echo unexpected \"$0 $*\" >> " calls "\n"
                                 "exit 99\n"))
        (chmod-exec! script))
      (let [result (run-command [(str (.joinpath root "scripts/steve_six_session.sh"))]
                                {"BASILISP_BIN" (str fake-basilisp)
                                 "STEVE_THETADATA_LIFECYCLE" (str fake-lifecycle)
                                 "STEVE_SIX_NOW_ET" "2026-07-08 08:59:00"
                                 "CAPTURE_DIR" (str (path tmp "captures"))
                                 "ANALYSIS_DIR" (str (path tmp "analysis"))})]
        (is (= 0 (.-returncode result)) (.-stderr result))
        (is (str/includes? (.-stdout result) "outside recoverable market session window"))
        (is (not (.exists calls)))))))

(deftest steve-six-session-market-window-prepares-capture-before-terminal
  (with-open [tmp-dir (tempfile/TemporaryDirectory)]
    (let [tmp (pathlib/Path tmp-dir)
          calls (path tmp "calls.log")
          fake-basilisp (path tmp "fake-basilisp")
          fake-python (path tmp "fake-python")
          fake-lifecycle (path tmp "fake-lifecycle")
          analysis (path tmp "analysis")
          captures (path tmp "captures")]
      (write-text! fake-basilisp
                   (str "#!/usr/bin/env bash\n"
                        "set -euo pipefail\n"
                        "echo BASILISP \"$*\" >> " calls "\n"
                        "case \"$*\" in\n"
                        "  *prepare_capture_v2_session.lpy*)\n"
                        "    out=''\n"
                        "    while [ \"$#\" -gt 0 ]; do\n"
                        "      if [ \"$1\" = '--out-json' ]; then out=\"$2\"; shift 2; else shift; fi\n"
                        "    done\n"
                        "    if [ -n \"$out\" ]; then mkdir -p \"$(dirname \"$out\")\"; printf '{\"status\":\"ok\"}\\n' > \"$out\"; fi\n"
                        "    ;;\n"
                        "esac\n"
                        "exit 0\n"))
      (write-text! fake-python
                   (str "#!/usr/bin/env bash\n"
                        "echo PY \"$*\" >> " calls "\n"
                        "out=''\n"
                        "while [ \"$#\" -gt 0 ]; do\n"
                        "  if [ \"$1\" = '--out-json' ]; then out=\"$2\"; shift 2; else shift; fi\n"
                        "done\n"
                        "if [ -n \"$out\" ]; then mkdir -p \"$(dirname \"$out\")\"; printf '{\"status\":\"ok\"}\\n' > \"$out\"; fi\n"
                        "exit 0\n"))
      (write-text! fake-lifecycle
                   (str "#!/usr/bin/env bash\n"
                        "echo LIFECYCLE \"$*\" >> " calls "\n"
                        "exit 0\n"))
      (doseq [script [fake-basilisp fake-python fake-lifecycle]] (chmod-exec! script))
      (let [result (run-command [(str (.joinpath root "scripts/steve_six_session.sh"))]
                                {"BASILISP_BIN" (str fake-basilisp)
                                 "STEVE_THETADATA_LIFECYCLE" (str fake-lifecycle)
                                 "STEVE_SIX_NOW_ET" "2026-07-08 09:30:00"
                                 "CAPTURE_DIR" (str captures)
                                 "ANALYSIS_DIR" (str analysis)})
            text (.read_text calls)]
        (is (= 0 (.-returncode result)) (.-stderr result))
        (contains-all? text ["preflight_live_imports.lpy"
                             "prepare_capture_v2_session.lpy"
                             (str "--capture-dir " captures)
                             "--target-date 2026-07-08"
                             "LIFECYCLE start"
                             "launch_steve_six.lpy"])
        (is (.exists (path analysis "prepare_capture_v2_session_20260708.json")))
        (is (< (.index text "prepare_capture_v2_session.lpy") (.index text "LIFECYCLE start")))
        (is (< (.index text "LIFECYCLE start") (.index text "launch_steve_six.lpy")))))))

