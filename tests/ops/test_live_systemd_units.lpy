(deftest market-evidence-wrapper-writes-preflight-status-success
  (with-open [tmp-dir (tempfile/TemporaryDirectory)]
    (let [tmp (pathlib/Path tmp-dir)
          analysis (path tmp "analysis")
          captures (path tmp "captures")
          payloads (path tmp "payloads")
          ref (write-aligned-corrected-ref! (path tmp "shared"))
          fake-python (path tmp "fake-python")
          fake-basilisp (path tmp "fake-basilisp")
          calls (path tmp "basilisp-calls.txt")]
      (write-text! fake-python "#!/usr/bin/env bash\nexit 0\n")
      (write-text! fake-basilisp (str "#!/usr/bin/env bash\n"
                                      "printf '%s\\n' \"$*\" >> " calls "\n"
                                      "exit 0\n"))
      (doseq [p [fake-python fake-basilisp]] (chmod-exec! p))
      (doseq [p [analysis captures payloads]] (.mkdir p))
      (let [result (run-market-evidence {"MARKET_EVIDENCE_MODE" "preflight"
                                         "MARKET_EVIDENCE_DATE" "2026-07-02"
                                         "MARKET_EVIDENCE_LOG_DIR" (str (path tmp "logs"))
                                         "BASILISP_BIN" (str fake-basilisp)
                                         "ANALYSIS_DIR" (str analysis)
                                         "CAPTURE_DIR" (str captures)
                                         "PAYLOAD_DIR" (str payloads)
                                         "STEVE_REF_ROOT" (str ref)})
            status (read-json (path analysis "market_evidence_preflight_20260702.json"))
            log (.read_text (.joinpath tmp "logs" "market-evidence.log"))
            call-text (.read_text calls)]
        (is (= 0 (.-returncode result)) (.-stderr result))
        (is (= "2026-07-02" (.get status "target_date")))
        (is (= "20260702" (.get status "target_stamp")))
        (is (= "ok" (.get status "status")))
        (is (= 0 (.get status "returncode")))
        (contains-all? call-text ["run scripts/is_trading_day.lpy -- 2026-07-02"])
        (contains-all? log ["Market evidence preflight"
                            "target_date=2026-07-02"
                            "+ "
                            "scripts/thetadata_capability_probe.lpy"
                            "scripts/market_evidence_status.lpy"])))))

