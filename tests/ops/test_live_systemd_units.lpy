(ns ops.test-live-systemd-units
  (:import json os pathlib subprocess tempfile time)
  (:require [basilisp.test :refer [deftest is]]
            [clojure.string :as str]))

(def root (pathlib/Path (os/getcwd)))

(defn read-file [rel]
  (.read_text (.joinpath root rel)))

(defn path [parent child] (.joinpath parent child))

(defn jsonable [x]
  (cond
    (map? x) (python/dict (map (fn [[k v]] (python/tuple [(str k) (jsonable v)])) x))
    (python/isinstance x python/dict) (python/dict (map (fn [[k v]] (python/tuple [(str k) (jsonable v)])) (.items x)))
    (or (vector? x) (seq? x) (python/isinstance x python/list)) (python/list (map jsonable x))
    :else x))

(defn dumps [x] (json/dumps (jsonable x)))
(defn loads [s] (json/loads s))
(defn read-json [p] (loads (.read_text p)))
(defn write-json! [p x] (.write_text p (str (dumps x) "\n")))
(defn write-text! [p text] (.write_text p text))
(defn chmod-exec! [p] (.chmod p 493))

(defn py-env [m]
  (doto (.copy os/environ)
    (.update (jsonable m))))

(defn run-command [args env]
  (subprocess/run
   (python/list args)
   ** :cwd (str root)
      :env (py-env env)
      :text true
      :capture_output true
      :check false))

(defn basilisp-bin []
  (or (os.environ/get "BASILISP_BIN")
      (let [repo-candidate (.joinpath root ".venv/bin/basilisp")]
        (if (.exists repo-candidate)
          (str repo-candidate)
          "basilisp"))))

(defn contains-all? [text snippets]
  (doseq [snippet snippets]
    (is (str/includes? text snippet) snippet)))

(deftest six-timer-starts-before-market-open
  (let [timer (read-file "projects/ops/scripts/systemd/stevetrading-six.timer")]
    (contains-all? timer ["OnCalendar=Mon..Fri *-*-* 09:20:00 America/New_York"
                          "Unit=stevetrading-six.service"
                          "WantedBy=timers.target"])))

(deftest reports-build-timer-runs-shortly-after-market-close
  (let [timer (read-file "projects/ops/scripts/systemd/stevetrading-reports-build.timer")
        service (read-file "projects/ops/scripts/systemd/stevetrading-reports-build.service")]
    (contains-all? timer ["OnCalendar=Mon..Fri *-*-* 16:05:00 America/New_York"
                          "Unit=stevetrading-reports-build.service"
                          "Persistent=true"])
    (contains-all? service ["StartLimitBurst=8"
                            "Restart=on-failure"
                            "RestartSec=5min"])))

(deftest theta-terminal-restarts-only-on-real-failure
