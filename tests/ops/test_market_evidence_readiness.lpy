                             "generated_at" "2026-07-05T15:00:00Z"
                             "capture_rows" 120
                             "replayed_rows" 120
                             "neutralized_total" 703
                             "supported_neutralized" 181
                             "unsupported_neutralized" 522
                             "candidate_count" 0
                             "guarded_greek_reconstruction_count" 60
                             "source_counts" {"bar_buffer_replay" 113}
                             "status_counts" {}}})
    (write-json! v3-unlock
                 {"summary" {"target_date" "2026-07-05"
                             "generated_at" "2026-07-05T15:00:00Z"
                             "neutralized_v3_features" 131
                             "recomputed_candidate_now" 0
                             "recomputed_non_degenerate" 0
                             "prediction_delta_status" "skipped-no-candidates"
                             "prediction_delta_p95_abs_seed_z" 0.0
                             "prediction_delta_max_abs_seed_z" 0.0
