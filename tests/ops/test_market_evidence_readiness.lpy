(deftest market-evidence-readiness-fails-without-raw-replay-metadata
  (with-open [tmp-dir (tempfile/TemporaryDirectory)]
    (let [tmp (pathlib/Path tmp-dir)
          analysis (path tmp "analysis")
          artifacts (write-readiness-bundle analysis)]
      (update-json! (get artifacts "baseline")
                    (fn [p] (let [summary (.get p "summary")
                                  captures (.get summary "captures")
                                  per-capture (.__getitem__ (.get summary "per_capture") 0)]
                              (.pop captures "required_raw_replay_arrays")
                              (.pop captures "raw_replay_missing_by_file")
                              (.pop per-capture "raw_replay_ready")
                              (.pop per-capture "raw_replay_missing")
                              p)))
      (let [result (run-readiness :args ["--target-date" "2026-07-05"
                                         "--analysis-dir" (str analysis)
                                         "--out-dir" (str (path tmp "out"))
                                         "--baseline-json" (str (get artifacts "baseline"))
                                         "--probe-json" (str (get artifacts "probe"))
                                         "--payload-verification-json" (str (get artifacts "verification"))
                                         "--neutralization-json" (str (get artifacts "neutralization"))])
            payload (stdout-payload (.-stdout result))]
        (is (= 1 (.-returncode result)))
        (is (str/includes? (reasons payload) "baseline missing raw replay sidecar metadata")))))
  (with-open [tmp-dir (tempfile/TemporaryDirectory)]
    (let [tmp (pathlib/Path tmp-dir)
          analysis (path tmp "analysis")
          artifacts (write-readiness-bundle analysis)]
      (update-json! (get artifacts "baseline")
                    (fn [p] (let [summary (.get p "summary")
                                  captures (.get summary "captures")
                                  per-capture (.__getitem__ (.get summary "per_capture") 0)]
                              (aset captures "raw_replay_missing_by_file"
                                    (jsonable {"live_features_20260705.npz" ["bar_buffers_json" "option_chain_json" "option_surfaces_json"]}))
                              (aset per-capture "raw_replay_ready" false)
                              (aset per-capture "raw_replay_missing"
                                    (python/list ["bar_buffers_json" "option_chain_json" "option_surfaces_json"]))
                              p)))
      (let [result (run-readiness :args ["--target-date" "2026-07-05"
                                         "--analysis-dir" (str analysis)
                                         "--out-dir" (str (path tmp "out"))
                                         "--baseline-json" (str (get artifacts "baseline"))
                                         "--probe-json" (str (get artifacts "probe"))
                                         "--payload-verification-json" (str (get artifacts "verification"))
                                         "--neutralization-json" (str (get artifacts "neutralization"))])
            payload (stdout-payload (.-stdout result))
            text (reasons payload)]
        (is (= 1 (.-returncode result)))
        (is (str/includes? text "target-date capture missing raw replay sidecars"))
        (is (str/includes? text "target-date per_capture row is not raw replay ready"))))))
