(ns ops.test-market-evidence-readiness
  (:import json os pathlib shutil subprocess sys tempfile)
  (:require [basilisp.test :refer [deftest is]]
            [clojure.string :as str]))

(def root (pathlib/Path (os/getcwd)))
(def script (.joinpath root "scripts/market_evidence_readiness.lpy"))
(def stamp "20260705")

(defn resolve-basilisp []
  (cond
    (os.environ/get "BASILISP_BIN") (pathlib/Path (os.environ/get "BASILISP_BIN"))
    (.exists (.joinpath root ".venv/bin/basilisp")) (.joinpath root ".venv/bin/basilisp")
    (.exists (.with_name (pathlib/Path sys/executable) "basilisp")) (.with_name (pathlib/Path sys/executable) "basilisp")
    (shutil/which "basilisp") (pathlib/Path (shutil/which "basilisp"))
    :else (.joinpath root ".venv/bin/basilisp")))

(def basilisp-bin (str (resolve-basilisp)))

(defn jsonable [x]
  (cond
    (map? x) (python/dict (map (fn [[k v]] (python/tuple [(str k) (jsonable v)])) x))
    (python/isinstance x python/dict) (python/dict (map (fn [[k v]] (python/tuple [(str k) (jsonable v)])) (.items x)))
    (or (vector? x) (seq? x) (python/isinstance x python/list)) (python/list (map jsonable x))
    :else x))

(defn dumps [x] (json/dumps (jsonable x)))
(defn write-json! [p x] (.write_text p (str (dumps x) "\n")))
(defn read-json [p] (json/loads (.read_text p)))
(defn path [parent child] (.joinpath parent child))

(defn merged-env [m]
  (let [env (.copy os/environ)]
    (.update env (jsonable (or m {})))
    env))

(defn run-readiness [& opts]
  (let [opts-map (into {} (map vec (partition 2 opts)))
        args (get opts-map :args [])
        cwd (get opts-map :cwd root)
        env (get opts-map :env {})]
    (subprocess/run
     (python/list (concat [basilisp-bin "run" (str script) "--"] args))
     ** :cwd (str cwd)
        :env (merged-env env)
        :text true
        :capture_output true
        :check false)))

(defn stdout-payload [stdout]
  (json/loads (first (str/split stdout #"\nwrote " 2))))

(defn write-readiness-bundle [base]
  (.mkdir base ** :parents true :exist_ok true)
  (let [baseline (path base (str "live_feature_parity_baseline_" stamp ".json"))
        probe (path base (str "thetadata_capability_probe_" stamp ".json"))
        verification (path base (str "thetadata_payload_verification_" stamp ".json"))
        neutralization (path base (str "neutralization_audit_" stamp ".json"))
        capture-check (path base (str "capture_v2_sidecar_check_" stamp ".json"))
        option-surface-sidecar-check (path base (str "option_surface_sidecar_check_" stamp ".json"))
        legacy-search (path base (str "legacy_greek_formula_search_" stamp ".json"))
        greek-promotion (path base (str "greek_reconstruction_promotion_gate_" stamp ".json"))
        historical-cohort (path base (str "historical_feature_cohort_" stamp ".json"))
        raw-unlock (path base (str "raw_feature_unlock_audit_" stamp ".json"))
        v3-unlock (path base (str "v3_grid_unlock_audit_" stamp ".json"))
        matched-parity (path base (str "matched_feature_parity_" stamp ".json"))
        payload-dir (path base "payloads")
        expirations-payload (path payload-dir "expirations.json")
        quote-payload (path payload-dir "quote.json")]
    (.mkdir payload-dir ** :parents true :exist_ok true)
    (write-json! baseline
                 {"target_date" "2026-07-05"
                  "summary" {"generated_at" "2026-07-05T15:00:00Z"
                             "rows" 120
                             "captures" {"files" ["live_features_20260705.npz"]
                                         "rows_by_file" {"live_features_20260705.npz" 120}
                                         "skipped_files" {}
                                         "required_raw_replay_arrays" ["bar_buffers_json" "option_chain_json" "option_surfaces_json"]
                                         "raw_replay_missing_by_file" {}}
                             "per_capture" [{"date" "20260705"
                                             "path" "live_features_20260705.npz"
                                             "rows" 120
                                             "raw_replay_ready" true
                                             "raw_replay_missing" []}]
                             "capture_file_count" 1
                             "active_problem_count" 0}})
    (write-json! probe
                 {"target_date" "2026-07-05"
                  "generated_at" "2026-07-05T15:00:00Z"
                  "summary" {"total" 2 "ok" 2 "usable" 2 "failed" 0 "payload_examples" 2 "error_classes" {}}
                  "results" [{"name" "option.expirations"
                              "ok" true
                              "usable" true
                              "summary" {"required_ok" true "row_width_valid" true}
                              "payload_example" (str expirations-payload)}
                             {"name" "option.snapshot.quote"
                              "ok" true
                              "usable" true
                              "summary" {"required_ok" true "row_width_valid" true}
                              "payload_example" (str quote-payload)}]})
    (write-json! verification
                 {"target_date" stamp
                  "generated_at" "2026-07-05T15:00:00Z"
                  "status" "ok"
                  "valid?" true
                  "total" 2
                  "checked" 2
                  "skipped" 0
                  "invalid" 0
                  "example_generated_date_counts" {stamp 2}
                  "example_path_date_counts" {stamp 2}
                  "results" [{"probe" "option.expirations" "status" "ok" "valid?" true "path" (str expirations-payload)}
                             {"probe" "option.snapshot.quote" "status" "ok" "valid?" true "path" (str quote-payload)}]})
    (write-json! neutralization
                 {"target_date" "2026-07-05"
                  "summary" {"generated_at" "2026-07-05T15:00:00Z"
                             "candidate_now" 0
                             "review_count" 0
                             "blocked_count" 0
                             "neutralized_features" 826
                             "baseline_csv" (str (path base (str "live_feature_parity_baseline_" stamp ".csv")))
                             "usage_csv" (str (path base (str "live_feature_model_usage_" stamp ".csv")))}})
    (write-json! capture-check
                 {"target_date" "2026-07-05"
                  "generated_at" "2026-07-05T15:00:00Z"
                  "ok" true
                  "status" "ok"
                  "capture_version" 2
                  "row_count" 120
                  "unique_time_count" 120
                  "duplicate_time_count" 0
                  "sidecar_useful_rows" {"bar_buffers_json" 120
                                         "grid_history_json" 120
                                         "option_chain_json" 120
                                         "option_surfaces_json" 120}
                  "sidecar_total_contracts" {"option_chain_json" 24000
                                             "option_surfaces_json" 36000}
                  "sidecar_malformed_contracts" {"option_chain_json" 0
                                                 "option_surfaces_json" 0}
                  "required_option_surface_prefixes" ["SPX" "SPXW" "VIX" "VIXW"]
                  "option_surface_prefixes" ["SPX" "SPXW" "VIX" "VIXW"]
                  "option_surface_contracts_by_prefix" {"SPX" 9000 "SPXW" 9000 "VIX" 9000 "VIXW" 9000}
                  "option_surface_malformed_contracts_by_prefix" {"SPX" 0 "SPXW" 0 "VIX" 0 "VIXW" 0}
                  "issues" []
                  "warnings" []})
    (write-json! option-surface-sidecar-check
                 {"target_date" "2026-07-05"
                  "generated_at" "2026-07-05T15:00:00Z"
                  "ok" true
                  "row_count" 4
                  "useful_row_count" 4
                  "required_prefixes" ["SPX" "SPXW" "VIX" "VIXW"]
                  "prefixes_present" ["SPX" "SPXW" "VIX" "VIXW"]
                  "contracts_by_prefix" {"SPX" 1200 "SPXW" 1200 "VIX" 458 "VIXW" 255}
                  "malformed_by_prefix" {"SPX" 0 "SPXW" 0 "VIX" 0 "VIXW" 0}
                  "issues" []})
    (write-json! legacy-search
                 {"summary" {"target_date" "2026-07-05"
                             "generated_at" "2026-07-05T15:00:00Z"
                             "candidate_formula_hits" 0
                             "legacy_formula_provenance_hits" 0
                             "candidate_reconstruction_hits" 28
                             "manifest_reference_count" 60
                             "manifest_impl_classes_missing" 60
                             "hit_count" 108}
                  "manifest_references" []
                  "hits" []})
    (write-json! greek-promotion
                 {"summary" {"target_date" "2026-07-05"
                             "generated_at" "2026-07-05T15:00:00Z"
                             "capture_ok" true
                             "capture_reasons" []
                             "coverage_ok" true
                             "coverage_reasons" []
                             "evaluated_count" 60
                             "min_evaluated_count" 60
                             "raw_guarded_greek_reconstruction_count" 60
                             "candidate_count" 0
                             "candidate_features" []}
                  "features" []})
    (write-json! historical-cohort
                 {"target_date" "2026-07-05"
                  "generated_at" "2026-07-05T15:00:00Z"
                  "status" "ok"
                  "ok" true
                  "alignment" "thetadata"
