(deftest prepare-capture-v2-session-does-not-quarantine-only-too-few-rows
  (with-open [tmp-dir (tempfile/TemporaryDirectory)]
    (let [tmp (pathlib/Path tmp-dir)
          capture-dir (path tmp "captures")
          capture (path capture-dir "live_features_20260705.npz")]
      (write-capture capture :rows 0)
      (let [result (run-prepare "--capture-dir" (str capture-dir)
                                "--target-date" "2026-07-05")
            payload (stdout-json result)]
        (is (= 0 (.-returncode result)) (.-stderr result))
        (is (= "none" (.get payload "action")))
        (is (.exists capture))))))

(deftest capture-v2-sidecar-check-rejects-v1-capture-without-sidecars
  (with-open [tmp-dir (tempfile/TemporaryDirectory)]
    (let [capture (path (pathlib/Path tmp-dir) "live_features_20260705.npz")]
      (write-capture capture :version 1 :include-sidecars false)
      (let [result (run-check "--capture" (str capture) "--target-date" "2026-07-05")
            payload (stdout-json result)
            issues (str/join "\n" (.get payload "issues"))]
        (is (= 1 (.-returncode result)))
        (is (= false (.get payload "ok")))
        (is (str/includes? issues "capture_version must be 2"))
        (is (str/includes? issues "missing required arrays"))))))

(deftest capture-v2-sidecar-check-requires-grid-history-sidecar
  (with-open [tmp-dir (tempfile/TemporaryDirectory)]
    (let [capture (path (pathlib/Path tmp-dir) "live_features_20260705.npz")]
      (write-capture capture :rows 2)
      (replace-capture! capture #(dissoc % "grid_history_json"))
      (let [result (run-check "--capture" (str capture) "--target-date" "2026-07-05")
            payload (stdout-json result)
            issues (str/join "\n" (.get payload "issues"))]
        (is (= 1 (.-returncode result)))
        (is (str/includes? issues "missing required arrays"))
        (is (str/includes? issues "grid_history_json"))))))

(deftest capture-v2-sidecar-check-rejects-unusable-grid-history-sidecar
  (with-open [tmp-dir (tempfile/TemporaryDirectory)]
    (let [capture (path (pathlib/Path tmp-dir) "live_features_20260705.npz")]
      (write-capture capture :rows 2)
      (replace-capture! capture #(assoc % "grid_history_json" (numpy/array (python/list ["[]" (dumps [[1 2 3]])]))))
      (let [result (run-check "--capture" (str capture) "--target-date" "2026-07-05")
            payload (stdout-json result)
            issues (str/join "\n" (.get payload "issues"))]
        (is (= 1 (.-returncode result)))
        (is (= 2 (.get (.get payload "sidecar_nonblank_rows") "grid_history_json")))
        (is (= 0 (.get (.get payload "sidecar_useful_rows") "grid_history_json")))
        (is (str/includes? issues "grid_history_json has no rows with full greeks-grid history"))))))

(deftest capture-v2-sidecar-check-rejects-sparse-useful-sidecar-rows
  (with-open [tmp-dir (tempfile/TemporaryDirectory)]
    (let [capture (path (pathlib/Path tmp-dir) "live_features_20260705.npz")]
      (write-capture capture :rows 3)
      (replace-capture! capture
                        #(assoc % "bar_buffers_json" (numpy/array (python/list [(aget (get % "bar_buffers_json") 0) "" ""]))
                                  "grid_history_json" (numpy/array (python/list [(aget (get % "grid_history_json") 0) "[]" "[]"]))))
      (let [result (run-check "--capture" (str capture)
                              "--target-date" "2026-07-05"
                              "--min-rows" "3")
            payload (stdout-json result)
            issues (set (.get payload "issues"))]
        (is (= 1 (.-returncode result)))
        (is (= 3 (.get payload "row_count")))
        (is (= 3 (.get payload "unique_time_count")))
        (is (= 1 (.get (.get payload "sidecar_useful_rows") "bar_buffers_json")))
        (is (= 1 (.get (.get payload "sidecar_useful_rows") "grid_history_json")))
        (is (contains? issues "bar_buffers_json has 1 useful rows; expected at least 3"))
        (is (contains? issues "grid_history_json has 1 useful rows; expected at least 3"))))))

(deftest capture-v2-sidecar-check-row-limit-uses-latest-sidecar-rows
  (with-open [tmp-dir (tempfile/TemporaryDirectory)]
    (let [capture (path (pathlib/Path tmp-dir) "live_features_20260705.npz")]
      (write-capture capture :rows 4)
      (replace-capture! capture
                        #(assoc % "bar_buffers_json"
                                (numpy/array (python/list ["" "" (aget (get % "bar_buffers_json") 2) (aget (get % "bar_buffers_json") 3)])
                                             ** :dtype object)
                                "option_chain_json"
                                (numpy/array (python/list ["" "" (aget (get % "option_chain_json") 2) (aget (get % "option_chain_json") 3)])
                                             ** :dtype object)
                                "grid_history_json"
                                (numpy/array (python/list ["[]" "[]" (aget (get % "grid_history_json") 2) (aget (get % "grid_history_json") 3)])
                                             ** :dtype object)))
      (let [result (run-check "--capture" (str capture)
                              "--target-date" "2026-07-05"
                              "--min-rows" "2"
                              "--sidecar-row-limit" "2")
            payload (stdout-json result)]
        (is (= 0 (.-returncode result)) (.-stderr result))
        (is (= 4 (.get payload "row_count")))
        (is (= 2 (.get (.get payload "sidecar_useful_rows") "bar_buffers_json")))
        (is (= 2 (.get (.get payload "sidecar_useful_rows") "option_chain_json")))
        (is (= 2 (.get (.get payload "sidecar_useful_rows") "grid_history_json")))))))

