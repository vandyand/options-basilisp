(deftest capture-v2-sidecar-check-does-not-count-stringified-contract-rows
  (with-open [tmp-dir (tempfile/TemporaryDirectory)]
    (let [capture (path (pathlib/Path tmp-dir) "live_features_20260705.npz")
          malformed-surface (dumps {"contracts" ["{:strike 6000.0, :right \"CALL\", :bid 10.0, :ask 10.5, :expiration \"2026-07-10\"}"]})]
      (write-capture capture :rows 1)
      (replace-capture! capture
                        #(assoc % "option_chain_json"
                                (numpy/array (python/list [(dumps {"contracts" ["{:strike 600.0, :right \"CALL\", :bid 1.0, :ask 1.1, :expiration \"2026-07-10\"}"]})]))
                                  "option_surfaces_json"
                                  (numpy/array (python/list [(dumps {"SPX" malformed-surface})]))))
      (let [result (run-check "--capture" (str capture) "--target-date" "2026-07-05")
            payload (stdout-json result)
            issues (str/join "\n" (.get payload "issues"))]
        (is (= 1 (.-returncode result)))
        (is (= 0 (.get (.get payload "sidecar_total_contracts") "option_chain_json")))
        (is (= 0 (.get (.get payload "sidecar_total_contracts") "option_surfaces_json")))
        (is (= 1 (.get (.get payload "sidecar_malformed_contracts") "option_chain_json")))
        (is (= 1 (.get (.get payload "sidecar_malformed_contracts") "option_surfaces_json")))
        (is (= {"SPX" 0} (into {} (.items (.get payload "option_surface_contracts_by_prefix")))))
        (is (= {"SPX" 1} (into {} (.items (.get payload "option_surface_malformed_contracts_by_prefix")))))
        (is (= 0 (.get (.get payload "sidecar_useful_rows") "option_surfaces_json")))
        (is (str/includes? issues "option_chain_json has 1 non-object contract entries"))
        (is (str/includes? issues "option_surfaces_json has 1 non-object contract entries"))
        (is (str/includes? issues "option_surfaces_json has no rows with option contracts"))))))

(deftest capture-v2-sidecar-check-warns-when-required-surface-prefixes-are-missing
  (with-open [tmp-dir (tempfile/TemporaryDirectory)]
    (let [capture (path (pathlib/Path tmp-dir) "live_features_20260705.npz")]
      (write-capture capture :rows 2)
      (replace-capture! capture
                        #(assoc % "option_surfaces_json"
                                (obj-array (for [i (range 2)]
                                             (dumps {"SPXW" (dumps {"contracts" [(sidecar-contract (+ 6000.0 i) "PUT" 10.0 10.5 "2026-07-10")]})})))))
      (let [result (run-check "--capture" (str capture) "--target-date" "2026-07-05")
            payload (stdout-json result)
            issues (str/join "\n" (.get payload "issues"))]
        (is (= 1 (.-returncode result)))
        (is (= ["SPXW"] (vec (.get payload "option_surface_prefixes"))))
        (is (= {"SPXW" 2} (into {} (.items (.get payload "option_surface_contracts_by_prefix")))))
        (is (str/includes? issues "missing required surface prefixes with contracts: SPX, VIX, VIXW"))))))

(deftest capture-v2-sidecar-check-can-allow-missing-for-preflight
  (with-open [tmp-dir (tempfile/TemporaryDirectory)]
    (let [capture (path (pathlib/Path tmp-dir) "live_features_20260705.npz")
          result (run-check "--capture" (str capture)
                            "--target-date" "2026-07-05"
                            "--allow-missing")
          payload (stdout-json result)]
      (is (= 0 (.-returncode result)))
      (is (= true (.get payload "ok")))
      (is (= "missing" (.get payload "status")))
      (is (str/includes? (str/join "\n" (.get payload "warnings")) "capture file is not present yet")))))

(deftest capture-v2-sidecar-check-warns-when-option-sidecars-have-no-contracts
  (with-open [tmp-dir (tempfile/TemporaryDirectory)]
    (let [capture (path (pathlib/Path tmp-dir) "live_features_20260705.npz")]
      (write-capture capture :rows 2)
      (replace-capture! capture
                        #(assoc % "option_chain_json" (obj-array (for [_ (range 2)] (dumps {"contracts" []})))
                                  "option_surfaces_json" (obj-array (for [_ (range 2)] (dumps {})))))
      (let [result (run-check "--capture" (str capture) "--target-date" "2026-07-05")
            payload (stdout-json result)
            issues (str/join "\n" (.get payload "issues"))]
        (is (= 1 (.-returncode result)))
        (is (= 0 (.get (.get payload "sidecar_useful_rows") "option_chain_json")))
        (is (= 0 (.get (.get payload "sidecar_useful_rows") "option_surfaces_json")))
        (is (str/includes? issues "SPY option-chain unlocks will not verify"))
        (is (str/includes? issues "SPX/VIX/VIXW option unlocks will not verify"))))))

(deftest capture-v2-sidecar-check-reports-option-surface-refresh-status
  (with-open [tmp-dir (tempfile/TemporaryDirectory)]
    (let [capture (path (pathlib/Path tmp-dir) "live_features_20260705.npz")]
      (write-capture capture :rows 1)
      (replace-capture! capture
                        #(assoc % "option_surfaces_json" (obj-array [(dumps {})])
                                  "option_surface_status_json"
                                  (obj-array [(dumps {"SPX" (dumps {"ok" false
                                                                    "reason" "fetch-error"
                                                                    "error" "connection reset"
                                                                    "contracts" 0})
                                                      "VIXW" (dumps {"ok" false
                                                                     "reason" "missing-underlying"
                                                                     "contracts" 0})})])))
      (let [result (run-check "--capture" (str capture) "--target-date" "2026-07-05")
            payload (stdout-json result)
            statuses (into {} (.items (.get payload "option_surface_status_by_prefix")))
            spx (.get statuses "SPX")
            vixw (.get statuses "VIXW")
            warnings (str/join "\n" (.get payload "warnings"))]
        (is (= 1 (.-returncode result)))
        (is (= false (.get spx "ok")))
        (is (= "fetch-error" (.get spx "reason")))
        (is (= "connection reset" (.get spx "error")))
        (is (= false (.get vixw "ok")))
        (is (= "missing-underlying" (.get vixw "reason")))
        (is (not (str/includes? warnings "option_surface_status_json is missing")))))))
