(deftest capture-v2-sidecar-check-rejects-duplicate-timestamps
  (with-open [tmp-dir (tempfile/TemporaryDirectory)]
    (let [capture (path (pathlib/Path tmp-dir) "live_features_20260705.npz")]
      (write-capture capture :rows 3)
      (replace-capture! capture #(assoc % "times" (numpy/array (python/list ["2026-07-05T10:00:00" "2026-07-05T10:01:00" "2026-07-05T10:01:00"]))))
      (let [result (run-check "--capture" (str capture)
                              "--target-date" "2026-07-05"
                              "--min-rows" "3")
            payload (stdout-json result)
            issues (set (.get payload "issues"))]
        (is (= 1 (.-returncode result)))
        (is (= 3 (.get payload "row_count")))
        (is (= 2 (.get payload "unique_time_count")))
        (is (= 1 (.get payload "duplicate_time_count")))
        (is (= ["2026-07-05T10:01:00Z"] (vec (.get payload "duplicate_times"))))
        (is (contains? issues "capture has 2 unique timestamp rows; expected at least 3"))))))

(deftest capture-v2-sidecar-check-rejects-blank-and-malformed-timestamps
  (with-open [tmp-dir (tempfile/TemporaryDirectory)]
    (let [capture (path (pathlib/Path tmp-dir) "live_features_20260705.npz")]
      (write-capture capture :rows 3)
      (replace-capture! capture #(assoc % "times" (numpy/array (python/list ["" "not-a-time" "#inst \"2026-07-05T10:02:00+00:00\""]))))
      (let [result (run-check "--capture" (str capture)
                              "--target-date" "2026-07-05"
                              "--min-rows" "2")
            payload (stdout-json result)
            issues (set (.get payload "issues"))]
        (is (= 1 (.-returncode result)))
        (is (= 3 (.get payload "row_count")))
        (is (= 1 (.get payload "valid_time_count")))
        (is (= 1 (.get payload "unique_time_count")))
        (is (= 1 (.get payload "blank_time_count")))
        (is (= 1 (.get payload "malformed_time_count")))
        (is (= ["not-a-time"] (vec (.get payload "malformed_times"))))
        (is (contains? issues "capture has 1 blank timestamp rows"))
        (is (contains? issues "capture has 1 malformed timestamp rows"))
        (is (contains? issues "capture has 1 unique timestamp rows; expected at least 2"))))))

(deftest capture-v2-sidecar-check-normalizes-duplicate-timestamp-encodings
  (with-open [tmp-dir (tempfile/TemporaryDirectory)]
    (let [capture (path (pathlib/Path tmp-dir) "live_features_20260705.npz")]
      (write-capture capture :rows 3)
      (replace-capture! capture #(assoc % "times" (numpy/array (python/list ["#inst \"2026-07-05T10:01:00+00:00\"" "2026-07-05T10:01:00Z" "2026-07-05T10:02:00-00:00"]))))
