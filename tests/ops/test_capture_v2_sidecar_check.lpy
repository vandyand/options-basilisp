        (is (= 2 (.get payload "unique_time_count")))
        (is (= 1 (.get payload "duplicate_time_count")))
        (is (= ["2026-07-05T10:01:00Z"] (vec (.get payload "duplicate_times"))))
        (is (str/includes? issues "duplicate timestamp rows"))))))

