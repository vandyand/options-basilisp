(defn resolve-basilisp []
  (cond
    (os.environ/get "BASILISP_BIN") (pathlib/Path (os.environ/get "BASILISP_BIN"))
    (.exists (.joinpath root ".venv/bin/basilisp")) (.joinpath root ".venv/bin/basilisp")
    (.exists (.with_name (pathlib/Path sys/executable) "basilisp")) (.with_name (pathlib/Path sys/executable) "basilisp")
    (shutil/which "basilisp") (pathlib/Path (shutil/which "basilisp"))
    :else (.joinpath root ".venv/bin/basilisp")))

(def basilisp (str (resolve-basilisp)))

(defn path [parent child]
  (.joinpath parent child))

(defn read-file [rel]
  (.read_text (.joinpath root rel)))

(defn runtime-wrapper-files []
  (let [roots [(.joinpath root "scripts")
               (.joinpath root "projects/ops/scripts")]
        suffixes #{".sh" ".service" ".timer"}]
    (vec
     (sort
      (for [search-root roots
            path (iterator-seq (.rglob search-root "*"))
            :when (and (.is_file path)
                       (contains? suffixes (.-suffix path)))]
        (.as_posix (.relative_to path root)))))))

(defn python-script-reference? [text]
  (or (not (nil? (re-find #"(?m)(?:^|\s)(?:python|python3)\s+[^;\n]*\.py\b" text)))
      (not (nil? (re-find #"(?m)(?:^|\s)(?:bash|env|timeout|exec|nohup)\s+[^;\n]*\.py\b" text)))
      (not (nil? (re-find #"(?m)Exec(?:Start|StartPre|Reload|Stop)=[^\n]*\.py\b" text)))))

(defn jsonable [x]
  (cond
    (map? x) (python/dict (map (fn [[k v]] (python/tuple [(str k) (jsonable v)])) x))
    (or (vector? x) (seq? x)) (python/list (map jsonable x))
    :else x))

(defn merged-env [m]
  (let [env (.copy os/environ)]
    (.update env (jsonable (or m {})))
    env))

(defn run-cmd
  ([args] (run-cmd args {} root nil))
  ([args env cwd timeout]
   (subprocess/run
    (python/list args)
    ** :cwd (str cwd)
       :env (merged-env env)
       :text true
       :capture_output true
       :check false
       :timeout (or timeout 60))))

(defn run-basilisp [script args cwd env timeout]
  (run-cmd (concat [basilisp "run" (str (.joinpath root script)) "--"] args)
           env cwd timeout))

(deftest reports-web-service-uses-deployed-basilisp-bin-env
  (let [service (read-file "projects/ops/scripts/systemd/stevetrading-reports-web.service")]
    (is (str/includes? service "EnvironmentFile=-/etc/stevetrading/env"))
    (is (str/includes? service "${BASILISP_BIN:?BASILISP_BIN not set}"))
    (is (not (str/includes? service "/opt/stevetrading/current/.venv/bin/basilisp")))))

(deftest status-dashboard-wrapper-autoloads-deployed-env-without-overriding-explicit-env
  (let [script (read-file "projects/ops/scripts/run_status_dashboard.sh")]
    (doseq [snippet ["/etc/stevetrading/env"
                     "-z \"${BASILISP_BIN:-}\""
                     "-z \"${STEVE_REF_ROOT:-}\""
                     "-z \"${ANALYSIS_DIR:-}\""
                     "resolve_runner \"${BASILISP_BIN:-}\""]]
      (is (str/includes? script snippet) snippet))))

(deftest reports-static-server-has-no-python-wrappers
  (is (not (.exists (.joinpath root "projects/ops/scripts/reports_static_server.py"))))
  (is (not (.exists (.joinpath root "scripts/ops/reports_static_server.py")))))

(deftest reports-static-server-public-status-requires-explicit-flag
  (let [server (read-file "scripts/reports_static_server.lpy")]
    (is (str/includes? server "os/getenv \"REPORTS_PUBLIC_STATUS\" \"\""))
    (is (str/includes? server "contains? public-paths"))
    (is (str/includes? server "REPORTS_PASSWORD_SHA256 is required unless REPORTS_ALLOW_NO_AUTH=1"))))

(deftest manual-session-runners-export-canonical-repo-root-and-basilisp-override
  (doseq [rel ["scripts/open_session.sh"
               "scripts/steve_six_session.sh"
               "scripts/steve_watchdog.sh"
               "scripts/local_sim_session.sh"
               "scripts/local_sim_watchdog.sh"
               "scripts/lint.sh"
               "scripts/test.sh"
               "scripts/nrepl.sh"]]
    (is (str/includes? (read-file rel) "export STEVE_REPO_ROOT=\"$REPO\"") rel))
  (let [open-session (read-file "scripts/open_session.sh")
        steve-six (read-file "scripts/steve_six_session.sh")
        lint (read-file "scripts/lint.sh")
        test-runner (read-file "scripts/test.sh")
        nrepl (read-file "scripts/nrepl.sh")]
    (is (str/includes? open-session "REPO=\"${STEVE_REPO_ROOT:-$(cd \"$(dirname \"$0\")/..\" && pwd)}\""))
    (is (str/includes? open-session "BASILISP=\"${BASILISP_BIN:-$REF/.venv/bin/basilisp}\""))
    (is (str/includes? open-session "PYTHONPATH=\"$PYPATH\" \"$BASILISP\" run \"$REPO/scripts/launch_open_venturevd.lpy\""))
    (is (not (str/includes? open-session "\"$REPO/.venv/bin/basilisp\"")))
    (is (str/includes? steve-six "BASILISP=\"${BASILISP_BIN:-$REF/.venv/bin/basilisp}\""))
    (is (str/includes? lint "BASILISP=\"${BASILISP_BIN:-$REPO/.venv/bin/basilisp}\""))
    (is (str/includes? lint "\"$BASILISP\" run scripts/compile_check.lpy"))
    (is (str/includes? lint "\"$BASILISP\" run scripts/check_deps.lpy"))
    (is (str/includes? test-runner "BASILISP=\"${BASILISP_BIN:-$REPO/.venv/bin/basilisp}\""))
    (is (str/includes? test-runner "exec \"$BASILISP\" test \"$@\""))
    (is (str/includes? nrepl "BASILISP=\"${BASILISP_BIN:-$REPO/.venv/bin/basilisp}\""))
    (is (str/includes? nrepl "nohup \"$BASILISP\" nrepl-server --port \"${PORT}\""))))

(deftest test-runner-has-fast-inner-loop-mode
  (let [text (read-file "scripts/test.sh")
        docs (read-file "tests/README.md")
        inner-block (subs text (.index text "inner)") (.index text "    ;;\n  changed)"))]
    (is (str/includes? text "scripts/test.sh inner"))
    (is (str/includes? docs "scripts/test.sh inner"))
    (is (str/includes? text "tests/test_toolchain.lpy"))
    (is (str/includes? text "tests/feature_parity/test_evidence_status.lpy"))
    (is (not (str/includes? inner-block "tests/ops")))
    (is (not (str/includes? inner-block "tests/e2e")))))

(deftest test-runner-rejects-python-test-targets
  (let [text (read-file "scripts/test.sh")
        result (run-cmd [(str (.joinpath root "scripts/test.sh")) "map" "tests/ops/legacy_python_test.py"])]
    (is (str/includes? text "reject_python_test_target"))
    (is (str/includes? text "Python test targets are not supported"))
    (is (str/includes? text "tests/*.py|tests/**/*.py"))
    (is (= 2 (.-returncode result)) (str (.-stdout result) (.-stderr result)))
    (is (str/includes? (.-stderr result) "Python test targets are not supported"))))

(deftest market-evidence-wrapper-uses-basilisp-status-assertions
  (let [text (read-file "scripts/collect_market_evidence.sh")]
    (is (str/includes? text "scripts/assert_market_evidence_status.lpy"))
    (is (not (str/includes? text "python3 - \"$STATUS_JSON\"")))))

(deftest local-sim-wrappers-use-strict-basilisp-thetadata-health
  (doseq [rel ["scripts/local_sim_session.sh"
               "scripts/local_sim_watchdog.sh"]]
    (let [text (read-file rel)
          theta-block (subs text (.index text "theta_healthy()")
                            (.index text "}\n\n" (.index text "theta_healthy()")))]
      (is (str/includes? theta-block "scripts/wait_thetadata_health.lpy") rel)
	      (is (str/includes? theta-block "--timeout-seconds") rel)
	      (is (not (str/includes? theta-block "curl -sS")) rel)
	      (is (not (str/includes? theta-block "*expiration*")) rel))))

(deftest local-sim-session-and-watchdog-locks-do-not-perma-block-recovery
  (let [session (read-file "scripts/local_sim_session.sh")
        watchdog (read-file "scripts/local_sim_watchdog.sh")]
    (is (str/includes? session "live_runtime/local_sim_session.lock"))
    (is (str/includes? session "flock -n 8"))
    (is (str/includes? watchdog "live_runtime/local_sim_watchdog.lock"))
    (is (str/includes? watchdog "flock -n 9"))
    (doseq [snippet ["local_sim_session.sh\" 9>&-"
                     "\"$REF_BASILISP\" run \"$REPO/scripts/launch_vol_term_sim.lpy\" \\\n    9>&-"]]
      (is (str/includes? watchdog snippet) snippet))))

(deftest market-evidence-wrapper-uses-basilisp-workflow-scripts
  (let [text (read-file "scripts/collect_market_evidence.sh")]
    (doseq [script ["scripts/thetadata_capability_probe.lpy"
                    "scripts/live_feature_prediction_delta.lpy"
                    "scripts/live_feature_parity_baseline.lpy"
                    "scripts/market_evidence_status.lpy"]]
      (is (str/includes? text script) script))
    (doseq [stale ["scripts/thetadata_capability_probe.py"
                   "scripts/live_feature_prediction_delta.py"
                   "scripts/live_feature_parity_baseline.py"
                   ".venv/bin/python"]]
      (is (not (str/includes? text stale)) stale))))

