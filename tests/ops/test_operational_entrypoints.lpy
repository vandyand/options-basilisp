(deftest production-python-script-inventory-is-empty
  (let [search-roots [(.joinpath root "scripts") (.joinpath root "projects/ops/scripts") (.joinpath root "tests")]
        discovered (atom [])]
    (doseq [search-root search-roots]
      (doseq [path (iterator-seq (.rglob search-root "*.py"))]
        (when-not (some #{"__pycache__"} (.-parts path))
          (swap! discovered conj (.as_posix (.relative_to path root))))))
    (is (= [] @discovered))))

(deftest runtime-wrappers-do-not-call-python-scripts
  (let [offenders (vec
                   (for [rel (runtime-wrapper-files)
                         :let [text (read-file rel)]
                         :when (python-script-reference? text)]
                     rel))]
    (is (= [] offenders))))

(deftest market-evidence-wrapper-overrides-stale-parent-repo-root
  (with-open [tmp-dir (tempfile/TemporaryDirectory)]
    (let [tmp (pathlib/Path tmp-dir)
          current (path tmp "current")
          logs (path tmp "logs")
          fake-collect (path tmp "fake-collect-market-evidence")
          calls (path tmp "calls.txt")]
      (.mkdir current)
      (.write_text fake-collect
                   (str "#!/usr/bin/env bash\n"
                        "set -euo pipefail\n"
                        "printf 'args=%s\\n' \"$*\" >> " calls "\n"
                        "printf 'STEVE_REPO_ROOT=%s\\n' \"$STEVE_REPO_ROOT\" >> " calls "\n"
                        "printf 'PWD=%s\\n' \"$PWD\" >> " calls "\n"))
      (.chmod fake-collect 493)
      (let [result (run-cmd [(str (.joinpath root "projects/ops/scripts/run_market_evidence.sh"))]
                            {"STEVE_REPO_ROOT" (str (path tmp "poisoned-parent-root"))
                             "STEVETRADING_BASILISP_ROOT" (str current)
                             "MARKET_EVIDENCE_MODE" "dry-run"
                             "MARKET_EVIDENCE_SKIP_NON_TRADING_DAYS" "0"
                             "MARKET_EVIDENCE_COLLECT_SCRIPT" (str fake-collect)
                             "MARKET_EVIDENCE_LOG_DIR" (str logs)}
                            tmp 60)
            call-text (.read_text calls)]
        (is (= 0 (.-returncode result)) (str (.-stdout result) (.-stderr result)))
        (is (str/includes? call-text (str "STEVE_REPO_ROOT=" current)))
        (is (str/includes? call-text (str "PWD=" current)))
        (is (not (str/includes? call-text "poisoned-parent-root")))))))

(deftest current-pnl-no-rows-exits-nonzero
  (with-open [tmp-dir (tempfile/TemporaryDirectory)]
    (let [tmp (pathlib/Path tmp-dir)
          result (run-basilisp "scripts/current_pnl.lpy" ["venturevd"]
                               tmp {"HOME" (str tmp) "STEVE_REPO_ROOT" (str root)} 60)]
      (is (= 1 (.-returncode result)))
      (is (str/includes? (.-stdout result) "No account rows found")))))

(deftest steve-v2-replay-rejects-malformed-cli-flags-before-loading-bridge
  (with-open [tmp-dir (tempfile/TemporaryDirectory)]
    (let [tmp (pathlib/Path tmp-dir)
          cases [[["--max-facts" "1.5"] "invalid --max-facts: 1.5"]
                 [["--max-facts" "0"] "invalid --max-facts: 0"]
                 [["--mult2-scale" "nan"] "invalid --mult2-scale: nan"]
                 [["--mult2-scale" "-1"] "invalid --mult2-scale: -1"]
                 [["--bundle-variant" "legacy"] "invalid bundle-variant: legacy"]
                 [["--fixtuer" (str (path tmp "missing.edn"))] "unknown argument: --fixtuer"]
                 [["--max-facts"] "missing value for --max-facts"]
                 [["--max-facts" "--bundle-variant"] "missing value for --max-facts"]]]
      (doseq [[extra expected] cases]
        (let [result (run-basilisp "scripts/launch_steve_v2_replay.lpy"
                                   (concat ["--fixture" (str (path tmp "missing.edn"))
                                            "--out" (str (path tmp "out"))]
                                           extra)
                                   root {"STEVE_REPO_ROOT" (str root)} 30)]
          (is (= 2 (.-returncode result)) (str extra))
          (is (str/includes? (.-stdout result) expected) expected)
          (is (not (str/includes? (.-stdout result) "loading Steve V2 bridge"))))))))

(deftest sim-broker-status-missing-journals-exits-nonzero
  (with-open [tmp-dir (tempfile/TemporaryDirectory)]
    (let [tmp (pathlib/Path tmp-dir)
          result (run-basilisp "scripts/sim_broker_status.lpy" [] tmp {} 60)]
      (is (= 1 (.-returncode result)))
      (is (str/includes? (.-stdout result) "No durable sim broker journals found")))))

(deftest safe-cli-scripts-help-and-unknown-args-do-not-traceback
  (doseq [script safe-cli-scripts]
    (let [help-result (run-cmd [basilisp "run" script "--" "--help"] {} root 60)
          unknown-result (run-cmd [basilisp "run" script "--" "--definitely-unknown"] {} root 60)]
      (is (= 0 (.-returncode help-result)) script)
      (is (not (str/includes? (.-stderr help-result) "Traceback")) script)
      (is (contains? #{1 2} (.-returncode unknown-result)) script)
      (is (not (str/includes? (.-stderr unknown-result) "Traceback")) script))))
