(ns reports.test-reports
  "Phase 11 reports base tests: the summary over a completed replay
  session must agree with (a) raw fact-log counts and (b) the portfolio
  derivation the runtime itself produced."
  (:import os.path sqlite3 tempfile)
  (:require [basilisp.edn :as edn]
            [basilisp.test :refer [deftest is testing]]
            [helpers.recovery-helpers :as h]
            [stevetrading.base.reports :as rep]
            [stevetrading.persistence.fact-store :as fs]
            [stevetrading.persistence.protocol :as p]))

(defn- control-facts
  []
  (p/facts-since (fs/make-fact-store
                  (os.path/join (:out-dir @h/control) "facts.db"))
                 0))

(deftest summary-counts-match-the-fact-log
  (let [facts (control-facts)
        summary (rep/build-summary facts)
        orders (:summary/orders summary)
        manual (fn [t] (count (filter #(= t (:record/type %)) facts)))]
    (is (= (count facts) (:summary/fact-count summary)))
    (testing "order counts come straight from the lifecycle facts"
      (is (= (manual :fact/order-intent-created)
             (:orders/intents-created orders)))
      (is (= (manual :fact/command-dispatched)
             (:orders/submits-dispatched orders)))
      (is (= (manual :fact/broker-ack-accepted)
             (:orders/acks-accepted orders)))
      (is (= (manual :fact/broker-ack-rejected)
             (:orders/acks-rejected orders)))
      (is (= (manual :fact/fill-observed) (:orders/fills orders)))
      (is (= 0 (:orders/cancelled orders))))
    (testing "the SMA-cross session shape: 2 intents → 2 fills"
      (is (= 2 (:orders/intents-created orders)))
      (is (= 2 (:orders/fills orders))))
    (testing "every fill is reported with its price and lineage"
      (is (= 2 (count (:summary/fills summary))))
      (is (every? #(and (string? (:fill/price %))
                        (string? (:fill/quantity %))
                        (string? (:order-intent/id %)))
                  (:summary/fills summary))))
    (testing "a clean session has no recovery events and no faults"
      (is (empty? (:summary/recovery summary)))
      (is (empty? (:summary/faults summary)))
      (is (empty? (:summary/skipped-ledger-fills summary))))))

(deftest summary-pnl-matches-the-portfolio-derivation
  (let [summary (rep/build-summary (control-facts))
        ;; the runtime's own final portfolio (same session)
        port (:portfolio (:summary @h/control))
        pnl (:summary/pnl summary)]
    (testing "ledger replay through the same derive/fold code reproduces
              the runtime's P&L exactly"
      (is (= (:portfolio/realized-pnl port) (:pnl/realized pnl)))
      (is (= (:portfolio/realized-trade-pnl port)
             (:pnl/realized-trade pnl)))
      (is (= (:portfolio/fees port) (:pnl/fees pnl)))
      (is (= (:portfolio/cash port) (:pnl/cash pnl)))
      (is (= (:portfolio/positions port) (:pnl/positions pnl))))
    (testing "per-strategy and per-account views are present"
      (is (contains? (:pnl/by-strategy pnl)
                     "strategy/simple-direction/sma-cross/v1"))
      (is (contains? (:pnl/by-account pnl) h/account-id))
      (is (= (:pnl/realized pnl)
             (get-in pnl [:pnl/by-account h/account-id :realized-pnl]))))))

(deftest summary-reports-recovery-events-and-faults
  ;; a crashed-and-recovered session surfaces its operational truth
  (let [env (h/make-env {})
        _crash (h/crash-run! env {:crash-before-fact
                                  (fn [f] (= :fact/broker-ack-accepted
                                             (:record/type f)))})
        recovery (h/recover! env)
        summary (rep/build-summary (h/log-facts (:out-dir env)))]
    (is (= :ready (:recovery/outcome recovery)))
    (testing "recovery start/complete events are listed in order"
      (is (= [:fact/recovery-started :fact/recovery-completed]
             (mapv :record/type (:summary/recovery summary))))
      (is (= :ready (:recovery/outcome
                     (second (:summary/recovery summary))))))
    (testing "the ack-ambiguity orphan marking shows up as a fault"
      (is (= 1 (count (:summary/faults summary))))
      (is (= :fault/reconciliation-anomaly
             (:fault/kind (first (:summary/faults summary))))))))

(deftest write-report-produces-edn-and-md
  (let [out-dir (tempfile/mkdtemp)
        summary (rep/write-report!
                 {:facts-path (os.path/join (:out-dir @h/control)
                                            "facts.db")
                  :out-dir out-dir})
        edn-path (os.path/join out-dir "summary.edn")
        md-path (os.path/join out-dir "summary.md")
        round-trip (edn/read-string (slurp edn-path))
        md (slurp md-path)]
    (testing "summary.edn round-trips to the pure build-summary value"
      (is (= summary round-trip)))
    (testing "summary.md is human-readable and covers the sections"
      (is (.startswith md "# Session Summary"))
      (is (>= (.find md "## Orders") 0))
      (is (>= (.find md "## Fills") 0))
      (is (>= (.find md "## Option Settlements") 0))
      (is (>= (.find md "## P&L") 0))
      (is (>= (.find md "Realized: ") 0))
      (is (>= (.find md "## Recovery Events") 0))
      (is (>= (.find md "## Faults") 0)))))

(deftest summary-includes-sim-store-and-broker-account-observations
  (let [sim-db (os.path/join (tempfile/mkdtemp) "sim-broker.db")
        conn (sqlite3/connect sim-db)
        _ (.execute conn
                    "CREATE TABLE sim_journal (id TEXT PRIMARY KEY, record TEXT NOT NULL, updated_at TEXT NOT NULL)")
        _ (.execute conn
                    "INSERT INTO sim_journal (id, record, updated_at) VALUES ('main', '{:orders {}}', '2026-06-23T20:55:00Z')")
        _ (.commit conn)
        _ (.close conn)
        facts [{:record/type :fact/broker-account-observed
                :record/account-id "account/sim/test"
                :fact/payload
                {:broker/source-system :broker/sim
                 :broker/account-id "account/sim/test"
                 :broker/observed-at "2026-06-23T20:55:01Z"
                 :account/open-order-count 0
                 :account/cash "12.34"
                 :account/realized-pnl "1.00"
                 :account/unrealized-pnl "0.50"
                 :account/net-positions {}}}
               {:record/type :fact/option-settlement-recorded
                :record/account-id "account/sim/test"
                :record/instrument-id
                "option/OPRA/SPY/2026-06-19/C/550.000"
                :fact/occurred-at "2026-06-19T20:00:00Z"
                :fact/recorded-at "2026-06-19T20:00:00Z"
                :fact/dedupe-key "settlement/sim/test"
                :fact/payload
                {:settlement/id "settlement/sim/test"
                 :settlement/type :settlement/option-expiration
                 :settlement/account-id "account/sim/test"
                 :settlement/strategy-id "strategy/test"
                 :settlement/instrument-id
                 "option/OPRA/SPY/2026-06-19/C/550.000"
                 :settlement/quantity "1"
                 :settlement/price "5.00"
                 :settlement/underlying-price "555.00"
                 :settlement/cash-amount "5.00"
                 :settlement/realized-pnl "3.00"
                 :settlement/settled-at "2026-06-19T20:00:00Z"
                 :lot/id "lot-test"
                 :lot/side :order-side/buy}}]
        summary (rep/build-summary facts {:sim-store-path sim-db})
        md (rep/render-markdown summary)]
    (is (= true (get-in summary [:summary/sim-store
                                 :sim-store/exists?])))
    (is (= "2026-06-23T20:55:00Z"
           (get-in summary [:summary/sim-store
                            :sim-store/updated-at])))
    (is (= "12.34"
           (get-in summary [:summary/broker-account-observations
                            "account/sim/test"
                            :account/cash])))
    (is (= 1 (count (:summary/settlements summary))))
    (is (>= (.find md "## Broker Account Observations") 0))
    (is (>= (.find md "## Option Settlements") 0))
    (is (>= (.find md "## Sim Broker Store") 0))))
