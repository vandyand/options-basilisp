                       :cash 100000.0
                       :gross-mv 0.0
                       :open-positions 0
                       :long-positions 0
                       :short-positions 0
                       :closed-trades 1
                       :open-trades 0
                       :pct-in-mkt 0.0
                       :fills 2
                       :include-in-total true}}
              {:name "BROKEN"
               :pnl nil
               :position "(Exception)"
               :stats {:section pnl/section-live
                       :realized-est nil
                       :unrealized nil
                       :equity nil
                       :cash nil
                       :gross-mv nil
                       :open-positions 0
                       :long-positions 0
                       :short-positions 0
                       :closed-trades 0
