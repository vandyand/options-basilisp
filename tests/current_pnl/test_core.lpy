(deftest markdown-render-keeps-valid-pnl-rows-with-non-money-warnings-in-totals
  (let [rows [{:name "VENTUREVD"
               :pnl 5.59
               :position "SPY:1"
               :stats {:section pnl/section-other-alpaca
                       :realized-est 6.31
                       :unrealized -0.72
                       :equity 96948.35
                       :cash 96197.36
                       :gross-mv 750.99
                       :open-positions 1
                       :long-positions 1
                       :short-positions 0
                       :closed-trades 0
                       :open-trades 1
                       :pct-in-mkt -3224729.0
                       :fills 0
                       :include-in-total true}}]
        out (pnl/render-markdown rows "2026-07-10 00:32:00 EDT")]
    (is (>= (.find out "pct-in-mkt-out-of-range") 0))
    (is (>= (.find out "| **SECTION TOTAL** | **$+5.59**") 0))
    (is (>= (.find out "| **GRAND TOTAL** | **$+5.59**") 0))))

(deftest row-issues-allow-carryover-open-position-without-same-day-fills
  (let [row {:name "VENTUREVD"
             :pnl 0.0
             :position "SPY:1"
             :stats {:realized-est 0.0
                     :unrealized 0.0
                     :open-positions 1
                     :long-positions 1
                     :short-positions 0
                     :closed-trades 0
                     :open-trades 1
                     :fills 0}}]
    (is (empty? (pnl/row-issues row)))))

(deftest row-issues-detect-open-position-without-position-identity
  (let [base {:name "MISSING-POSITION"
              :pnl 0.0
              :stats {:realized-est 0.0
                      :unrealized 0.0
                      :open-positions 1
                      :long-positions 1
                      :short-positions 0
                      :closed-trades 0
                      :open-trades 1
                      :fills 0}}]
    (doseq [position ["" "   " "(BrokerUnavailable)" nil]]
      (testing (str position)
        (is (some #(= "open-pos-missing-position-text" %)
                  (pnl/row-issues (assoc base :position position))))))))

(deftest row-issues-detect-malformed-current-pnl-numerics
  (let [row {:name "BROKEN"
             :pnl "nan?"
             :position "flat"
             :stats {:realized-est 0.0
                     :unrealized 0.0
                     :equity 100000.0
                     :cash 100000.0
                     :gross-mv "bad"
                     :pct-in-mkt "bad"
                     :open-positions -1
                     :long-positions 0
                     :short-positions 0
                     :closed-trades "1"
                     :open-trades true
                     :fills 0}}]
    (is (= #{"bad-number:pnl"
             "bad-number:gross-mv"
             "bad-number:pct-in-mkt"
             "bad-count:open-positions"
             "bad-count:closed-trades"
             "bad-count:open-trades"
             "included-total-without-pnl"}
           (set (pnl/row-issues row))))))

(deftest markdown-render-survives-malformed-current-pnl-numerics
  (let [rows [{:name "BROKEN"
               :pnl "bad"
               :position "flat"
               :stats {:section pnl/section-live
                       :realized-est 0.0
                       :unrealized 0.0
                       :equity 100000.0
                       :cash 100000.0
                       :gross-mv "bad"
                       :open-positions -1
                       :long-positions 0
                       :short-positions 0
                       :closed-trades "1"
                       :open-trades true
                       :pct-in-mkt "bad"
                       :fills 0
                       :include-in-total true}}]
        out (pnl/render-markdown rows "2026-07-03 12:00:00 EDT")]
    (is (>= (.find out "bad-number:pnl") 0))
    (is (>= (.find out "bad-number:gross-mv") 0))
    (is (>= (.find out "bad-number:pct-in-mkt") 0))
    (is (>= (.find out "bad-count:open-trades") 0))
    (is (>= (.find out "| BROKEN | n/a |") 0))
    (is (>= (.find out "| **SECTION TOTAL** | **$+0.00**") 0))))

(deftest row-issues-detect-impossible-market-time-percentages
  (let [negative {:name "NEGATIVE-MKT"
                  :pnl 0.0
                  :position "flat"
                  :stats {:realized-est 0.0
                          :unrealized 0.0
                          :pct-in-mkt -0.1
                          :open-positions 0
                          :long-positions 0
                          :short-positions 0
                          :closed-trades 0
                          :open-trades 0
                          :fills 0}}
        over {:name "OVER-MKT"
              :pnl 0.0
              :position "flat"
              :stats {:realized-est 0.0
                      :unrealized 0.0
                      :pct-in-mkt 100.1
                      :open-positions 0
                      :long-positions 0
                      :short-positions 0
                      :closed-trades 0
                      :open-trades 0
                      :fills 0}}]
    (is (some #(= "pct-in-mkt-out-of-range" %) (pnl/row-issues negative)))
    (is (some #(= "pct-in-mkt-out-of-range" %) (pnl/row-issues over)))))

(deftest deterministic-fuzz-row-issues-detect-open-state-contradictions
  (let [base {:name "OPEN-FUZZ"
              :pnl 0.0
              :position "SPY:1"
              :stats {:realized-est 0.0
                      :unrealized 0.0
                      :open-positions 1
                      :long-positions 1
                      :short-positions 0
                      :closed-trades 0
                      :open-trades 1
                      :pct-in-mkt 1.0
                      :fills 1}}
        open-trade-without-position
        (assoc base
               :position "flat"
               :stats (assoc (:stats base)
                             :open-positions 0
                             :long-positions 0
                             :open-trades 1))
        carry-open-position-without-same-day-open-trade
        (assoc-in base [:stats :open-trades] 0)]
    (is (some #(= "open-trades-without-position" %)
              (pnl/row-issues open-trade-without-position)))
    (is (not (some #(= "open-position-without-open-trade" %)
                   (pnl/row-issues
                    carry-open-position-without-same-day-open-trade))))))
