               :position "flat"
               :stats {:section pnl/section-live
                       :realized-est 10.0
                       :unrealized 0.0
                       :equity 100010.0
                       :cash 100000.0
                       :gross-mv 0.0
                       :open-positions 0
                       :long-positions 0
                       :short-positions 0
                       :closed-trades 1
                       :open-trades 0
                       :pct-in-mkt 0.0
                       :fills 2
                       :include-in-total true}}
              {:name "CONTRADICTORY"
               :pnl 9999.0
               :position "flat"
               :stats {:section pnl/section-live
                       :realized-est 1.0
                       :unrealized 2.0
                       :equity 109999.0
                       :cash 100000.0
                       :gross-mv 0.0
                       :open-positions 0
                       :long-positions 0
                       :short-positions 0
                       :closed-trades 1
                       :open-trades 0
                       :pct-in-mkt 0.0
                       :fills 2
                       :include-in-total true}}]
        out (pnl/render-markdown rows "2026-07-03 12:00:00 EDT")]
    (is (>= (.find out "CONTRADICTORY") 0))
    (is (>= (.find out "pnl!=real+unrl") 0))
    (is (>= (.find out "| **SECTION TOTAL** | **$+10.00**") 0))
    (is (>= (.find out "| **GRAND TOTAL** | **$+10.00**") 0))
    (is (= -1 (.find out "| **SECTION TOTAL** | **$+10,009.00**")))))

(deftest row-issues-detect-total-inclusion-without-valid-pnl
  (let [row {:name "BROKEN-TOTAL"
             :pnl nil
             :position "flat"
             :stats {:realized-est 0.0
                     :unrealized 0.0
                     :open-positions 0
                     :long-positions 0
                     :short-positions 0
                     :closed-trades 0
                     :open-trades 0
                     :fills 0
                     :include-in-total true}}]
    (is (= ["included-total-without-pnl"] (pnl/row-issues row)))))

