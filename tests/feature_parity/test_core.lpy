(deftest load-captures-skips-malformed-files-and-keeps-valid-evidence
  (let [dir (temp-dir)
        captures (os.path/join dir "captures")
        arr (numpy/array [[1.0 2.0] [3.0 4.0]])]
    (os/makedirs captures ** :exist_ok true)
    (numpy/savez (os.path/join captures "live_features_20260701.npz")
                 ** :times (numpy/array ["t1" "t2"])
                    :spy (numpy/array [600.0 601.0])
                    :grids (numpy/zeros #py (2 6 21 8))
                    :chestnut arr
                    :lynx arr
                    :moose arr)
    (numpy/savez (os.path/join captures "live_features_20260702.npz")
                 ** :times (numpy/array ["t1"])
                    :chestnut arr)
    (let [[X meta caps] (gate/load-captures captures nil)]
      (is (= [2 2] (vec (.-shape X))))
      (is (= 1 (count caps)))
      (is (= 2 (get-in meta ["rows_by_file" "live_features_20260701.npz"])))
      (is (>= (.find (get-in meta ["skipped_files" "live_features_20260702.npz"])
                     "missing required")
              0)))))

