(deftest baseline-stress-many-sane-features-with-injected-problems
  (let [n 80
        names (vec (map #(str "feat_" %) (range n)))
        base (numpy/array (vec (for [i (range 100)]
                                 (vec (for [j (range n)]
                                        (+ (* 0.01 i) (* 0.001 j)))))))
        mean (numpy/array (vec (repeat n 0.5)))
        std (numpy/array (vec (repeat n 0.3)))]
    ;; Inject deterministic failure modes into two columns.
    (doseq [i (range 100)]
      (aset base i 5 0.0)
      (aset base i 9 3.0))
    (let [rows (gate/build-baseline-rows base names mean std #{"feat_9"})
          summary (gate/summarize-baseline-rows rows)
          by-feature (into {} (map (fn [r] [(get r "feature") r]) rows))]
      (is (= n (count rows)))
      (is (= "ZERO_FILLED_LIVE" (get-in by-feature ["feat_5" "status"])))
      (is (= true (get-in by-feature ["feat_5" "active_problem"])))
      (is (= "DEGENERATE_LIVE" (get-in by-feature ["feat_9" "status"])))
      (is (= false (get-in by-feature ["feat_9" "active_problem"])))
      (is (= 1 (get summary "active_zero_filled")))
      (is (<= 1 (get summary "active_problem"))))))

