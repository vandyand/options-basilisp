(deftest model-usage-audit-stress-preserves-summary-invariants
  (let [dir (temp-dir)
        baseline (write-file
                  (os.path/join dir "live_feature_parity_baseline_20260703.csv")
                  (str model-usage-baseline-header
                       "feat_0,equity-base,SANE,false,false\n"
                       "feat_1,equity-base,ZERO_FILLED_LIVE,false,true\n"
                       "feat_2,equity-base,SANE,false,false\n"
                       "feat_3,equity-base,DEGENERATE_LIVE,false,true\n"
                       "feat_4,equity-base,SANE,false,false\n"
                       "feat_5,equity-base,SANE,false,false\n"
                       "feat_6,equity-base,SANE,false,false\n"
                       "feat_7,equity-base,SANE,false,false\n"))
        bundle (write-stress-xgb-bundle dir)
        {:keys [summaries rows]} (gate/model-usage-audit
                                  {:baseline-csv baseline
                                   :bundles [bundle]})]
    (is (= 3 (count summaries)))
    (doseq [summary summaries]
      (let [head (get summary "head")
            head-rows (filter #(= head (get % "head")) rows)
            split-total (reduce + (map #(get % "split_count") head-rows))
            gain-total (reduce + (map #(get % "total_gain") head-rows))
            cover-total (reduce + (map #(get % "total_cover") head-rows))
            tabular-total (reduce + (map #(if (= "tabular" (get % "feature_kind"))
                                            (get % "split_count")
                                            0)
                                         head-rows))
            embedding-total (reduce + (map #(if (= "embedding" (get % "feature_kind"))
                                              (get % "split_count")
                                              0)
                                           head-rows))]
        (is (= 90 (get summary "splits")))
        (is (= split-total (get summary "splits")))
        (is (= tabular-total (get summary "tabular_splits")))
        (is (= embedding-total (get summary "embedding_splits")))
        (is (approx= gain-total (get summary "total_gain")))
        (is (approx= cover-total (get summary "total_cover")))
        (is (> (get summary "active_problem_splits") 0))
        (is (> (get summary "active_problem_gain") 0.0))))))

(defn- write-json
  [path data]
  (spit path (json/dumps (gate/->jsonable data) ** :indent 2 :sort_keys true))
  path)

(defn- stamp->iso
  [stamp]
  (str (subs stamp 0 4) "-" (subs stamp 4 6) "-" (subs stamp 6 8)))

(defn- readiness-artifacts
  [dir stamp overrides]
  (let [iso-date (stamp->iso stamp)
        capture-file (str "live_features_" stamp ".npz")
        generated-at (str iso-date "T14:00:00Z")
        payload-generated-at (str iso-date "T14:01:00Z")
        baseline (write-json
                  (os.path/join dir (str "live_feature_parity_baseline_" stamp ".json"))
                  {"summary" (merge {"generated_at" generated-at
                                     "rows" 120
                                     "capture_file_count" 1
                                     "active_problem_count" 0
                                     "captures" {"files" [capture-file]
                                                 "rows_by_file" {capture-file 120}
                                                 "skipped_files" {}
                                                 "required_raw_replay_arrays" ["bar_buffers_json"
                                                                               "option_chain_json"
                                                                               "option_surfaces_json"]
                                                 "raw_replay_missing_by_file" {}}
                                     "per_capture" [{"date" stamp
                                                     "path" capture-file
                                                     "rows" 120
                                                     "raw_replay_ready" true
                                                     "raw_replay_missing" []}]}
                                    (get overrides "baseline" {}))})
        probe (write-json
               (os.path/join dir (str "thetadata_capability_probe_" stamp ".json"))
               (merge {"generated_at" generated-at
                       "summary" {"total" 4
                                  "ok" 4
                                  "usable" 2
                                  "failed" 0
                                  "payload_examples" 2
                                  "error_classes" {}}
                       "results" [{"name" "option.expirations"
                                   "ok" true
                                   "usable" true
                                   "summary" {"required_ok" true
                                              "row_width_valid" true}
                                   "payload_example" (os.path/join dir "payloads" stamp "expirations.json")}
                                  {"name" "option.snapshot.quote"
                                   "ok" true
                                   "usable" true
                                   "summary" {"required_ok" true
                                              "row_width_valid" true}
                                   "payload_example" (os.path/join dir "payloads" stamp "quote.json")}
                                  {"name" "option.snapshot.greeks"
                                   "ok" true
                                   "usable" false}
                                  {"name" "stock.snapshot.quote"
                                   "ok" true
                                   "usable" false}]}
                      (get overrides "probe" {})))
        payload-verification (write-json
                              (os.path/join dir (str "thetadata_payload_verification_" stamp ".json"))
                              (merge {"generated_at" payload-generated-at
                                      "valid?" true
                                      "status" "ok"
                                      "total" 2
                                      "checked" 2
                                      "skipped" 0
                                      "invalid" 0
                                      "example_generated_date_counts" {stamp 2}
                                      "example_path_date_counts" {stamp 2}
                                      "results" [{"probe" "option.expirations"
                                                  "path" (os.path/join dir "payloads" stamp "expirations.json")
                                                  "status" "ok"
                                                  "valid?" true}
                                                 {"probe" "option.snapshot.quote"
                                                  "path" (os.path/join dir "payloads" stamp "quote.json")
                                                  "status" "ok"
                                                  "valid?" true}]}
                                     (get overrides "payload-verification" {})))
        neutralization (write-json
                        (os.path/join dir (str "neutralization_audit_" stamp ".json"))
                        {"summary" (merge {"generated_at" generated-at
                                           "candidate_now" 0
                                           "review_count" 0
                                           "blocked_count" 0
                                           "neutralized_features" 826
                                           "baseline_csv" (os.path/join dir (str "live_feature_parity_baseline_" stamp ".csv"))
                                           "usage_csv" (os.path/join dir (str "live_feature_model_usage_" stamp ".csv"))}
                                          (get overrides "neutralization" {}))})
        matched-parity (write-json
                        (os.path/join dir (str "matched_feature_parity_" stamp ".json"))
                        {"summary" (merge {"target_date" iso-date
                                           "generated_at" generated-at
                                           "matched_rows" 120
                                           "matched_start" (str iso-date "T13:30:00Z")
                                           "matched_end" (str iso-date "T19:59:00Z")
                                           "feature_count" 2
                                           "neutralized_count" 0
                                           "problem_feature_count" 0
                                           "active_problem_count" 0
                                           "neutralized_problem_count" 0
                                           "status_counts" {"MATCH" 2}
                                           "max_abs_deviation" 0.0
                                           "min_correlation" 1.0}
                                          (get overrides "matched-parity" {}))
                         "features" (get overrides "matched-parity-features"
                                         [{"feature" "SPY_close"
                                           "status" "MATCH"
                                           "neutralized" false
                                           "active_problem" false}
                                          {"feature" "vix_proxy"
                                           "status" "MATCH"
                                           "neutralized" false
                                           "active_problem" false}])})]
    {"baseline" baseline
     "probe" probe
     "payload-verification" payload-verification
     "neutralization" neutralization
     "matched-parity" matched-parity}))

(deftest evidence-readiness-passes-for-fresh-sufficient-clean-artifacts
