(deftest evidence-readiness-rejects-invalid-min-capture-row-overrides
  (let [dir (temp-dir)
        artifacts (readiness-artifacts dir "20260705" {})]
    (doseq [bad-min [0 -1 1.5 true "many"]]
      (let [payload (gate/evidence-readiness
                     {:analysis-dir dir
                      :target-date "2026-07-05"
                      :baseline-json (get artifacts "baseline")
                      :probe-json (get artifacts "probe")
                      :payload-verification-json (get artifacts "payload-verification")
                      :neutralization-json (get artifacts "neutralization")
                      :min-capture-rows bad-min
                      :generated-at "2026-07-05T15:00:00Z"})]
        (is (= "FAIL" (get payload "verdict"))
            (str "bad min should fail: " (pr-str bad-min)))
        (is (some #(= "min-capture-rows must be positive integer" %)
                  (get payload "fail_reasons"))
            (str "bad min should be reported: " (pr-str bad-min)))))))

