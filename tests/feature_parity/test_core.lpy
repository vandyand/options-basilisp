(deftest neutralization-audit-rejects-malformed-input-csvs
  (let [dir (temp-dir)
        baseline (write-file
                  (os.path/join dir "live_feature_parity_baseline_20260703.csv")
                  (str audit-header
                       "f1,equity-base,SANE,true,false,1.0,1.0,0.0,1.0,0.0,0.0\n"))
        bad-baseline (write-file
                      (os.path/join dir "live_feature_parity_baseline_bad_20260703.csv")
                      (str audit-header
                           "f1,equity-base,SANE,true,false,nan,1.0,0.0,1.0,0.0,0.0\n"))
        bad-usage (write-file
                   (os.path/join dir "live_feature_model_usage_20260703.csv")
                   (str usage-header
                        "f1,not-a-number,1,1,chestnut,seed_z\n"
                        ",1.0,1,1,chestnut,seed_z\n"
                        "f2,1.0,-1,1,chestnut,seed_z\n"))
        missing-usage-column (write-file
                              (os.path/join dir "live_feature_model_usage_missing_20260703.csv")
                              (str "feature,total_gain,split_count,account,head\n"
                                   "f1,1.0,1,chestnut,seed_z\n"))
        usage-throw (try
                      (gate/summarize-neutralization-audit
                       {:baseline-csv baseline
                        :usage-csv bad-usage
                        :generated-at "2026-07-03T12:00:00Z"})
                      nil
                      (catch python/Exception e e))
        missing-throw (try
                        (gate/summarize-neutralization-audit
                         {:baseline-csv baseline
                          :usage-csv missing-usage-column
                          :generated-at "2026-07-03T12:00:00Z"})
                        nil
                        (catch python/Exception e e))
        baseline-throw (try
                         (gate/summarize-neutralization-audit
                          {:baseline-csv bad-baseline
                           :usage-csv bad-usage
                           :generated-at "2026-07-03T12:00:00Z"})
                         nil
                         (catch python/Exception e e))]
    (is (= :neutralization/malformed-input (:error/code (ex-data usage-throw))))
    (is (some #(not= -1 (.find % "total_gain must be finite numeric"))
              (:issues (ex-data usage-throw))))
    (is (some #(not= -1 (.find % "feature must be nonblank"))
              (:issues (ex-data usage-throw))))
    (is (some #(not= -1 (.find % "split_count must be nonnegative"))
              (:issues (ex-data usage-throw))))
    (is (some #(not= -1 (.find % "missing required columns"))
              (:issues (ex-data missing-throw))))
    (is (some #(not= -1 (.find % "live_mean must be finite numeric"))
              (:issues (ex-data baseline-throw))))))

