(deftest matched-time-indexes-normalizes-live-capture-instants
  (let [matched (gate/matched-time-indexes
                 ["#inst \"2026-07-05T13:30:00+00:00\""
                  "#inst \"2026-07-05T13:31:00+00:00\""
                  "#inst \"2026-07-05T13:32:00+00:00\""]
                 ["2026-07-05T13:31:00Z"
                  "2026-07-05T13:30:00Z"])]
    (is (= [0 1] (get matched "live_indexes")))
    (is (= [1 0] (get matched "historical_indexes")))
    (is (= ["2026-07-05T13:30:00Z"
            "2026-07-05T13:31:00Z"]
           (get matched "times")))))

(deftest matched-feature-parity-report-writes-steve-requested-metrics
  (let [dir (temp-dir)
        live (os.path/join dir "live_features_20260705.npz")
        historical (os.path/join dir "historical_features_20260705.npz")
        features (os.path/join dir "feature_names.json")
        neutralized (os.path/join dir "neutralize_features.json")
        out (os.path/join dir "out")]
    (spit features (json/dumps (gate/->jsonable ["SPY_close" "vix_proxy"])))
    (spit neutralized (json/dumps (gate/->jsonable ["vix_proxy"])))
    (numpy/savez live
                 ** :times (numpy/array ["#inst \"2026-07-05T13:30:00+00:00\""
                                          "#inst \"2026-07-05T13:31:00+00:00\""
                                          "#inst \"2026-07-05T13:32:00+00:00\""])
                    :chestnut (numpy/array [[1.0 0.0]
                                            [2.0 0.0]
                                            [3.0 0.0]]))
    (numpy/savez historical
                 ** :times (numpy/array ["2026-07-05T13:30:00Z"
                                          "2026-07-05T13:31:00Z"
                                          "2026-07-05T13:32:00Z"])
                    :X (numpy/array [[1.0 0.0]
                                     [2.5 0.0]
                                     [3.0 1.0]]))
    (let [{:keys [summary rows csv-path json-path markdown-path]}
          (gate/write-matched-feature-parity!
           {:live-capture live
            :historical-npz historical
            :feature-names features
            :out-dir out
            :target-date "2026-07-05"
            :generated-at "2026-07-05T20:00:00Z"})
          by-feature (into {} (map (fn [r] [(get r "feature") r]) rows))
          spy (get by-feature "SPY_close")
          vix (get by-feature "vix_proxy")
          payload (json/loads (slurp json-path))]
      (is (= 3 (get summary "matched_rows")))
      (is (= "2026-07-05T13:30:00Z" (get summary "matched_start")))
      (is (= "2026-07-05T13:32:00Z" (get summary "matched_end")))
      (is (= 2 (get summary "feature_count")))
      (is (= 1 (get (get summary "status_counts") "CONSTANT_OR_DEGENERATE")))
      (is (= 1 (get (get summary "status_counts") "DIVERGED")))
      (is (= 2 (get summary "problem_feature_count")))
      (is (= 1 (get summary "active_problem_count")))
      (is (= 1 (get summary "neutralized_count")))
      (is (= 1 (get summary "neutralized_problem_count")))
      (is (= 2 (count rows)))
      (is (= 2.0 (get spy "live_mean")))
      (is (= 0.5 (get spy "max_abs_deviation")))
      (is (= "DIVERGED" (get spy "status")))
      (is (= false (get spy "neutralized")))
      (is (= true (get spy "active_problem")))
      (is (= 0 (get spy "live_leading_zero_count")))
      (is (nil? (get spy "live_leading_zero_until")))
      (is (= 1.0 (get vix "live_zero_frac")))
      (is (= (/ 2.0 3.0) (get vix "historical_zero_frac")))
      (is (= 3 (get vix "live_leading_zero_count")))
      (is (= "2026-07-05T13:32:00Z" (get vix "live_leading_zero_until")))
      (is (= 2 (get vix "historical_leading_zero_count")))
      (is (= "2026-07-05T13:31:00Z" (get vix "historical_leading_zero_until")))
      (is (= "CONSTANT_OR_DEGENERATE" (get vix "status")))
      (is (= true (get vix "neutralized")))
      (is (= false (get vix "active_problem")))
      (is (= 3 (get-in payload ["summary" "matched_rows"])))
      (is (= 2 (get-in payload ["summary" "feature_count"])))
      (is (= 1 (get-in payload ["summary" "status_counts" "CONSTANT_OR_DEGENERATE"])))
      (is (= 1 (get-in payload ["summary" "status_counts" "DIVERGED"])))
      (is (= 1 (get-in payload ["summary" "active_problem_count"])))
      (is (= 1 (get-in payload ["summary" "neutralized_problem_count"])))
      (is (true? (os.path/exists csv-path)))
      (is (= 3 (count (str/split-lines (slurp csv-path)))))
      (is (str/includes? (slurp csv-path) "SPY_close"))
      (is (str/includes? (slurp csv-path) "vix_proxy"))
      (is (true? (os.path/exists markdown-path)))
      (is (.startswith (slurp markdown-path)
                       "# Matched Live vs Historical Feature Parity")))))

(deftest matched-feature-parity-report-rejects-insufficient-overlap
  (let [dir (temp-dir)
        live (os.path/join dir "live_features_20260705.npz")
        historical (os.path/join dir "historical_features_20260705.npz")
        features (os.path/join dir "feature_names.json")
        out (os.path/join dir "out")]
    (spit features (json/dumps (gate/->jsonable ["SPY_close"])))
    (numpy/savez live
                 ** :times (numpy/array ["#inst \"2026-07-05T13:30:00+00:00\""
                                          "#inst \"2026-07-05T13:31:00+00:00\""])
                    :chestnut (numpy/array [[1.0] [2.0]]))
    (numpy/savez historical
                 ** :times (numpy/array ["2026-07-05T13:30:00Z"
                                          "2026-07-05T13:31:00Z"])
                    :X (numpy/array [[1.0] [2.0]]))
    (os/makedirs out ** :exist_ok true)
    (doseq [ext [".json" ".csv" ".md"]]
      (spit (os.path/join out (str "matched_feature_parity_20260705" ext))
            "stale matched parity artifact\n"))
    (let [thrown (try
                   (gate/write-matched-feature-parity!
                    {:live-capture live
                     :historical-npz historical
                     :feature-names features
                     :out-dir out
                     :target-date "2026-07-05"
                     :min-rows 60})
                   nil
                   (catch python/Exception e e))]
      (is (not (nil? thrown)))
      (is (not= -1 (.find (str thrown)
                          "insufficient overlapping timestamps between live and historical tensors")))
      (is (false? (os.path/exists (os.path/join out "matched_feature_parity_20260705.json"))))
      (is (false? (os.path/exists (os.path/join out "matched_feature_parity_20260705.csv"))))
      (is (false? (os.path/exists (os.path/join out "matched_feature_parity_20260705.md")))))))
