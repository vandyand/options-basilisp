        artifacts (readiness-artifacts dir "20260705" {})
        neutralization-path (get artifacts "neutralization")
        neutralization (json/loads (slurp neutralization-path))]
    (spit neutralization-path
          (json/dumps
           (gate/->jsonable
            {"summary" (assoc (into {} (.items (get neutralization "summary")))
                               "neutralized_features" 0
                               "candidate_now" 0
                               "review_count" 0
                               "blocked_count" 0)
             "features" [{"feature" "candidate"
                          "recoverability" "candidate-now"}
                         {"feature" "review"
                          "recoverability" "review-shift"}
                         {"feature" "blocked"
                          "recoverability" "blocked-live-source"}]})
           ** :indent 2 :sort_keys true))
    (let [payload (gate/evidence-readiness
                   {:analysis-dir dir
                    :target-date "2026-07-05"
                    :baseline-json (get artifacts "baseline")
                    :probe-json (get artifacts "probe")
                    :payload-verification-json (get artifacts "payload-verification")
                    :neutralization-json neutralization-path
                    :generated-at "2026-07-05T15:00:00Z"})]
      (is (= "FAIL" (get payload "verdict")))
      (is (some #(= "neutralization audit neutralized_features does not match feature rows" %)
                (get payload "fail_reasons")))
      (is (some #(= "neutralization audit candidate_now does not match feature rows" %)
                (get payload "fail_reasons")))
      (is (some #(= "neutralization audit review_count does not match feature rows" %)
                (get payload "fail_reasons")))
      (is (some #(= "neutralization audit blocked_count does not match feature rows" %)
                (get payload "fail_reasons"))))))

