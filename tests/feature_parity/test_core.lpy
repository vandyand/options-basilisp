    (is (some #(= "ThetaData payload verification missing" %)
              (get missing "fail_reasons")))
    (is (= "FAIL" (get invalid "verdict")))
    (is (some #(= "ThetaData payload verification found invalid examples" %)
              (get invalid "fail_reasons")))
    (is (some #(= "ThetaData payload verification valid flag is not true" %)
              (get invalid "fail_reasons")))
    (is (some #(= "ThetaData payload verification status is not ok" %)
              (get invalid "fail_reasons")))))

