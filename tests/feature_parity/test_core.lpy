(deftest baseline-classifies-distribution-edge-cases
  (is (= "SANE"
         (gate/classify-feature (numpy/array [-1.0 0.0 1.0])
                                (numpy/array [-1.0 0.0 1.0])
                                1.0)))
  (is (= "ZERO_FILLED_LIVE"
         (gate/classify-feature (numpy/array [0.0 0.0 0.0])
                                (numpy/array [-0.5 -0.5 -0.5])
                                2.0)))
  (is (= "BOTH_ZERO"
         (gate/classify-feature (numpy/array [0.0 0.0 0.0])
                                (numpy/array [0.0 0.0 0.0])
                                0.0)))
  (is (= "DEGENERATE_LIVE"
         (gate/classify-feature (numpy/array [3.0 3.0 3.0])
                                (numpy/array [0.0 0.0 0.0])
                                1.0)))
  (is (= "WILD_OFFSET"
         (gate/classify-feature (numpy/array [10.0 11.0 12.0])
                                (numpy/array [10.0 11.0 12.0])
                                1.0)))
  (is (= "NONFINITE"
         (gate/classify-feature (numpy/array [numpy/nan numpy/inf])
                                (numpy/array [numpy/nan numpy/inf])
                                1.0))))

(deftest baseline-write-produces-expected-summary-and-files
  (let [{:keys [bundle captures out]} (make-baseline-fixture)
