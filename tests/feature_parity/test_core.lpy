    (is (= 0 (python/len (get-in json-payload ["summary" "captures" "raw_replay_missing_by_file"]))))
    (is (= true (get-in json-payload ["summary" "per_capture" 0 "raw_replay_ready"])))
    (is (= [] (vec (get-in json-payload ["summary" "per_capture" 0 "raw_replay_missing"]))))
    (is (true? (os.path/exists csv-path)))
    (is (true? (os.path/exists markdown-path)))
