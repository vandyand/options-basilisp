    (is (= "ZERO_FILLED_LIVE" (get-in by-feature ["zero_bug" "status"])))
    (is (= "DEGENERATE_LIVE" (get-in by-feature ["flat_active" "status"])))
    (is (= true (get-in by-feature ["zero_bug" "active_problem"])))
    (is (= false (get-in by-feature ["neutralized_bad" "active_problem"])))
