    (is (some #(not= -1 (.find % "feature parity baseline CSV has unexpected columns"))
              (get payload "reasons")))
    (is (some #(not= -1 (.find % "unexpected_column"))
              (get payload "reasons")))))

(deftest feature-parity-gate-fuzz-rejects-corrupted-baseline-csvs
  (let [dir (temp-dir)
        delta (write-file (os.path/join dir "live_feature_prediction_delta_aggregate_20260703.csv")
                          (str "strategy,p95_abs_seed_z_any_head,max_abs_seed_z_any_head\n"
                               "lynx,0.05,0.09\n"))
        corruptions [(str baseline-header
                          "f1,SANE,false,false\n"
                          "f1,SANE,false,false\n")
                     (str baseline-header
                          "f1,SANE,TRUEISH,false\n")
                     (str baseline-header
                          "f1,SANE,false,FALSEISH\n")
                     (str "feature,status,active_problem\n"
                          "f1,SANE,false\n")
                     (str baseline-header
                          "f1,GARBAGE,false,false\n")]]
    (doseq [[idx csv-text] (map-indexed vector corruptions)]
      (let [baseline (write-file (os.path/join dir (str "live_feature_parity_baseline_20260703_"
                                                        idx ".csv"))
                                 csv-text)
            payload (gate/summarize-gate {:baseline-csv baseline
                                          :prediction-delta-csv delta
                                          :out-dir dir
                                          :generated-at "2026-07-03T12:00:00Z"})]
        (is (= "FAIL" (get payload "verdict")) (str "corruption idx " idx))
        (is (seq (get payload "reasons")) (str "corruption idx " idx))))))

(deftest feature-parity-gate-fails-nonfinite-or-missing-prediction-delta-metrics
  (let [dir (temp-dir)
        baseline (write-file (os.path/join dir "live_feature_parity_baseline_20260703.csv")
                             (str baseline-header
                                  "f1,SANE,false,false\n"))
        nan-delta (write-file (os.path/join dir "live_feature_prediction_delta_aggregate_20260703.csv")
                              (str "strategy,p95_abs_seed_z_any_head,max_abs_seed_z_any_head\n"
                                   "lynx,nan,0.09\n"))
        blank-delta (write-file (os.path/join dir "live_feature_prediction_delta_aggregate_20260704.csv")
                                (str "strategy,p95_abs_seed_z_any_head,max_abs_seed_z_any_head\n"
                                     "lynx,0.05,\n"))
        nan-payload (gate/summarize-gate {:baseline-csv baseline
                                          :prediction-delta-csv nan-delta
                                          :out-dir dir
                                          :generated-at "2026-07-03T12:00:00Z"})
        blank-payload (gate/summarize-gate {:baseline-csv baseline
                                            :prediction-delta-csv blank-delta
                                            :out-dir dir
                                            :generated-at "2026-07-03T12:00:00Z"})]
    (is (= "FAIL" (get nan-payload "verdict")))
    (is (some #(not= -1 (.find % "missing/nonfinite/negative p95"))
              (get nan-payload "reasons")))
    (is (= "FAIL" (get blank-payload "verdict")))
    (is (some #(not= -1 (.find % "missing/nonfinite/negative max"))
              (get blank-payload "reasons")))))

(deftest feature-parity-gate-fails-prediction-delta-missing-required-columns
  (let [dir (temp-dir)
        baseline (write-file (os.path/join dir "live_feature_parity_baseline_20260703.csv")
                             (str baseline-header
                                  "f1,SANE,false,false\n"))
        missing-max (write-file (os.path/join dir "live_feature_prediction_delta_aggregate_20260703.csv")
                                (str "strategy,p95_abs_seed_z_any_head\n"
                                     "lynx,0.05\n"))
        empty-missing (write-file (os.path/join dir "live_feature_prediction_delta_aggregate_20260704.csv")
                                  "strategy\n")
        missing-max-payload (gate/summarize-gate {:baseline-csv baseline
                                                  :prediction-delta-csv missing-max
                                                  :out-dir dir
                                                  :generated-at "2026-07-03T12:00:00Z"})
        empty-missing-payload (gate/summarize-gate {:baseline-csv baseline
                                                    :prediction-delta-csv empty-missing
                                                    :out-dir dir
                                                    :generated-at "2026-07-04T12:00:00Z"})]
    (is (= "FAIL" (get missing-max-payload "verdict")))
    (is (some #(not= -1 (.find % "prediction delta CSV missing required columns"))
              (get missing-max-payload "reasons")))
    (is (some #(not= -1 (.find % "max_abs_seed_z_any_head"))
              (get missing-max-payload "reasons")))
    (is (= "FAIL" (get empty-missing-payload "verdict")))
    (is (some #(not= -1 (.find % "prediction delta CSV missing required columns"))
              (get empty-missing-payload "reasons")))
    (is (some #(= "prediction delta CSV has no rows" %)
              (get empty-missing-payload "reasons")))))

