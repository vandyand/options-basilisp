(deftest evidence-readiness-fails-for-malformed-payload-verification-result-rows
  (let [dir (temp-dir)
        cases [[{"results" "not-a-list"}
                "ThetaData payload verification results must be list"]
               [{"results" [{"probe" "option.expirations"
                             "status" "ok"}
                            {"probe" "option.snapshot.quote"
                             "status" "ok"
                             "valid?" true}]}
                "ThetaData payload verification result row 0 valid? must be boolean"]
               [{"results" [{"probe" "option.expirations"
                             "status" "green"
                             "valid?" true}
                            {"probe" "option.snapshot.quote"
                             "status" "ok"
                             "valid?" true}]}
                "ThetaData payload verification result row 0 status is invalid"]
               [{"results" [{"status" "ok"
                             "valid?" true}
                            {"probe" "option.snapshot.quote"
                             "status" "ok"
                             "valid?" true}]}
                "ThetaData payload verification result row 0 missing probe identity"]
               [{"results" ["not-an-object"
                            {"probe" "option.snapshot.quote"
                             "status" "ok"
                             "valid?" true}]}
                "ThetaData payload verification result row 0 must be object"]]]
    (doseq [[override expected] cases]
      (let [artifacts (readiness-artifacts
                       dir "20260705"
                       {"payload-verification" override})
            payload (gate/evidence-readiness
                     {:analysis-dir dir
                      :target-date "2026-07-05"
                      :baseline-json (get artifacts "baseline")
                      :probe-json (get artifacts "probe")
                      :payload-verification-json (get artifacts "payload-verification")
                      :neutralization-json (get artifacts "neutralization")
                      :generated-at "2026-07-05T15:00:00Z"})]
        (is (= "FAIL" (get payload "verdict")))
        (is (some #(= expected %) (get payload "fail_reasons")))))))

(deftest evidence-readiness-fails-for-malformed-probe-result-rows
  (let [dir (temp-dir)
        cases [[{"results" "not-a-list"}
                "ThetaData probe results must be list"]
               [{"results" [{"ok" true
                             "usable" true
                             "payload_example" "expirations.json"}
                            {"name" "option.snapshot.quote"
                             "ok" true
                             "usable" true
                             "payload_example" "quote.json"}
                            {"name" "option.snapshot.greeks"
                             "ok" true
                             "usable" false}
                            {"name" "stock.snapshot.quote"
                             "ok" true
                             "usable" false}]}
                "ThetaData probe result row 0 missing probe identity"]
               [{"results" [{"name" "option.expirations"
                             "usable" true
                             "payload_example" "expirations.json"}
                            {"name" "option.snapshot.quote"
                             "ok" true
                             "usable" true
                             "payload_example" "quote.json"}
                            {"name" "option.snapshot.greeks"
                             "ok" true
                             "usable" false}
                            {"name" "stock.snapshot.quote"
                             "ok" true
                             "usable" false}]}
                "ThetaData probe result row 0 ok must be boolean"]
               [{"results" [{"name" "option.expirations"
                             "ok" true
                             "payload_example" "expirations.json"}
                            {"name" "option.snapshot.quote"
                             "ok" true
                             "usable" true
                             "payload_example" "quote.json"}
                            {"name" "option.snapshot.greeks"
                             "ok" true
                             "usable" false}
                            {"name" "stock.snapshot.quote"
                             "ok" true
                             "usable" false}]}
                "ThetaData probe result row 0 usable must be boolean"]
               [{"results" [{"name" "option.expirations"
                             "ok" false
                             "usable" false
                             "payload_example" "expirations.json"}
                            {"name" "option.snapshot.quote"
                             "ok" true
                             "usable" true
                             "payload_example" "quote.json"}
                            {"name" "option.snapshot.greeks"
                             "ok" true
                             "usable" false}
                            {"name" "stock.snapshot.quote"
                             "ok" true
                             "usable" false}]}
                "ThetaData probe result row 0 saved payload example despite ok=false"]
               [{"results" [{"name" "option.expirations"
                             "ok" true
                             "usable" true
                             "payload_example" "expirations.json"}
                            {"name" "option.snapshot.quote"
                             "ok" true
                             "usable" true
                             "summary" {"required_ok" true
                                        "row_width_valid" true}
                             "payload_example" "quote.json"}
                            {"name" "option.snapshot.greeks"
                             "ok" true
                             "usable" false}
                            {"name" "stock.snapshot.quote"
                             "ok" true
                             "usable" false}]}
                "ThetaData probe result row 0 usable summary must be object"]
               [{"results" [{"name" "option.expirations"
                             "ok" true
                             "usable" true
                             "summary" {"required_ok" false
                                        "row_width_valid" true}
                             "payload_example" "expirations.json"}
                            {"name" "option.snapshot.quote"
                             "ok" true
                             "usable" true
                             "summary" {"required_ok" true
                                        "row_width_valid" true}
                             "payload_example" "quote.json"}
                            {"name" "option.snapshot.greeks"
                             "ok" true
                             "usable" false}
                            {"name" "stock.snapshot.quote"
                             "ok" true
                             "usable" false}]}
                "ThetaData probe result row 0 usable summary required_ok must be true"]
               [{"results" [{"name" "option.expirations"
                             "ok" true
                             "usable" true
                             "summary" {"required_ok" true
                                        "row_width_valid" false}
                             "payload_example" "expirations.json"}
                            {"name" "option.snapshot.quote"
                             "ok" true
                             "usable" true
                             "summary" {"required_ok" true
                                        "row_width_valid" true}
                             "payload_example" "quote.json"}
                            {"name" "option.snapshot.greeks"
                             "ok" true
                             "usable" false}
                            {"name" "stock.snapshot.quote"
                             "ok" true
                             "usable" false}]}
                "ThetaData probe result row 0 usable summary row_width_valid must not be false"]
               [{"results" ["not-an-object"
                            {"name" "option.snapshot.quote"
                             "ok" true
                             "usable" true
                             "summary" {"required_ok" true
                                        "row_width_valid" true}
                             "payload_example" "quote.json"}
                            {"name" "option.snapshot.greeks"
                             "ok" true
                             "usable" false}
                            {"name" "stock.snapshot.quote"
                             "ok" true
                             "usable" false}]}
                "ThetaData probe result row 0 must be object"]]]
    (doseq [[override expected] cases]
      (let [artifacts (readiness-artifacts
                       dir "20260705"
                       {"probe" override})
            payload (gate/evidence-readiness
                     {:analysis-dir dir
                      :target-date "2026-07-05"
                      :baseline-json (get artifacts "baseline")
                      :probe-json (get artifacts "probe")
                      :payload-verification-json (get artifacts "payload-verification")
                      :neutralization-json (get artifacts "neutralization")
                      :generated-at "2026-07-05T15:00:00Z"})]
        (is (= "FAIL" (get payload "verdict")))
        (is (some #(= expected %) (get payload "fail_reasons")))))))

(deftest deterministic-fuzz-readiness-watches-any-positive-baseline-active-problem-count
  (let [dir (temp-dir)]
    (doseq [n (range 1 15)]
      (let [stamp (str "202607" (python/format (+ 10 n) "02d"))
            artifacts (readiness-artifacts
                       dir stamp
                       {"baseline" {"active_problem_count" n}})
            target-date (str (subs stamp 0 4) "-" (subs stamp 4 6) "-" (subs stamp 6 8))
            payload (gate/evidence-readiness
                     {:analysis-dir dir
                      :target-date target-date
                      :baseline-json (get artifacts "baseline")
                      :probe-json (get artifacts "probe")
                      :payload-verification-json (get artifacts "payload-verification")
                      :neutralization-json (get artifacts "neutralization")
                      :generated-at (str target-date "T15:00:00Z")})]
        (is (= "WATCH" (get payload "verdict")))
        (is (= n (get-in payload ["baseline" "active_problem_count"])))
        (is (some #(= "baseline has active training-distribution warnings" %)
                  (get payload "watch_reasons")))))))

