                               :capture-dir captures
                               :out-dir out
                               :generated-at "2026-07-03T12:00:00Z"})
        by-feature (into {} (map (fn [r] [(get r "feature") r]) rows))
        json-payload (json/loads (slurp json-path))]
    (is (= 8 (get summary "features")))
    (is (= 3 (get summary "rows")))
    (is (= 1 (get summary "capture_file_count")))
    (is (= 1 (get summary "neutralized_count")))
