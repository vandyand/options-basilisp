                       "shifted,equity-base,OFFSET,true,false,10.0,1.0,4.0,0.5,0.0,0.0\n"
                       "active_bad,equity-base,ZERO_FILLED_LIVE,false,true,0.0,0.0,-1.0,0.0,1.0,0.0\n"))
        usage (write-file
               (os.path/join dir "live_feature_model_usage_20260703.csv")
               (str usage-header
                    "opt_delta,6.0,2,10,chestnut,seed_z\n"
                    "shifted,4.0,1,5,lynx,win_prob\n"
                    "active_bad,90.0,20,100,lynx,seed_z\n"))
