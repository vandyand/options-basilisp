(ns feature-parity.test-neutralization-candidate-gap-report-cli
  (:import json os pathlib shutil subprocess sys tempfile)
  (:require [basilisp.test :refer [deftest is]]
            [clojure.string :as str]))

(def root (pathlib/Path (os/getcwd)))
(def script (.joinpath root "scripts/neutralization_candidate_gap_report.lpy"))

(defn resolve-basilisp []
  (cond
    (os.environ/get "BASILISP_BIN") (pathlib/Path (os.environ/get "BASILISP_BIN"))
    (.exists (.joinpath root ".venv/bin/basilisp")) (.joinpath root ".venv/bin/basilisp")
    (.exists (.with_name (pathlib/Path sys/executable) "basilisp")) (.with_name (pathlib/Path sys/executable) "basilisp")
    (shutil/which "basilisp") (pathlib/Path (shutil/which "basilisp"))
    :else (.joinpath root ".venv/bin/basilisp")))

(def basilisp-bin (str (resolve-basilisp)))

(defn jsonable [x]
  (cond
    (map? x) (python/dict (map (fn [[k v]] (python/tuple [(str k) (jsonable v)])) x))
    (or (vector? x) (seq? x)) (python/list (map jsonable x))
    :else x))

(defn write-json! [path payload]
  (.write_text path (str (json/dumps (jsonable payload) ** :indent 2 :sort_keys true) "\n")))

(defn read-json [path]
  (json/loads (.read_text path)))

(defn run-cli [args]
  (subprocess/run
   (python/list (concat [basilisp-bin "run" (str script) "--"] args))
   ** :cwd (str root)
      :text true
      :capture_output true
      :check false))

(deftest candidate-gap-report-explains-exact-but-not-candidate-features
  (with-open [tmp-dir (tempfile/TemporaryDirectory)]
    (let [tmp (pathlib/Path tmp-dir)
          raw (.joinpath tmp "raw.json")
          dry (.joinpath tmp "dry.json")
          greek (.joinpath tmp "greek.json")
          matched (.joinpath tmp "matched.csv")
          out (.joinpath tmp "gap.json")]
      (write-json!
       raw
       {"summary" {"target_date" "2026-07-08"
                   "neutralized_total" 4
                   "supported_neutralized" 3
                   "unsupported_neutralized" 1
                   "unsupported_neutralized_by_family" {"v3-grid" 1}
                   "candidate_count" 1
                   "status_counts" {"SANE" 1 "LOW_VARIANCE" 1 "DEGENERATE_LIVE" 1}
                   "source_counts" {"bar_buffer_replay" 2 "option_surface_formula" 1}}
        "features" [{"feature" "candidate_feature"
                     "candidate" true
                     "family" "equity-base"
                     "source_note" "bar_buffer_replay"
                     "recomputed_status" "SANE"
                     "baseline_status" "DEGENERATE_LIVE"}
                    {"feature" "exact_constant"
                     "candidate" false
                     "family" "equity-base"
                     "source_note" "bar_buffer_replay"
                     "recomputed_status" "LOW_VARIANCE"
                     "baseline_status" "DEGENERATE_LIVE"
                     "model_gain" 3.0
                     "model_split_count" 2}
                    {"feature" "offset_feature"
                     "candidate" false
                     "family" "options-base"
                     "source_note" "option_surface_formula"
                     "recomputed_status" "OFFSET"
                     "baseline_status" "DEGENERATE_LIVE"}]})
      (write-json!
       dry
       {"audit_target_date" "2026-07-08"
        "candidate_count" 2
        "candidate_features" ["candidate_feature" "v3_candidate"]
        "candidate_provenance" [{"feature" "candidate_feature" "sources" ["raw_feature_unlock_audit"]}
                                {"feature" "v3_candidate" "sources" ["v3_grid_unlock_audit"]}]
        "extra_audits" [{"path" "v3.json" "candidate_count" 1 "target_date" "2026-07-08"}]})
      (write-json!
       greek
       {"features" [{"feature" "greek_candidate"
                     "candidate" true
                     "recomputed_status" "SANE"}
                    {"feature" "exact_constant"
                     "candidate" false
                     "family" "options-base"
                     "recomputed_status" "SANE"
                     "reasons" "abs z_mean exceeds threshold; z_std below threshold"
                     "z_mean" 1.7
                     "z_std" 0.1
                     "model_gain" 3.0
                     "model_split_count" 2}]})
      (.write_text
       matched
       (str "feature,family,neutralized,active_problem,matched_rows,live_mean,historical_mean,"
            "live_std,historical_std,live_min,historical_min,live_max,historical_max,"
            "live_zero_frac,historical_zero_frac,live_leading_zero_count,live_leading_zero_until,"
            "historical_leading_zero_count,historical_leading_zero_until,live_nan_frac,"
            "historical_nan_frac,correlation,mean_abs_deviation,max_abs_deviation,status\n"
            "candidate_feature,equity-base,True,False,10,1,1,1,1,0,0,2,2,0,0,0,,0,,0,0,1,0,0,EXACT_MATCH\n"
            "exact_constant,equity-base,True,False,10,5,5,0,0,5,5,5,5,0,0,0,,0,,0,0,,0,0,EXACT_MATCH\n"
            "offset_feature,options-base,True,False,10,5,6,1,1,3,4,7,8,0,0,0,,0,,0,0,1,1,1,TRACKS_WITH_OFFSET_OR_SCALE\n"))
      (let [result (run-cli ["--raw-audit" (str raw)
                             "--dry-run" (str dry)
                             "--matched-csv" (str matched)
                             "--greek-gate" (str greek)
                             "--out-json" (str out)
                             "--sample-limit" "10"])
            payload (json/loads (.-stdout result))]
        (is (= 0 (.-returncode result)) (.-stderr result))
        (is (= (get payload "dry_run_candidate_count")
               (get (read-json out) "dry_run_candidate_count")))
        (is (= 4 (get payload "neutralized_total")))
        (is (= 1 (get payload "raw_candidate_count")))
        (is (= 2 (get payload "dry_run_candidate_count")))
        (is (= 1 (get (get payload "dry_run_candidate_provenance_counts") "raw_feature_unlock_audit")))
        (is (= 1 (get (get payload "dry_run_candidate_provenance_counts") "v3_grid_unlock_audit")))
        (is (= 2 (get payload "matched_exact_neutralized_count")))
        (is (= 1 (get payload "matched_exact_dry_run_candidate_count")))
        (is (= 1 (get payload "matched_exact_not_candidate_count")))
        (is (= 1 (get (get payload "matched_exact_not_candidate_by_raw_status") "LOW_VARIANCE")))
        (is (= 1 (python/len (get payload "matched_exact_not_candidate_samples"))))
        (is (= "exact_constant" (get (get payload "matched_exact_not_candidate_samples") 0)))
        (is (= 1 (get (get payload "supported_non_candidate_by_status") "LOW_VARIANCE")))
        (is (= 1 (get (get payload "supported_non_candidate_by_status") "OFFSET")))
        (is (= 1 (get (get payload "greek_gate") "candidate_count")))
        (is (= 1 (get (get payload "greek_gate") "sane_rejected_count")))
        (is (= 1 (get (get (get payload "greek_gate") "rejected_by_reasons")
                      "abs z_mean exceeds threshold; z_std below threshold")))
        (is (= "exact_constant"
               (get (get (get (get payload "greek_gate") "sane_rejected_samples") 0)
                    "feature")))))))

(deftest candidate-gap-report-rejects-duplicate-json-keys
  (with-open [tmp-dir (tempfile/TemporaryDirectory)]
    (let [tmp (pathlib/Path tmp-dir)
          raw (.joinpath tmp "raw.json")
          dry (.joinpath tmp "dry.json")
          matched (.joinpath tmp "matched.csv")]
      (.write_text raw "{\"summary\": {}, \"summary\": {\"candidate_count\": 999}}\n")
      (write-json! dry {"candidate_features" [] "candidate_provenance" []})
      (.write_text matched "feature,family,neutralized,status\n")
      (let [result (run-cli ["--raw-audit" (str raw)
                             "--dry-run" (str dry)
                             "--matched-csv" (str matched)])]
        (is (= 2 (.-returncode result)))
        (is (str/includes? (.-stderr result) "duplicate JSON key: summary"))))))
