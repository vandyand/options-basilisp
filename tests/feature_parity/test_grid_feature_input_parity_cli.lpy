(deftest grid-feature-input-parity-identifies-best-historical-time-shift
  (with-open [tmp-dir (tempfile/TemporaryDirectory)]
    (let [tmp (pathlib/Path tmp-dir)
          live (path tmp "live.npz")
          hist (path tmp "historical.npz")
          out (path tmp "grid.json")
          md (path tmp "grid.md")
          shifted (value-grids [10.0 -50.0 125.0 5.0 80.0])]
      (numpy/savez live
                  ** :times (numpy/array ["2026-07-09T13:30:00Z"
                                          "2026-07-09T13:31:00Z"
                                          "2026-07-09T13:32:00Z"])
                     :grids (.__getitem__ shifted (slice 0 3)))
      (numpy/savez hist
                  ** :times (numpy/array ["2026-07-09T13:31:00Z"
                                          "2026-07-09T13:32:00Z"
                                          "2026-07-09T13:33:00Z"])
                     :grids (.__getitem__ shifted (slice 0 3)))
      (let [result (run-script "--live-capture" (str live)
                               "--historical-npz" (str hist)
                               "--out-json" (str out)
                               "--md-out" (str md)
                               "--target-date" "2026-07-09"
                               "--min-rows" "2")
            payload (read-json out)
            best (.get payload "best_historical_time_shift")
            diagnosis (.get payload "alignment_diagnosis")
            summaries (.get payload "historical_time_shift_summaries")]
        (is (= 0 (.-returncode result)) (.-stderr result))
        (is (= 7 (count summaries)))
        (is (= 1 (.get best "historical_shift_minutes")))
        (is (= 3 (.get best "matched_rows")))
        (is (>= (.get best "min_correlation") 0.99))
        (is (= "timestamp-bucket-shift" (.get diagnosis "category")))
        (is (str/includes? (.get diagnosis "reason") "timestamp bucketing"))
        (is (str/includes? (.read_text md) "Historical Time-Shift Diagnostic"))))))

(deftest grid-feature-input-parity-classifies-rolling-window-sequence-lag
  (with-open [tmp-dir (tempfile/TemporaryDirectory)]
    (let [tmp (pathlib/Path tmp-dir)
          live (path tmp "live.npz")
          hist (path tmp "historical.npz")
          out (path tmp "grid.json")
          md (path tmp "grid.md")
          live-grid-arr (value-grids [10.0 -50.0 125.0 5.0 80.0])
          hist-grid-arr (numpy/copy live-grid-arr)]
      (doseq [i (range 0 4)]
        (.__setitem__ hist-grid-arr
                      (python/tuple [i (slice nil nil) (slice nil nil) (slice nil nil)])
                      (.__getitem__ live-grid-arr
                                    (python/tuple [(inc i) (slice nil nil) (slice nil nil) (slice nil nil)]))))
      (numpy/savez live
                  ** :times (numpy/array ["2026-07-09T13:30:00Z"
                                          "2026-07-09T13:40:00Z"
                                          "2026-07-09T13:50:00Z"
                                          "2026-07-09T14:00:00Z"
                                          "2026-07-09T14:10:00Z"])
                     :grids live-grid-arr)
      (numpy/savez hist
                  ** :times (numpy/array ["2026-07-09T13:30:00Z"
                                          "2026-07-09T13:40:00Z"
                                          "2026-07-09T13:50:00Z"
                                          "2026-07-09T14:00:00Z"
                                          "2026-07-09T14:10:00Z"])
                     :grids hist-grid-arr)
      (let [result (run-script "--live-capture" (str live)
                               "--historical-npz" (str hist)
                               "--out-json" (str out)
                               "--md-out" (str md)
                               "--target-date" "2026-07-09"
                               "--min-rows" "4")
            payload (read-json out)
            diagnosis (.get payload "alignment_diagnosis")]
        (is (= 0 (.-returncode result)) (.-stderr result))
        (is (= "rolling-window-sequence-lag" (.get diagnosis "category")))
        (is (= -1 (.get diagnosis "best_sequence_lag_minutes")))
        (is (str/includes? (.get diagnosis "reason") "rolling grid-history"))
        (is (str/includes? (.read_text md) "Alignment Diagnosis"))))))

(deftest grid-feature-input-parity-uses-historical-row-provenance
  (with-open [tmp-dir (tempfile/TemporaryDirectory)]
    (let [tmp (pathlib/Path tmp-dir)
          live (path tmp "live.npz")
          hist (path tmp "historical.npz")
          cohort (path tmp "historical.json")
          out (path tmp "grid.json")
          md (path tmp "grid.md")
          grid-arr (value-grids [10.0 -50.0 125.0 5.0])]
      (numpy/savez live
                  ** :times (numpy/array ["2026-07-09T13:30:00Z"
                                          "2026-07-09T13:31:00Z"
                                          "2026-07-09T13:32:00Z"
                                          "2026-07-09T13:33:00Z"])
                     :grids grid-arr)
      (numpy/savez hist
                  ** :times (numpy/array ["2026-07-09T13:30:00Z"
                                          "2026-07-09T13:31:00Z"
                                          "2026-07-09T13:32:00Z"
                                          "2026-07-09T13:33:00Z"])
                     :grids grid-arr)
      (.write_text cohort
                   "{\"row_provenance_summary\":{\"rows\":4,\"grid_appended_rows\":3,\"carried_grid_rows\":1}}\n")
      (let [result (run-script "--live-capture" (str live)
                               "--historical-npz" (str hist)
                               "--historical-cohort-json" (str cohort)
                               "--out-json" (str out)
                               "--md-out" (str md)
                               "--target-date" "2026-07-09"
                               "--min-rows" "4")
            diagnosis (.get (read-json out) "alignment_diagnosis")]
        (is (= 0 (.-returncode result)) (.-stderr result))
        (is (= "historical-carried-grid" (.get diagnosis "category")))
        (is (= 1 (.get diagnosis "historical_carried_grid_rows")))
        (is (str/includes? (.get diagnosis "reason") "stale carried grids"))))))

(deftest grid-feature-input-parity-flags-live-grid-history-tail-mismatch
  (with-open [tmp-dir (tempfile/TemporaryDirectory)]
    (let [tmp (pathlib/Path tmp-dir)
          live (path tmp "live.npz")
          hist (path tmp "historical.npz")
          out (path tmp "grid.json")
          grid-arr (grids 2 1.0)
          bad-history (numpy/copy grid-arr)]
      (.__setitem__ bad-history #py (1 0 10 3) 999.0)
      (numpy/savez live
                  ** :times (numpy/array ["2026-07-09T13:30:00Z"
                                          "2026-07-09T13:31:00Z"])
                     :grids grid-arr
                     :grid_history_json (numpy/array
                                         (python/list [(json/dumps (.tolist (.__getitem__ grid-arr (slice 0 1))))
                                                       (json/dumps (.tolist bad-history))])
                                         ** :dtype object))
      (numpy/savez hist
                  ** :times (numpy/array ["2026-07-09T13:30:00Z"
                                          "2026-07-09T13:31:00Z"])
                     :grids grid-arr)
      (let [result (run-script "--live-capture" (str live)
                               "--historical-npz" (str hist)
                               "--out-json" (str out)
                               "--target-date" "2026-07-09"
                               "--min-rows" "2")
            tail (.get (read-json out) "live_grid_history_tail")]
        (is (= 0 (.-returncode result)) (.-stderr result))
        (is (= 2 (.get tail "rows_with_grid_history")))
        (is (= 1 (.get tail "tail_mismatch_rows")))
        (is (str/includes? (.get tail "reason") "differ"))))))

(deftest grid-feature-input-parity-compares-live-and-historical-grid-history-sequences
  (with-open [tmp-dir (tempfile/TemporaryDirectory)]
    (let [tmp (pathlib/Path tmp-dir)
          live (path tmp "live.npz")
          hist (path tmp "historical.npz")
          out (path tmp "grid.json")
          md (path tmp "grid.md")
          grid-arr (grids 3 1.0)]
      (numpy/savez live
                  ** :times (numpy/array ["2026-07-09T13:30:00Z"
                                          "2026-07-09T13:31:00Z"
                                          "2026-07-09T13:32:00Z"])
                     :grids grid-arr
                     :grid_history_json (grid-history-json grid-arr))
      (numpy/savez hist
                  ** :times (numpy/array ["2026-07-09T13:30:00Z"
                                          "2026-07-09T13:31:00Z"
                                          "2026-07-09T13:32:00Z"])
                     :grids grid-arr
                     :grid_histories (padded-grid-histories grid-arr 3))
      (let [result (run-script "--live-capture" (str live)
                               "--historical-npz" (str hist)
                               "--out-json" (str out)
                               "--md-out" (str md)
                               "--target-date" "2026-07-09"
                               "--min-rows" "3")
            seq-history (.get (read-json out) "grid_history_sequence")]
        (is (= 0 (.-returncode result)) (.-stderr result))
        (is (= true (.get seq-history "available")))
        (is (= 3 (.get seq-history "rows_compared")))
        (is (= 0 (.get seq-history "sequence_mismatch_rows")))
        (is (= 0.0 (.get (.get seq-history "sequence_abs_delta") "max")))
        (is (str/includes? (.read_text md) "Grid-History Sequence"))))))

(deftest grid-feature-input-parity-inferrs-historical-contract-density
  (with-open [tmp-dir (tempfile/TemporaryDirectory)]
    (let [tmp (pathlib/Path tmp-dir)
          live (path tmp "live.npz")
          hist (path tmp "historical.npz")
          cohort (path tmp "historical.json")
          out (path tmp "grid.json")
          chain-json (json/dumps
                      (python/dict {"contracts" (python/list
                                                 (for [i (range 100)]
                                                   (python/dict {"strike" (+ 700 i)
                                                                 "right" "CALL"})))}))]
      (numpy/savez live
                  ** :times (numpy/array ["2026-07-09T13:30:00Z"])
                     :grids (grids 1 1.0)
                     :option_chain_json (numpy/array [chain-json] ** :dtype object))
      (numpy/savez hist
                  ** :times (numpy/array ["2026-07-09T13:30:00Z"])
                     :grids (grids 1 1.0))
      (.write_text cohort
                   (str (json/dumps
                         (python/dict {"target_date" "2026-07-09"
                                       "contract_field_coverage"
                                       (python/dict {"SPY"
                                                     (python/dict {"contracts" 50
                                                                   "minutes_with_contracts" 1})})}))
                        "\n"))
      (let [result (run-script "--live-capture" (str live)
                               "--historical-npz" (str hist)
                               "--historical-cohort-json" (str cohort)
                               "--out-json" (str out)
                               "--min-rows" "1")
            density (.get (read-json out) "contract_density")]
        (is (= 0 (.-returncode result)) (.-stderr result))
        (is (= 0.5 (.get density "historical_to_live_median_ratio")))
        (is (= 50.0 (.get (.get (.get density "historical") "contracts_per_minute") "median")))))))

(deftest grid-feature-input-parity-compares-live-and-historical-chain-quotes
  (with-open [tmp-dir (tempfile/TemporaryDirectory)]
    (let [tmp (pathlib/Path tmp-dir)
          live (path tmp "live.npz")
          hist (path tmp "historical.npz")
          out (path tmp "grid.json")
          md (path tmp "grid.md")
          chain-json (fn [bid ask]
                       (json/dumps
                        (python/dict {"observed_at" "2026-07-09T13:30:00Z"
                                      "contracts" (python/list
                                                   [(python/dict {"strike" 700
                                                                  "right" "CALL"
                                                                  "expiration" "2026-07-09"
                                                                  "bid" bid
                                                                  "ask" ask})])})))]
      (numpy/savez live
                  ** :times (numpy/array ["2026-07-09T13:30:00Z"])
                     :grids (grids 1 1.0)
                     :option_chain_json (numpy/array [(chain-json 1.0 1.2)] ** :dtype object))
      (numpy/savez hist
                  ** :times (numpy/array ["2026-07-09T13:30:00Z"])
                     :grids (grids 1 1.0)
                     :option_chain_json (numpy/array [(chain-json 1.4 1.6)] ** :dtype object))
      (let [result (run-script "--live-capture" (str live)
                               "--historical-npz" (str hist)
                               "--out-json" (str out)
                               "--md-out" (str md)
                               "--target-date" "2026-07-09"
                               "--min-rows" "1")
            quote-source (.get (read-json out) "chain_quote_source")]
        (is (= 0 (.-returncode result)) (.-stderr result))
        (is (= true (.get quote-source "available")))
        (is (= 1 (.get quote-source "rows_compared")))
        (is (= 1 (.get quote-source "shared_contracts")))
        (is (= 0 (.get quote-source "missing_in_historical_contracts")))
        (is (= 0 (.get quote-source "extra_in_historical_contracts")))
        (is (< (abs (- 0.4 (.get (.get quote-source "bid_abs_deviation") "max_abs_deviation"))) 1.0e-9))
        (is (< (abs (- 0.4 (.get (.get quote-source "ask_abs_deviation") "max_abs_deviation"))) 1.0e-9))
        (is (< (abs (- 0.4 (.get (.get quote-source "mid_abs_deviation") "max_abs_deviation"))) 1.0e-9))
        (is (str/includes? (.get quote-source "reason") "quote values differ"))
        (is (str/includes? (.read_text md) "Chain Quote Source"))))))
