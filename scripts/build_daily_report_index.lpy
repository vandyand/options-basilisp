;; Build report-viewer report section indexes from local artifacts. Daily
;; metrics come from validation JSON when present; no broker refetches.
(import calendar datetime glob json os os.path re sys)

(defn usage []
  (println
   (str "usage: basilisp run scripts/build_daily_report_index.lpy -- "
        "--daily-dir DIR [--weekly-dir DIR] [--accounts-dir DIR] [--title TITLE]")))

(defn option-value [remaining arg]
  (let [value (second remaining)]
    (when (or (nil? value) (.startswith (str value) "--"))
      (throw (python/ValueError (str "missing value for " arg))))
    value))

(defn parse-args [args]
  (loop [remaining (seq args)
         out {:title "Daily Reports"}]
    (if-not remaining
      out
      (let [arg (first remaining)]
        (cond
          (= arg "--daily-dir")
          (recur (nnext remaining) (assoc out :daily-dir (option-value remaining arg)))

          (= arg "--title")
          (recur (nnext remaining) (assoc out :title (option-value remaining arg)))

          (= arg "--weekly-dir")
          (recur (nnext remaining) (assoc out :weekly-dir (option-value remaining arg)))

          (= arg "--accounts-dir")
          (recur (nnext remaining) (assoc out :accounts-dir (option-value remaining arg)))

          (or (= arg "-h") (= arg "--help"))
          (do (usage)
              (python/exit 0))

          :else
          (throw (python/ValueError (str "unknown argument: " arg))))))))

(defn read-json [path]
  (json/loads (slurp path)))

(defn parse-compact-date [stamp]
  (datetime/date (python/int (subs stamp 0 4))
                 (python/int (subs stamp 4 6))
                 (python/int (subs stamp 6 8))))

(defn compact-date [d]
  (.strftime d "%Y%m%d"))

(defn date-label [d]
  (str (.strftime d "%b") " " (.-day d)))

(defn month-label [year month]
  (str (aget (.-month_name calendar) month) " " year))

(defn validation-report-date [payload]
  (.get payload "report/date"))

(defn rendered? [payload]
  (true? (.get payload "report/rendered?" false)))

(defn account-number [acct key]
  (python/float (or (.get acct key 0.0) 0.0)))

(defn parse-money [s]
  (let [raw (.strip (str s))
        neg? (.startswith raw "-")
        cleaned (-> raw
                    (.replace "$" "")
                    (.replace "," "")
                    (.replace "-" "")
                    (.strip))
        n (python/float cleaned)]
    (if neg? (- n) n)))

(defn summarize-validation [payload]
  (let [accounts (.get payload "accounts" [])
        pnl (reduce + 0.0 (map #(account-number % "pnl/equity-day") accounts))
        trades (reduce + 0 (map #(python/int (or (.get % "trade/closed-count" 0) 0)) accounts))]
    {:pnl pnl
     :trades trades
     :accounts (python/len accounts)}))

(defn summarize-html [html-path]
  (let [html (slurp html-path)
        pnl-match (re/search #"(?s)<h3>Total Daily PnL</h3>\s*<div class=\"value [^\"]+\">([^<]+)</div>" html)
        trades-match (re/search #"(?s)<h3>Total Trades</h3>\s*<div class=\"value [^\"]+\">([^<]+)</div>" html)]
    (when (and pnl-match trades-match)
      {:pnl (parse-money (.group pnl-match 1))
       :trades (python/int (.replace (.strip (.group trades-match 1)) "," ""))
       :accounts 0})))

(defn money [value]
  (let [n (python/float (or value 0.0))
        body (.format "${:,.2f}" (abs n))]
    (cond
      (neg? n) (str "-" body)
      :else body)))

(defn pnl-class [value]
  (let [n (python/float (or value 0.0))]
    (cond
      (pos? n) "positive"
      (neg? n) "negative"
      :else "neutral")))

(defn valid-entry [daily-dir html-path]
  (let [name (os.path/basename html-path)
        match (re/fullmatch #"(\d{8})\.html" name)]
    (when match
      (let [stamp (.group match 1)
            d (parse-compact-date stamp)
            validation-path (os.path/join daily-dir (str stamp ".validation.json"))]
        (if (os.path/exists validation-path)
          (let [payload (read-json validation-path)
                report-date (validation-report-date payload)]
            (when (and (rendered? payload)
                       (= report-date (.isoformat d)))
              (merge {:date d
                      :stamp stamp
                      :filename name
                      :validated? true
                      :metrics-source "validation"}
                     (summarize-validation payload))))
          (let [html-summary (summarize-html html-path)]
            (merge {:date d
                    :stamp stamp
                    :filename name
                    :validated? false
                    :metrics-source (if html-summary "html" "missing")
                    :pnl nil
                    :trades nil
                    :accounts 0}
                   html-summary)))))))

(defn collect-entries [daily-dir]
  (vec
   (sort-by :date
            (keep #(valid-entry daily-dir %)
                  (glob/glob (os.path/join daily-dir "*.html"))))))

(defn rows-for-month [entries year month]
  (let [by-day (into {} (map (fn [e] [(:date e) e]) entries))
        first-day (datetime/date year month 1)
        last-day (datetime/date year month (aget (calendar/monthrange year month) 1))
        first-monday (- first-day (datetime/timedelta ** :days (.weekday first-day)))]
    (loop [monday first-monday
           rows []]
      (if (> monday last-day)
        rows
        (recur (+ monday (datetime/timedelta ** :days 7))
               (conj rows
                     (vec
                      (for [col (range 5)]
                        (let [d (+ monday (datetime/timedelta ** :days col))]
                          (cond
                            (not= (.-month d) month) {:kind :blank}
                            (contains? by-day d) (assoc (get by-day d) :kind :report)
                            :else {:kind :empty :date d}))))))))))

(defn escape-html [s]
  (-> (str s)
      (.replace "&" "&amp;")
      (.replace "<" "&lt;")
      (.replace ">" "&gt;")
      (.replace "\"" "&quot;")))

(defn render-cell [cell]
  (case (:kind cell)
    :blank
    "        <div class=\"calendar-day blank\"></div>\n"

    :empty
    (str "        <div class=\"calendar-day empty\">\n"
         "          <div class=\"cd-num\">" (date-label (:date cell)) "</div>\n"
         "        </div>\n")

    :report
    (str "        <a class=\"calendar-day has-report\" href=\"" (escape-html (:filename cell)) "\">\n"
         "          <div class=\"cd-num\">" (date-label (:date cell)) "</div>\n"
         (if (some? (:pnl cell))
           (str "          <div class=\"cd-pnl " (pnl-class (:pnl cell)) "\">" (money (:pnl cell)) "</div>\n"
                "          <div class=\"cd-meta\">" (:trades cell) " trades &middot; "
                (if (:validated? cell) "validated" "legacy HTML") "</div>\n")
           "          <div class=\"cd-pnl neutral\">metrics n/a</div>\n          <div class=\"cd-meta\">legacy artifact</div>\n")
         "        </a>\n")))

(defn render-month [entries year month]
  (str "  <div class=\"calendar-month\">\n"
       "    <div class=\"calendar-month-label\">" (escape-html (month-label year month)) "</div>\n"
       "    <div class=\"calendar-grid with-header\">\n"
       "      <div class=\"cgh\">Mon</div><div class=\"cgh\">Tue</div><div class=\"cgh\">Wed</div><div class=\"cgh\">Thu</div><div class=\"cgh\">Fri</div>\n"
       "    </div>\n"
       (apply str
              (for [row (rows-for-month entries year month)]
                (str "    <div class=\"calendar-grid\">\n"
                     (apply str (map render-cell row))
                     "    </div>\n")))
       "  </div>\n"))

(def index-css
  "body{margin:0;background:#0d1117;color:#e6edf3;font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Helvetica,Arial,sans-serif}.site-header{border-bottom:1px solid #30363d;background:#161b22}.site-header-inner{max-width:1180px;margin:0 auto;padding:18px 24px;display:flex;justify-content:space-between;gap:20px;align-items:center}.brand a{color:#e6edf3;text-decoration:none}.brand h1{margin:0;font-size:24px}.updated{margin-top:4px;color:#8b949e;font-size:12px}.site-nav{display:flex;gap:10px;flex-wrap:wrap}.site-nav a{color:#c9d1d9;text-decoration:none;border:1px solid #30363d;border-radius:999px;padding:7px 10px}.site-nav a:hover{border-color:#58a6ff;color:#fff}.container{max-width:1180px;margin:0 auto;padding:28px 24px}.section{background:#161b22;border:1px solid #30363d;border-radius:16px;padding:20px}.section h2{margin:0 0 18px}.calendar{display:grid;gap:24px}.calendar-month{border:1px solid #30363d;border-radius:14px;padding:14px;background:#0d1117}.calendar-month-label{font-weight:700;margin-bottom:10px}.calendar-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:8px;margin-bottom:8px}.cgh{color:#8b949e;font-size:12px;text-transform:uppercase}.calendar-day{min-height:72px;border:1px solid #30363d;border-radius:10px;padding:10px;text-decoration:none;color:#e6edf3;background:#161b22}.calendar-day.has-report:hover{border-color:#58a6ff}.calendar-day.empty{color:#8b949e;background:#111820}.calendar-day.blank{visibility:hidden}.cd-num{font-weight:700}.cd-pnl{margin-top:8px;font-weight:800}.positive{color:#3fb950}.negative{color:#f85149}.neutral{color:#8b949e}.cd-meta{margin-top:4px;color:#8b949e;font-size:12px}@media(max-width:720px){.site-header-inner{display:block}.site-nav{margin-top:14px}.calendar-grid{grid-template-columns:1fr}.calendar-day.blank{display:none}}")

(defn render-index [daily-dir title entries]
  (let [months (reverse (sort (set (map (fn [e] [(.-year (:date e)) (.-month (:date e))]) entries))))
        updated (.strftime (datetime.datetime/now) "%Y-%m-%d %H:%M:%S")]
    (str "<!doctype html>\n<html lang=\"en\">\n<head>\n"
         "  <meta charset=\"utf-8\">\n"
         "  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n"
         "  <link rel=\"icon\" type=\"image/svg+xml\" href=\"/favicon.svg\">\n"
         "  <title>" (escape-html title) " &mdash; Tran Trading</title>\n"
         "  <style>" index-css "</style>\n"
         "</head>\n<body>\n"
         "  <header class=\"site-header\"><div class=\"site-header-inner\"><div class=\"brand\">"
         "<a href=\"/reports/index.html\"><h1>" (escape-html title) "</h1></a>"
         "<div class=\"updated\">Updated: " (escape-html updated) "</div></div>"
         "<nav class=\"site-nav\"><a href=\"/reports/index.html\">Overview</a>"
         "<a href=\"/reports/daily/index.html\">Daily</a>"
         "<a href=\"/reports/weekly/index.html\">Weekly</a>"
         "<a href=\"/reports/accounts/index.html\">Accounts</a>"
         "<a href=\"/reports/status/index.html\">System</a>"
         "<a href=\"/index.html\" class=\"back\">All Reports</a></nav></div></header>\n"
         "  <main class=\"container\"><section class=\"section\">\n"
         "  <h2>Calendar &mdash; " (count entries) " report" (if (= 1 (count entries)) "" "s") "</h2>\n"
         (if (seq entries)
           (str "    <div class=\"calendar\">\n"
                (apply str (map (fn [[year month]]
                                  (render-month entries year month))
                                months))
                "    </div>\n")
           "    <div class=\"empty\">No daily reports yet.</div>\n")
         "  </section></main>\n</body>\n</html>\n")))

(defn simple-page [title body]
  (let [updated (.strftime (datetime.datetime/now) "%Y-%m-%d %H:%M:%S")]
    (str "<!doctype html>\n<html lang=\"en\">\n<head>\n"
         "  <meta charset=\"utf-8\">\n"
         "  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n"
         "  <link rel=\"icon\" type=\"image/svg+xml\" href=\"/favicon.svg\">\n"
         "  <title>" (escape-html title) " &mdash; Tran Trading</title>\n"
         "  <style>" index-css ".link-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:12px}.link-card{display:block;color:#e6edf3;text-decoration:none;border:1px solid #30363d;background:#161b22;border-radius:12px;padding:14px}.link-card:hover{border-color:#58a6ff}.lc-title{font-weight:800}.lc-sub{margin-top:6px;color:#8b949e;font-size:12px}</style>\n"
         "</head>\n<body>\n"
         "  <header class=\"site-header\"><div class=\"site-header-inner\"><div class=\"brand\">"
         "<a href=\"/reports/index.html\"><h1>" (escape-html title) "</h1></a>"
         "<div class=\"updated\">Updated: " (escape-html updated) "</div></div>"
         "<nav class=\"site-nav\"><a href=\"/reports/index.html\">Overview</a>"
         "<a href=\"/reports/daily/index.html\">Daily</a>"
         "<a href=\"/reports/weekly/index.html\">Weekly</a>"
         "<a href=\"/reports/accounts/index.html\">Accounts</a>"
         "<a href=\"/reports/status/index.html\">System</a>"
         "<a href=\"/index.html\" class=\"back\">All Reports</a></nav></div></header>\n"
         "  <main class=\"container\">" body "</main>\n</body>\n</html>\n")))

(defn weekly-entry [html-path]
  (let [name (os.path/basename html-path)
        match (re/fullmatch #"(\d{4})-W(\d{2})\.html" name)]
    (when match
      {:filename name
       :year (.group match 1)
       :week (.group match 2)
       :label (str (.group match 1) "-W" (.group match 2))})))

(defn build-weekly! [weekly-dir]
  (when (and weekly-dir (os.path/isdir weekly-dir))
    (let [entries (vec (reverse (sort-by :label
                                         (keep weekly-entry
                                               (glob/glob (os.path/join weekly-dir "*.html"))))))
          body (str "<section class=\"section\"><h2>Weekly Reports &mdash; " (count entries) "</h2>"
                    (if (seq entries)
                      (str "<div class=\"link-grid\">"
                           (apply str
                                  (map (fn [e]
                                         (str "<a class=\"link-card\" href=\"" (escape-html (:filename e)) "\">"
                                              "<div class=\"lc-title\">" (escape-html (:label e)) "</div>"
                                              "<div class=\"lc-sub\">Weekly report</div></a>"))
                                       entries))
                           "</div>")
                      "<div class=\"empty\">No weekly reports yet.</div>")
                    "</section>")
          index-path (os.path/join weekly-dir "index.html")]
      (spit index-path (simple-page "Weekly Reports" body))
      {:index-path index-path
       :reports (count entries)})))

(def account-display
  {"chestnut" "CHESTNUT"
   "lynx" "LYNX"
   "moose" "MOOSE"
   "oak" "OAK"
   "parrot" "PARROT"
   "dolphin" "DOLPHIN"})

(defn account-entry [html-path]
  (let [name (os.path/basename html-path)
        match (re/fullmatch #"([A-Za-z0-9_-]+)\.html" name)]
    (when (and match (not= "index.html" name))
      (let [slug (.lower (.group match 1))]
        {:filename name
         :slug slug
         :display (get account-display slug (.upper slug))}))))

(defn build-accounts! [accounts-dir]
  (when (and accounts-dir (os.path/isdir accounts-dir))
    (let [entries (vec (sort-by :display
                                (keep account-entry
                                      (glob/glob (os.path/join accounts-dir "*.html")))))
          body (str "<section class=\"section\"><h2>Accounts &mdash; " (count entries) "</h2>"
                    (if (seq entries)
                      (str "<div class=\"link-grid\">"
                           (apply str
                                  (map (fn [e]
                                         (str "<a class=\"link-card\" href=\"" (escape-html (:filename e)) "\">"
                                              "<div class=\"lc-title\">" (escape-html (:display e)) "</div>"
                                              "<div class=\"lc-sub\">Per-account report</div></a>"))
                                       entries))
                           "</div>")
                      "<div class=\"empty\">No account reports yet.</div>")
                    "</section>")
          index-path (os.path/join accounts-dir "index.html")]
      (spit index-path (simple-page "Accounts" body))
      {:index-path index-path
       :reports (count entries)})))

(defn build! [{:keys [daily-dir weekly-dir accounts-dir title]}]
  (when-not daily-dir
    (throw (python/ValueError "--daily-dir is required")))
  (when-not (os.path/isdir daily-dir)
    (throw (python/FileNotFoundError daily-dir)))
  (let [entries (collect-entries daily-dir)
        index-path (os.path/join daily-dir "index.html")
        weekly-result (build-weekly! weekly-dir)
        accounts-result (build-accounts! accounts-dir)]
    (spit index-path (render-index daily-dir title entries))
    {:index-path index-path
     :reports (count entries)
     :weekly weekly-result
     :accounts accounts-result}))

(try
  (let [result (build! (parse-args (vec *command-line-args*)))]
    (println (json/dumps (python/dict {"index_path" (:index-path result)
                                       "reports" (:reports result)
                                       "weekly_index_path" (get-in result [:weekly :index-path])
                                       "weekly_reports" (get-in result [:weekly :reports])
                                       "accounts_index_path" (get-in result [:accounts :index-path])
                                       "accounts" (get-in result [:accounts :reports])})
                         ** :indent 2 :sort_keys true))
    (python/exit 0))
  (catch python/ValueError e
    (binding [*out* *err*]
      (println (str e)))
    (python/exit 2))
  (catch python/FileNotFoundError e
    (binding [*out* *err*]
      (println (str e)))
    (python/exit 2))
  (catch python/Exception e
    (binding [*out* *err*]
      (println (str e)))
    (python/exit 2)))
