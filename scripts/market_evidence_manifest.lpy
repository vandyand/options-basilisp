;; Write or verify a checksum manifest for a market-evidence artifact bundle.
(import datetime glob hashlib json math os os.path re sys)
(require '[clojure.set :as set])

(defn usage []
  (println "usage: basilisp run scripts/market_evidence_manifest.lpy -- --target-date YYYY-MM-DD [--analysis-dir DIR] [--payload-dir DIR] [--out manifest.json] [--verify manifest.json]"))

(defn compact-date
  [date-str]
  (let [s (str date-str)]
    (cond
      (and (= 8 (count s)) (.isdigit s))
      (let [iso (str (subs s 0 4) "-" (subs s 4 6) "-" (subs s 6 8))]
        (datetime.date/fromisoformat iso)
        s)

      (= 10 (count s))
      (do
        (datetime.date/fromisoformat s)
        (.replace s "-" ""))

      :else
      (throw (python/ValueError (str "invalid date: " s))))))

(defn cli-target-date
  [value]
  (let [s (str value)]
    (when-not (= 10 (count s))
      (throw (python/ValueError
              (str "invalid --target-date: " s
                   " (expected YYYY-MM-DD calendar date)"))))
    (try
      (datetime.date/fromisoformat s)
      (catch python/Exception _
        (throw (python/ValueError
                (str "invalid --target-date: " s
                     " (expected YYYY-MM-DD calendar date)")))))
    s))

(def repo-root (or (os.environ/get "STEVE_REPO_ROOT") (os/getcwd)))

(defn option-value
  [remaining arg]
  (let [value (second remaining)]
    (when (or (nil? value)
              (.startswith (str value) "--"))
      (throw (python/ValueError (str "missing value for " arg))))
    value))

(defn parse-args
  [args]
  (loop [remaining (seq args)
         out {:analysis-dir (os.path/join repo-root "live_runtime" "analysis")
              :payload-dir (os.path/join repo-root "resources" "thetadata" "payload_examples")}]
    (if-not remaining
      out
      (let [arg (first remaining)]
	        (cond
	          (= arg "--target-date")
	          (recur (nnext remaining)
                   (assoc out :target-date
                          (cli-target-date (option-value remaining arg))))

	          (= arg "--analysis-dir")
	          (recur (nnext remaining) (assoc out :analysis-dir (option-value remaining arg)))

	          (= arg "--payload-dir")
	          (recur (nnext remaining) (assoc out :payload-dir (option-value remaining arg)))

	          (= arg "--out")
	          (recur (nnext remaining) (assoc out :out (option-value remaining arg)))

	          (= arg "--verify")
	          (recur (nnext remaining) (assoc out :verify (option-value remaining arg)))

          (or (= arg "-h") (= arg "--help"))
          (do (usage)
              (python/exit 0))

	          :else
	          (throw (python/ValueError (str "unknown argument: " arg))))))))

