(def expected-unmask-accounts
  ["chestnut" "lynx" "moose"])

(def expected-unmask-account-set
  (set expected-unmask-accounts))

(defn usage []
  (println "usage: basilisp run scripts/market_evidence_status.lpy -- --target-date YYYY-MM-DD [--analysis-dir DIR] [--payload-dir DIR] [--manifest manifest.json] [--out status.json] [--md-out status.md]"))

(defn compact-date
  [date-str]
  (let [s (str date-str)]
    (cond
      (and (= 8 (count s)) (.isdigit s))
      (let [iso (str (subs s 0 4) "-" (subs s 4 6) "-" (subs s 6 8))]
        (datetime.date/fromisoformat iso)
        s)

      (= 10 (count s))
      (do
        (datetime.date/fromisoformat s)
        (.replace s "-" ""))

      :else
      (throw (python/ValueError (str "invalid date: " s))))))

(defn cli-target-date
  [value]
  (let [s (str value)]
    (when-not (= 10 (count s))
      (throw (python/ValueError
              (str "invalid --target-date: " s
                   " (expected YYYY-MM-DD calendar date)"))))
    (try
      (datetime.date/fromisoformat s)
      (catch python/Exception _
        (throw (python/ValueError
                (str "invalid --target-date: " s
                     " (expected YYYY-MM-DD calendar date)")))))
    s))

(defn option-value
  [remaining arg]
  (let [value (second remaining)]
    (when (or (nil? value)
              (.startswith (str value) "--"))
      (throw (python/ValueError (str "missing value for " arg))))
    value))

(defn parse-args
  [args]
  (loop [remaining (seq args)
         out {:analysis-dir (os.path/join repo-root "live_runtime" "analysis")
              :payload-dir (os.path/join repo-root "resources" "thetadata" "payload_examples")}]
    (if-not remaining
      out
      (let [arg (first remaining)]
        (cond
          (= arg "--target-date")
          (recur (nnext remaining)
                 (assoc out :target-date
                        (cli-target-date (option-value remaining arg))))

          (= arg "--analysis-dir")
          (recur (nnext remaining) (assoc out :analysis-dir (option-value remaining arg)))

          (= arg "--payload-dir")
          (recur (nnext remaining) (assoc out :payload-dir (option-value remaining arg)))

          (= arg "--manifest")
          (recur (nnext remaining) (assoc out :manifest (option-value remaining arg)))

          (= arg "--out")
          (recur (nnext remaining) (assoc out :out (option-value remaining arg)))

          (= arg "--md-out")
          (recur (nnext remaining) (assoc out :md-out (option-value remaining arg)))

          (or (= arg "-h") (= arg "--help"))
          (do (usage)
              (python/exit 0))

          :else
          (throw (python/ValueError (str "unknown argument: " arg))))))))

(defn reject-duplicate-json-object
  [pairs]
  (loop [remaining (seq pairs)
         seen #{}
         out {}]
    (if-not remaining
      out
      (let [pair (first remaining)
            k (first pair)
            v (second pair)]
        (when (contains? seen k)
          (throw (python/ValueError (str "duplicate JSON key: " k))))
        (recur (next remaining)
               (conj seen k)
               (assoc out k v))))))

(defn read-json
  [path]
  (json/loads (slurp path) ** :object_pairs_hook reject-duplicate-json-object))

(defn json-out
  [x]
  (letfn [(jsonable [v]
            (cond
              (map? v) (python/dict
                        (map (fn [[k vv]]
                               (python/tuple [(str k) (jsonable vv)]))
                             v))
              (python/isinstance v python/dict) (python/dict
                                                 (map (fn [[k vv]]
                                                        (python/tuple [(str k) (jsonable vv)]))
                                                      (.items v)))
              (python/isinstance v python/list) (python/list (map jsonable v))
              (or (vector? v) (seq? v) (set? v)) (python/list (map jsonable v))
              :else v))]
    (json/dumps (jsonable x) ** :indent 2 :sort_keys true)))

(defn sha256-file
  [path]
  (let [h (hashlib/sha256)]
    (with-open [fh (open path "rb")]
      (loop [chunk (.read fh 1048576)]
        (when (pos? (count chunk))
          (.update h chunk)
          (recur (.read fh 1048576)))))
    (.hexdigest h)))

