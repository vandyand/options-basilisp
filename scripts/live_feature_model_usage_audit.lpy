;; Basilisp implementation of the Steve-v2 live feature model usage audit.
(import datetime glob json os os.path sys)

(def repo-root (or (os.environ/get "STEVE_REPO_ROOT") (os/getcwd)))
(doseq [path (concat (glob/glob (os.path/join repo-root "components" "*" "src"))
                     (glob/glob (os.path/join repo-root "bases" "*" "src")))]
  (.insert (.-path sys) 0 path))

(require '[stevetrading.feature-parity.core :as fp])

(def ref-root
  (or (os.environ/get "STEVE_REF_ROOT")
      (os.path/join (os.path/expanduser "~")
                    "contracting/upwork/steven-tran/SteveTrading/ref/Data-Preprocessor")))

(def default-bundles
  [(os.path/join ref-root "pipeline_data/live_model_chestnut_multihead_corrected")
   (os.path/join ref-root "pipeline_data/live_model_lynx_multihead_corrected")
   (os.path/join ref-root "pipeline_data/live_model_moose_multihead_corrected")])

(defn usage []
  (println (str "usage: basilisp run scripts/live_feature_model_usage_audit.lpy -- "
                "[--baseline-csv PATH] [--bundle DIR] [--ref-root DIR] [--out-dir DIR] "
                "[--target-date YYYY-MM-DD] "
                "[--write-unavailable --unavailable-reason TEXT]")))

(defn option-value
  [remaining arg]
  (let [value (second remaining)]
    (when (or (nil? value)
              (.startswith (str value) "--"))
      (throw (python/ValueError (str "missing value for " arg))))
    value))

(defn cli-target-date
  [value]
  (let [s (str value)]
    (when-not (= 10 (count s))
      (throw (python/ValueError
              (str "invalid --target-date: " s
                   " (expected YYYY-MM-DD calendar date)"))))
    (try
      (datetime.date/fromisoformat s)
      (catch python/Exception _
        (throw (python/ValueError
                (str "invalid --target-date: " s
                     " (expected YYYY-MM-DD calendar date)")))))
    s))

(defn parse-args
  [args]
  (loop [remaining (seq args)
         out {:out-dir (os.path/join repo-root fp/default-analysis-dir)
              :bundles []}]
    (if-not remaining
      (if (seq (:bundles out))
        out
        (assoc out :bundles default-bundles))
      (let [arg (first remaining)]
        (cond
          (= arg "--baseline-csv")
          (recur (nnext remaining) (assoc out :baseline-csv (option-value remaining arg)))

          (= arg "--bundle")
          (recur (nnext remaining) (update out :bundles conj (option-value remaining arg)))

          (= arg "--ref-root")
          (let [root (option-value remaining arg)]
            (recur (nnext remaining)
                   (-> out
                       (assoc :ref-root root)
                       (assoc :bundles
                              [(os.path/join root "pipeline_data/live_model_chestnut_multihead_corrected")
                               (os.path/join root "pipeline_data/live_model_lynx_multihead_corrected")
                               (os.path/join root "pipeline_data/live_model_moose_multihead_corrected")]))))

          (= arg "--out-dir")
          (recur (nnext remaining) (assoc out :out-dir (option-value remaining arg)))

          (= arg "--target-date")
          (recur (nnext remaining)
                 (assoc out :target-date
                        (cli-target-date (option-value remaining arg))))

          (= arg "--write-unavailable")
          (recur (next remaining) (assoc out :write-unavailable true))

          (= arg "--unavailable-reason")
          (recur (nnext remaining) (assoc out :unavailable-reason (option-value remaining arg)))

          (or (= arg "-h") (= arg "--help"))
          (do (usage)
              (python/exit 0))

          :else
          (throw (python/ValueError (str "unknown argument: " arg))))))))

(defn compact-date [date]
  (.replace (str date) "-" ""))

(defn write-csv-header! [path]
  (os/makedirs (os.path/dirname path) ** :exist_ok true)
  (spit path (str (apply str (interpose "," fp/model-usage-csv-columns)) "\n")))

(defn write-unavailable! [opts]
  (let [target-date (:target-date opts)]
    (when-not target-date
      (throw (python/ValueError "missing required --target-date for --write-unavailable")))
    (let [out-dir (:out-dir opts)
          reason (or (:unavailable-reason opts) "model usage audit unavailable")
          generated-at (.strftime (datetime.datetime/now datetime.timezone/utc)
                                  "%Y-%m-%dT%H:%M:%SZ")
          stamp (compact-date target-date)
          out-base (os.path/join (str out-dir) (str "live_feature_model_usage_" stamp))
          csv-path (str out-base ".csv")
          json-path (str out-base ".json")
          md-path (str out-base ".md")
          payload {"generated_at" generated-at
                   "target_date" target-date
                   "status" "unavailable"
                   "available" false
                   "ok" false
                   "unavailable_reason" reason
                   "baseline_csv" (str (or (:baseline-csv opts) ""))
                   "summaries" []
                   "features" []}]
      (os/makedirs (str out-dir) ** :exist_ok true)
      (write-csv-header! csv-path)
      (spit json-path (json/dumps (fp/->jsonable payload) ** :indent 2 :sort_keys true))
      (spit md-path (str "# Live Feature Model Usage Audit\n\n"
                         "- Target date: `" target-date "`\n"
                         "- Status: `unavailable`\n"
                         "- Reason: `" reason "`\n"
                         "- Features: `0`\n"))
      {:summaries []
       :payload payload
       :csv-path csv-path
       :json-path json-path
       :markdown-path md-path})))

(try
  (let [opts (parse-args (vec *command-line-args*))
        result (if (:write-unavailable opts)
                 (write-unavailable! opts)
                 (fp/write-model-usage-audit! opts))
        {:keys [summaries payload markdown-path csv-path json-path]} result]
    (println (json/dumps (fp/->jsonable (or payload {"summaries" summaries})) ** :indent 2 :sort_keys true))
    (println (str "wrote " markdown-path))
    (println (str "wrote " csv-path))
    (println (str "wrote " json-path))
    (when (:write-unavailable opts)
      (python/exit 1)))
  (catch python/ValueError e
    (binding [*out* *err*]
      (println (str e)))
    (python/exit 2))
  (catch python/Exception e
    (binding [*out* *err*]
      (println (str e)))
    (python/exit 1)))
